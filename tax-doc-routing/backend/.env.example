# Local development environment for the Tax Document Routing backend.
# Copy to `backend/.env` (git-ignored) and adjust. NEVER commit the real .env.
# See docs/LOCAL_DEV_SETUP.md section 4.

# --- runtime ---
ENV_NAME=local
API_HOST=127.0.0.1
API_PORT=8080
LOG_LEVEL=info
APP_LOG_JSON=false
APP_OTEL_ENABLED=false

# Worker-thread stack (MiB): the read path recurses deeply; 128 avoids a stack overflow.
# See backend/src/main.rs. Leave it.
BACKEND_WORKER_STACK_MIB=128

# --- database: local `tax-doc-routing-postgres` container (host port 5434, database tax_routing) ---
# The compose image creates only the `postgres` superuser. Either create a `tax_routing_svc`
# role once (see LOCAL_DEV_SETUP.md) or set these to postgres / postgres.
PG_SERVICE_ACCOUNT_NAME=postgres
PG_SERVICE_ACCOUNT_PASS=postgres
PG_PORT=5434

# --- CORS: Vite dev server ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- GraphQL introspection (local dev convenience) ---
APP_GRAPHQL_INTROSPECTION_ENABLED=true
APP_GRAPHQL_INTROSPECTION_REQUIRED_ROLES=admin

# --- serve the built SPA at / ---
APP_PRODUCT_UI_ENABLED=true

# --- Okta / JWT: never contacted in local mode, but the config parser requires these to be set.
# APP_ENABLE_LOCAL_TEST_AUTH=true + ENV_NAME=local => every request is auto-authenticated as a
# local admin. NEVER set that flag outside local/compose.
OKTA_ISSUER=https://example.okta.com/oauth2/default
OKTA_AUDIENCE=api://default
OKTA_CLIENT_ID=local-dev-client-id
APP_ENABLE_LOCAL_TEST_AUTH=true

# --- Document store (OPTIONAL; deferred). The storage platform is Box in the source spec and
# moves to SharePoint later. Until then the in-memory store is used. Never commit real values.
# DOCUMENT_STORE=memory
VERSION=0.1.0
