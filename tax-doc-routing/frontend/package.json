{
  "name": "tax-doc-routing-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node ../../.claude/skills/pds-frontend-guard/hooks/enable-git-hook.mjs || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pds:ratchet": "node scripts/check-pds-ratchet.mjs",
    "appfw:check": "node scripts/check-scaffold.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "bash ../../.claude/skills/pds-frontend-guard/scripts/verify-all.sh",
    "test:frontend": "npm run appfw:check && npm run pds:ratchet && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@appfw/pds-health-components": "file:vendor/appfw-pds-health-components-0.12.0.tgz",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
