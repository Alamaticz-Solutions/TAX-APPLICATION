#!/usr/bin/env bash
# Blocks a push unless the commit being pushed passed the PDS verification:
# .claude/skills/pds-frontend-guard/scripts/verify-all.sh (for a push that touches the frontend: the
# frontend gate with the PDS rule tests, then the Playwright suite on the mocked API, about 3 minutes;
# a push with no frontend change has nothing to check and goes through).
#
# Enabled automatically (no setup): the plugin's SessionStart hook and `npm install` in
# tax-doc-routing/frontend both run hooks/enable-git-hook.mjs, which sets core.hooksPath
# to this folder. A commit verify-all.sh already passed is not run twice.

set -euo pipefail

z40=0000000000000000000000000000000000000000
stamp="$(git rev-parse --absolute-git-dir)/pds-verify-passed"
head="$(git rev-parse HEAD)"
verified="$(cat "$stamp" 2>/dev/null || true)"
need=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue # deleting a remote branch
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked-out commit. Verification runs on the checked-out" >&2
    echo "pre-push: commit, so check out $local_ref and push it from there." >&2
    exit 1
  fi
  [ "$local_sha" = "$verified" ] || need=1
done

if [ "$need" = 0 ]; then
  if [ "$verified" = "$head" ]; then
    echo "pre-push: $(git rev-parse --short HEAD) already passed verify-all.sh"
  else
    echo "pre-push: nothing to verify (the push only deletes remote branches)"
  fi
  exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: the working tree has uncommitted changes. Verification checks the committed" >&2
  echo "pre-push: code, so commit or stash them first." >&2
  exit 1
fi

echo "pre-push: running the frontend PDS verification (about 3 minutes; logs in tax-doc-routing/target/verify/)"
bash "$(git rev-parse --show-toplevel)/.claude/skills/pds-frontend-guard/scripts/verify-all.sh" </dev/null
