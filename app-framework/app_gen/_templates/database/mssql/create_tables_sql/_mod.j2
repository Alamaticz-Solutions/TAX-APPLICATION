IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'{{ schema.name }}')
    EXEC('CREATE SCHEMA [{{ schema.name }}]');
GO

{#
    ADD TABLES

    Emit GO after each table block so ODBC/SQL Server apply DDL as separate
    batches. A single giant batch aborts mid-script on the first failing
    statement and can leave later tables (including *_audit) uncreated while
    the migrate driver still reports success for the overall execute call.
#}
{% for table in ddl.tables %}
IF OBJECT_ID(N'[{{ table.schema_name }}].[{{ table.name }}]', N'U') IS NOT NULL
BEGIN
    PRINT N'ALTERING table {{ table.name }}';
{% for column in table.alter_columns %}
    IF NOT EXISTS (
        SELECT 1 FROM sys.columns
        WHERE object_id = OBJECT_ID(N'[{{ table.schema_name }}].[{{ table.name }}]')
          AND name = N'{{ column.name }}'
    )
        ALTER TABLE [{{ table.schema_name }}].[{{ table.name }}] ADD {{ column.alter_definition }};
{% endfor %}
END
ELSE
BEGIN
    PRINT N'CREATING table {{ table.name }}';
    CREATE TABLE [{{ table.schema_name }}].[{{ table.name }}]
    ({% for column in table.columns %}
        {% if not loop.first %},{% endif %}{{ column.create_definition }}
    {%- endfor %}
    );
END
GO
{% endfor %}

{#
    ADD PER-ENTITY AUDIT TABLES
#}
{% for audit in ddl.audit_tables %}
IF OBJECT_ID(N'[{{ audit.schema_name }}].[{{ audit.name }}]', N'U') IS NULL
BEGIN
    CREATE TABLE [{{ audit.schema_name }}].[{{ audit.name }}]
    ({% for column in audit.columns %}
        {% if not loop.first %},{% endif %}[{{ column.name }}] {{ column.create_definition }}
    {%- endfor %}
    );
END
GO

{% for column in audit.migration_columns %}
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID(N'[{{ audit.schema_name }}].[{{ audit.name }}]') AND name = N'{{ column.name }}')
    ALTER TABLE [{{ audit.schema_name }}].[{{ audit.name }}] ADD [{{ column.name }}] {{ column.sql_type }} NOT NULL CONSTRAINT [df_{{ audit.name }}_{{ column.name }}] DEFAULT {{ column.default_literal }};
GO
{% endfor %}
{% for index in audit.indexes %}
IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = N'{{ index.name }}' AND object_id = OBJECT_ID(N'[{{ index.schema_name }}].[{{ index.table_name }}]'))
    CREATE {% if index.unique %}UNIQUE {% endif %}INDEX [{{ index.name }}] ON [{{ index.schema_name }}].[{{ index.table_name }}] ({{ index.column_list }});
GO
{% endfor %}
{% endfor %}

{#
    ADD INDEXES
#}
{% for index in ddl.indexes %}
IF NOT EXISTS (
    SELECT 1 FROM sys.indexes
    WHERE name = N'{{ index.name }}'
      AND object_id = OBJECT_ID(N'[{{ index.schema_name }}].[{{ index.table_name }}]')
)
BEGIN
    PRINT N'Creating index {{ index.name }}';
    CREATE {% if index.unique %}UNIQUE {% endif %}INDEX [{{ index.name }}]
        ON [{{ index.schema_name }}].[{{ index.table_name }}] ({{ index.column_list }});
END
GO
{% endfor %}

{#
    ADD FOREIGN KEY CONSTRAINTS
#}
{% for fk in ddl.foreign_keys %}
IF NOT EXISTS (
    SELECT 1 FROM sys.foreign_keys
    WHERE name = N'{{ fk.name }}'
      AND parent_object_id = OBJECT_ID(N'[{{ fk.source_schema }}].[{{ fk.source_table }}]')
)
BEGIN
    PRINT N'Creating foreign key constraint {{ fk.name }}';
    ALTER TABLE [{{ fk.source_schema }}].[{{ fk.source_table }}]
        ADD CONSTRAINT [{{ fk.name }}]
        FOREIGN KEY ([{{ fk.source_column }}])
        REFERENCES [{{ fk.target_schema }}].[{{ fk.target_table }}]([{{ fk.target_column }}])
        ON DELETE {{ fk.on_delete }} ON UPDATE {{ fk.on_update }};
END
GO
{% endfor %}

{#
    ADD CONSTRAINTS
#}
{% for constraint in ddl.constraints %}
IF NOT EXISTS (
    SELECT 1 FROM sys.objects
    WHERE name = N'{{ constraint.name }}'
      AND parent_object_id = OBJECT_ID(N'[{{ constraint.schema_name }}].[{{ constraint.table_name }}]')
)
BEGIN
    PRINT N'Creating constraint {{ constraint.name }} on {{ constraint.table_name }}';
    ALTER TABLE [{{ constraint.schema_name }}].[{{ constraint.table_name }}]
        ADD CONSTRAINT {{ constraint.definition }};
END
GO
{% endfor %}

{#
    ADD JUNCTION TABLES FOR MANYTOMANY RELATIONSHIPS
#}
{% for junction in ddl.junction_tables %}
-- Junction table for ManyToMany: {{ junction.source_entity_name }} <-> {{ junction.target_entity_name }}
IF OBJECT_ID(N'[{{ junction.schema_name }}].[{{ junction.table_name }}]', N'U') IS NULL
BEGIN
    PRINT N'CREATING junction table {{ junction.raw_table_name }}';
    CREATE TABLE [{{ junction.schema_name }}].[{{ junction.table_name }}]
    (
        [id] uniqueidentifier NOT NULL CONSTRAINT [df_{{ junction.table_name }}_id] DEFAULT NEWID() CONSTRAINT [pk_{{ junction.table_name }}] PRIMARY KEY,
        [{{ junction.local_key }}] uniqueidentifier NOT NULL,
        [{{ junction.foreign_key }}] uniqueidentifier NOT NULL,
        [created_at] datetimeoffset(7) NOT NULL CONSTRAINT [df_{{ junction.table_name }}_created_at] DEFAULT SYSDATETIMEOFFSET(),
        CONSTRAINT [uq_{{ junction.table_name }}] UNIQUE ([{{ junction.local_key }}], [{{ junction.foreign_key }}])
    );

    CREATE INDEX [idx_{{ junction.table_name }}_{{ junction.local_key }}]
        ON [{{ junction.schema_name }}].[{{ junction.table_name }}] ([{{ junction.local_key }}]);
    CREATE INDEX [idx_{{ junction.table_name }}_{{ junction.foreign_key }}]
        ON [{{ junction.schema_name }}].[{{ junction.table_name }}] ([{{ junction.foreign_key }}]);

    ALTER TABLE [{{ junction.schema_name }}].[{{ junction.table_name }}]
        ADD CONSTRAINT [fk_{{ junction.table_name }}_{{ junction.local_key }}]
        FOREIGN KEY ([{{ junction.local_key }}])
        REFERENCES [{{ junction.source_schema }}].[{{ junction.source_table }}]([id])
        ON DELETE CASCADE ON UPDATE CASCADE;

    ALTER TABLE [{{ junction.schema_name }}].[{{ junction.table_name }}]
        ADD CONSTRAINT [fk_{{ junction.table_name }}_{{ junction.foreign_key }}]
        FOREIGN KEY ([{{ junction.foreign_key }}])
        REFERENCES [{{ junction.target_schema }}].[{{ junction.target_table }}]([id])
        ON DELETE NO ACTION ON UPDATE NO ACTION;
END
GO
{% endfor %}
