--
--    Generated by app_gen.
--    by app_gen/_templates/database/mssql/seed_sql/_mod.j2
--    Seed data for {{ schema.name }} schema (T-SQL dialect)
--

{% for seed in seeds %}
{% set table = seed.entity_type | snake_n %}

-- ----------------------------------------------------------------------------
-- {{ seed.entity_type }}
-- ----------------------------------------------------------------------------

{% for record in seed.records %}
IF NOT EXISTS (SELECT 1 FROM [{{ seed.schema }}].[{{ table }}] WHERE [id] = N'{{ record["id"] }}')
    INSERT INTO [{{ seed.schema }}].[{{ table }}] (
        {% for col in seed.columns %}[{{ col }}]{% if not loop.last %}, {% endif %}{% endfor %}
    )
    VALUES (
        {% for col in seed.columns %}
        {%- if record[col] is defined -%}
          {{- record[col] | mssql_seed_literal -}}
        {%- else -%}NULL
        {%- endif -%}
        {%- if not loop.last %}, {% endif %}
        {% endfor %}
    );
{% endfor %}

{% endfor %}
