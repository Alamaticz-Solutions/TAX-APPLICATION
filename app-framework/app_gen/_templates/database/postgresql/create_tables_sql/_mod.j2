DO $$
BEGIN

{#
 ADD SEQUENCES
#}
{% for sequence in ddl.sequences %}
    IF NOT EXISTS (SELECT 1 FROM pg_sequences WHERE schemaname = '{{ sequence.schema_name }}' AND sequencename = '{{ sequence.name }}') THEN
        RAISE NOTICE 'Creating sequence {{ sequence.schema_name }}.{{ sequence.name }}';
        CREATE SEQUENCE {{ sequence.schema_name }}.{{ sequence.name }};
    END IF;
{% endfor %}

{#
 ADD TABLES
#}
{% for table in ddl.tables %}
    IF EXISTS(SELECT TRUE FROM pg_type where typnamespace = (select oid from pg_catalog.pg_namespace where nspname = '{{ table.schema_name }}') AND typname = '{{ table.name }}')
    THEN
        RAISE NOTICE 'ALTERING table {{ table.name }}';
{% for column in table.alter_columns %}
        ALTER TABLE {{ table.schema_name }}.{{ table.name }} ADD COLUMN IF NOT EXISTS {{ column.alter_definition }};
{% endfor %}
    ELSE
        RAISE NOTICE 'CREATING, table {{ table.name }}';
        CREATE TABLE {{ table.schema_name }}.{{ table.name }}
        ({% for column in table.columns %}
            {% if not loop.first %},{% endif %}{{ column.create_definition }}
        {%- endfor %}
        );
    END IF;
{% endfor %}

{#
 ADD PER-ENTITY AUDIT TABLES
#}
{% for audit in ddl.audit_tables %}
    CREATE TABLE IF NOT EXISTS {{ audit.schema_name }}.{{ audit.name }}
    ({% for column in audit.columns %}
        {% if not loop.first %},{% endif %}{{ column.name }} {{ column.create_definition }}
    {%- endfor %}
    );

{% for column in audit.migration_columns %}
    ALTER TABLE {{ audit.schema_name }}.{{ audit.name }} ADD COLUMN IF NOT EXISTS {{ column.name }} {{ column.sql_type }} NOT NULL DEFAULT {{ column.default_literal }};
{% endfor %}
{% for index in audit.indexes %}
    CREATE {% if index.unique %}UNIQUE {% endif %}INDEX IF NOT EXISTS {{ index.name }}
        ON {{ index.schema_name }}.{{ index.table_name }} ({{ index.column_list }});
{% endfor %}
{% endfor %}

{#
 ADD INDEXES
#}
{% for index in ddl.indexes %}
    IF NOT EXISTS (
        SELECT 1
        FROM pg_indexes
        WHERE schemaname = '{{ index.schema_name }}'
        AND tablename = '{{ index.table_name }}'
        AND indexname = '{{ index.name }}'
    ) THEN
        RAISE NOTICE 'Creating index {{ index.name }}';
        CREATE {% if index.unique %}UNIQUE {% endif %}INDEX {{ index.name }}
        ON {{ index.schema_name }}.{{ index.table_name }} ({{ index.column_list }});
    ELSE
        RAISE NOTICE 'Index {{ index.name }} already exists';
    END IF;
{% endfor %}

{#
 ADD FOREIGN KEY CONSTRAINTS
#}
{% for fk in ddl.foreign_keys %}
    IF NOT EXISTS (
        SELECT 1
        FROM information_schema.table_constraints
        WHERE constraint_schema = '{{ fk.source_schema }}'
        AND table_name = '{{ fk.source_table }}'
        AND constraint_name = '{{ fk.name }}'
        AND constraint_type = 'FOREIGN KEY'
    ) THEN
        RAISE NOTICE 'Creating foreign key constraint {{ fk.name }}';
        ALTER TABLE {{ fk.source_schema }}.{{ fk.source_table }}
        ADD CONSTRAINT {{ fk.name }}
        FOREIGN KEY ("{{ fk.source_column }}")
        REFERENCES {{ fk.target_schema }}.{{ fk.target_table }}("{{ fk.target_column }}")
        ON DELETE {{ fk.on_delete }} ON UPDATE {{ fk.on_update }};
    ELSE
        RAISE NOTICE 'Foreign key constraint {{ fk.name }} already exists';
    END IF;
{% endfor %}

{#
 ADD CONSTRAINTS
#}
{% for constraint in ddl.constraints %}
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = '{{ constraint.name }}'
        AND conrelid = '{{ constraint.schema_name }}."{{ constraint.table_name }}"'::regclass
    ) THEN
        RAISE NOTICE 'Creating constraint {{ constraint.name }} on {{ constraint.table_name }}';
        ALTER TABLE {{ constraint.schema_name }}."{{ constraint.table_name }}"
        ADD CONSTRAINT {{ constraint.definition }};
    ELSE
        RAISE NOTICE 'Constraint {{ constraint.name }} already exists';
    END IF;
{% endfor %}

{#
 ADD JUNCTION TABLES FOR MANYTOMANY RELATIONSHIPS
#}
{% for junction in ddl.junction_tables %}
    -- Creating junction table for ManyToMany relationship: {{ junction.source_entity_name }} <-> {{ junction.target_entity_name }}

    IF NOT EXISTS(SELECT TRUE FROM pg_type where typnamespace = (select oid from pg_catalog.pg_namespace where nspname = '{{ junction.schema_name }}') AND typname = '{{ junction.table_name }}')
    THEN
        RAISE NOTICE 'CREATING junction table {{ junction.raw_table_name }}';
        CREATE TABLE {{ junction.schema_name }}.{{ junction.table_name }}
        (
            "id" uuid NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,
            "{{ junction.local_key }}" uuid NOT NULL,
            "{{ junction.foreign_key }}" uuid NOT NULL,
            "created_at" timestamp DEFAULT NOW(),
            UNIQUE("{{ junction.local_key }}", "{{ junction.foreign_key }}")
        );

        CREATE INDEX idx_{{ junction.table_name }}_{{ junction.local_key }} ON {{ junction.schema_name }}.{{ junction.table_name }} ("{{ junction.local_key }}");
        CREATE INDEX idx_{{ junction.table_name }}_{{ junction.foreign_key }} ON {{ junction.schema_name }}.{{ junction.table_name }} ("{{ junction.foreign_key }}");

        ALTER TABLE {{ junction.schema_name }}.{{ junction.table_name }}
        ADD CONSTRAINT fk_{{ junction.table_name }}_{{ junction.local_key }}
        FOREIGN KEY ("{{ junction.local_key }}")
        REFERENCES {{ junction.source_schema }}.{{ junction.source_table }}("id")
        ON DELETE CASCADE ON UPDATE CASCADE;

        ALTER TABLE {{ junction.schema_name }}.{{ junction.table_name }}
        ADD CONSTRAINT fk_{{ junction.table_name }}_{{ junction.foreign_key }}
        FOREIGN KEY ("{{ junction.foreign_key }}")
        REFERENCES {{ junction.target_schema }}.{{ junction.target_table }}("id")
        ON DELETE CASCADE ON UPDATE CASCADE;
    ELSE
        RAISE NOTICE 'Junction table {{ junction.raw_table_name }} already exists';
    END IF;
{% endfor %}

END $$;
