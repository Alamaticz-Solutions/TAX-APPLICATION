  async fn user_info(
    &self, 
    ctx: &Context<'_>
  ) -> Result<JsonValue>
  {
    // Convenience handler to return user info.
    // If user is not None, then they are authenticated. 
    if let Some(user) = user_from_context(ctx) {
      Ok(serde_json::to_value(user)?)
    } else {
      Ok(serde_json::json!({ "error": true }))
    }
  }
