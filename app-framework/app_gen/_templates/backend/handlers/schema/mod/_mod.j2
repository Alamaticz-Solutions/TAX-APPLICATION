#[cfg(feature = "http")]
fn from_context(
  ctx: &Context<'_>, 
  schema_name: &'static str,
  type_name: &'static str,
) -> std::result::Result<HandlerContext, AppError>
{
  let user = user_from_context(ctx);
  let data_access = data_access_from_context(ctx);
  let entity_type = entity_type_for_handler(&data_access, schema_name, type_name)?;
  let selections = get_query_selections(data_access.app_config.clone(), entity_type.clone(), ctx.field())?;
  Ok(HandlerContext::new(user, data_access, entity_type, selections))
}

#[cfg(feature = "http")]
fn from_context_without_selections(
  ctx: &Context<'_>,
  schema_name: &'static str,
  type_name: &'static str,
) -> std::result::Result<HandlerContext, AppError>
{
  let user = user_from_context(ctx);
  let data_access = data_access_from_context(ctx);
  let entity_type = entity_type_for_handler(&data_access, schema_name, type_name)?;
  Ok(HandlerContext::new(user, data_access, entity_type, JsonValue::Null))
}

#[cfg(feature = "http")]
fn pagination_args(
  skip: Option<i32>,
  limit: Option<i32>,
) -> std::result::Result<(i32, i32), AppError>
{
  Ok(PaginationPolicy::from_env().normalize(skip, limit)?)
}
