{%- if methodName == "FindById" %}
  async fn find_{{ entityType.snake_1 }}(
    &self, 
    ctx: &Context<'_>, 
    id: String
  ) -> FieldResult<Option<{{ entityType.pascal_1 }}Projection>> 
  {
    let handler_context = from_context(ctx, "{{ entityType.schema_name }}", "{{ entityType.pascal_1 }}")?;
    let (user, data_access, entity_type, selections) = handler_context.into_handler_parts();
   
    let res = {{ entityType.snake_1 }}::find_impl(
      user, &data_access, &entity_type, selections, id
    ).await;

    match res {
      Ok(res) => Ok(res),
      Err(e) => Err(e.into()),
    }
  }

