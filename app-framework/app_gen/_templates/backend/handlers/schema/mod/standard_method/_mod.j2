{%- elif methodName == "Query" %}
  async fn query_{{ entityType.snake_n }}(
    &self, 
    ctx: &Context<'_>, 
    filter: Option<JsonValue>,
    sort: Option<JsonValue>,
    skip: Option<i32>,
    limit: Option<i32>,
    after: Option<String>,
  ) -> FieldResult<{{ entityType.pascal_1 }}QueryResult> 
  {
    let handler_context = from_context(ctx, "{{ entityType.schema_name }}", "{{ entityType.pascal_1 }}")?;
    let (user, data_access, entity_type, selections) = handler_context.into_handler_parts();
    let (skip, limit) = pagination_args(skip, limit)?;
 
    let res = {{ entityType.snake_1 }}::query_impl(
      user, &data_access, &entity_type, selections, filter, sort, skip, limit, after
    ).await;
    
    match res {
      Ok(res) => Ok(
        {{ entityType.pascal_1 }}QueryResult {
          date_time: res.date_time,
          request_duration: res.request_duration,
          skip: res.skip,
          limit: res.limit,
          page_count: res.page_count,
          page_index: res.page_index,
          query_count: res.query_count,
          next_cursor: res.next_cursor,
          previous_cursor: res.previous_cursor,
          items: res.items,
        }
      ),
      Err(e) => Err(e.into()),
    }
  }
  async fn aggregate_{{ entityType.snake_n }}(
    &self,
    ctx: &Context<'_>,
    filter: Option<JsonValue>,
    group_by: Option<JsonValue>,
    metrics: Option<JsonValue>,
    having: Option<JsonValue>,
    sort: Option<JsonValue>,
    skip: Option<i32>,
    limit: Option<i32>,
  ) -> FieldResult<AggregateResult>
  {
    let handler_context = from_context_without_selections(ctx, "{{ entityType.schema_name }}", "{{ entityType.pascal_1 }}")?;
    let (user, data_access, entity_type, _) = handler_context.into_handler_parts();
    let (skip, limit) = pagination_args(skip, limit)?;

    let res = data_access.aggregate_items(
      entity_type,
      filter,
      group_by,
      metrics,
      having,
      sort,
      skip,
      limit,
      user,
    ).await;

    match res {
      Ok(res) => Ok(res),
      Err(e) => Err(e.into()),
    }
  }
