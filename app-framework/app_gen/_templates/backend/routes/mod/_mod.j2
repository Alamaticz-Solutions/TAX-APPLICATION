#[cfg(feature = "http")]
async fn create_data_access_for_schema(app_config: Arc<AppConfig>, schema_name: &str, metrics: MetricsRegistry) -> Result<Arc<DataAccess>, AppError>
{
  let data_source_name = app_config.get_schema_data_source_name(schema_name)?;
  let client = create_database_client(app_config.clone(), data_source_name).await?;
  Ok(Arc::new(DataAccess::init(app_config, client, metrics)))
}

#[cfg(feature = "http")]
async fn create_database_client(app_config: Arc<AppConfig>, data_source_name: String) -> Result<DatabaseClientBox, AppError>
{
  let provider = runtime_provider(app_config.get_data_source_type(&data_source_name)?);
  database_client_registry(app_config).create(provider, data_source_name).await
}

