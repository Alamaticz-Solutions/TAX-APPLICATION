fn data_access_for_schema(
    data_access_by_schema: &HashMap<String, Arc<DataAccess>>,
    schema_name: &str,
) -> Result<Arc<DataAccess>, AppError> {
    data_access_by_schema
        .get(schema_name)
        .cloned()
        .ok_or_else(|| AppError::Validation(format!("unknown schema: {schema_name}")))
}

fn selection_json(entity_type: &EntityType, fields: Option<Vec<String>>) -> Value {
    appfw_runtime::operation::selection_json(&runtime_entity_metadata(entity_type), fields)
}

fn to_redacted_entity_json<T: Serialize>(
    entity_type: &EntityType,
    value: T,
) -> Result<Value, AppError> {
    let value = operation::to_json(value)?;
    Ok(operation::redact_entity_payload(
        &runtime_entity_metadata(entity_type),
        value,
    ))
}
