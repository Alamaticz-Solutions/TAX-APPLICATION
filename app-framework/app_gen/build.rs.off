use std::{fs, path::PathBuf};
use std::env;
use std::fs::{self};
use serde_json::{Map, Value, json};
use tera::*;


// extern crate app_gen_utils;
// use app_gen_utils::{ filters, templates };


fn main() 
{
  println!("build.rs STARTED");

  let curr_dir = env::current_dir().expect("could not get current dir");

  let tera = &mut Tera::default();

  register_filters(tera, &curr_dir).expect("register_filters error"); 
  register_templates(tera, &curr_dir).expect("register_templates error"); 

  let mut context = Context::new();

  // Generate files
  gen_app_serde_rs(&tera, &context);

  println!("build.rs COMPLETED");
}


fn gen_app_serde_rs(tera: &Tera, context: &Context) 
{
  let schema_mod_rs = tera.render("config_serde", context).expect("tera.render config_serde failed");
  fs::write("./src/app.rs", schema_mod_rs).unwrap();
  println!("mod.rs generated");
}



fn register_filters(tera: &mut Tera, path: &PathBuf) -> Result<()> 
{
  let gen_config_serde_dir = path.join("1_gen_config_serde");
  filters::register_type_def(tera, &gen_config_serde_dir).expect("register_type_def_filter failed");
  filters::register_enum_def(tera, &gen_config_serde_dir).expect("register_enum_def_filter failed");
  filters::register_inflector(tera, "camel").expect("register_inflector_filter failed");
  Ok(())
}

fn register_templates(tera: &mut Tera, path: &PathBuf) -> Result<()> 
{
  let common_dir = path.join("0_common");
  let gen_config_serde_dir = path.join("1_gen_config_serde");
  println!("register_templates: path {:?}", gen_config_serde_dir);
  templates::register_templates(tera, common_dir.as_path()).expect("register_templates common_dir failed");
  templates::register_templates(tera, gen_config_serde_dir.as_path()).expect("register_templates gen_config_serde_dir failed");
  Ok(())
}







pub fn create() -> Result<Context> 
{
  Ok(Context::new())
}


pub fn create_for_app(app_name: &str) -> Result<Context> 
{
  let mut context = Context::new();
  context.insert("appName", &app_name);
  Ok(context)
}

pub fn load_yaml(context: &mut Context, src_file: &PathBuf, ctx_name: &str)-> Result<()> 
{
  println!("    context::load_yaml: {:?}", src_file);
  let res: Value = read_yaml(src_file).unwrap();
  context.insert(ctx_name, &res);
  Ok( () )
}

pub fn load_item_yaml(context: &mut Context, src_file: &PathBuf, ctx_name: &str)-> Result<()> 
{
  println!("    context::load_item_yaml: {:?}", src_file);
  let res: Value = read_yaml(src_file).unwrap();
  let item = res.as_array().unwrap().first().unwrap();
  context.insert(ctx_name, &item);
  Ok( () )
}


