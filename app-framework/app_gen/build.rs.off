pub fn read_yaml(src_file: &PathBuf)-> Result<Value> 
{
  println!("    context::read_yaml: {:?}", src_file);
  let f = std::fs::File::open(src_file).expect("Could not open yaml file.");
  let res: Value = serde_yaml::from_reader(f).expect("Could not read yaml values.");
  Ok( res )
}


pub fn load_dir(context: &mut Context, src_dir: &PathBuf, ctx_name: &str)-> Result<()> 
{
  // println!("context::load_dir:: src_dir = {:?}, ctx_name = {:?}", src_dir, ctx_name);
  let res = get_dir_value(src_dir).unwrap();
  context.insert(ctx_name, &res);
  Ok( () )
}

//
// NOTE: ONLY CONSUMES FIRST LEVEL FILES
//
fn get_dir_value(dir_path: &PathBuf) -> Result<serde_yaml::Value> 
{
  // println!("");
  // println!("get_dir_value: {:?}", dir_path);
  let mut dir_items = serde_yaml::Sequence::new();
  for entry in fs::read_dir(dir_path)? {
    let path = entry?.path();
    let file_name = path.file_stem().unwrap().to_str().unwrap();
    let extension = path.extension().unwrap();
    // Only yaml files and NOT the _res.yaml one.
    if extension.eq_ignore_ascii_case("yaml") && file_name.ne("_res") {
      println!("      get_file_value: {:?}", path);
      let f = std::fs::File::open(path).expect("could not read yaml file");
      let mut file_items: serde_yaml::Sequence = serde_yaml::from_reader(f).expect("could not deserialize yaml");
      dir_items.append(&mut file_items);
    }
  }
  let res: serde_yaml::Value = dir_items.into();
  // println!("result:");
  // println!("{:?}", res);
  Ok(res)
}
