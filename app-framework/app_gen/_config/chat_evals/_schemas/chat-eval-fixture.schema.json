{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-framework.local/schemas/chat-eval-fixture.schema.json",
  "title": "App Framework Chat Eval Fixture",
  "type": "object",
  "required": [
    "name",
    "description",
    "auth_token",
    "provenance",
    "query",
    "context",
    "registry",
    "fixture_store",
    "transcript",
    "replay_transcript",
    "answer_envelope",
    "expect"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "auth_token": {
      "type": "string",
      "enum": ["pdsh_admin", "cc_tenant_user", "west_sales_rep", "other_tenant_admin"]
    },
    "provenance": {
      "type": "string",
      "enum": ["synthetic", "vendor_export", "recorded_live"]
    },
    "query": { "type": "string", "minLength": 1 },
    "context": { "type": "object" },
    "registry": {
      "type": "object",
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "args_schema", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "args_schema": { "const": "registry" },
              "kind": { "enum": ["read", "write"] },
              "write_gated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "fixture_store": {
      "type": "object",
      "required": ["records"],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "tenant", "type"],
            "properties": {
              "id": { "type": "string", "pattern": "^rl_[0-9a-f]{32}$" },
              "tenant": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "caption": { "type": "string" }
            }
          }
        },
        "cross_tenant_seeded_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "transcript": {
      "type": "array",
      "items": { "type": "object", "required": ["type"] }
    },
    "replay_transcript": {
      "type": "array",
      "items": { "type": "object", "required": ["type"] }
    },
    "answer_envelope": {
      "type": "object",
      "required": ["version", "refs", "citations", "fallback_view"],
      "properties": {
        "version": { "const": "answer_envelope@1" },
        "refs": { "type": "array" },
        "citations": { "type": "array" },
        "fallback_view": { "type": "string", "minLength": 1 },
        "unverified": { "type": "boolean" }
      }
    },
    "expect": { "type": "object" }
  }
}
