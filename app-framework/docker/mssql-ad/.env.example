# Throwaway lab credentials for docker/mssql-ad only.
# Copy to `.env` (gitignored) before `docker compose up`:
#   cp .env.example .env
#
# Only the SQL SA password must be set. Compose defaults cover hosts, ports,
# NTLM mock principals, and login timeout. Keep MSSQL_ODBC_PASSWORD in sync by
# using the same value (test-runner reads SA password for sql_password e2e).

MSSQL_SA_PASSWORD=YourStrong!Passw0rd
