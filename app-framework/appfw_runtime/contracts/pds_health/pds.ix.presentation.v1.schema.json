{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appfw.pdshealth.com/schemas/pds.ix.presentation.v1.schema.json",
  "title": "PDS IX Presentation Envelope",
  "description": "Channel-neutral presentation data. This is not an IX lifecycle or authority contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "announcement", "response"],
  "properties": {
    "identity": { "$ref": "#/$defs/identity" },
    "announcement": { "$ref": "#/$defs/nonEmptyString" },
    "context": { "$ref": "#/$defs/context" },
    "workStatus": { "$ref": "#/$defs/workStatus" },
    "response": { "$ref": "#/$defs/response" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "presentationId", "revision"],
      "properties": {
        "schemaVersion": { "const": "pds.ix.presentation@1" },
        "presentationId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "sourceRef": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "items"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/evidenceItem" }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "announcement", "gaps", "evidence"],
      "properties": {
        "eyebrow": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/nonEmptyString" },
        "announcement": { "$ref": "#/$defs/nonEmptyString" },
        "gaps": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "metaLabel": { "$ref": "#/$defs/nonEmptyString" },
        "actionLabel": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "workStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "active"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/nonEmptyString" },
        "active": { "type": "boolean" },
        "actionLabel": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["partial", "ready", "stale", "failed"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "body": { "$ref": "#/$defs/nonEmptyString" },
        "whyItMatters": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "actionLabel": { "$ref": "#/$defs/nonEmptyString" },
        "editable": { "type": "boolean" },
        "changed": { "type": "boolean" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "announcement", "active", "regions", "emptyState"],
      "properties": {
        "eyebrow": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "metaLabel": { "$ref": "#/$defs/nonEmptyString" },
        "announcement": { "$ref": "#/$defs/nonEmptyString" },
        "active": { "type": "boolean" },
        "regions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/region" }
        },
        "emptyState": { "$ref": "#/$defs/nonEmptyString" },
        "footerText": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
