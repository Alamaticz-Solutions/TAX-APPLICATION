# Helper rule to check if a user has a specific role
has_role(user, role) if {
    user.roles[_] == role
}

# Returns tenant filter for community connect users
tenant_filter(user) := filter if {
    # if tenant id is PDS Health id, then return empty filter
    user.tenant_id == pds_tenant_id
