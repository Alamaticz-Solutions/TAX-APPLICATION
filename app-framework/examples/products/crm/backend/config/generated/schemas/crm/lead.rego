}

# Sales managers can review all lead flow.
access := res if {
    check_schema_type()
    input.action == "read"
    has_role(input.user, "sales_manager")
    res := {"allow": true, "filter": {}}
}

# Sales reps can see qualified unconverted leads only.
access := res if {
    check_schema_type()
    input.action == "read"
    has_role(input.user, "sales_rep")
    res := {"allow": true, "filter": {
        "_and": [
            {"is_converted": {"_eq": false}},
            {"company": {"_ne": null}}
        ]
    }}
