  run_generated_api_tests "$@"
}

provider_from_env() {
  local raw="${API_TEST_PROVIDER:-${APP_CRM_DATA_SOURCE_NAME:-${APP_DATA_SOURCE_NAME:-}}}"
  raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$raw" in
    *mongo*) printf 'mongo' ;;
    *mssql*|*sqlserver*) printf 'mssql' ;;
    *snowflake*) printf 'snowflake' ;;
    *pg*|*postgres*) printf 'postgres' ;;
    *) printf '' ;;
  esac
}

provider_data_source_name() {
  case "$1" in
    postgres) printf 'pg_primary' ;;
    mongo) printf 'mongo_primary' ;;
    mssql) printf 'mssql_primary' ;;
    snowflake) printf 'snowflake_primary' ;;
    *)
      echo "Unknown provider: $1" >&2
      return 2
      ;;
  esac
}

provider_base_url() {
  local provider="$1"
  local upper
  upper="$(printf '%s' "$provider" | tr '[:lower:]' '[:upper:]')"
  local var_name="API_TEST_BASE_URL_${upper}"
  local provider_url="${!var_name:-}"
  if [[ -n "$provider_url" ]]; then
    printf '%s' "$provider_url"
  else
    printf '%s' "${API_TEST_BASE_URL:-http://localhost:8080}"
  fi
}

provider_base_url_env_name() {
  local provider="$1"
  local upper
  upper="$(printf '%s' "$provider" | tr '[:lower:]' '[:upper:]')"
  printf 'API_TEST_BASE_URL_%s' "$upper"
}

provider_test_allows_shared_base_url() {
  case "$(printf '%s' "${APPFW_PROVIDER_TEST_ALLOW_SHARED_BASE_URL:-}" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | y | on)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

provider_health_url() {
  local base_url="$1"
  printf '%s/health/ready' "${base_url%/}"
}

provider_test_preflight() {
  local provider="$1"
  local base_url="$2"
  local log_file="$3"
  local all="$4"
  local env_name
  env_name="$(provider_base_url_env_name "$provider")"

  if [[ "$all" == "1" && -z "${!env_name:-}" ]] && ! provider_test_allows_shared_base_url; then
    {
      printf 'provider-test preflight failed for %s\n' "$provider"
      printf '  missing %s for --all certification\n' "$env_name"
      printf '  fallback base URL would be %s\n' "$base_url"
      printf '  set %s to the provider-specific backend URL, or set APPFW_PROVIDER_TEST_ALLOW_SHARED_BASE_URL=true for a non-release local smoke run\n' "$env_name"
    } >>"$log_file"
    return 1
  fi

  if command -v curl >/dev/null 2>&1; then
    local health_url
    health_url="$(provider_health_url "$base_url")"
    if ! curl -kfsS --max-time "${APPFW_PROVIDER_TEST_PREFLIGHT_TIMEOUT:-5}" "$health_url" >/dev/null 2>&1; then
      {
        printf 'provider-test preflight failed for %s\n' "$provider"
        printf '  health endpoint is not reachable: %s\n' "$health_url"
        printf '  start a backend with APP_CRM_DATA_SOURCE_NAME=%s and set %s=%s\n' \
          "$(provider_data_source_name "$provider")" \
          "$env_name" \
          "$base_url"
      } >>"$log_file"
      return 1
    fi
  fi
}

run_provider_api_tests() {
  local provider="$1"
  local log_file="$2"
  shift 2

  local data_source
  data_source="$(provider_data_source_name "$provider")"
  local base_url
  base_url="$(provider_base_url "$provider")"

  (
    cd "$provider_api_tests_dir"
    require_framework_lockfile
    export API_TEST_PROVIDER="$provider"
    export APP_CRM_DATA_SOURCE_NAME="$data_source"
    export API_TEST_BASE_URL="$base_url"
    export API_TEST_PROVIDER_CERTIFICATION=1
    export API_TEST_AUTH_MODE="${API_TEST_AUTH_MODE:-local_dev}"

    local test_filter=""
    if [[ $# -gt 0 && "${1:-}" != --* ]]; then
      test_filter="$1"
      shift
    fi

    local test_binary_args=(--show-output --test-threads=1 "$@")
    if [[ -n "$test_filter" ]]; then
      cargo test --locked "$test_filter" -- "${test_binary_args[@]}"
    else
      local status=0
      cargo test --locked provider_contracts:: -- "${test_binary_args[@]}" || status=$?
      cargo test --locked provider_semantic_contracts:: -- "${test_binary_args[@]}" || status=$?
      cargo test --locked provider_schema_contracts:: -- "${test_binary_args[@]}" || status=$?
      return "$status"
    fi
  ) >"$log_file" 2>&1
}

provider_area_report() {
  local provider="$1"
  local log_file="$2"

  run_provider_certification_export \
    --provider "$provider" \
    --log-file "$log_file" \
    --areas
}

provider_graduation() {
  local plan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      *)
        echo "provider-graduation: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "provider-graduation" --plan
    return $?
  fi

  local report_dir="$framework_root/target/appfw"
  local report_file="$report_dir/provider-graduation.json"
  mkdir -p "$report_dir"
  require_framework_lockfile

  local report_tmp
  report_tmp="$(mktemp "$report_dir/provider-graduation.XXXXXX")"
  local export_status
  set +e
  run_provider_certification_export --graduation >"$report_tmp"
  export_status=$?
  set -e
  if [[ $export_status -ne 0 ]]; then
    rm -f "$report_tmp"
    return "$export_status"
  fi

  local report_status
  set +e
  python3 - "$report_tmp" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    report = json.loads(path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"provider-graduation: exporter did not produce valid JSON: {exc}", file=sys.stderr)
    raise SystemExit(2)

if not isinstance(report, dict):
    print("provider-graduation: exporter report must be a JSON object", file=sys.stderr)
    raise SystemExit(2)
if report.get("command") != "provider-graduation":
    print("provider-graduation: exporter report command mismatch", file=sys.stderr)
    raise SystemExit(2)

raise SystemExit(0 if report.get("ok") is True else 1)
PY
  report_status=$?
  set -e
  if [[ $report_status -eq 2 ]]; then
    rm -f "$report_tmp"
    return "$report_status"
  fi
  mv "$report_tmp" "$report_file"

  if [[ "$json" == "1" ]]; then
    cat "$report_file"
  else
    echo "provider-graduation report written to $report_file"
  fi
  return "$report_status"
}

governed_write_check() {
  local json="$1"
  shift || true

  local plan=0
  local enforce=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --enforce)
        enforce=1
        ;;
      *)
        echo "governed-write-check: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    python3 - "$json" <<'PY'
import json
import sys

json_mode = sys.argv[1] == "1"
report = {
    "command": "governed-write-check",
    "lane": "G1",
    "plan_only": True,
    "ok": True,
    "artifact": "target/appfw/governed-write-posture.json",
    "evidence_artifact": "target/appfw/governed-write-evidence.json",
    "purpose": "Report fail-closed external API governed-write posture before any SaaS provider can claim write certification.",
    "next_step": "Add provider-test/live evidence for delegated actor context, token-store isolation, named mutations, idempotency, policy/scope enforcement, and audit before setting governed_write_certified:true.",
}
if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
else:
    print("governed-write-check is the G1 report-only posture command")
PY
    return
  fi

  python3 - "$framework_root" "$json" "$enforce" <<'PY'
import datetime
import json
import os
import sys
from pathlib import Path

framework_root = Path(sys.argv[1]).resolve()
json_mode = sys.argv[2] == "1"
enforce = sys.argv[3] == "1"
report_dir = Path(os.environ.get("APPFW_GOVERNED_WRITE_REPORT_DIR", framework_root / "target/appfw")).resolve()
report_path = report_dir / "governed-write-posture.json"
evidence_path = report_dir / "governed-write-evidence.json"
graduation_path = report_dir / "provider-graduation.json"

external_providers = [
    "servicenow",
    "workday",
    "icims",
    "salesforce",
    "anaplan",
    "oracle_financials",
]
governed_write_areas = [
    "governed_write_enforcement",
    "delegated_actor_context",
    "token_store_isolation",
    "named_mutation_registry",
    "mutation_request_binding",
    "idempotency_and_replay_protection",
    "write_policy_and_scope_enforcement",
    "write_audit_and_evidence",
]

def rel(path):
    try:
        return str(Path(path).resolve().relative_to(framework_root))
    except ValueError:
        return str(path)

def read_json(path):
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

graduation = read_json(graduation_path)
evidence = read_json(evidence_path)
providers_by_key = {}
if isinstance(graduation, dict):
    for provider in graduation.get("providers", []) or []:
        if isinstance(provider, dict) and provider.get("provider"):
            providers_by_key[str(provider["provider"])] = provider

def area_status(provider_report, area_key):
    if not isinstance(provider_report, dict):
        return {
            "area": area_key,
            "status": "unknown",
            "graduated": False,
            "ok": False,
            "reason": "provider-graduation evidence is missing",
        }
    for area in provider_report.get("areas", []) or []:
        if isinstance(area, dict) and area.get("area") == area_key:
            return {
                "area": area_key,
                "status": area.get("status"),
                "graduated": bool(area.get("graduated")),
                "ok": bool(area.get("ok")),
                "reason": area.get("reason"),
            }
    return {
        "area": area_key,
        "status": "missing",
        "graduated": False,
        "ok": False,
        "reason": "provider-graduation did not report this governed-write area",
    }

provider_reports = []
certified_providers = []
for provider in external_providers:
    provider_report = providers_by_key.get(provider)
    gates = [area_status(provider_report, area) for area in governed_write_areas]
    certified = all(gate["graduated"] and gate["ok"] for gate in gates)
    if certified:
        certified_providers.append(provider)
    provider_reports.append({
        "provider": provider,
        "family": "external_api",
        "governed_write_certified": certified,
        "write_enabled": False,
        "mcp_enabled": False,
        "gates": gates,
    })

def evidence_schema_findings(evidence):
    if evidence is None:
        return []
    findings = []
    if not isinstance(evidence, dict):
        return ["governed-write evidence must be a JSON object"]
    sensitive_key_fragments = [
        "access_token",
        "refresh_token",
        "authorization",
        "bearer_token",
        "client_secret",
        "password",
        "raw_request",
        "raw_response",
        "request_payload",
        "response_payload",
        "tenant_data",
        "phi",
    ]
    allowed_redaction_keys = {"secrets_removed", "raw_payloads_removed", "tenant_data_removed"}
    def redaction_findings(value, path="$"):
        redaction_errors = []
        if isinstance(value, dict):
            for key, child in value.items():
                key_lower = str(key).lower()
                if key_lower not in allowed_redaction_keys and any(fragment in key_lower for fragment in sensitive_key_fragments):
                    redaction_errors.append(f"{path}.{key} must not retain secrets, raw payloads, tenant data, or PHI")
                redaction_errors.extend(redaction_findings(child, f"{path}.{key}"))
        elif isinstance(value, list):
            for index, child in enumerate(value):
                redaction_errors.extend(redaction_findings(child, f"{path}[{index}]"))
        elif isinstance(value, str):
            normalized = value.strip().lower()
            if normalized.startswith("bearer ") or normalized.startswith("basic "):
                redaction_errors.append(f"{path} must not retain authorization header values")
        return redaction_errors
    findings.extend(redaction_findings(evidence))
    external_api_providers = {
        "servicenow",
        "workday",
        "icims",
        "salesforce",
        "anaplan",
        "oracle_financials",
    }
    known_named_mutations_by_provider = {
        "servicenow": {
            "servicenow.create_incident": "servicenow.incident.write",
        }
    }
    provider = evidence.get("provider")
    for field in ["command", "lane", "ok", "release_ready", "provider", "operation"]:
        if field not in evidence:
            findings.append(f"missing {field}")
    if evidence.get("command") != "provider-test":
        findings.append("command must be provider-test")
    if evidence.get("lane") != "G1":
        findings.append("lane must be G1")
    if evidence.get("ok") is not True:
        findings.append("ok must be true")
    if evidence.get("release_ready") is not True:
        findings.append("release_ready must be true")
    if provider not in external_api_providers:
        findings.append("provider must be a supported external API provider")
    if evidence.get("operation") != "named_mutation":
        findings.append("operation must be named_mutation")

    redaction = evidence.get("redaction")
    if not isinstance(redaction, dict):
        findings.append("missing object redaction")
    else:
        if redaction.get("secrets_removed") is not True:
            findings.append("redaction.secrets_removed must be true")
        if redaction.get("raw_payloads_removed") is not True:
            findings.append("redaction.raw_payloads_removed must be true")
        if redaction.get("tenant_data_removed") is not True:
            findings.append("redaction.tenant_data_removed must be true")

    delegated = evidence.get("delegated_actor_context")
    if not isinstance(delegated, dict):
        findings.append("missing object delegated_actor_context")
    else:
        if delegated.get("principal_type") != "user":
            findings.append("delegated_actor_context.principal_type must be user")
        if not delegated.get("tenant"):
            findings.append("delegated_actor_context.tenant is required")
        if not delegated.get("on_behalf_of"):
            findings.append("delegated_actor_context.on_behalf_of is required")

    token_store = evidence.get("token_store_isolation")
    if not isinstance(token_store, dict):
        findings.append("missing object token_store_isolation")
    else:
        partition_key = token_store.get("partition_key")
        if not isinstance(partition_key, list) or not {"user", "tenant", "provider"}.issubset(set(partition_key)):
            findings.append("token_store_isolation.partition_key must include user, tenant, and provider")
        if token_store.get("revocation_checked") is not True:
            findings.append("token_store_isolation.revocation_checked must be true")

    mutation_registry = evidence.get("mutation_registry")
    if not isinstance(mutation_registry, dict):
        findings.append("missing object mutation_registry")
    else:
        registry_name = mutation_registry.get("name")
        registry_scope = mutation_registry.get("policy_scope")
        if not registry_name:
            findings.append("mutation_registry.name is required")
        if mutation_registry.get("mcp_enabled") is not False:
            findings.append("mutation_registry.mcp_enabled must be false until certified")
        if not registry_scope:
            findings.append("mutation_registry.policy_scope is required")
        known_mutations = known_named_mutations_by_provider.get(provider, {})
        if known_mutations and registry_name not in known_mutations:
            findings.append("mutation_registry.name is not in the provider allow-list")
        if registry_name in known_mutations and registry_scope != known_mutations[registry_name]:
            findings.append("mutation_registry.policy_scope does not match provider allow-list")

    request_binding = evidence.get("request_binding")
    if not isinstance(request_binding, dict):
        findings.append("missing object request_binding")
    else:
        if request_binding.get("provider_owned_request") is not True:
            findings.append("request_binding.provider_owned_request must be true")
        if request_binding.get("raw_url_or_query_from_caller") is not False:
            findings.append("request_binding.raw_url_or_query_from_caller must be false")

    idempotency = evidence.get("idempotency")
    if not isinstance(idempotency, dict):
        findings.append("missing object idempotency")
    else:
        if not idempotency.get("key_source"):
            findings.append("idempotency.key_source is required")
        if idempotency.get("replay_rejected") is not True:
            findings.append("idempotency.replay_rejected must be true")

    policy = evidence.get("policy")
    if not isinstance(policy, dict):
        findings.append("missing object policy")
    else:
        if policy.get("scope_enforced") is not True:
            findings.append("policy.scope_enforced must be true")
        if policy.get("decision") != "allow":
            findings.append("policy.decision must be allow")

    audit = evidence.get("audit")
    if not isinstance(audit, dict):
        findings.append("missing object audit")
    else:
        if audit.get("source") not in {"http", "mcp", "kafka"}:
            findings.append("audit.source must be http, mcp, or kafka")
        for field in ["correlation_id", "provider_request_id", "sink"]:
            if not audit.get(field):
                findings.append(f"audit.{field} is required")

    live_call = evidence.get("live_provider_call")
    if not isinstance(live_call, dict):
        findings.append("missing object live_provider_call")
    else:
        if live_call.get("executed") is not True:
            findings.append("live_provider_call.executed must be true")
        if live_call.get("non_production") is not True:
            findings.append("live_provider_call.non_production must be true")
        if isinstance(mutation_registry, dict) and mutation_registry.get("name") and live_call.get("mutation_name") != mutation_registry.get("name"):
            findings.append("live_provider_call.mutation_name must match mutation_registry.name")
        if live_call.get("result") != "success":
            findings.append("live_provider_call.result must be success")
        if live_call.get("replay_attempted") is not True:
            findings.append("live_provider_call.replay_attempted must be true")
    return findings

evidence_findings = evidence_schema_findings(evidence)
blocking_violations = []
if enforce:
    if not isinstance(graduation, dict):
        blocking_violations.append("provider-graduation evidence is required for enforced governed-write posture")
    elif graduation.get("ok") is not True:
        blocking_violations.append("provider-graduation evidence must be ok before governed-write posture can be enforced")
if evidence is not None and evidence_findings:
    blocking_violations.extend(evidence_findings)
if certified_providers and evidence is None:
    blocking_violations.append(
        "governed-write evidence is required before any external API provider can be governed_write_certified:true"
    )

report = {
    "command": "governed-write-check",
    "lane": "G1",
    "ok": not blocking_violations,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/governed-write-posture.json",
    "evidence_artifact": "target/appfw/governed-write-evidence.json",
    "gate": {
        "enforced": enforce,
        "ready_to_enforce": isinstance(graduation, dict) and graduation.get("ok") is True,
        "reason": "G1 posture is enforced only when provider-graduation evidence is present; live write certification still requires provider-test governed-write evidence.",
    },
    "provider_graduation": {
        "path": rel(graduation_path),
        "present": graduation_path.is_file(),
        "ok": isinstance(graduation, dict) and graduation.get("ok") is True,
    },
    "evidence": {
        "path": rel(evidence_path),
        "present": evidence_path.is_file(),
        "schema_ok": evidence is not None and not evidence_findings,
        "findings": evidence_findings,
    },
    "providers": provider_reports,
    "certified_providers": certified_providers,
    "blocking_violations": blocking_violations,
    "next_steps": [
        "Keep all external API writes disabled until provider-test/live evidence proves every G1 gate for a named mutation.",
        "Use target/appfw/governed-write-evidence.json only for real provider-test governed-write evidence, not posture reports.",
        "Keep MCP exposure disabled for named mutations until G1 and MCP release posture are both certified.",
    ],
}

report_dir.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"governed-write-check ok: {report['artifact']}")
else:
    print("governed-write-check failed", file=sys.stderr)
    for violation in blocking_violations:
        print(f"- {violation}", file=sys.stderr)
raise SystemExit(0 if report["ok"] else 1)
PY
}

provider_test_filter_from_args() {
  if [[ $# -gt 0 && "${1:-}" != --* ]]; then
    printf '%s' "$1"
  fi
}

provider_test_report_item() {
  local first="$1"
  local provider="$2"
  local ok="$3"
  local data_source="$4"
  local base_url="$5"
  local log_file="$6"
  local areas_json="$7"
  local mode="$8"
  local test_filter="$9"

  if [[ "$first" != "1" ]]; then
    printf ','
  fi
  printf '{"provider":'
  json_escape "$provider"
  printf ',"ok":%s,"data_source":' "$ok"
  json_escape "$data_source"
  printf ',"base_url":'
  json_escape "$base_url"
  printf ',"log":'
  json_escape "$log_file"
  printf ',"mode":'
  json_escape "$mode"
  if [[ -n "$test_filter" ]]; then
    printf ',"test_filter":'
    json_escape "$test_filter"
  fi
  printf ',"areas":'
  printf '%s' "$areas_json"
  printf '}'
}

finalize_provider_test_json_report() {
  local report_tmp="$1"
  local report_file="$2"
  local failed="$3"

  printf ']}\n' >>"$report_tmp"
  if [[ "$failed" == "1" ]]; then
    local failed_report
    failed_report="$(mktemp "${TMPDIR:-/tmp}/appfw-provider-test.XXXXXX")"
    json_set_top_level_bool "$report_tmp" "$failed_report" ok false
    mv "$failed_report" "$report_tmp"
  fi
  mv "$report_tmp" "$report_file"
}

abort_provider_test_json_report() {
  local status=$?

  if [[ "${APPFW_PROVIDER_TEST_JSON_OPEN:-0}" == "1" \
    && -n "${APPFW_PROVIDER_TEST_JSON_TMP:-}" \
    && -n "${APPFW_PROVIDER_TEST_JSON_FILE:-}" \
    && -f "${APPFW_PROVIDER_TEST_JSON_TMP:-}" ]]; then
    finalize_provider_test_json_report \
      "$APPFW_PROVIDER_TEST_JSON_TMP" \
      "$APPFW_PROVIDER_TEST_JSON_FILE" \
      1 || true
  fi

  exit "$status"
}

mirror_provider_test_artifacts() {
  local source_dir="$1"
  local dest_dir="$2"
  shift 2

  if [[ "$source_dir" == "$dest_dir" ]]; then
    return 0
  fi

  mkdir -p "$dest_dir"
  if [[ -f "$source_dir/provider-parity.json" ]]; then
    cp "$source_dir/provider-parity.json" "$dest_dir/provider-parity.json"
  fi

  local provider
  for provider in "$@"; do
    if [[ -f "$source_dir/provider-test-${provider}.log" ]]; then
      cp "$source_dir/provider-test-${provider}.log" "$dest_dir/provider-test-${provider}.log"
    fi
  done
}

provider_test_governed_write_area() {
  local json="$1"
  local provider="$2"
  local plan="$3"

  case "$provider" in
    servicenow|workday|icims|salesforce|anaplan|oracle_financials)
      ;;
    "")
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "missing external API provider; pass --provider servicenow|workday|icims|salesforce|anaplan|oracle_financials with --area governed-write"
      else
        echo "Missing external API provider for --area governed-write." >&2
      fi
      return 2
      ;;
    *)
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "governed-write provider-test area is only for external API providers"
      else
        echo "governed-write provider-test area is only for external API providers." >&2
      fi
      return 2
      ;;
  esac

  python3 - "$repo_root" "$json" "$provider" "$plan" <<'PY'
import datetime
import json
import os
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
json_mode = sys.argv[2] == "1"
provider = sys.argv[3]
plan_only = sys.argv[4] == "1"
report_dir = Path(os.environ.get("APPFW_PROVIDER_TEST_REPORT_DIR", repo_root / "target/appfw")).resolve()
preflight_path = report_dir / "governed-write-provider-test.json"

def rel(path):
    try:
        return str(Path(path).resolve().relative_to(repo_root))
    except ValueError:
        return str(Path(path).resolve())

env_prefix = f"APPFW_{provider.upper()}_GOVERNED_WRITE"
evidence_file_env = f"{env_prefix}_EVIDENCE_FILE"
required_env = [
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_BASE_URL",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_AUTH_MODE",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_TOKEN_REF",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_TEST_TENANT",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_TEST_USER",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_MUTATION_NAME",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_POLICY_SCOPE",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_TEST_IDEMPOTENCY_KEY",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_AUDIT_SINK",
    f"APPFW_{provider.upper()}_GOVERNED_WRITE_TEST_INGRESS",
    evidence_file_env,
]
required_checks = [
    "delegated_actor_context",
    "token_store_isolation",
    "named_mutation_registry",
    "named_mutation_registry_allowlist",
    "mutation_request_binding",
    "idempotency_and_replay_protection",
    "write_policy_and_scope_enforcement",
    "write_audit_and_evidence",
]
known_named_mutations_by_provider = {
    "servicenow": [
        {
            "name": "servicenow.create_incident",
            "policy_scope": "servicenow.incident.write",
            "mcp_enabled": False,
            "status": "planned_non_executable",
            "source": "appfw-provider-servicenow registry",
        }
    ],
    "workday": [],
    "icims": [],
    "salesforce": [],
    "anaplan": [],
    "oracle_financials": [],
}
known_named_mutations = known_named_mutations_by_provider.get(provider, [])
known_mutation_names = [item["name"] for item in known_named_mutations]
known_mutation_by_name = {item["name"]: item for item in known_named_mutations}
missing_env = [name for name in required_env if not os.environ.get(name)]
connection_env = required_env[:5]
operation_env = required_env[5:10]
evidence_env = required_env[10:]
test_ingress = os.environ.get(f"{env_prefix}_TEST_INGRESS", "http")
invalid_env = []
if os.environ.get(f"{env_prefix}_TEST_INGRESS") and test_ingress not in {"http", "mcp", "kafka"}:
    invalid_env.append({
        "name": f"{env_prefix}_TEST_INGRESS",
        "value": test_ingress,
        "allowed_values": ["http", "mcp", "kafka"],
    })
mutation_name = os.environ.get(f"{env_prefix}_MUTATION_NAME")
policy_scope = os.environ.get(f"{env_prefix}_POLICY_SCOPE")
if mutation_name and known_mutation_names and mutation_name not in known_mutation_by_name:
    invalid_env.append({
        "name": f"{env_prefix}_MUTATION_NAME",
        "value": mutation_name,
        "allowed_values": known_mutation_names,
    })
elif mutation_name and policy_scope and mutation_name in known_mutation_by_name:
    expected_scope = known_mutation_by_name[mutation_name]["policy_scope"]
    if policy_scope != expected_scope:
        invalid_env.append({
            "name": f"{env_prefix}_POLICY_SCOPE",
            "value": policy_scope,
            "allowed_values": [expected_scope],
        })

evidence_template = {
    "command": "provider-test",
    "lane": "G1",
    "ok": True,
    "release_ready": True,
    "provider": provider,
    "operation": "named_mutation",
    "evidence_source": {
        "mode": "external_live_runner",
        "evidence_file": f"${evidence_file_env}",
    },
    "redaction": {
        "secrets_removed": True,
        "raw_payloads_removed": True,
        "tenant_data_removed": True,
    },
    "delegated_actor_context": {
        "principal_type": "user",
        "tenant": f"${env_prefix}_TEST_TENANT",
        "on_behalf_of": f"${env_prefix}_TEST_USER",
    },
    "token_store_isolation": {
        "partition_key": ["user", "tenant", "provider"],
        "revocation_checked": True,
    },
    "mutation_registry": {
        "name": f"${env_prefix}_MUTATION_NAME",
        "mcp_enabled": False,
        "policy_scope": f"${env_prefix}_POLICY_SCOPE",
    },
    "request_binding": {
        "provider_owned_request": True,
        "raw_url_or_query_from_caller": False,
    },
    "idempotency": {
        "key_source": f"${env_prefix}_TEST_IDEMPOTENCY_KEY",
        "replay_rejected": True,
    },
    "policy": {
        "scope_enforced": True,
        "decision": "allow",
    },
    "audit": {
        "source": f"${env_prefix}_TEST_INGRESS",
        "correlation_id": "generated-by-provider-test",
        "provider_request_id": "redacted-or-hash",
        "sink": f"${env_prefix}_AUDIT_SINK",
    },
    "live_provider_call": {
        "executed": True,
        "non_production": True,
        "mutation_name": f"${env_prefix}_MUTATION_NAME",
        "result": "success",
        "replay_attempted": True,
    },
}

def evidence_findings(value):
    findings = []
    if not isinstance(value, dict):
        return ["governed-write evidence must be a JSON object"]
    sensitive_key_fragments = [
        "access_token",
        "refresh_token",
        "authorization",
        "bearer_token",
        "client_secret",
        "password",
        "raw_request",
        "raw_response",
        "request_payload",
        "response_payload",
        "tenant_data",
        "phi",
    ]
    allowed_redaction_keys = {"secrets_removed", "raw_payloads_removed", "tenant_data_removed"}
    def redaction_findings(candidate, path="$"):
        redaction_errors = []
        if isinstance(candidate, dict):
            for key, child in candidate.items():
                key_lower = str(key).lower()
                if key_lower not in allowed_redaction_keys and any(fragment in key_lower for fragment in sensitive_key_fragments):
                    redaction_errors.append(f"{path}.{key} must not retain secrets, raw payloads, tenant data, or PHI")
                redaction_errors.extend(redaction_findings(child, f"{path}.{key}"))
        elif isinstance(candidate, list):
            for index, child in enumerate(candidate):
                redaction_errors.extend(redaction_findings(child, f"{path}[{index}]"))
        elif isinstance(candidate, str):
            normalized = candidate.strip().lower()
            if normalized.startswith("bearer ") or normalized.startswith("basic "):
                redaction_errors.append(f"{path} must not retain authorization header values")
        return redaction_errors
    findings.extend(redaction_findings(value))
    for field in ["command", "lane", "ok", "release_ready", "provider", "operation"]:
        if field not in value:
            findings.append(f"missing {field}")
    if value.get("command") != "provider-test":
        findings.append("command must be provider-test")
    if value.get("lane") != "G1":
        findings.append("lane must be G1")
    if value.get("ok") is not True:
        findings.append("ok must be true")
    if value.get("release_ready") is not True:
        findings.append("release_ready must be true")
    if value.get("provider") != provider:
        findings.append(f"provider must be {provider}")
    if value.get("operation") != "named_mutation":
        findings.append("operation must be named_mutation")

    redaction = value.get("redaction")
    if not isinstance(redaction, dict):
        findings.append("missing object redaction")
    else:
        if redaction.get("secrets_removed") is not True:
            findings.append("redaction.secrets_removed must be true")
        if redaction.get("raw_payloads_removed") is not True:
            findings.append("redaction.raw_payloads_removed must be true")
        if redaction.get("tenant_data_removed") is not True:
            findings.append("redaction.tenant_data_removed must be true")

    delegated = value.get("delegated_actor_context")
    if not isinstance(delegated, dict):
        findings.append("missing object delegated_actor_context")
    else:
        if delegated.get("principal_type") != "user":
            findings.append("delegated_actor_context.principal_type must be user")
        if not delegated.get("tenant"):
            findings.append("delegated_actor_context.tenant is required")
        if not delegated.get("on_behalf_of"):
            findings.append("delegated_actor_context.on_behalf_of is required")
        if os.environ.get(f"{env_prefix}_TEST_TENANT") and delegated.get("tenant") != os.environ[f"{env_prefix}_TEST_TENANT"]:
            findings.append("delegated_actor_context.tenant must match configured test tenant")
        if os.environ.get(f"{env_prefix}_TEST_USER") and delegated.get("on_behalf_of") != os.environ[f"{env_prefix}_TEST_USER"]:
            findings.append("delegated_actor_context.on_behalf_of must match configured test user")

    token_store = value.get("token_store_isolation")
    if not isinstance(token_store, dict):
        findings.append("missing object token_store_isolation")
    else:
        partition_key = token_store.get("partition_key")
        if not isinstance(partition_key, list) or not {"user", "tenant", "provider"}.issubset(set(partition_key)):
            findings.append("token_store_isolation.partition_key must include user, tenant, and provider")
        if token_store.get("revocation_checked") is not True:
            findings.append("token_store_isolation.revocation_checked must be true")

    registry = value.get("mutation_registry")
    if not isinstance(registry, dict):
        findings.append("missing object mutation_registry")
    else:
        registry_name = registry.get("name")
        registry_scope = registry.get("policy_scope")
        if not registry_name:
            findings.append("mutation_registry.name is required")
        if registry.get("mcp_enabled") is not False:
            findings.append("mutation_registry.mcp_enabled must be false until certified")
        if not registry_scope:
            findings.append("mutation_registry.policy_scope is required")
        if mutation_name and registry_name != mutation_name:
            findings.append("mutation_registry.name must match configured mutation name")
        if policy_scope and registry_scope != policy_scope:
            findings.append("mutation_registry.policy_scope must match configured policy scope")
        if known_mutation_names and registry_name not in known_mutation_by_name:
            findings.append("mutation_registry.name is not in the provider allow-list")
        if registry_name in known_mutation_by_name and registry_scope != known_mutation_by_name[registry_name]["policy_scope"]:
            findings.append("mutation_registry.policy_scope does not match provider allow-list")

    request_binding = value.get("request_binding")
    if not isinstance(request_binding, dict):
        findings.append("missing object request_binding")
    else:
        if request_binding.get("provider_owned_request") is not True:
            findings.append("request_binding.provider_owned_request must be true")
        if request_binding.get("raw_url_or_query_from_caller") is not False:
            findings.append("request_binding.raw_url_or_query_from_caller must be false")

    idempotency = value.get("idempotency")
    if not isinstance(idempotency, dict):
        findings.append("missing object idempotency")
    else:
        if not idempotency.get("key_source"):
            findings.append("idempotency.key_source is required")
        if idempotency.get("replay_rejected") is not True:
            findings.append("idempotency.replay_rejected must be true")

    policy = value.get("policy")
    if not isinstance(policy, dict):
        findings.append("missing object policy")
    else:
        if policy.get("scope_enforced") is not True:
            findings.append("policy.scope_enforced must be true")
        if policy.get("decision") != "allow":
            findings.append("policy.decision must be allow")

    audit = value.get("audit")
    if not isinstance(audit, dict):
        findings.append("missing object audit")
    else:
        if audit.get("source") not in {"http", "mcp", "kafka"}:
            findings.append("audit.source must be http, mcp, or kafka")
        if os.environ.get(f"{env_prefix}_TEST_INGRESS") and audit.get("source") != os.environ[f"{env_prefix}_TEST_INGRESS"]:
            findings.append("audit.source must match configured ingress")
        for field in ["correlation_id", "provider_request_id", "sink"]:
            if not audit.get(field):
                findings.append(f"audit.{field} is required")

    live_call = value.get("live_provider_call")
    if not isinstance(live_call, dict):
        findings.append("missing object live_provider_call")
    else:
        if live_call.get("executed") is not True:
            findings.append("live_provider_call.executed must be true")
        if live_call.get("non_production") is not True:
            findings.append("live_provider_call.non_production must be true")
        if mutation_name and live_call.get("mutation_name") != mutation_name:
            findings.append("live_provider_call.mutation_name must match configured mutation name")
        if live_call.get("result") != "success":
            findings.append("live_provider_call.result must be success")
        if live_call.get("replay_attempted") is not True:
            findings.append("live_provider_call.replay_attempted must be true")
    return findings

report = {
    "command": "provider-test",
    "lane": "G1",
    "area": "governed_write",
    "provider": provider,
    "provider_family": "external_api",
    "mode": "plan" if plan_only else "live-preflight",
    "plan_only": plan_only,
    "ok": True if plan_only else False,
    "release_ready": False,
    "generated_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/governed-write-provider-test.json",
    "evidence_artifact": "target/appfw/governed-write-evidence.json",
    "required_env": required_env,
    "required_live_inputs": {
        "connection": connection_env,
        "operation_contract": operation_env,
        "evidence_retention": evidence_env,
    },
    "known_named_mutations": known_named_mutations,
    "missing_env": [] if plan_only else missing_env,
    "invalid_env": [] if plan_only else invalid_env,
    "required_checks": required_checks,
    "evidence_template": evidence_template,
    "evidence_policy": (
        "Plan mode does not create governed-write-evidence.json. Live mode validates an external "
        "provider-backed evidence file and retains governed-write-evidence.json only when the file "
        "proves the required checks against a named external API mutation."
    ),
    "next_step": (
        f"Configure a live {provider} sandbox, run the provider-backed named mutation fixture, "
        f"set {evidence_file_env}, and rerun provider-test to retain target/appfw/governed-write-evidence.json."
    ),
}
if not plan_only:
    evidence_path = report_dir / "governed-write-evidence.json"
    evidence_file = os.environ.get(evidence_file_env)
    evidence = None
    evidence_errors = []
    if evidence_file:
        try:
            candidate = Path(evidence_file).expanduser().resolve()
            report["evidence_file"] = str(candidate)
            if candidate == evidence_path:
                evidence_errors.append(
                    f"{evidence_file_env} must point to an external live runner artifact, not reserved target/appfw/governed-write-evidence.json"
                )
            elif candidate == preflight_path:
                evidence_errors.append(
                    f"{evidence_file_env} must point to an external live runner artifact, not target/appfw/governed-write-provider-test.json"
                )
            else:
                evidence = json.loads(candidate.read_text(encoding="utf-8"))
        except Exception as exc:
            evidence_errors.append(f"failed to read {evidence_file_env}: {exc}")
    else:
        if evidence_file_env not in missing_env:
            evidence_errors.append(f"missing environment variable {evidence_file_env}")
    if evidence is not None:
        evidence_errors.extend(evidence_findings(evidence))

    report["blocking_violations"] = [
        *[f"missing environment variable {name}" for name in missing_env],
        *[
            "invalid environment variable "
            f"{item['name']}={item['value']!r}; expected one of {', '.join(item['allowed_values'])}"
            for item in invalid_env
        ],
        *evidence_errors,
    ]
    if not report["blocking_violations"] and evidence is not None:
        report["ok"] = True
        report["release_ready"] = True
        report["mode"] = "live-evidence-validation"
        report["retained_evidence"] = rel(evidence_path)
        evidence_path.parent.mkdir(parents=True, exist_ok=True)
        evidence_path.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    report_dir.mkdir(parents=True, exist_ok=True)
    preflight_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
else:
    if plan_only:
        print(f"provider-test governed-write plan for {provider}")
    elif report["ok"]:
        print(f"provider-test governed-write evidence retained for {provider}: {evidence_path}")
    else:
        print(f"provider-test governed-write preflight failed for {provider}; see {preflight_path}", file=sys.stderr)
raise SystemExit(0 if report["ok"] else 1)
PY
}

