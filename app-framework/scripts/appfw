report_dir.mkdir(parents=True, exist_ok=True)
artifact_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if not json_mode:
    print(f"{kind} report written: {rel(artifact_path)}")
    print(f"Scope: {scope}")
    print(f"Review depth: {review_depth}")
    print(f"Slash command: {report['slash_command']}")
PY
  delivery_mode_annotate_artifact "$report_dir/$artifact_name" "$json"
}

sra_package() {
  local json_mode="$1"
  local scope="$2"
  shift 2 || true

  local all_products="0"
  local project_name=""
  local business_purpose=""
  local owner=""
  local technical_owner=""
  local sra_record_url=""
  local evidence_url=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json_mode="1"
        shift
        ;;
      --all-products)
        all_products="1"
        shift
        ;;
      --project-name)
        project_name="${2:-}"
        shift 2
        ;;
      --business-purpose)
        business_purpose="${2:-}"
        shift 2
        ;;
      --owner)
        owner="${2:-}"
        shift 2
        ;;
      --technical-owner)
        technical_owner="${2:-}"
        shift 2
        ;;
      --sra-record-url)
        sra_record_url="${2:-}"
        shift 2
        ;;
      --evidence-url)
        evidence_url="${2:-}"
        shift 2
        ;;
      --help|-h)
        cat <<'EOF'
Usage: scripts/appfw <framework|product> sra-package [--json] [--all-products]
       [--project-name <name>] [--business-purpose <text>]
       [--owner <name>] [--technical-owner <name>]
       [--sra-record-url <url>] [--evidence-url <url>]

Writes a report-only PDS Health SRA package scaffold:
  framework: target/appfw/sra-package.json
  product:   .appfw/target/appfw/sra-package.json

Use --all-products from framework scope to inventory each product app in this
checkout. The report is preparation evidence only; it is not SRA approval.
EOF
        return 0
        ;;
      *)
        echo "sra-package: unknown option: $1" >&2
        return 2
        ;;
    esac
  done

  if [[ "$scope" != "framework" && "$scope" != "product" ]]; then
    echo "sra-package: scope must be framework or product" >&2
    return 2
  fi

  local sra_report_dir="$repo_root/target/appfw"
  if [[ "$scope" == "product" ]]; then
    sra_report_dir="$report_root"
  fi

  python3 - "$repo_root" "$framework_root" "$app_root" "$sra_report_dir" \
    "$scope" "$json_mode" "$all_products" "$project_name" "$business_purpose" \
    "$owner" "$technical_owner" "$sra_record_url" "$evidence_url" <<'PY'
import datetime
import json
import re
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
framework_root = Path(sys.argv[2]).resolve()
app_root = Path(sys.argv[3]).resolve()
report_dir = Path(sys.argv[4]).resolve()
scope = sys.argv[5]
json_mode = sys.argv[6] == "1"
all_products = sys.argv[7] == "1"
metadata = {
    "project_name": sys.argv[8].strip(),
    "business_purpose": sys.argv[9].strip(),
    "owner": sys.argv[10].strip(),
    "technical_owner": sys.argv[11].strip(),
    "sra_record_url": sys.argv[12].strip(),
    "evidence_url": sys.argv[13].strip(),
}


def read_text(path):
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def rel(path):
    if path is None:
        return None
    candidate = Path(path)
    try:
        return candidate.resolve().relative_to(repo_root).as_posix()
    except Exception:
        return candidate.as_posix()


def artifact(path, label=None, required=False):
    candidate = Path(path)
    return {
        "label": label or candidate.name,
        "path": rel(candidate),
        "present": candidate.is_file(),
        "required_for_sra_submission": required,
    }


def strip_value(value):
    value = value.strip()
    if "#" in value:
        value = value.split("#", 1)[0].strip()
    if (value.startswith("'") and value.endswith("'")) or (
        value.startswith('"') and value.endswith('"')
    ):
        value = value[1:-1]
    return value


def section_scalar(text, section, key):
    in_section = False
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line.startswith(" ") and line.rstrip(":").strip() == section:
            in_section = True
            continue
        if in_section and not line.startswith(" "):
            break
        if in_section:
            stripped = line.strip()
            prefix = f"{key}:"
            if stripped.startswith(prefix):
                return strip_value(stripped[len(prefix):])
    return ""


def parse_topology_list(text, section_name):
    items = []
    active_section = None
    current = None
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if line.startswith("  ") and not line.startswith("    ") and stripped.endswith(":"):
            active_section = stripped[:-1]
            current = None
            continue
        if not line.startswith(" "):
            active_section = None
            current = None
            continue
        if active_section != section_name:
            continue
        if stripped.startswith("- name:"):
            current = {"name": strip_value(stripped.split(":", 1)[1])}
            items.append(current)
            continue
        if current is not None and ":" in stripped:
            key, value = stripped.split(":", 1)
            current[key.strip()] = strip_value(value)
    return items


def model_classification_signals(product_root):
    signals = []
    model_root = product_root / ".appfw/model"
    candidates = []
    if model_root.is_dir():
        candidates.extend(sorted(model_root.rglob("*.yaml")))
        candidates.extend(sorted(model_root.rglob("*.yml")))
        candidates.extend(sorted(model_root.rglob("*.rego")))
    for extra in [
        product_root / ".appfw/model-proposal.yaml",
        product_root / ".appfw/poc-analysis.yaml",
        product_root / ".appfw/poc-intake.yaml",
    ]:
        if extra.is_file():
            candidates.append(extra)
    for path in candidates:
        text = read_text(path)
        for idx, line in enumerate(text.splitlines(), start=1):
            lowered = line.lower()
            if any(token in lowered for token in ["classification", "phi", "pii", "sensitive"]):
                signals.append(
                    {
                        "path": rel(path),
                        "line": idx,
                        "signal": line.strip()[:180],
                    }
                )
                if len(signals) >= 20:
                    return signals
    return signals


def product_summary(product_root):
    manifest = product_root / ".appfw/manifest.yaml"
    text = read_text(manifest)
    name = section_scalar(text, "app", "name") or product_root.name
    display_name = section_scalar(text, "app", "display_name") or name
    return {
        "name": name,
        "display_name": display_name,
        "root": rel(product_root),
        "manifest": rel(manifest),
        "manifest_present": manifest.is_file(),
        "description": section_scalar(text, "app", "description"),
        "data_sources": parse_topology_list(text, "data_sources"),
        "schemas": parse_topology_list(text, "schemas"),
        "ingress": parse_topology_list(text, "ingress"),
        "classification_signals": model_classification_signals(product_root),
        "sra_command": (
            f"APPFW_APP_ROOT={rel(product_root)} scripts/appfw product sra-package --json"
        ),
    }


def product_roots():
    roots = []
    products_dir = repo_root / "examples/products"
    if products_dir.is_dir():
        for manifest in sorted(products_dir.glob("*/.appfw/manifest.yaml")):
            roots.append(manifest.parent.parent)
    if app_root not in roots and (app_root / ".appfw/manifest.yaml").is_file():
        roots.append(app_root)
    return roots


