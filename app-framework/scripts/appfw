handoff() {
  local json="$1"
  shift || true

  local args=()
  local app_root="$app_root"
  local config_root="$config_root"
  local report_root="$report_root"
  if [[ "$json" == "1" ]]; then
    args+=("--json")
  fi
  args+=("handoff" "$@")
  if [[ "${command_namespace:-}" == "framework" ]]; then
    local app_root="$framework_root"
    local config_root="$framework_root/app_gen/_config"
    local report_root="$framework_root/target/appfw"
  fi
  local status=0
  if [[ "$json" == "1" ]]; then
    local handoff_output
    handoff_output="$(mktemp "${TMPDIR:-/tmp}/appfw-handoff.XXXXXX")"
    run_appfw_introspect "${args[@]}" >"$handoff_output" || status=$?
    if [[ $status -ne 0 ]]; then
      cat "$handoff_output"
      rm -f "$handoff_output"
      return $status
    fi
    local artifact_path
    artifact_path="$(python3 - "$handoff_output" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    print(json.load(stream)["artifact_path"])
PY
)"
    rm -f "$handoff_output"
    delivery_mode_annotate_artifact "$artifact_path" "$json"
    return $?
  else
    run_appfw_introspect "${args[@]}" || status=$?
  fi
  if [[ $status -eq 0 ]]; then
    delivery_mode_annotate_artifact "$report_root/agent-handoff.json" "$json"
  fi
  return $status
}

delivery_mode_annotate_artifact() {
  local artifact_path="$1"
  local emit_json="${2:-0}"
  python3 - "$script_dir/appfw-delivery-mode.py" "$repo_root" "$artifact_path" "$emit_json" <<'PY'
import json
import os
import subprocess
import sys
from pathlib import Path

controller, repo_root, artifact_path, emit_json = sys.argv[1:]
result = subprocess.run(
    [sys.executable, controller, "--repo-root", repo_root, "annotation"],
    text=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    check=False,
)
if result.returncode:
    print(result.stderr.strip() or "delivery mode annotation failed", file=sys.stderr)
    raise SystemExit(result.returncode)
path = Path(artifact_path)
if not path.exists():
    raise SystemExit(0)
report = json.loads(path.read_text(encoding="utf-8"))
delivery_profile = json.loads(result.stdout)
report["delivery_profile"] = delivery_profile
projection = delivery_profile.get("gate_execution_projection", {})
if projection.get("ok") is False:
    report["ok"] = False
serialized = json.dumps(report, indent=2, sort_keys=True) + "\n"
temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
try:
    temporary.write_text(serialized, encoding="utf-8")
    os.replace(temporary, path)
finally:
    if temporary.exists():
        temporary.unlink()
if emit_json == "1":
    sys.stdout.write(serialized)
PY
}

delivery_mode_record_gate() {
  local gate_id="$1"
  local command="$2"
  local exit_status="$3"
  local expected_source_sha="$4"
  python3 "$script_dir/appfw-delivery-mode.py" \
    --repo-root "$repo_root" \
    record-gate \
    --gate-id "$gate_id" \
    --command "$command" \
    --exit-status "$exit_status" \
    --expected-source-sha "$expected_source_sha"
}

delivery_mode_clean_source_sha() {
  python3 "$script_dir/appfw-delivery-mode.py" \
    --repo-root "$repo_root" \
    source-sha
}

delivery_mode_execution_context() {
  python3 "$script_dir/appfw-delivery-mode.py" \
    --repo-root "$repo_root" \
    annotation |
    python3 -c '
import json
import sys

annotation = json.load(sys.stdin)
print("{}\t{}".format(annotation["profile"], annotation["source_status"]))
'
}

run_framework_gate() {
  local gate_id="$1"
  local command="$2"
  local retain_evidence="$3"
  shift 3
  local delivery_context
  local profile
  local source_status
  local status=0
  local source_sha=""

  delivery_context="$(delivery_mode_execution_context)"
  IFS=$'\t' read -r profile source_status <<<"$delivery_context"
  # Candidate runs need a clean source before any downstream stage executes.
  # Accelerated dirty runs remain ephemeral feedback and never retain evidence.
  if [[ "$profile" == "candidate" ]]; then
    source_sha="$(delivery_mode_clean_source_sha)"
  elif [[ "$profile" == "accelerated" && "$source_status" == dirty* ]]; then
    retain_evidence=0
  elif [[ "$retain_evidence" == "1" ]]; then
    source_sha="$(delivery_mode_clean_source_sha)"
  fi

  set +e
  (
    set -e
    "$@"
  )
  status=$?
  set -e
  if [[ "$retain_evidence" == "1" ]]; then
    delivery_mode_record_gate "$gate_id" "$command" "$status" "$source_sha"
  fi
  return "$status"
}

mode_command() {
  local json="$1"
  local check="$2"
  shift 2 || true
  if [[ -n "${command_namespace:-}" ]]; then
    if [[ "$json" == "1" ]]; then
      json_result "mode" false "mode is root-only; use scripts/appfw mode"
    else
      echo "mode is root-only; use scripts/appfw mode" >&2
    fi
    return 2
  fi
  if [[ "$check" == "1" ]]; then
    if [[ "$json" == "1" ]]; then
      json_result "mode" false "mode does not support --check"
    else
      echo "mode does not support --check" >&2
    fi
    return 2
  fi
  if [[ ${#@} -eq 0 ]]; then
    if [[ "$json" == "1" ]]; then
      json_result "mode" false "mode requires status or set <accelerated|candidate>"
    else
      echo "mode requires status or set <accelerated|candidate>" >&2
    fi
    return 2
  fi
  local args=(--repo-root "$repo_root")
  if [[ "$json" == "1" ]]; then
    args+=(--json)
  fi
  args+=("$@")
  python3 "$script_dir/appfw-delivery-mode.py" "${args[@]}"
}

review_command() {
  local json="$1"
  local kind="$2"
  shift 2 || true

  local scope="${command_namespace:-}"
  if [[ -z "$scope" ]]; then
    scope="$(detected_context_mode)"
  fi
  if [[ "$scope" != "framework" && "$scope" != "product" ]]; then
    scope="product"
  fi

  local scope_root report_dir
  if [[ "$scope" == "framework" ]]; then
    scope_root="$framework_root"
    report_dir="$framework_root/target/appfw"
  else
    scope_root="$app_root"
    report_dir="$app_root/target/appfw"
  fi
  local artifact_name="review-performance.json"
  if [[ "$kind" == "review-brief" ]]; then
    artifact_name="review-brief.json"
  fi

  python3 - "$repo_root" "$framework_root" "$app_root" "$scope_root" "$report_dir" "$scope" "$kind" "$json" "$@" <<'PY'
import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
framework_root = Path(sys.argv[2]).resolve()
app_root = Path(sys.argv[3]).resolve()
scope_root = Path(sys.argv[4]).resolve()
report_dir = Path(sys.argv[5]).resolve()
scope = sys.argv[6]
kind = sys.argv[7]
json_mode = sys.argv[8] == "1"
argv = sys.argv[9:]


def usage(message):
    payload = {"command": kind, "ok": False, "detail": message}
    if json_mode:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(message, file=sys.stderr)
    raise SystemExit(2)


options = {
    "base": "origin/main",
    "head": "HEAD",
    "pr_url": "",
    "review_output": "",
    "reviewer": "",
    "approver": "",
    "evidence_url": "",
    "review_depth": "focused",
}
idx = 0
while idx < len(argv):
    arg = argv[idx]
    if arg == "--comprehensive":
        options["review_depth"] = "comprehensive"
        idx += 1
        continue
    if arg == "--focused":
        options["review_depth"] = "focused"
        idx += 1
        continue
    if arg == "--auto-depth":
        options["review_depth"] = "auto"
        idx += 1
        continue
    if arg in {"--base", "--head", "--pr", "--review-output", "--reviewer", "--approver", "--evidence-url", "--review-depth"}:
        if idx + 1 >= len(argv):
            usage(f"{arg} requires a value")
        key = {
            "--base": "base",
            "--head": "head",
            "--pr": "pr_url",
            "--review-output": "review_output",
            "--reviewer": "reviewer",
            "--approver": "approver",
            "--evidence-url": "evidence_url",
            "--review-depth": "review_depth",
        }[arg]
        options[key] = argv[idx + 1]
        idx += 2
        continue
    if arg.startswith("--base="):
        options["base"] = arg.split("=", 1)[1]
    elif arg.startswith("--head="):
        options["head"] = arg.split("=", 1)[1]
    elif arg.startswith("--pr="):
        options["pr_url"] = arg.split("=", 1)[1]
    elif arg.startswith("--review-output="):
        options["review_output"] = arg.split("=", 1)[1]
    elif arg.startswith("--reviewer="):
        options["reviewer"] = arg.split("=", 1)[1]
    elif arg.startswith("--approver="):
        options["approver"] = arg.split("=", 1)[1]
    elif arg.startswith("--evidence-url="):
        options["evidence_url"] = arg.split("=", 1)[1]
    elif arg.startswith("--review-depth="):
        options["review_depth"] = arg.split("=", 1)[1]
    else:
        usage(f"unknown {kind} option: {arg}")
    idx += 1

if options["review_depth"] not in {"focused", "comprehensive", "auto"}:
    usage("--review-depth must be focused, comprehensive, or auto")


def rel(path):
    path = Path(path).resolve()
    for base in (scope_root, repo_root, framework_root, app_root):
        try:
            return path.relative_to(base).as_posix()
        except ValueError:
            pass
    return str(path)


def git(args):
    try:
        # Use rstrip("\n") rather than strip(): porcelain status lines can start
        # with a leading space (e.g. " M path"). strip() would corrupt the first
        # line and drop it from handoff surface matching.
        return subprocess.check_output(
            ["git", *args], cwd=scope_root, text=True, stderr=subprocess.DEVNULL
        ).rstrip("\n")
    except Exception:
        return ""


def load_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def read_text(path):
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return ""


def scan_required_sections(text, sections):
    heading_matches = []
    for section in sections:
        pattern = re.compile(
            r"(?im)^[ \t]*(?:#{1,6}[ \t]*)?(?:\d+\.[ \t]*)?(?:\*\*)?"
            + re.escape(section)
            + r"(?:\*\*)?[ \t]*(?:(?:[:.][ \t]*(?:\*\*)?[ \t]*(.*))|$)"
        )
        match = pattern.search(text)
        if match:
            heading_matches.append(
                {
                    "section": section,
                    "start": match.start(),
                    "end": match.end(),
                    "inline_body": (match.group(1) or "").strip(),
                }
            )
    heading_matches.sort(key=lambda item: item["start"])
    content_by_section = {}
    body_by_section = {}
    for idx, item in enumerate(heading_matches):
        next_start = (
            heading_matches[idx + 1]["start"]
            if idx + 1 < len(heading_matches)
            else len(text)
        )
        raw_body = f"{item['inline_body']}\n{text[item['end']:next_start]}"
        body_by_section[item["section"]] = raw_body.strip()
        significant_body = re.sub(r"[\s#*_`>|:.\-]+", "", raw_body)
        content_by_section[item["section"]] = len(significant_body) >= 8
    section_scan = {section: section in content_by_section for section in sections}
    body_scan = {
        section: content_by_section.get(section, False) for section in sections
    }
    missing_sections = [section for section in sections if not section_scan[section]]
    empty_sections = [
        section
        for section in sections
        if section_scan[section] and not body_scan[section]
    ]
    return section_scan, body_scan, missing_sections, empty_sections, body_by_section


def recommendation_summary_scan(body, status_values, severity_buckets):
    status_pattern = "|".join(
        re.escape(status) for status in sorted(status_values, key=len, reverse=True)
    )
    status_match = re.search(
        rf"(?im)^\s*(?:final\s+status|status)\s*:\s*({status_pattern})\b",
        body,
    )
    severity_counts = {}
    severity_count_scan = {}
    for bucket in severity_buckets:
        count_match = re.search(
            rf"(?i)\b{re.escape(bucket)}\s*(?:=|:)\s*(\d+)\b", body
        )
        severity_count_scan[bucket] = bool(count_match)
        severity_counts[bucket] = int(count_match.group(1)) if count_match else None
    missing_buckets = [
        bucket for bucket in severity_buckets if not severity_count_scan[bucket]
    ]
    status = status_match.group(1) if status_match else None
    conditions_match = re.search(
        r"(?im)^\s*conditions?\s+captured\s*(?:=|:)\s*([A-Za-z0-9_ -]+)\b",
        body,
    )
    conditions_value = conditions_match.group(1).strip().lower() if conditions_match else None
    conditions_captured = conditions_value in {"yes", "true", "captured"}
    conditions_not_applicable = conditions_value in {
        "n/a",
        "na",
        "none",
        "not applicable",
        "not_applicable",
    }
    conditions_capture_required = status == "GO WITH CONDITIONS"
    status_and_counts_satisfied = bool(status_match) and not missing_buckets
    conditions_capture_satisfied = (
        not conditions_capture_required or conditions_captured
    )
    return {
        "status": status,
        "status_valid": bool(status_match),
        "severity_counts": severity_counts,
        "severity_count_scan": severity_count_scan,
        "missing_severity_count_buckets": missing_buckets,
        "conditions_captured_value": conditions_value,
        "conditions_captured_present": bool(conditions_match),
        "conditions_captured": conditions_captured,
        "conditions_not_applicable": conditions_not_applicable,
        "conditions_capture_required": conditions_capture_required,
        "conditions_capture_satisfied": conditions_capture_satisfied,
        "status_and_counts_satisfied": status_and_counts_satisfied,
        "satisfied": status_and_counts_satisfied and conditions_capture_satisfied,
    }


def attention_items_scan(body):
    items = []
    current_item = None

    def flush_current():
        nonlocal current_item
        if current_item:
            item = re.sub(r"[*_`]+", "", current_item.strip())
            item = re.sub(r"\s+", " ", item)
            if item:
                items.append(item[:240])
        current_item = None

    for raw_line in body.splitlines():
        line = raw_line.strip()
        if not line:
            flush_current()
            continue
        if re.match(r"(?i)^(none|n/a|na|not_applicable|not applicable)\b", line):
            flush_current()
            continue
        if re.match(r"(?i)^no (actionable )?(attention items|conditions|blockers|findings)\b", line):
            flush_current()
            continue
        bullet = re.match(r"^(?:[-*+]|\d+[.)])\s+(.*)$", line)
        if bullet:
            flush_current()
            current_item = bullet.group(1).strip()
            continue
        if current_item and not re.match(r"^#{1,6}\s+", line):
            current_item += " " + line
            continue
        flush_current()
    flush_current()
    return items


def artifact(path):
    path = Path(path)
    value = load_json(path) if path.is_file() else None
    return {
        "path": rel(path),
        "present": path.is_file(),
        "ok": value.get("ok") if isinstance(value, dict) else None,
        "command": value.get("command") if isinstance(value, dict) else None,
    }


def first_present(candidates):
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return candidates[0]


def git_status_signature(line):
    if len(line) < 4:
        return None
    if line[2] != " ":
        return None
    raw_status = line[0:2]
    status = raw_status.strip()
    path = line[3:].strip().strip('"')
    if " -> " in path:
        path = path.split(" -> ", 1)[1].strip().strip('"')
    if not status or not path:
        return None
    return {"status": status, "path": path}


def git_diff_signature(line):
    parts = line.split("\t")
    if len(parts) < 2:
        return None
    raw_status = parts[0].strip()
    if not raw_status:
        return None
    status = raw_status[0]
    path_idx = 2 if status in {"R", "C"} and len(parts) >= 3 else 1
    path = parts[path_idx].strip().strip('"')
    if not path:
        return None
    return {"status": status, "path": path}


def merge_surface_signatures(primary, secondary):
    signatures_by_path = {signature["path"]: signature for signature in secondary}
    for signature in primary:
        signatures_by_path[signature["path"]] = signature
    return sorted(
        signatures_by_path.values(),
        key=lambda signature: (signature["status"], signature["path"]),
    )


def surface_paths(signatures):
    return sorted({signature["path"] for signature in signatures if signature.get("path")})


def surface_signature(surface):
    if not isinstance(surface, dict):
        return None
    status = surface.get("status")
    path = surface.get("path")
    if not status or not path:
        return None
    return {"status": str(status), "path": str(path)}


def scope_path_prefix(framework_root, scope_root):
    try:
        rel_path = scope_root.resolve().relative_to(framework_root.resolve())
    except Exception:
        return ""
    rel = rel_path.as_posix()
    if rel == ".":
        return ""
    return f"{rel}/"


def normalize_scope_path(path, prefix):
    normalized = str(path).replace("\\", "/").strip()
    while normalized.startswith("./"):
        normalized = normalized[2:]
    if prefix and normalized.startswith(prefix):
        return normalized[len(prefix):] or "."
    return normalized


def parse_timestamp(value):
    if not value:
        return None
    try:
        return datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def changed_paths_newer_than(paths, generated_at):
    generated_ts = parse_timestamp(generated_at)
    if generated_ts is None:
        return []
    newer = []
    for path in paths:
        candidate = scope_root / path
        try:
            if candidate.exists() and candidate.stat().st_mtime > generated_ts + 0.001:
                newer.append(path)
        except OSError:
            continue
    return newer


def path_mtime(path):
    try:
        return Path(path).stat().st_mtime
    except OSError:
        return None


def comprehensive_review_reason_for_path(path):
    exact = {
        "AGENTS.md": "repository operating rules changed",
        "bitbucket-pipelines.yml": "CI pipeline shape changed",
        "scripts/appfw": "agent-facing CLI contract changed",
        "scripts/check-doc-examples.sh": "docs-check enforcement changed",
        "Cargo.toml": "workspace dependency/build contract changed",
        "Cargo.lock": "workspace dependency lock changed",
    }
    if path in exact:
        return exact[path]
    prefixes = [
        ("agent_skills/", "agent skill procedure changed"),
        ("scripts/ci/", "CI or release guard script changed"),
        ("scripts/git-hooks/", "local Git hook changed"),
        ("appfw_cli/", "compiled CLI source changed"),
        ("app_gen/src/", "generator source changed"),
        ("app_gen/_templates/", "generator template changed"),
        ("appfw_runtime/src/security", "runtime security source changed"),
        ("appfw_runtime/src/ingress", "runtime ingress source changed"),
        ("appfw_runtime/src/policy", "runtime policy source changed"),
        ("backend/src/data/", "framework data-access source changed"),
        ("docs/start/pr-review-agent-harness.md", "framework review harness changed"),
        ("docs/start/product-pr-review-agent-harness.md", "product review harness changed"),
        ("docs/start/agent-role-cards.md", "agent role/push authority changed"),
        ("docs/start/agentic-human-operating-model.md", "human/agent operating model changed"),
        ("docs/start/team-harness-replication.md", "team harness replication changed"),
        ("docs/start/branch-integration-model.md", "branch/integration policy changed"),
        ("docs/architecture/concerns/agentic-", "agentic safety architecture changed"),
        ("docs/architecture/concerns/maintainability.md", "docs/skills/CLI maintainability contract changed"),
        ("docs/release/", "release evidence or delivery governance changed"),
        ("docs/strategy/", "product strategy or North Star direction changed"),
    ]
    for prefix, reason in prefixes:
        if path.startswith(prefix):
            return reason
    return None


def comprehensive_review_reasons(branch, paths):
    reasons = []
    if branch.startswith("integrate/"):
        reasons.append(f"branch {branch} is an integration branch")
    if len(paths) > 12:
        reasons.append(f"branch changes {len(paths)} files")
    for path in paths:
        reason = comprehensive_review_reason_for_path(path)
        if reason:
            reasons.append(f"{path}: {reason}")
    return sorted(dict.fromkeys(reasons))


