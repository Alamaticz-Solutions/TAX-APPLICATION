if not runtime_audit_ready:
    runtime_audit_release_violations.extend(npm_audit_evidence_violations)
    if not npm_audit_passed:
        runtime_audit_release_violations.append("runtime audit evidence did not pass")
    if not paths["npm_audit_disposition"].is_file():
        runtime_audit_release_violations.append("release-approved runtime audit disposition is missing")
        if paths["npm_audit_disposition_template"].is_file():
            runtime_audit_release_violations.append("npm-audit-disposition.template.json is a template only, not release approval")
    else:
        runtime_audit_release_violations.extend(npm_audit_disposition_violations)
device_status = device_evidence.get("status") if isinstance(device_evidence, dict) else None
device_evidence_valid, device_evidence_violations, device_evidence_kind = valid_device_evidence(device_evidence)
device_smoke_executed = device_evidence_valid and device_status in {"passed", "certified"}
store_track_status = store_track_evidence.get("status") if isinstance(store_track_evidence, dict) else None
