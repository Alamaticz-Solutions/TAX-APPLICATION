def release_artifact_report(spec):
    source = spec["source"]
    target = spec["path"]
    source_present = source.is_file()
    source_parse_valid = spec.get("source_parse_valid")
    source_parse_error = spec.get("source_parse_error")
    invalid_readiness_fields = list(spec.get("invalid_readiness_fields", []))
    forbidden_readiness_claims = list(spec.get("forbidden_readiness_claims", []))
    staging_allowed = source_present and source_parse_valid is True and not forbidden_readiness_claims
    rejection_reasons = []
    if source_present and source_parse_valid is not True:
        rejection_reasons.append(source_parse_error or "$: source was not strictly decoded as JSON")
    if forbidden_readiness_claims:
        rejection_reasons.append(
            "forbidden candidate/release readiness claims at " + ", ".join(forbidden_readiness_claims)
        )
    return {
        "name": spec["name"],
        "source": rel(source),
        "path": rel(target, framework_root),
        "required": bool(spec["required"]),
        "source_present": source_present,
        "source_parse_valid": source_parse_valid if source_present else None,
        "source_parse_error": source_parse_error if source_present else None,
        "staging_allowed": staging_allowed,
        "source_rejected": source_present and not staging_allowed,
        "rejection_reasons": rejection_reasons,
        "staging_encoding": "canonical-json",
        "invalid_readiness_fields": invalid_readiness_fields,
        "forbidden_readiness_claims": forbidden_readiness_claims,
        "staged": target.is_file(),
        "legacy_condition_satisfied": bool(spec["legacy_condition_satisfied"]),
        "release_ready": bool(spec["release_ready"]),
    }

def stage_release_artifacts(specs):
    staged = []
    for spec in specs:
        source = spec["source"]
        target = spec["path"]
        source_parse_valid = spec.get("source_parse_valid")
        source_value = spec.get("source_value")
        forbidden_readiness_claims = spec.get("forbidden_readiness_claims", [])
        if source.is_file() and source_parse_valid is True and not forbidden_readiness_claims:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(
                json.dumps(source_value, indent=2, sort_keys=True, allow_nan=False) + "\n",
                encoding="utf-8",
            )
        elif target.is_file():
            target.unlink()
        staged.append(release_artifact_report(spec))
    return staged

if paths["scaffold_manifest"].is_file():
    add_check(
