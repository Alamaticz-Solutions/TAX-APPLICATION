def required_artifact_status(path):
    item, _ = artifact(framework_root / path)
    item["required"] = True
    return item

def attach_required_artifact_status(plan):
    enriched = []
    total_required = 0
    total_present = 0
    total_missing = 0
    total_release_ready_false = 0
    missing_artifacts = []
    release_ready_false_artifacts = []
    for entry in plan:
        copy = dict(entry)
        statuses = [required_artifact_status(path) for path in entry.get("required_artifacts", [])]
        required_count = len(statuses)
        present_count = len([item for item in statuses if item.get("present") is True])
        missing_count = required_count - present_count
        release_ready_false_count = len([
            item for item in statuses
            if item.get("present") is True and item.get("release_ready") is False
        ])
        missing_artifacts.extend([
            {"lane": entry.get("lane"), "path": item.get("path")}
            for item in statuses
            if item.get("present") is not True
        ])
        release_ready_false_artifacts.extend([
            {"lane": entry.get("lane"), "path": item.get("path")}
            for item in statuses
            if item.get("present") is True and item.get("release_ready") is False
        ])
        copy["required_artifact_status"] = statuses
        copy["required_artifact_summary"] = {
            "required_count": required_count,
            "present_count": present_count,
            "missing_count": missing_count,
            "release_ready_false_count": release_ready_false_count,
            "all_present": missing_count == 0,
            "missing": [
                {"lane": entry.get("lane"), "path": item.get("path")}
                for item in statuses
                if item.get("present") is not True
            ],
            "release_ready_false": [
                {"lane": entry.get("lane"), "path": item.get("path")}
                for item in statuses
                if item.get("present") is True and item.get("release_ready") is False
            ],
        }
        total_required += required_count
        total_present += present_count
        total_missing += missing_count
        total_release_ready_false += release_ready_false_count
        enriched.append(copy)
    return enriched, {
        "required_count": total_required,
        "present_count": total_present,
        "missing_count": total_missing,
        "release_ready_false_count": total_release_ready_false,
        "all_present": total_missing == 0,
        "missing": missing_artifacts,
        "release_ready_false": release_ready_false_artifacts,
    }

external_evidence_plan, external_required_artifact_summary = attach_required_artifact_status(external_evidence_plan)

local_lanes = [item for item in lanes if item["code"] != "P1-P4"]
local_preflight_lanes = [item for item in lanes if item["code"] == "P1-P4"]
