#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
invocation_cwd="$(pwd)"
default_app_root="$repo_root"
if [[ -f "$repo_root/examples/products/crm/.appfw/manifest.yaml" ]]; then
  default_app_root="$repo_root/examples/products/crm"
fi
app_root="${APPFW_APP_ROOT:-$default_app_root}"
framework_root="${APPFW_FRAMEWORK_ROOT:-$repo_root}"

app_gen_dir="${APPFW_GENERATOR_ROOT:-$framework_root/app_gen}"
config_root="${APPFW_CONFIG_ROOT:-$app_root/.appfw/model}"
templates_root="${APPFW_TEMPLATES_ROOT:-$app_gen_dir/_templates}"
report_root="${APPFW_REPORT_ROOT:-$app_root/.appfw/target/appfw}"
appfw_runtime_dir="$framework_root/appfw_runtime"
appfw_cli_dir="$framework_root/appfw_cli"
appfw_test_dir="$framework_root/appfw_test"
database_crate_dir="${APPFW_DATABASE_CRATE_ROOT:-$framework_root/database}"
backend_dir="$app_root/backend"
database_dir="$app_root/database"
api_tests_dir="$app_root/api_tests"
provider_api_tests_dir="${APPFW_PROVIDER_API_TESTS_ROOT:-$framework_root/api_tests}"
rego_test_dir="$app_root/rego_test"

if [[ -z "${APPFW_INTROSPECT_BIN:-}" && -x "$framework_root/bin/appfw_introspect" ]]; then
  export APPFW_INTROSPECT_BIN="$framework_root/bin/appfw_introspect"
fi
if [[ -z "${APPFW_APP_GEN_BIN:-}" && -x "$framework_root/bin/app_gen" ]]; then
  export APPFW_APP_GEN_BIN="$framework_root/bin/app_gen"
fi
if [[ -z "${APPFW_DATABASE_BIN:-}" && -x "$framework_root/bin/database" ]]; then
  export APPFW_DATABASE_BIN="$framework_root/bin/database"
fi
if [[ -z "${APPFW_PROVIDER_CERTIFICATION_EXPORT_BIN:-}" && -x "$framework_root/bin/provider_certification_export" ]]; then
  export APPFW_PROVIDER_CERTIFICATION_EXPORT_BIN="$framework_root/bin/provider_certification_export"
fi

appfw_use_color() {
  if [[ -n "${NO_COLOR:-}" ]]; then
    return 1
  fi
  case "${APPFW_COLOR:-auto}" in
    always)
      return 0
      ;;
    never)
      return 1
      ;;
  esac
  [[ -t 1 && "${TERM:-}" != "dumb" ]]
}

appfw_color() {
  local code="$1"
  shift || true
  if appfw_use_color; then
    printf '\033[%sm%s\033[0m' "$code" "$*"
  else
    printf '%s' "$*"
  fi
}

appfw_banner() {
  local title subtitle
  title="$(appfw_color '1;36' 'App Framework')"
  subtitle="$(appfw_color '2' 'agentic enterprise app generation')"
  cat <<EOF
    ___                 ______                                           __
   /   |  ____  ____   / ____/________ _____ ___  ___ _      ______  _____/ /__
  / /| | / __ \/ __ \ / /_  / ___/ __ \`/ __ \`__ \/ _ \ | /| / / __ \/ ___/ //_/
 / ___ |/ /_/ / /_/ // __/ / /  / /_/ / / / / / /  __/ |/ |/ / /_/ / /  / ,<
/_/  |_/ .___/ .___//_/   /_/   \__,_/_/ /_/ /_/\___/|__/|__/\____/_/  /_/|_|
      /_/   /_/

${title} - ${subtitle}
EOF
}

app_gen_root_args=(
  --app-root "$app_root"
  --framework-root "$framework_root"
  --generator-root "$app_gen_dir"
  --config-root "$config_root"
  --templates-root "$templates_root"
  --report-root "$report_root"
)

