  local json="$1"
  shift || true

  local args=()
  if [[ "$json" == "1" ]]; then
    args+=("--json")
  fi
  args+=("$@")
  bash "$script_dir/ci/local-live-release-preflight.sh" "${args[@]}"
}

write_policy_test_release_artifact() {
  local artifact_file="$1"
  local log_file="$2"

  run_policy_tests >"$log_file" 2>&1
  local status=$?
  local ok=false
  if [[ $status -eq 0 ]]; then
    ok=true
  fi

  {
    printf '{"command":"policy-test","ok":%s,"exit_code":%s,"log":' "$ok" "$status"
    json_escape "$log_file"
    printf '}\n'
  } >"$artifact_file"
  local artifact_status=$?
  if [[ $artifact_status -ne 0 ]]; then
    return "$artifact_status"
  fi

  return "$status"
}

