}

cli_test_delivery_mode_controller() {
  python3 "$script_dir/appfw-delivery-mode-test.py"
}

cli_test_mobile_readiness_containment() {
  python3 "$script_dir/mobile-readiness-containment.test.py"
}

cli_test_proget_publish() {
  bash "$script_dir/ci/proget-publish.test.sh"
}

cli_test_semantic_gates() {
  bash "$script_dir/cli-semantic-gates-test.sh"
}

cli_test_appfw_cli_unit() {
  require_framework_lockfile
  (cd "$framework_root" && cargo test --locked -p appfw-cli)
}

cli_test_appfw_introspect_contract() {
  require_framework_lockfile
  (cd "$app_gen_dir" && cargo test --locked --bin appfw_introspect cli_contract)
}

cli_test_run_check() {
  local name="$1"
  local command_text="$2"
  shift 2

  local log_file="$repo_root/target/appfw/cli-test-${name}.log"
  if [[ "${CLI_TEST_JSON:-0}" != "1" ]]; then
    printf 'CLI test: %s\n' "$command_text"
  fi

  set +e
  "$@" >"$log_file" 2>&1
  local status=$?
  set -e

  local ok=false
  if [[ $status -eq 0 ]]; then
    ok=true
  else
    CLI_TEST_FAILED=1
    if [[ "${CLI_TEST_JSON:-0}" != "1" ]]; then
      cat "$log_file" >&2 || true
    fi
  fi
  CLI_TEST_ITEMS+=("$name|$ok|$status|$log_file|$command_text")
}

cli_test() {
  local json="$1"
  shift || true

  local plan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      *)
        echo "Unknown cli-test option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    if [[ "$json" == "1" ]]; then
      cli_test_plan_json
    else
      cat <<'EOF'
cli-test plan

Fast CLI contract checks:
  bash -n scripts/appfw
  bash -n scripts/check-doc-examples.sh
  bash scripts/cli-semantic-gates-test.sh
  python3 scripts/appfw-delivery-mode-test.py
  python3 scripts/mobile-readiness-containment.test.py
  bash scripts/ci/proget-publish.test.sh
  cargo test --locked -p appfw-cli
  cargo test --locked --bin appfw_introspect cli_contract

This lane intentionally avoids docs-check, generation, product crate tests,
provider certification, and live services.
EOF
    fi
    return 0
  fi

  if [[ "${command_namespace:-}" == "product" ]]; then
    echo "cli-test is a framework command; use scripts/appfw framework cli-test" >&2
    return 2
  fi

  mkdir -p "$repo_root/target/appfw"
  local report_file="$repo_root/target/appfw/cli-test.json"
  CLI_TEST_FAILED=0
  CLI_TEST_JSON="$json"
  CLI_TEST_ITEMS=()

  cli_test_run_check "shell-appfw" "bash -n scripts/appfw" cli_test_shell_appfw
  cli_test_run_check "shell-doc-examples" "bash -n scripts/check-doc-examples.sh" cli_test_shell_doc_examples
  cli_test_run_check "semantic-gates" "bash scripts/cli-semantic-gates-test.sh" cli_test_semantic_gates
  cli_test_run_check "delivery-mode-controller" "python3 scripts/appfw-delivery-mode-test.py" cli_test_delivery_mode_controller
  cli_test_run_check "mobile-readiness-containment" "python3 scripts/mobile-readiness-containment.test.py" cli_test_mobile_readiness_containment
  cli_test_run_check "proget-publish" "bash scripts/ci/proget-publish.test.sh" cli_test_proget_publish
  cli_test_run_check "appfw-cli-unit" "cargo test --locked -p appfw-cli" cli_test_appfw_cli_unit
  cli_test_run_check "appfw-introspect-cli-contract" "cargo test --locked --bin appfw_introspect cli_contract" cli_test_appfw_introspect_contract

  local ok=true
  if [[ "$CLI_TEST_FAILED" != "0" ]]; then
    ok=false
  fi

  {
    printf '{"command":"cli-test","ok":%s,"mode":"run","scope":"fast CLI contract","artifact":"target/appfw/cli-test.json","checks":[' "$ok"
    local first=1 item name item_ok status log_file command_text
    for item in "${CLI_TEST_ITEMS[@]}"; do
      IFS='|' read -r name item_ok status log_file command_text <<<"$item"
      cli_test_json_item "$first" "$name" "$item_ok" "$status" "$log_file" "$command_text"
      first=0
    done
    printf ']}\n'
  } >"$report_file"

  if [[ "$json" == "1" ]]; then
    cat "$report_file"
  else
    printf 'CLI test artifact: %s\n' "$report_file"
  fi

  if [[ "$CLI_TEST_FAILED" == "0" ]]; then
    return 0
  fi
  return 1
}

boundary_check() {
  local json="$1"

  local args=()
  if [[ "$json" == "1" ]]; then
    args+=("--json")
  fi
  args+=("boundary-check")
  run_appfw_introspect "${args[@]}"
}

feature_check_item_json() {
  local first="$1"
  local name="$2"
  local ok="$3"
  local detail="$4"
  local elapsed_ms="$5"
  local exit_code="$6"
  local timing_ok="$7"

  if [[ "$first" != "1" ]]; then
    printf ','
  fi
  printf '{"name":'
  json_escape "$name"
  printf ',"ok":%s' "$ok"
  printf ',"elapsed_ms":%s' "$elapsed_ms"
  printf ',"timing_ok":%s' "$timing_ok"
  printf ',"exit_code":%s' "$exit_code"
  if [[ -n "$detail" ]]; then
    printf ',"detail":'
    json_escape "$detail"
  fi
  printf '}'
}

feature_check_plan() {
  local json="$1"
  local report_file="$framework_root/target/appfw/feature-check-plan.json"
  mkdir -p "$(dirname "$report_file")"
  {
    printf '{"command":"feature-check","ok":true,"plan_only":true'
    printf ',"artifact":"target/appfw/feature-check-plan.json"'
    printf ',"scope":"retained U7 runtime/provider feature compile evidence"'
    printf ',"checks":['
    printf '{"name":"runtime core without ingress defaults","command":"cargo check --locked -p appfw-runtime --no-default-features"},'
    printf '{"name":"runtime ingress features","features":["http","mcp","kafka"]},'
    printf '{"name":"product backend ingress features","features":["http","mcp","kafka"]},'
    printf '{"name":"product backend provider features","features":["provider-postgres","provider-mongo","provider-mssql","provider-snowflake","provider-neo4j"]},'
    printf '{"name":"crm sample backend ingress features","features":["http","mcp","kafka"],"when":"framework-root invocation"},'
    printf '{"name":"excluded ingress dependency graphs","command":"cargo tree --locked ... --prefix none"}'
    printf ']'
    printf ',"notes":['
    json_escape "Plan mode does not compile; run scripts/appfw framework feature-check --json to retain compile evidence."
    printf ','
    json_escape "The retained artifact is consumed by U7 composition evidence and release-check runs composition-check --enforce after feature-check."
    printf ']}\n'
  } >"$report_file"
  if [[ "$json" == "1" ]]; then
    cat "$report_file"
  else
    echo "feature-check plan written to target/appfw/feature-check-plan.json"
  fi
}

feature_check_write_report() {
  local json="$1"
  local report_file="$framework_root/target/appfw/feature-check.json"
  mkdir -p "$(dirname "$report_file")"
  {
    printf '{"command":"feature-check","ok":%s' "$([[ "$FEATURE_CHECK_FAILED" == "0" ]] && echo true || echo false)"
    printf ',"artifact":"target/appfw/feature-check.json"'
    printf ',"scope":"retained U7 runtime/provider feature compile evidence"'
    local finished_ms elapsed_ms timing_ok
    timing_ok=false
    if [[ "$FEATURE_CHECK_STARTED_MS" =~ ^[0-9]+$ ]] \
      && finished_ms="$(feature_check_now_ms)" \
      && [[ "$finished_ms" =~ ^[0-9]+$ ]]; then
      elapsed_ms=$((finished_ms - FEATURE_CHECK_STARTED_MS))
      if [[ "$elapsed_ms" -lt 0 ]]; then
        elapsed_ms=0
      else
        timing_ok=true
      fi
    else
      elapsed_ms=0
    fi
    printf ',"elapsed_ms":%s' "$elapsed_ms"
    printf ',"timing_ok":%s' "$timing_ok"
    printf ',"timing_clock":'
    json_escape "$FEATURE_CHECK_CLOCK_MODE"
    printf ',"checks":['
    local first=1
    local item name ok detail check_elapsed_ms exit_code check_timing_ok
    for item in "${FEATURE_CHECK_RESULTS[@]}"; do
      IFS=$'\x1f' read -r name ok detail check_elapsed_ms exit_code check_timing_ok <<<"$item"
      feature_check_item_json "$first" "$name" "$ok" "$detail" "$check_elapsed_ms" "$exit_code" "$check_timing_ok"
      first=0
    done
    printf ']}\n'
  } >"$report_file"
  if [[ "$json" == "1" ]]; then
    cat "$report_file"
  fi
}

feature_check_valid_clock_sample() {
  feature_check_canonical_clock_sample "$1" >/dev/null
}

feature_check_canonical_clock_sample() {
  local sample="$1"
  [[ "$sample" =~ ^[0-9]+$ ]] || return 1
  while [[ "$sample" == 0* && "$sample" != "0" ]]; do
    sample="${sample#0}"
  done
  if [[ "${#sample}" -gt 19 ]] \
    || { [[ "${#sample}" -eq 19 ]] && [[ "$sample" > "9223372036854775807" ]]; }; then
    return 1
  fi
  printf '%s\n' "$sample"
}

feature_check_python_monotonic_ms() {
  local sample
  sample="$(python3 -c 'import time; print(time.monotonic_ns() // 1_000_000)' 2>/dev/null)" || return 1
  sample="$(feature_check_canonical_clock_sample "$sample")" || return 1
  printf '%s\n' "$sample"
}

feature_check_epoch_ms() {
  local seconds
  seconds="$(date +%s 2>/dev/null)" || return 1
  seconds="$(feature_check_canonical_clock_sample "$seconds")" || return 1
  feature_check_canonical_clock_sample "${seconds}000"
}

feature_check_now_ms() {
  case "${FEATURE_CHECK_CLOCK_MODE:-epoch-seconds}" in
    monotonic)
      feature_check_python_monotonic_ms
      ;;
    epoch-seconds)
      feature_check_epoch_ms
      ;;
    *)
      return 1
      ;;
  esac
}

feature_check_select_clock() {
  local started_ms
  if command -v python3 >/dev/null 2>&1 \
    && started_ms="$(feature_check_python_monotonic_ms)"; then
    FEATURE_CHECK_CLOCK_MODE="monotonic"
    FEATURE_CHECK_STARTED_MS="$started_ms"
    return
  fi

  if started_ms="$(feature_check_epoch_ms)"; then
    FEATURE_CHECK_CLOCK_MODE="epoch-seconds"
    FEATURE_CHECK_STARTED_MS="$started_ms"
    return
  fi

  FEATURE_CHECK_CLOCK_MODE="unavailable"
  FEATURE_CHECK_STARTED_MS=""
}

feature_check_elapsed_evidence() {
  local started_ms="$1"
  local finished_ms elapsed_ms
  if ! started_ms="$(feature_check_canonical_clock_sample "$started_ms")" \
    || ! finished_ms="$(feature_check_now_ms)" \
    || ! finished_ms="$(feature_check_canonical_clock_sample "$finished_ms")"; then
    printf '0\x1ffalse'
    return
  fi
  elapsed_ms=$((finished_ms - started_ms))
  if [[ "$elapsed_ms" -lt 0 ]]; then
    printf '0\x1ffalse'
    return
  fi
  printf '%s\x1ftrue' "$elapsed_ms"
}

feature_check_progress() {
  local json="$1"
  local event="$2"
  local name="$3"
  local elapsed_ms="${4:-}"
  local exit_code="${5:-}"
  local ok="${6:-}"
  local timing_ok="${7:-}"

  if [[ "$json" != "1" ]]; then
    return
  fi

  {
    printf '{"event":'
    json_escape "$event"
    printf ',"name":'
    json_escape "$name"
    if [[ -n "$elapsed_ms" ]]; then
      printf ',"elapsed_ms":%s' "$elapsed_ms"
    fi
    if [[ -n "$exit_code" ]]; then
      printf ',"exit_code":%s' "$exit_code"
    fi
    if [[ -n "$ok" ]]; then
      printf ',"ok":%s' "$ok"
    fi
    if [[ -n "$timing_ok" ]]; then
      printf ',"timing_ok":%s' "$timing_ok"
    fi
    printf '}\n'
  } >&2
}

feature_check_log_slug() {
  local name="$1"
  local slug
  slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')"
  slug="${slug#-}"
  slug="${slug%-}"
  printf '%s' "$slug"
}

feature_check_retain_log() {
  local name="$1"
  local tmp_log="$2"
  local slug retained
  slug="$(feature_check_log_slug "$name")"
  retained="$framework_root/target/appfw/feature-check-logs/${slug}.log"
  mkdir -p "$(dirname "$retained")"
  cp "$tmp_log" "$retained" || true
  printf '%s' "target/appfw/feature-check-logs/${slug}.log"
}

feature_check_failure_detail() {
  local prefix="$1"
  local retained_rel="$2"
  local tmp_log="$3"
  local snippet
  snippet="$(tail -n 16 "$tmp_log" | tr '\t\n' '  ' | tr -s ' ')"
  printf '%s diagnostic output was captured at %s. %s' "$prefix" "$retained_rel" "$snippet"
}

feature_check_run() {
  local json="$1"
  local name="$2"
  local cwd="$3"
  shift 3

  if [[ "$json" == "1" ]]; then
    local log_file started_ms elapsed_ms timing_ok
    log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-feature-check.XXXXXX")"
    started_ms="$(feature_check_now_ms)" || started_ms=""
    feature_check_progress "$json" "feature-check-start" "$name"
    set +e
    (cd "$cwd" && "$@") >"$log_file" 2>&1
    local status=$?
    set -e
    IFS=$'\x1f' read -r elapsed_ms timing_ok <<<"$(feature_check_elapsed_evidence "$started_ms")"
    if [[ $status -eq 0 ]]; then
      rm -f "$log_file"
      FEATURE_CHECK_RESULTS+=("$name"$'\x1f'"true"$'\x1f'""$'\x1f'"$elapsed_ms"$'\x1f'"$status"$'\x1f'"$timing_ok")
    else
      FEATURE_CHECK_FAILED=1
      local retained_rel
      retained_rel="$(feature_check_retain_log "$name" "$log_file")"
      FEATURE_CHECK_RESULTS+=("$name"$'\x1f'"false"$'\x1f'"$(feature_check_failure_detail "command failed;" "$retained_rel" "$log_file")"$'\x1f'"$elapsed_ms"$'\x1f'"$status"$'\x1f'"$timing_ok")
      rm -f "$log_file"
    fi
    feature_check_progress "$json" "feature-check-finish" "$name" "$elapsed_ms" "$status" "$([[ $status -eq 0 ]] && echo true || echo false)" "$timing_ok"
    return "$status"
  fi

  echo "Checking $name"
  (cd "$cwd" && "$@")
}

feature_check_forbid_tree_matches() {
  local json="$1"
  local name="$2"
  local cwd="$3"
  local pattern="$4"
  shift 4

  local log_file started_ms elapsed_ms timing_ok
  log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-feature-check.XXXXXX")"
  if [[ "$json" == "1" ]]; then
    started_ms="$(feature_check_now_ms)" || started_ms=""
    feature_check_progress "$json" "feature-check-start" "$name"
  fi
  set +e
  (cd "$cwd" && "$@") >"$log_file" 2>&1
  local status=$?
  set -e
  if [[ "$json" == "1" ]]; then
    IFS=$'\x1f' read -r elapsed_ms timing_ok <<<"$(feature_check_elapsed_evidence "$started_ms")"
  fi

  if [[ $status -ne 0 ]]; then
    FEATURE_CHECK_FAILED=1
    if [[ "$json" == "1" ]]; then
      local retained_rel
      retained_rel="$(feature_check_retain_log "$name" "$log_file")"
      FEATURE_CHECK_RESULTS+=("$name"$'\x1f'"false"$'\x1f'"$(feature_check_failure_detail "cargo tree failed;" "$retained_rel" "$log_file")"$'\x1f'"$elapsed_ms"$'\x1f'"$status"$'\x1f'"$timing_ok")
      feature_check_progress "$json" "feature-check-finish" "$name" "$elapsed_ms" "$status" "false" "$timing_ok"
      rm -f "$log_file"
    else
      echo "Checking $name"
      cat "$log_file"
    fi
    return "$status"
  fi

  if grep -E "$pattern" "$log_file" >/dev/null 2>&1; then
    FEATURE_CHECK_FAILED=1
    status=1
    if [[ "$json" == "1" ]]; then
      local retained_rel
      retained_rel="$(feature_check_retain_log "$name" "$log_file")"
      FEATURE_CHECK_RESULTS+=("$name"$'\x1f'"false"$'\x1f'"$(feature_check_failure_detail "excluded ingress packages were present;" "$retained_rel" "$log_file")"$'\x1f'"$elapsed_ms"$'\x1f'"$status"$'\x1f'"$timing_ok")
      feature_check_progress "$json" "feature-check-finish" "$name" "$elapsed_ms" "$status" "false" "$timing_ok"
      rm -f "$log_file"
    else
      echo "Checking $name"
      echo "Excluded ingress packages were present:"
      grep -E "$pattern" "$log_file" || true
    fi
    return 1
  fi

  rm -f "$log_file"
  if [[ "$json" == "1" ]]; then
    FEATURE_CHECK_RESULTS+=("$name"$'\x1f'"true"$'\x1f'""$'\x1f'"$elapsed_ms"$'\x1f'"$status"$'\x1f'"$timing_ok")
    feature_check_progress "$json" "feature-check-finish" "$name" "$elapsed_ms" "$status" "true" "$timing_ok"
  else
    echo "Checking $name"
  fi
}

feature_check() {
  local json="$1"
  shift || true

  local plan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      *)
        json_result "feature-check" false "feature-check only accepts --plan"
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    feature_check_plan "$json"
    return
  fi

  require_framework_lockfile
  require_product_lockfile

  local failed=0
  FEATURE_CHECK_FAILED=0
  FEATURE_CHECK_RESULTS=()
  feature_check_select_clock
  local http_ingress_tree_pattern='^(axum|async-graphql-axum) v|^tower-http v0\.4\.'
  local provider_features=(
    provider-postgres
    provider-mongo
    provider-mssql
    provider-snowflake
    provider-neo4j
  )

  feature_check_run "$json" "runtime core without ingress defaults" "$framework_root" \
    cargo check --locked -p appfw-runtime --no-default-features || failed=1
  feature_check_forbid_tree_matches "$json" "runtime core excludes HTTP ingress dependency graph" "$framework_root" "$http_ingress_tree_pattern" \
    cargo tree --locked -p appfw-runtime --no-default-features --prefix none || failed=1
  for feature in http mcp kafka; do
    feature_check_run "$json" "runtime $feature ingress feature" "$framework_root" \
      cargo check --locked -p appfw-runtime --no-default-features --features "$feature" || failed=1
  done
  for feature in mcp kafka; do
    feature_check_forbid_tree_matches "$json" "runtime $feature excludes HTTP ingress dependency graph" "$framework_root" "$http_ingress_tree_pattern" \
      cargo tree --locked -p appfw-runtime --no-default-features --features "$feature" --prefix none || failed=1
  done

  if [[ -f "$backend_dir/Cargo.toml" ]]; then
    feature_check_run "$json" "product backend core without ingress defaults" "$framework_root" \
      cargo check --locked --manifest-path "$backend_dir/Cargo.toml" --no-default-features || failed=1
    feature_check_forbid_tree_matches "$json" "product backend core excludes HTTP ingress dependency graph" "$framework_root" "$http_ingress_tree_pattern" \
      cargo tree --locked --manifest-path "$backend_dir/Cargo.toml" --no-default-features --prefix none || failed=1
    for feature in http mcp kafka; do
      feature_check_run "$json" "product backend $feature feature" "$framework_root" \
        cargo check --locked --manifest-path "$backend_dir/Cargo.toml" --no-default-features --features "$feature" || failed=1
    done
    for feature in mcp kafka; do
      feature_check_forbid_tree_matches "$json" "product backend $feature excludes HTTP ingress dependency graph" "$framework_root" "$http_ingress_tree_pattern" \
        cargo tree --locked --manifest-path "$backend_dir/Cargo.toml" --no-default-features --features "$feature" --prefix none || failed=1
    done
    for feature in "${provider_features[@]}"; do
      if grep -E "^[[:space:]]*$feature[[:space:]]*=" "$backend_dir/Cargo.toml" >/dev/null 2>&1; then
        feature_check_run "$json" "product backend $feature provider feature" "$framework_root" \
          cargo check --locked --manifest-path "$backend_dir/Cargo.toml" --no-default-features --features "$feature" || failed=1
      fi
    done
  fi

  local crm_backend="$framework_root/examples/products/crm/backend/Cargo.toml"
  if [[ "$app_root" == "$framework_root" && -f "$crm_backend" ]]; then
    feature_check_run "$json" "crm sample backend core without ingress defaults" "$framework_root" \
      cargo check --locked --manifest-path "$crm_backend" --no-default-features || failed=1
    feature_check_forbid_tree_matches "$json" "crm sample backend core excludes HTTP ingress dependency graph" "$framework_root" "$http_ingress_tree_pattern" \
      cargo tree --locked --manifest-path "$crm_backend" --no-default-features --prefix none || failed=1
    for feature in http mcp kafka; do
      feature_check_run "$json" "crm sample backend $feature feature" "$framework_root" \
        cargo check --locked --manifest-path "$crm_backend" --no-default-features --features "$feature" || failed=1
    done
    for feature in mcp kafka; do
      feature_check_forbid_tree_matches "$json" "crm sample backend $feature excludes HTTP ingress dependency graph" "$framework_root" "$http_ingress_tree_pattern" \
        cargo tree --locked --manifest-path "$crm_backend" --no-default-features --features "$feature" --prefix none || failed=1
    done
  fi

  if [[ "$json" == "1" ]]; then
    feature_check_write_report "$json"
  else
    feature_check_write_report "$json"
  fi

  return "$failed"
}

test_all() {
  local json="$1"
  shift || true

  if [[ "$json" == "1" ]]; then
    local plan=0
    local plan_fast=0
    local plan_smoke=0
    local arg
    for arg in "$@"; do
      case "$arg" in
        --plan)
          plan=1
          ;;
        --fast)
          plan_fast=1
          ;;
        --smoke)
          plan_smoke=1
          ;;
        *)
          json_result "test" false "unknown test option: $arg"
          return
          ;;
      esac
    done
    if [[ "$plan" == "1" ]]; then
      local mode="full"
      if [[ "$plan_fast" == "1" && "$plan_smoke" == "1" ]]; then
        json_result "test" false "test: choose either --smoke or --fast, not both"
        return
      elif [[ "$plan_smoke" == "1" ]]; then
        mode="smoke"
      elif [[ "$plan_fast" == "1" ]]; then
        mode="fast"
      fi
      printf '{"command":"test","ok":true,"plan_only":true,"mode":'
      json_escape "$mode"
      if [[ "$mode" == "smoke" ]]; then
        printf ',"scope":"validation, boundaries, and script syntax without Rust compilation"'
        printf ',"checks":["framework validate","boundary-check","shell syntax","javascript checker syntax"]'
      elif [[ "$mode" == "fast" ]]; then
        printf ',"scope":"validation, boundaries, appfw-runtime, appfw-cli, app_gen, and boundary unit coverage"'
        printf ',"checks":["framework validate","boundary-check","appfw-runtime tests","appfw-cli tests","app_gen tests"]'
      else
        printf ',"scope":"full local framework and product test lane"'
        printf ',"checks":["app_gen tests","product backend tests","database runner tests","policy fixtures","api_tests compile"]'
      fi
      printf '}\n'
      return
    fi
    run_with_json_capture "test" test_all 0 "$@"
    return
  fi

  local fast=0
  local smoke=0
  local plan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --smoke)
        smoke=1
        ;;
      --fast)
        fast=1
        ;;
      *)
        echo "Unknown test option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$smoke" == "1" && "$fast" == "1" ]]; then
    echo "test: choose either --smoke or --fast, not both" >&2
    return 2
  fi

  if [[ "$plan" == "1" ]]; then
    if [[ "$smoke" == "1" ]]; then
      cat <<'EOF'
Test smoke plan:
- validate product/framework configuration
- run generated-boundary checks
- run framework shell syntax checks
- run framework JavaScript checker syntax checks when node is available
EOF
    elif [[ "$fast" == "1" ]]; then
      cat <<'EOF'
Test fast plan:
- validate product/framework configuration
- run generated-boundary checks
- run focused framework crate tests
- skip product backend/API live scenarios
EOF
    else
      cat <<'EOF'
Test full plan:
- run app_gen tests
- run product backend tests
- run database runner tests
- run policy fixtures
- compile generated API tests without live backend scenarios
EOF
    fi
    return
  fi

  if [[ "$smoke" == "1" ]]; then
    echo "Validating config"
    validate 0
    echo
    echo "Checking product boundaries"
    boundary_check 0
    echo
    if [[ "${command_namespace:-}" != "product" ]]; then
      echo "Checking framework shell syntax"
      bash -n "$repo_root/scripts/appfw"
      bash -n "$repo_root/scripts/check-doc-examples.sh"
      echo
      if command -v node >/dev/null 2>&1; then
        echo "Checking framework JavaScript checker syntax"
        node --check "$repo_root/scripts/check-pds-components.mjs"
        node --check "$repo_root/scripts/check-pds-tokens.mjs"
        node --check "$repo_root/scripts/check-pds-catalog-evidence.mjs"
        node --check "$repo_root/scripts/check-nexus-workstreams.mjs"
        node --check "$repo_root/scripts/check-product-increment-plan.mjs"
        node --check "$repo_root/scripts/check-product-increment-portfolio.mjs"
        node --check "$repo_root/scripts/product-increment-path-safety.mjs"
        echo
      else
        echo "Skipping JavaScript checker syntax; node is not on PATH"
        echo
      fi
    fi
    return
  fi

  if [[ "$fast" == "1" ]]; then
    echo "Validating config"
    validate 0
    echo
    echo "Checking product boundaries"
    boundary_check 0
    echo
    if [[ "${command_namespace:-}" == "product" ]]; then
      return
    fi
    if [[ -d "$appfw_runtime_dir" ]]; then
      require_framework_lockfile
      echo "Testing appfw_runtime"
      (cd "$appfw_runtime_dir" && cargo test --locked --lib --tests)
      echo
    fi
    if [[ -d "$appfw_cli_dir" ]]; then
      require_framework_lockfile
      echo "Testing appfw_cli"
      (cd "$framework_root" && cargo test --locked -p appfw-cli --lib)
      echo
    fi
    echo "Testing app_gen boundary-check unit coverage"
    require_framework_lockfile
    (cd "$app_gen_dir" && cargo test --locked --lib boundary_check)
    return
  fi

  if [[ "${command_namespace:-}" != "product" ]]; then
  echo "Testing app_gen"
  require_framework_lockfile
  (cd "$app_gen_dir" && cargo test --locked)
  echo
  if [[ -d "$appfw_cli_dir" ]]; then
    require_framework_lockfile
    echo "Testing appfw_cli"
    (cd "$framework_root" && cargo test --locked -p appfw-cli)
    echo
  fi
  if [[ -d "$appfw_runtime_dir" ]]; then
    require_framework_lockfile
    echo "Testing appfw_runtime"
    (cd "$appfw_runtime_dir" && cargo test --locked --lib --tests)
    echo
  fi
  if [[ -d "$appfw_test_dir" ]]; then
    require_framework_lockfile
    echo "Testing appfw_test"
    (cd "$appfw_test_dir" && cargo test --locked)
    echo
  fi
  if [[ -d "$framework_root/appfw_provider_mssql" ]]; then
    require_framework_lockfile
    echo "Testing appfw_provider_mssql"
    (cd "$framework_root" && cargo test --locked -p appfw-provider-mssql --lib --tests)
    echo
  fi
  fi
  echo "Checking product boundaries"
  boundary_check 0
  echo
  echo "Testing backend"
  require_product_lockfile
  (cd "$backend_dir" && cargo_test_for_product_crate -- --test-threads=1)
  echo
  echo "Testing database"
  require_framework_lockfile
  require_product_lockfile
  (cd "$database_dir" && cargo test --locked --manifest-path "$database_crate_dir/Cargo.toml")
  echo
  echo "Testing product policy fixtures"
  run_policy_tests
  echo
  echo "Compiling product api_tests generated scenarios"
  (cd "$api_tests_dir" && cargo_test_for_product_crate --no-run)
}

run_policy_tests() {
  require_product_lockfile
  (cd "$rego_test_dir" && cargo_test_for_product_crate "$@")
}

policy_test() {
  local json="$1"
  shift

  if [[ "$json" == "1" ]]; then
    run_with_json_capture "policy-test" run_policy_tests "$@"
    return
  fi

  run_policy_tests "$@"
}

resolve_frontend_root() {
  if [[ -n "${APPFW_FRONTEND_ROOT:-}" ]]; then
    printf '%s\n' "$APPFW_FRONTEND_ROOT"
    return 0
  fi
  if [[ -f "$app_root/frontend/package.json" ]]; then
    printf '%s\n' "$app_root/frontend"
    return 0
  fi
  if [[ -f "$app_root/examples/products/crm/frontend/package.json" ]]; then
    printf '%s\n' "$app_root/examples/products/crm/frontend"
    return 0
  fi
  return 1
}

frontend_test() {
  local json="$1"
  shift || true
  local frontend_root
  if ! frontend_root="$(resolve_frontend_root)"; then
    if [[ "$json" == "1" ]]; then
      json_result "frontend-test" false "no frontend package found; set APPFW_FRONTEND_ROOT"
    else
      printf 'No frontend package found; set APPFW_FRONTEND_ROOT.\n' >&2
    fi
    return 2
  fi

  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local artifact_file="$report_dir/frontend-test.json"
  local log_file="$report_dir/frontend-test.log"
  mkdir -p "$report_dir"

  set +e
  (
    cd "$frontend_root"
    npm run test:frontend
  ) >"$log_file" 2>&1
  local status=$?
  set -e

  if [[ -f "$frontend_root/scripts/frontend-test-evidence.mjs" ]]; then
    node "$frontend_root/scripts/frontend-test-evidence.mjs" \
      --output "$artifact_file" \
      --status "$status" >/dev/null
  else
    printf '{"command":"frontend-test","ok":%s,"frontend_root":' "$([[ $status -eq 0 ]] && printf true || printf false)" >"$artifact_file"
    json_escape "$frontend_root" >>"$artifact_file"
    printf ',"log":' >>"$artifact_file"
    json_escape "$log_file" >>"$artifact_file"
    printf '}\n' >>"$artifact_file"
  fi

  if [[ "$json" == "1" ]]; then
    cat "$artifact_file"
  elif [[ $status -eq 0 ]]; then
    printf 'Frontend test: OK\n'
    printf 'Evidence: %s\n' "$artifact_file"
  else
    printf 'Frontend test: FAILED\n' >&2
    printf 'Log: %s\n' "$log_file" >&2
    printf 'Evidence: %s\n' "$artifact_file" >&2
  fi

  return "$status"
}

