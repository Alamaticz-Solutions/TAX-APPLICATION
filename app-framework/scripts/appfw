    if isinstance(npm_audit_evidence.get("audit_remediation"), dict):
        npm_audit_remediation = npm_audit_evidence["audit_remediation"]
    if isinstance(npm_audit_evidence.get("audit_unavailable"), dict):
        npm_audit_unavailable = npm_audit_evidence["audit_unavailable"]
npm_audit_disposition_required = npm_audit_evidence_present and not runtime_audit_ready
