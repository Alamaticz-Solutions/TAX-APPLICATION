static_ready = not static_blocking_violations
legacy_evidence_satisfied = static_ready and typecheck_executed and test_executed and expo_doctor_executed and runtime_audit_ready and device_smoke_executed and store_track_release_ready
candidate_ready = False
release_ready = False
readiness_level = "static-scaffold" if static_ready else "missing-static-scaffold"
