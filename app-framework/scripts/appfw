    for path, desired in desired_files.items():
        current = path.read_text(encoding="utf-8") if path.exists() else None
        differs = current != desired
        if check_mode:
            action = "verified" if not differs else ("would_create" if current is None else "would_update")
            if differs:
                blocking_violations.append(f"generated mobile artifact drift: {rel(path)}")
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            if differs:
                path.write_text(desired, encoding="utf-8")
            action = "created" if current is None else ("updated" if differs else "unchanged")
        write_actions.append(
            {
                "path": rel(path),
                "action": action,
                "ownership": "framework-generated-target",
                "sha256": sha256(desired),
            }
        )
except Exception as exc:
    blocking_violations.append(str(exc))

report = {
    "ok": not blocking_violations,
    "check": check_mode,
    "write_actions": write_actions,
