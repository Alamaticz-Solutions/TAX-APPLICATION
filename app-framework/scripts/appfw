store_track_release_ready = store_track_evidence_valid and store_track_status == "certified"
device_tooling_preflight_recorded = isinstance(device_tooling_evidence, dict) and device_tooling_evidence.get("ok") is True
static_blocking_violations = list(blocking_violations)

if run_local:
    if local_run_findings:
