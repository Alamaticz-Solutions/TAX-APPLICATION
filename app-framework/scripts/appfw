harness_check() {
  local json="$1"
  shift || true

  local plan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      *)
        echo "harness-check: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "harness-check" --plan
    return
  fi

  local args=()
  if [[ "$json" == "1" ]]; then
    args+=("--json")
  fi
  args+=("harness-check")
  run_appfw_introspect "${args[@]}"
}

chat_eval() {
  local json="$1"
  shift || true

  local plan=0
  local inject_leak=0
  local pipeline_plan=0
  local fixture_root="$framework_root/app_gen/_config/chat_evals"
  local artifact=""
  local pipeline_artifact=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --inject-leak)
        inject_leak=1
        ;;
      --pipeline-plan)
        pipeline_plan=1
        ;;
      --fixture-root)
        if [[ $# -lt 2 ]]; then
          echo "chat-eval: --fixture-root requires a path" >&2
          return 2
        fi
        fixture_root="$2"
        shift
        ;;
      --artifact)
        if [[ $# -lt 2 ]]; then
          echo "chat-eval: --artifact requires a path" >&2
          return 2
        fi
        artifact="$2"
        shift
        ;;
      --pipeline-artifact)
        if [[ $# -lt 2 ]]; then
          echo "chat-eval: --pipeline-artifact requires a path" >&2
          return 2
        fi
        pipeline_artifact="$2"
        shift
        ;;
      *)
        echo "chat-eval: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "chat-eval" --plan
    return
  fi

  if [[ -z "$artifact" ]]; then
    if [[ "$inject_leak" == "1" ]]; then
      artifact="$report_root/chat-eval-inject-leak.json"
    else
      artifact="$report_root/chat-eval.json"
    fi
  fi
  if [[ "$pipeline_plan" == "1" && -z "$pipeline_artifact" ]]; then
    pipeline_artifact="$report_root/chat-eval-promptfoo-plan.json"
  fi
  mkdir -p "$(dirname "$artifact")"
  if [[ "$pipeline_plan" == "1" ]]; then
    mkdir -p "$(dirname "$pipeline_artifact")"
  fi

  local args=("--fixture-root" "$fixture_root" "--artifact" "$artifact")
  if [[ "$json" == "1" ]]; then
    args+=("--json")
  fi
  if [[ "$inject_leak" == "1" ]]; then
    args+=("--inject-leak")
  fi
  if [[ "$pipeline_plan" == "1" ]]; then
    args+=("--pipeline-plan" "--pipeline-artifact" "$pipeline_artifact")
  fi

  node "$framework_root/scripts/check-chat-eval.mjs" "${args[@]}"
  local exit_code=$?

  if [[ "$inject_leak" != "1" && -f "$artifact" ]]; then
    local staged_artifact="$framework_root/target/appfw/wave4/ch6-chat-eval.json"
    mkdir -p "$(dirname "$staged_artifact")"
    cp "$artifact" "$staged_artifact" || true
  fi
  if [[ "$pipeline_plan" == "1" && "$inject_leak" != "1" && -f "$pipeline_artifact" ]]; then
    local staged_pipeline_artifact="$framework_root/target/appfw/wave4/ch6-chat-eval-promptfoo-plan.json"
    mkdir -p "$(dirname "$staged_pipeline_artifact")"
    cp "$pipeline_artifact" "$staged_pipeline_artifact" || true
  fi

  return "$exit_code"
}

fork_check() {
  local json="$1"
  shift || true

  local plan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      *)
        echo "fork-check: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "fork-check" --plan
    return
  fi

  python3 - "$repo_root" "$json" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
json_mode = sys.argv[2] == "1"
report_path = repo_root / "target/appfw/fork-check.json"

def rel(path: Path) -> str:
    return str(path.relative_to(repo_root))

def read_text(path: Path) -> str | None:
    if not path.exists():
        return None
    return path.read_text(encoding="utf-8")

def sha256(text: str | None) -> str | None:
    if text is None:
        return None
    return "sha256:" + hashlib.sha256(text.replace("\r\n", "\n").encode("utf-8")).hexdigest()

canonical = {
    "pds_tokens_css": repo_root / "appfw_ui/pds_health/tokens/pdsTokens.css",
    "pds_tokens_ts": repo_root / "appfw_ui/pds_health/tokens/pdsTokens.ts",
    "pds_component_manifest": repo_root / "appfw_ui/pds_health/reference/catalog.json",
}

local_token_copies = [
    {
        "id": "admin-ui-css-token-copy",
        "owner": "admin-ui",
        "canonical": "pds_tokens_css",
        "path": repo_root / "admin_ui/src/design/pdsTokens.css",
    },
    {
        "id": "admin-ui-ts-token-copy",
        "owner": "admin-ui",
        "canonical": "pds_tokens_ts",
        "path": repo_root / "admin_ui/src/design/pdsTokens.ts",
    },
    {
        "id": "crm-frontend-css-token-copy",
        "owner": "crm-reference-product",
        "canonical": "pds_tokens_css",
        "path": repo_root / "examples/products/crm/frontend/src/design/pdsTokens.css",
    },
]

source_consumers = [
    {
        "id": "crm-pds-component-import",
        "path": repo_root / "examples/products/crm/frontend/src/components/ui.tsx",
        "pattern": "@appfw/pds-health-components",
        "expected": "shared component package import",
    },
    {
        "id": "crm-pds-style-import",
        "path": repo_root / "examples/products/crm/frontend/src/styles/index.css",
        "pattern": "@appfw/pds-health/tokens/pdsTokens.css",
        "expected": "canonical PDS token stylesheet import",
    },
    {
        "id": "admin-pds-token-import",
        "path": repo_root / "admin_ui/src/main.tsx",
        "pattern": "@appfw/pds-health/tokens/pdsTokens.css",
        "expected": "canonical PDS token stylesheet import",
    },
    {
        "id": "admin-pds-component-import",
        "path": repo_root / "admin_ui/src/components/RecordsPanel.tsx",
        "pattern": "@appfw/pds-health-components",
        "expected": "shared component package import",
    },
    {
        "id": "catalog-token-source-import",
        "path": repo_root / "appfw_ui/pds_health/catalog-app/src/main.tsx",
        "pattern": "@appfw/pds-health/tokens/pdsTokens.css",
        "expected": "direct canonical token import",
    },
]

generated_contract_checks = [
    {
        "id": "crm-ui-contract-token-path",
        "path": repo_root / "examples/products/crm/frontend/src/generated/appfw-ui-contract.ts",
        "pattern": '"tokenCssPath": "@appfw/pds-health/tokens/pdsTokens.css"',
        "status": "canonical-source-token-path",
        "missing_status": "missing-canonical-source-token-path",
    },
    {
        "id": "generator-default-token-path",
        "path": repo_root / "app_gen/src/frontend.rs",
        "pattern": 'token_css_path: "@appfw/pds-health/tokens/pdsTokens.css"',
        "status": "canonical-source-token-path",
        "missing_status": "missing-canonical-source-token-path",
    },
]

token_results = []
transitional = []
local_copy_violations = []
for consumer in local_token_copies:
    exists = consumer["path"].exists()
    if exists:
        local_copy_violations.append(f"{consumer['id']} local token copy must be removed: {rel(consumer['path'])}")
    token_results.append(
        {
            "id": consumer["id"],
            "owner": consumer["owner"],
            "path": rel(consumer["path"]),
            "canonical": rel(canonical[consumer["canonical"]]),
            "mode": "forbidden-local-copy",
            "present": exists,
            "ok": not exists,
        }
    )

source_results = []
missing_source_consumption = []
for check in source_consumers:
    text = read_text(check["path"])
    present = text is not None and check["pattern"] in text
    if not present:
        missing_source_consumption.append(f"{check['id']} missing {check['pattern']} in {rel(check['path'])}")
    source_results.append(
        {
            "id": check["id"],
            "path": rel(check["path"]),
            "expected": check["expected"],
            "pattern": check["pattern"],
            "ok": present,
        }
    )

contract_results = []
for check in generated_contract_checks:
    text = read_text(check["path"])
    present = text is not None and check["pattern"] in text
    if not present:
        missing_source_consumption.append(f"{check['id']} missing {check['pattern']} in {rel(check['path'])}")
    contract_results.append(
        {
            "id": check["id"],
            "path": rel(check["path"]),
            "pattern": check["pattern"],
            "present": present,
            "status": check["status"] if present else check["missing_status"],
        }
    )

blocking_violations = local_copy_violations + missing_source_consumption
gate_ready = not blocking_violations and not transitional
report = {
    "command": "fork-check",
    "lane": "U6",
    "ok": not blocking_violations,
    "generated_at": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/fork-check.json",
    "gate": {
        "enforced": True,
        "ready_to_enforce": gate_ready,
        "reason": "U6 fork rejection is enforced for known PDS token copies and missing canonical source consumption",
    },
    "canonical_assets": {key: rel(value) for key, value in canonical.items()},
    "token_consumers": token_results,
    "source_consumers": source_results,
    "generated_contracts": contract_results,
    "transitional_items": transitional,
    "blocking_violations": blocking_violations,
    "next_steps": [
        "Extend fork-check to product workspaces as packaged PDS token/component consumption becomes the downstream default.",
        "Add named, expiring risk-acceptance support only if a product has a justified temporary fork.",
    ],
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"fork-check ok: {report['artifact']}")
    if transitional:
        print(f"transitional items: {len(transitional)}")
else:
    print("fork-check failed")
    for violation in blocking_violations:
        print(f"- {violation}")

sys.exit(0 if report["ok"] else 1)
PY
}

composition_check() {
  local json="$1"
  shift || true

  local plan=0
  local enforce=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --enforce)
        enforce=1
        ;;
      *)
        echo "composition-check: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "composition-check" --plan
    return
  fi

  python3 - "$repo_root" "$app_root" "$json" "$enforce" <<'PY'
import datetime
import json
import re
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
app_root = Path(sys.argv[2])
json_mode = sys.argv[3] == "1"
enforce_mode = sys.argv[4] == "1"
report_path = repo_root / "target/appfw/composition-check.json"
enforced_report_path = repo_root / "target/appfw/composition-check-enforced.json"

def rel(path):
    path = Path(path)
    for root in (repo_root, app_root):
        try:
            return str(path.relative_to(root))
        except ValueError:
            pass
    return str(path)

def read_text(path):
    if not path.exists():
        return None
    return path.read_text(encoding="utf-8")

def read_json(path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def load_yaml(path):
    try:
        import yaml
    except Exception:
        return None, "PyYAML is not available and the topology report is missing"
    try:
        return yaml.safe_load(path.read_text(encoding="utf-8")) or {}, None
    except Exception as exc:
        return None, f"failed to parse {rel(path)}: {exc}"

def parse_manifest_scalar(value):
    value = value.strip()
    if "#" in value:
        value = value.split("#", 1)[0].strip()
    if (value.startswith("'") and value.endswith("'")) or (value.startswith('"') and value.endswith('"')):
        value = value[1:-1]
    lowered = value.lower()
    if lowered == "true":
        return True
    if lowered == "false":
        return False
    if lowered in {"null", "~"}:
        return None
    return value

def load_manifest_ui_fallback(path):
    text = read_text(path)
    if text is None:
        return {}
    ui = {}
    in_ui = False
    current_surface = None
    for raw_line in text.splitlines():
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        indent = len(raw_line) - len(raw_line.lstrip(" "))
        stripped = raw_line.strip()
        if indent == 0:
            in_ui = stripped == "ui:"
            current_surface = None
            continue
        if not in_ui:
            continue
        if indent <= 0:
            break
        if indent == 2 and stripped.endswith(":"):
            current_surface = stripped[:-1].strip()
            ui[current_surface] = {}
            continue
        if indent == 4 and current_surface and ":" in stripped:
            key, value = stripped.split(":", 1)
            ui[current_surface][key.strip()] = parse_manifest_scalar(value)
    return ui

def load_topology():
    topology_report = app_root / ".appfw/target/appfw/app_topology.json"
    if topology_report.exists():
        try:
            data = json.loads(topology_report.read_text(encoding="utf-8"))
            return data, "app_topology", rel(topology_report), None
        except Exception as exc:
            return None, "app_topology", rel(topology_report), f"failed to parse {rel(topology_report)}: {exc}"

    manifest_path = app_root / ".appfw/manifest.yaml"
    if not manifest_path.exists():
        return None, "missing", rel(manifest_path), f"missing {rel(manifest_path)}"

    manifest, error = load_yaml(manifest_path)
    if error:
        return None, "manifest", rel(manifest_path), error

    topology = manifest.get("topology", {}) if isinstance(manifest, dict) else {}
    data = {
        "version": manifest.get("version", 1) if isinstance(manifest, dict) else 1,
        "manifest_path": str(manifest_path),
        "manifest_present": True,
        "source": "manifest",
        "app": manifest.get("app", {}) if isinstance(manifest, dict) else {},
        "topology": {
            "data_sources": topology.get("data_sources", []) or [],
            "schemas": topology.get("schemas", []) or [],
            "ingress": topology.get("ingress", []) or [],
        },
    }
    return data, "manifest", rel(manifest_path), None

def load_manifest():
    manifest_path = app_root / ".appfw/manifest.yaml"
    if not manifest_path.exists():
        return {}, rel(manifest_path), f"missing {rel(manifest_path)}"
    manifest, error = load_yaml(manifest_path)
    if error:
        ui = load_manifest_ui_fallback(manifest_path)
        if ui:
            return {"ui": ui}, rel(manifest_path), None
        return {}, rel(manifest_path), error
    if not isinstance(manifest, dict):
        return {}, rel(manifest_path), f"{rel(manifest_path)} is not a YAML mapping"
    return manifest, rel(manifest_path), None

def parse_cargo_features(path):
    text = read_text(path) or ""
    features = {}
    try:
        import tomllib
        parsed = tomllib.loads(text)
        for key, value in (parsed.get("features") or {}).items():
            features[key] = list(value or [])
        return features
    except Exception:
        pass

    current = None
    collecting = False
    buffer = []
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            current = "features" if line == "[features]" else None
            continue
        if current != "features":
            continue
        if collecting:
            buffer.append(line)
            if "]" in line:
                value = " ".join(buffer)
                features[name] = re.findall(r'"([^"]+)"', value)
                collecting = False
            continue
        match = re.match(r'([A-Za-z0-9_-]+)\s*=\s*(.*)', line)
        if not match:
            continue
        name, value = match.groups()
        if "[" in value and "]" not in value:
            collecting = True
            buffer = [value]
            continue
        features[name] = re.findall(r'"([^"]+)"', value)
    return features

def provider_dependencies(path):
    text = read_text(path) or ""
    providers = {
        "appfw_provider_postgres": "PostgreSQL",
        "appfw_provider_mongo": "MongoDB",
        "appfw_provider_mssql": "MsSqlServer",
        "appfw_provider_snowflake": "Snowflake",
        "appfw_provider_neo4j": "Neo4j",
    }
    deps = []
    for crate, provider in providers.items():
        match = re.search(rf'^{crate}\s*=\s*(.+)$', text, flags=re.MULTILINE)
        if not match:
            deps.append({"crate": crate, "provider": provider, "present": False, "optional": None})
            continue
        line = match.group(1)
        deps.append(
            {
                "crate": crate,
                "provider": provider,
                "present": True,
                "optional": "optional = true" in line,
            }
        )
    return deps

def config_yaml_enabled(path):
    if not path.exists():
        return None
    parsed, error = load_yaml(path)
    if error or not isinstance(parsed, dict):
        return None
    return bool(parsed.get("enabled", False))

topology, topology_source, topology_path, topology_error = load_topology()
blocking_violations = []
transitional_items = []
warnings = []
if topology_error:
    blocking_violations.append(topology_error)
    topology = {"topology": {"data_sources": [], "schemas": [], "ingress": []}, "app": {}}

manifest, manifest_path, manifest_error = load_manifest()
if manifest_error and not topology_error:
    warnings.append(f"manifest UI posture unavailable: {manifest_error}")

topology_body = topology.get("topology", {}) if isinstance(topology, dict) else {}
data_sources = topology_body.get("data_sources", []) or []
ingress = topology_body.get("ingress", []) or []
providers = sorted({item.get("provider") for item in data_sources if item.get("provider")})
schemas = topology_body.get("schemas", []) or []
schema_data_source_names = {
    item.get("data_source_name")
    for item in schemas
    if item.get("data_source_name")
}
runtime_provider_roles = {"graph-read"}
runtime_providers = sorted(
    {
        item.get("provider")
        for item in data_sources
        if item.get("provider")
        and (
            item.get("name") in schema_data_source_names
            or str(item.get("role", "")).lower() in runtime_provider_roles
        )
    }
)
enabled_ingress = [item for item in ingress if item.get("enabled", True)]

backend_dir = app_root / "backend"
cargo_toml = backend_dir / "Cargo.toml"
features = parse_cargo_features(cargo_toml)
default_features = set(features.get("default", []))
provider_deps = provider_dependencies(cargo_toml)

source_by_kind = {
    "http": backend_dir / "src/routes/mod.rs",
    "mcp": backend_dir / "src/mcp.rs",
    "kafka": backend_dir / "src/kafka.rs",
}
config_by_kind = {
    "kafka": backend_dir / "config/generated/ingress/kafka.yaml",
}

ingress_results = []
for module in ingress:
    kind = str(module.get("kind", "unknown")).lower()
    name = module.get("name") or kind
    enabled = bool(module.get("enabled", True))
    feature_declared = kind in features
    default_feature_enabled = kind in default_features
    source_path = source_by_kind.get(kind)
    source_present = source_path.exists() if source_path else False
    config_path = config_by_kind.get(kind)
    config_present = config_path.exists() if config_path else None
    config_enabled = config_yaml_enabled(config_path) if config_path else None

    result = {
        "name": name,
        "kind": kind,
        "manifest_enabled": enabled,
        "feature_declared": feature_declared,
        "default_feature_enabled": default_feature_enabled,
        "source_present": source_present,
        "source_path": rel(source_path) if source_path else None,
        "config_present": config_present,
        "config_enabled": config_enabled,
        "config_path": rel(config_path) if config_path else None,
    }
    ingress_results.append(result)

    if enabled and not feature_declared:
        blocking_violations.append(f"enabled {kind} ingress `{name}` has no backend Cargo feature")
    if enabled and source_path and not source_present:
        blocking_violations.append(f"enabled {kind} ingress `{name}` has no generated/source module at {rel(source_path)}")
    if enabled and config_path and not config_present:
        blocking_violations.append(f"enabled {kind} ingress `{name}` has no generated config at {rel(config_path)}")
    if enabled and config_enabled is False:
        blocking_violations.append(f"enabled {kind} ingress `{name}` has generated config enabled:false")
    if enabled and feature_declared and not default_feature_enabled:
        transitional_items.append(
            {
                "id": f"{kind}-manifest-enabled-not-default-feature",
                "current": f"{kind} ingress is enabled in topology but not in backend default features",
                "target": "manifest-driven generated build selects matching feature set or records explicit runtime mode evidence",
                "path": rel(cargo_toml),
            }
        )

product_dist_index = backend_dir / "product_dist/index.html"
admin_dist_index = backend_dir / "admin_dist/index.html"
ui_config = manifest.get("ui", {}) if isinstance(manifest, dict) else {}
if not isinstance(ui_config, dict):
    warnings.append("manifest ui section is not a mapping")
    ui_config = {}

def ui_surface(name, *, default_enabled, default_packaging, dist_index):
    raw = ui_config.get(name)
    explicit = isinstance(raw, dict)
    if not explicit and raw is not None:
        warnings.append(f"manifest ui.{name} section is not a mapping")
    raw = raw if explicit else {}
    enabled = bool(raw.get("enabled", default_enabled))
    packaging = str(raw.get("packaging", default_packaging if enabled else "disabled"))
    dist_present = dist_index.exists()
    embedded = enabled and packaging != "disabled" and dist_present
    return {
        "enabled": enabled,
        "packaging": packaging,
        "declared": explicit,
        "dist_present": dist_present,
        "dist_index": rel(dist_index),
        "embedded": embedded,
    }

product_ui = ui_surface(
    "product_spa",
    default_enabled=product_dist_index.exists(),
    default_packaging="backend-product-dist",
    dist_index=product_dist_index,
)
admin_ui = ui_surface(
    "admin_ui",
    default_enabled=True,
    default_packaging="backend-admin-dist",
    dist_index=admin_dist_index,
)
frontend_report = {
    "manifest_path": manifest_path,
    "product_spa": product_ui["dist_present"],
    "product_ui": product_ui,
    "admin_ui_source": (repo_root / "admin_ui").exists(),
    "admin_ui_dist": admin_ui["dist_present"],
    "admin_ui": admin_ui,
    "served_by_backend_image": product_dist_index.exists() and backend_dir.exists(),
}
if product_ui["enabled"] and product_ui["packaging"] != "disabled" and not product_ui["dist_present"]:
    transitional_items.append(
        {
            "id": "product-spa-enabled-not-embedded",
            "current": "manifest enables product SPA packaging but backend/product_dist/index.html is missing",
            "target": "enabled product SPA build emits backend/product_dist/index.html or manifest explicitly disables product SPA",
            "path": product_ui["dist_index"],
        }
    )
if admin_ui["enabled"] and admin_ui["packaging"] != "disabled" and not admin_ui["dist_present"]:
    transitional_items.append(
        {
            "id": "admin-ui-source-not-embedded",
            "current": "manifest enables admin UI packaging but backend/admin_dist/index.html is missing",
            "target": "enabled admin UI build emits backend/admin_dist/index.html or manifest explicitly disables admin UI",
            "path": admin_ui["dist_index"],
        }
    )
if admin_ui["enabled"] and admin_ui["packaging"] == "disabled":
    blocking_violations.append("manifest enables admin UI but sets ui.admin_ui.packaging: disabled")
if product_ui["enabled"] and product_ui["packaging"] == "disabled":
    blocking_violations.append("manifest enables product SPA but sets ui.product_spa.packaging: disabled")

provider_alignment = []
provider_feature_names = {
    "PostgreSQL": "provider-postgres",
    "MongoDB": "provider-mongo",
    "MsSqlServer": "provider-mssql",
    "Snowflake": "provider-snowflake",
    "Neo4j": "provider-neo4j",
}
for dep in provider_deps:
    selected = dep["provider"] in providers
    selected_by_runtime = dep["provider"] in runtime_providers
    feature_name = provider_feature_names.get(dep["provider"])
    feature_declared = feature_name in features if feature_name else False
    feature_values = features.get(feature_name, []) if feature_name else []
    default_feature_enabled = feature_name in default_features if feature_name else False
    feature_links_dependency = f"dep:{dep['crate']}" in feature_values
    provider_alignment.append(
        {
            **dep,
            "selected_by_manifest": selected,
            "selected_by_runtime": selected_by_runtime,
            "feature": feature_name,
            "feature_declared": feature_declared,
            "feature_links_dependency": feature_links_dependency,
            "default_feature_enabled": default_feature_enabled,
        }
    )
    if dep["present"] and not dep["optional"]:
        transitional_items.append(
            {
                "id": f"{dep['provider']}-provider-unconditional-dependency",
                "current": f"{dep['provider']} provider crate is always compiled when backend builds",
                "target": "provider crates become optional and are selected from manifest-driven build features",
                "path": rel(cargo_toml),
            }
        )
    if dep["present"] and dep["optional"] and not feature_declared:
        transitional_items.append(
            {
                "id": f"{dep['provider']}-provider-feature-missing",
                "current": f"{dep['provider']} provider crate is optional but has no explicit provider feature",
                "target": "provider crates are selected through explicit manifest-driven build features",
                "path": rel(cargo_toml),
            }
        )
    if dep["present"] and dep["optional"] and feature_declared and not feature_links_dependency:
        transitional_items.append(
            {
                "id": f"{dep['provider']}-provider-feature-missing-dep-link",
                "current": f"{feature_name} does not link dep:{dep['crate']}",
                "target": "provider feature uses Cargo dep linkage for its optional provider crate",
                "path": rel(cargo_toml),
            }
        )
    if dep["present"] and selected_by_runtime and feature_declared and not default_feature_enabled:
        transitional_items.append(
            {
                "id": f"{dep['provider']}-runtime-provider-not-default-feature",
                "current": f"{dep['provider']} is used by runtime schema/graph topology but not enabled by the backend default feature set",
                "target": "manifest-driven backend defaults include runtime-selected provider features",
                "path": rel(cargo_toml),
            }
        )
    if dep["present"] and not selected_by_runtime and default_feature_enabled:
        transitional_items.append(
            {
                "id": f"{dep['provider']}-provider-certification-default-feature",
                "current": f"{dep['provider']} is a non-runtime/provider-certification topology entry but is still enabled by the backend default feature set",
                "target": "provider-certification crates compile in provider-test/release-evidence lanes, not in the default product backend feature set",
                "path": rel(cargo_toml),
            }
        )
    if dep["present"] and not selected:
        warnings.append(f"{dep['provider']} provider dependency is present but not selected by manifest topology")

def lock_package_versions(lock_path, package_name):
    versions = []
    if not lock_path.exists():
        return versions
    lock_text = read_text(lock_path) or ""
    packages = re.split(r'\n\[\[package\]\]\n', "\n" + lock_text)
    for package in packages:
        name = re.search(rf'(?:^|\n)name = "{re.escape(package_name)}"\n', package)
        version = re.search(r'(?:^|\n)version = "([^"]+)"\n', package)
        if name and version:
            versions.append(version.group(1))
    return sorted(set(versions))

cargo_lock = repo_root / "Cargo.lock"
async_graphql_versions = lock_package_versions(cargo_lock, "async-graphql")
reqwest_versions = lock_package_versions(cargo_lock, "reqwest")
async_graphql_budget_ok = len(async_graphql_versions) <= 1
reqwest_budget_ok = len(reqwest_versions) <= 2 and not any(version.startswith("0.11.") for version in reqwest_versions)
duplicate_version_budget_ok = async_graphql_budget_ok and reqwest_budget_ok
if not async_graphql_budget_ok:
    transitional_items.append(
        {
            "id": "async-graphql-duplicate-version-budget",
            "current": f"async-graphql versions present: {', '.join(async_graphql_versions)}",
            "target": "one async-graphql version across framework and product workspaces",
            "path": rel(cargo_lock),
        }
    )
if not reqwest_budget_ok:
    transitional_items.append(
        {
            "id": "reqwest-duplicate-version-budget",
            "current": f"reqwest versions present: {', '.join(reqwest_versions)}",
            "target": "no legacy reqwest 0.11 direct clients; keep only the current runtime HTTP client and unavoidable OTLP transitive major until OTLP converges",
            "path": rel(cargo_lock),
        }
    )

runtime_ingress = sorted({str(item.get("kind", "unknown")).lower() for item in enabled_ingress})
provider_feature_gate_ready = all(
    item["optional"] and item["feature_declared"] and item["feature_links_dependency"]
    for item in provider_alignment
    if item["present"]
)
provider_default_selection_ready = all(
    item["default_feature_enabled"] == item["selected_by_runtime"]
    for item in provider_alignment
    if item["present"] and item["feature_declared"]
)
feature_check_path = repo_root / "target/appfw/feature-check.json"
feature_check_report = read_json(feature_check_path)
feature_check_results = {}
if isinstance(feature_check_report, dict):
    for item in feature_check_report.get("checks", []) or []:
        if isinstance(item, dict) and item.get("name"):
            feature_check_results[item["name"]] = item.get("ok") is True
expected_feature_checks = [
    "runtime core without ingress defaults",
    "runtime core excludes HTTP ingress dependency graph",
    "runtime http ingress feature",
    "runtime mcp ingress feature",
    "runtime kafka ingress feature",
    "runtime mcp excludes HTTP ingress dependency graph",
    "runtime kafka excludes HTTP ingress dependency graph",
    "product backend core without ingress defaults",
    "product backend core excludes HTTP ingress dependency graph",
    "product backend http feature",
    "product backend mcp feature",
    "product backend kafka feature",
    "product backend mcp excludes HTTP ingress dependency graph",
    "product backend kafka excludes HTTP ingress dependency graph",
]
expected_feature_checks.extend(
    f"product backend {item['feature']} provider feature"
    for item in provider_alignment
    if item.get("present") and item.get("feature_declared") and item.get("feature")
)
missing_feature_checks = [
    name for name in expected_feature_checks if feature_check_results.get(name) is not True
]
feature_check_compile_evidence_ready = (
    isinstance(feature_check_report, dict)
    and feature_check_report.get("ok") is True
    and feature_check_report.get("plan_only") is not True
    and not missing_feature_checks
)
gate_ready_to_enforce = (
    not blocking_violations
    and not transitional_items
    and feature_check_compile_evidence_ready
)
enforcement_blockers = []
if blocking_violations:
    enforcement_blockers.extend(blocking_violations)
if transitional_items:
    enforcement_blockers.append(
        f"{len(transitional_items)} transitional composition item(s) remain"
    )
if not feature_check_compile_evidence_ready:
    if not isinstance(feature_check_report, dict):
        enforcement_blockers.append("target/appfw/feature-check.json is missing or unreadable")
    elif feature_check_report.get("plan_only") is True:
        enforcement_blockers.append("target/appfw/feature-check.json contains plan-only evidence")
    elif missing_feature_checks:
        enforcement_blockers.append(
            "feature-check evidence is missing or failed expected subchecks: "
            + ", ".join(missing_feature_checks)
        )
    else:
        enforcement_blockers.append("feature-check evidence is not ok")
report = {
    "command": "composition-check",
    "lane": "U7",
    "ok": not blocking_violations and (not enforce_mode or gate_ready_to_enforce),
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/composition-check.json",
    "enforced_artifact": "target/appfw/composition-check-enforced.json",
    "enforced_artifact_written": enforce_mode,
    "app_root": rel(app_root),
    "topology": {
        "source": topology_source,
        "path": topology_path,
        "app": topology.get("app", {}),
    },
    "gate": {
        "enforced": enforce_mode,
        "ready_to_enforce": gate_ready_to_enforce,
        "reason": "U7 composition gate enforces only when retained feature-check evidence proves every expected runtime, ingress, and provider feature subcheck",
    },
    "runtime_ingress": runtime_ingress,
    "ingress_modules": ingress_results,
    "providers": providers,
    "runtime_providers": runtime_providers,
    "provider_dependencies": provider_alignment,
    "frontend": frontend_report,
    "binary_features": {
        "default_features": sorted(default_features),
        "declared_features": sorted(features.keys()),
        "duplicate_version_budget_ok": duplicate_version_budget_ok,
        "async_graphql_versions": async_graphql_versions,
        "async_graphql_budget_ok": async_graphql_budget_ok,
        "reqwest_versions": reqwest_versions,
        "reqwest_budget_ok": reqwest_budget_ok,
        "provider_feature_gate_ready": provider_feature_gate_ready,
        "provider_default_selection_ready": provider_default_selection_ready,
        "unused_provider_features_disabled": not warnings,
    },
    "compile_evidence": {
        "feature_check": {
            "path": rel(feature_check_path),
            "present": feature_check_path.exists(),
            "ok": isinstance(feature_check_report, dict) and feature_check_report.get("ok") is True,
            "plan_only": isinstance(feature_check_report, dict) and feature_check_report.get("plan_only") is True,
            "retained_compile_evidence_ready": feature_check_compile_evidence_ready,
            "expected_checks": sorted(set(expected_feature_checks)),
            "missing_or_failed_checks": missing_feature_checks,
        }
    },
    "transitional_items": transitional_items,
    "blocking_violations": blocking_violations,
    "enforcement_blockers": enforcement_blockers,
    "warnings": warnings,
    "next_steps": [
        "Keep retained compile evidence current for the default runtime feature set and provider-certification feature sets.",
        "Run release-check to exercise composition-check --enforce after feature-check refreshes retained compile evidence.",
        "Retain compile evidence for each enabled ingress mode, including Kafka worker mode when topology enables Kafka.",
        "Keep product/admin UI packaging posture explicit in .appfw/manifest.yaml and release evidence.",
    ],
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if enforce_mode:
    enforced_report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"composition-check ok: {report['artifact']}")
    if transitional_items:
        print(f"transitional items: {len(transitional_items)}")
else:
    print("composition-check failed")
    for violation in blocking_violations:
        print(f"- {violation}")
    for blocker in enforcement_blockers:
        if blocker not in blocking_violations:
            print(f"- {blocker}")

sys.exit(0 if report["ok"] else 1)
PY
}

governance_check() {
  local json="$1"
  shift || true

  local plan=0
  local enforce=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --enforce)
        enforce=1
        ;;
      *)
        echo "governance-check: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "governance-check" --plan
    return
  fi

  python3 - "$repo_root" "$json" "$enforce" <<'PY'
import datetime
import hashlib
import json
import os
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
json_mode = sys.argv[2] == "1"
enforce = sys.argv[3] == "1"
report_dir = repo_root / "target/appfw"
report_path = report_dir / "governance-check.json"
enforced_report_path = report_dir / "governance-check-enforced.json"

def rel(path):
    path = Path(path)
    try:
        return str(path.relative_to(repo_root))
    except ValueError:
        return str(path)

def sha256(path):
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()

def read_json(path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def evidence(path, *, release_ready_field="release_ready"):
    path = Path(path)
    data = read_json(path)
    item = {
        "path": rel(path),
        "present": path.is_file(),
        "json": data is not None,
        "ok": None,
        "release_ready": None,
    }
    if path.is_file():
        item["sha256"] = sha256(path)
        item["bytes"] = path.stat().st_size
    if isinstance(data, dict):
        if isinstance(data.get("ok"), bool):
            item["ok"] = data.get("ok")
        if isinstance(data.get(release_ready_field), bool):
            item["release_ready"] = data.get(release_ready_field)
        if "command" in data:
            item["command"] = data.get("command")
    return item

security_decision_path = report_dir / "security-assurance-decision.json"
release_identity_path = report_dir / "release-identity.json"
pds_baseline_path = report_dir / "pds-security-baseline.json"
provenance_paths = [
    report_dir / "release-provenance.json",
    report_dir / "release-provenance.intoto.jsonl",
    report_dir / "slsa-provenance.intoto.jsonl",
]
signing_paths = [
    report_dir / "artifact-signing.json",
    report_dir / "cosign-signing.json",
    report_dir / "signing-evidence.json",
]
phi_pipeline_evidence_env = "APPFW_PHI_PIPELINE_EVIDENCE_FILE"
phi_pipeline_evidence_value = os.environ.get(phi_pipeline_evidence_env, "").strip()
phi_pipeline_evidence_path = (
    Path(phi_pipeline_evidence_value)
    if phi_pipeline_evidence_value
    else report_dir / "phi-pipeline-governance-evidence.json"
)
if phi_pipeline_evidence_value and not phi_pipeline_evidence_path.is_absolute():
    phi_pipeline_evidence_path = repo_root / phi_pipeline_evidence_path
expected_phi_pipeline_schema = "appfw.phi-pipeline-governance.v1"
required_phi_pipeline_controls = [
    "classification_propagation",
    "deidentification",
    "environment_movement",
    "rag_curation",
    "retention_policy",
    "deletion_tombstone",
    "redaction",
    "audit_lineage",
]
release_ready_control_statuses = {
    "approved",
    "passed",
    "release-ready",
    "release_ready",
    "risk-accepted",
    "risk_accepted",
}
not_applicable_statuses = {"not-applicable", "not_applicable", "n/a"}

required_sources = [
    repo_root / "scripts/ci/security-assurance-decision.sh",
    repo_root / "scripts/ci/release-evidence-check.sh",
    repo_root / "scripts/ci/phi-log-lint.sh",
    repo_root / "scripts/ci/release-identity-check.sh",
    repo_root / "scripts/appfw",
]
blocking_violations = [
    f"missing required governance source {rel(path)}"
    for path in required_sources
    if not path.exists()
]

security_decision = evidence(security_decision_path)
release_identity = evidence(release_identity_path)
pds_baseline = evidence(pds_baseline_path)
provenance = [evidence(path) for path in provenance_paths]
artifact_signing = [evidence(path) for path in signing_paths]
phi_pipeline_evidence = evidence(phi_pipeline_evidence_path)

decision_json = read_json(security_decision_path) or {}
category_dispositions = {}
if isinstance(decision_json, dict):
    for item in decision_json.get("categories", []) or []:
        if isinstance(item, dict) and item.get("category"):
            evidence_artifacts = item.get("evidence_artifacts")
            evidence = item.get("evidence")
            present_artifacts = item.get("present_artifacts")
            risk_acceptance = item.get("risk_acceptance")
            category_dispositions[str(item["category"])] = {
                "status": item.get("status"),
                "release_ready": item.get("release_ready"),
                "ok": item.get("ok"),
                "disposition": item.get("disposition"),
                "evidence_count": len(evidence or []),
                "evidence_artifact_count": len(evidence_artifacts or []),
                "present_artifact_count": len(present_artifacts or []),
                "risk_accepted": bool(risk_acceptance),
            }

production_attestations_required = bool(
    decision_json.get("production_attestations_required")
) if isinstance(decision_json, dict) else False

def category_release_ready(category):
    item = category_dispositions.get(category, {})
    status = str(item.get("status") or "").strip().lower().replace("_", "-")
    disposition = str(item.get("disposition") or "").strip().lower().replace("_", "-")
    if item.get("release_ready") is True:
        return True
    if status in {"approved", "accepted-risk", "risk-accepted", "release-ready"}:
        return True
    if disposition == "risk-accepted" or item.get("risk_accepted") is True:
        return True
    if (
        production_attestations_required
        and item.get("ok") is True
        and disposition == "evidence"
        and item.get("evidence_artifact_count", 0) > 0
    ):
        return True
    return False

def category_posture(category):
    item = category_dispositions.get(category, {})
    status = item.get("status")
    if status:
        return status
    disposition = item.get("disposition")
    if disposition:
        return disposition
    return "missing-or-not-run"

def as_list(value):
    if value is None:
        return []
    if isinstance(value, list):
        return value
    return [value]

def control_evidence_refs(control):
    refs = []
    if not isinstance(control, dict):
        return refs
    for key in ("evidence", "evidence_refs", "evidence_artifacts", "artifacts"):
        for value in as_list(control.get(key)):
            if isinstance(value, str) and value.strip():
                refs.append(value.strip())
            elif isinstance(value, dict):
                path = value.get("path") or value.get("uri") or value.get("id")
                if isinstance(path, str) and path.strip():
                    refs.append(path.strip())
    return refs

def summarize_phi_pipeline(data):
    if not isinstance(data, dict):
        return {
            "schema_ok": False,
            "release_ready": False,
            "reason": "missing-or-invalid-json",
            "controls": {},
            "missing_controls": required_phi_pipeline_controls,
            "invalid_controls": [],
        }

    schema_version = data.get("schema_version") or data.get("evidence_schema")
    controls = data.get("controls") if isinstance(data.get("controls"), dict) else {}
    missing_controls = []
    invalid_controls = []
    control_summaries = {}

    for control_id in required_phi_pipeline_controls:
        control = controls.get(control_id)
        if not isinstance(control, dict):
            missing_controls.append(control_id)
            control_summaries[control_id] = {
                "present": False,
                "status": "missing",
                "release_ready": False,
                "evidence_count": 0,
            }
            continue

        status = str(control.get("status") or "").strip().lower()
        status = status.replace(" ", "-")
        evidence_refs = control_evidence_refs(control)
        rationale = str(control.get("rationale") or control.get("reason") or "").strip()
        not_applicable = status in not_applicable_statuses
        status_ready = status in release_ready_control_statuses
        control_ready = (
            (status_ready and len(evidence_refs) > 0)
            or (not_applicable and bool(rationale))
        )
        if not control_ready:
            invalid_controls.append(control_id)
        control_summaries[control_id] = {
            "present": True,
            "status": status or "missing",
            "release_ready": control_ready,
            "evidence_count": len(evidence_refs),
            "not_applicable": not_applicable,
        }

    schema_ok = (
        schema_version == expected_phi_pipeline_schema
        and not missing_controls
        and not invalid_controls
    )
    release_ready = (
        schema_ok
        and data.get("ok") is True
        and data.get("release_ready") is True
    )
    reason = "release-ready" if release_ready else "missing-required-release-ready-controls"
    if schema_version != expected_phi_pipeline_schema:
        reason = "schema-version-mismatch"
    return {
        "schema_version": schema_version,
        "expected_schema_version": expected_phi_pipeline_schema,
        "schema_ok": schema_ok,
        "release_ready": release_ready,
        "reason": reason,
        "controls": control_summaries,
        "missing_controls": missing_controls,
        "invalid_controls": invalid_controls,
    }

phi_pipeline_data = read_json(phi_pipeline_evidence_path)
phi_pipeline_summary = summarize_phi_pipeline(phi_pipeline_data)

def release_authority_item(ident, description, paths, command, readiness, accepted_risk_allowed=False, decision_category=None):
    candidate_paths = [Path(path) for path in paths]
    present_paths = [rel(path) for path in candidate_paths if path.is_file()]
    return {
        "id": ident,
        "description": description,
        "paths": [rel(path) for path in candidate_paths],
        "present_paths": present_paths,
        "command": command,
        "release_ready": bool(readiness),
        "accepted_risk_allowed": bool(accepted_risk_allowed),
        "decision_category": decision_category,
    }

release_authority_package = {
    "required_for_release": True,
    "local_evidence_satisfies_release": False,
    "reason": "G4 requires managed release authority evidence; local retained files only prove the evidence paths and fail-closed checks.",
    "items": [
        release_authority_item(
            "security-assurance-decision",
            "Formal DAST, SAST, ASVS, provenance, signing, and accepted-risk decision bundle.",
            [security_decision_path],
            ["scripts/ci/security-assurance-decision.sh"],
            security_decision.get("release_ready") is True,
        ),
        release_authority_item(
            "release-provenance",
            "Managed CI SLSA/in-toto provenance or formal accepted-risk disposition.",
            provenance_paths,
            ["scripts/ci/security-assurance-decision.sh"],
            category_release_ready("release-provenance"),
            accepted_risk_allowed=True,
            decision_category="release-provenance",
        ),
        release_authority_item(
            "artifact-signing",
            "Cosign or enterprise artifact-signing evidence, or formal accepted-risk disposition.",
            signing_paths,
            ["scripts/ci/security-assurance-decision.sh"],
            category_release_ready("artifact-signing"),
            accepted_risk_allowed=True,
            decision_category="artifact-signing",
        ),
        release_authority_item(
            "release-identity",
            "Release authority approval, licensing, release notes, and distribution evidence.",
            [release_identity_path],
            ["scripts/appfw", "framework", "release-identity", "--json"],
            release_identity.get("release_ready") is True,
        ),
        release_authority_item(
            "phi-pipeline-governance",
            "PHI/data pipeline evidence for classification propagation, de-identification, lower-environment movement, RAG curation, retention, redaction, deletion/tombstones, and audit lineage.",
            [phi_pipeline_evidence_path],
            ["scripts/appfw", "framework", "governance-check", "--json"],
            phi_pipeline_summary.get("release_ready") is True,
        ),
        release_authority_item(
            "pds-baseline",
            "PDS Security Baseline r4.5 release-authority evidence.",
            [pds_baseline_path],
            ["scripts/appfw", "framework", "pds-baseline", "--json"],
            pds_baseline.get("release_ready") is True,
        ),
    ],
}
release_authority_package["missing_or_not_ready"] = [
    item["id"] for item in release_authority_package["items"] if not item["release_ready"]
]

transitional_items = []
def add_if(condition, ident, current, target, path):
    if condition:
        transitional_items.append(
            {
                "id": ident,
                "current": current,
                "target": target,
                "path": rel(path),
            }
        )

add_if(
    not security_decision["present"],
    "security-assurance-decision-missing",
    "security-assurance decision artifact is absent",
    "retain target/appfw/security-assurance-decision.json from release authority evidence or accepted risk",
    security_decision_path,
)
add_if(
    security_decision["present"] and security_decision.get("release_ready") is not True,
    "security-assurance-not-release-ready",
    "security-assurance decision is present but not release_ready:true",
    "provide DAST/SAST/ASVS/provenance/signing evidence or formal accepted risk",
    security_decision_path,
)
add_if(
    not any(item["present"] for item in provenance),
    "release-provenance-missing",
    "release provenance evidence is absent",
    "retain SLSA/in-toto provenance or approved risk acceptance",
    provenance_paths[0],
)
add_if(
    not category_release_ready("release-provenance"),
    "production-provenance-not-release-ready",
    "release provenance category is not production-attested or risk-accepted",
    "retain SLSA/in-toto provenance from managed CI or formal accepted-risk decision",
    security_decision_path,
)
add_if(
    not any(item["present"] for item in artifact_signing),
    "artifact-signing-missing",
    "artifact signing evidence is absent",
    "retain cosign/enterprise signing evidence or approved risk acceptance",
    signing_paths[0],
)
add_if(
    not category_release_ready("artifact-signing"),
    "artifact-signing-not-release-ready",
    "artifact signing category is not enterprise-signed or risk-accepted",
    "retain cosign or enterprise signing evidence from managed CI or formal accepted-risk decision",
    security_decision_path,
)
add_if(
    release_identity["present"] and release_identity.get("release_ready") is not True,
    "release-identity-not-release-ready",
    "release identity evidence is present but not release_ready:true",
    "retain release authority approval, licensing, release notes, and distribution evidence",
    release_identity_path,
)
add_if(
    pds_baseline["present"] and pds_baseline.get("release_ready") is not True,
    "pds-baseline-not-release-ready",
    "PDS baseline evidence is present but not release_ready:true",
    "retain release authority evidence for PDS Security Baseline r4.5 work items",
    pds_baseline_path,
)
add_if(
    not phi_pipeline_evidence["present"],
    "phi-pipeline-evidence-missing",
    "PHI/data pipeline governance evidence is absent",
    "retain target/appfw/phi-pipeline-governance-evidence.json or set APPFW_PHI_PIPELINE_EVIDENCE_FILE to release evidence",
    phi_pipeline_evidence_path,
)
add_if(
    phi_pipeline_evidence["present"] and not phi_pipeline_summary.get("schema_ok"),
    "phi-pipeline-schema-not-release-ready",
    f"PHI/data pipeline evidence is present but schema validation is not release-ready: {phi_pipeline_summary.get('reason')}",
    f"retain {expected_phi_pipeline_schema} with every required control approved/passed and backed by evidence",
    phi_pipeline_evidence_path,
)
add_if(
    phi_pipeline_summary.get("schema_ok") and not phi_pipeline_summary.get("release_ready"),
    "phi-pipeline-not-release-ready",
    "PHI/data pipeline evidence schema is valid but ok/release_ready is not true",
    "retain release-approved PHI/data pipeline evidence or formal accepted risk",
    phi_pipeline_evidence_path,
)

enforcement_violations = []
if enforce:
    enforcement_violations.extend(
        f"{item['id']}: {item['current']} ({item['path']})"
        for item in transitional_items
    )
ready_to_enforce = not blocking_violations and not transitional_items
all_blocking_violations = [*blocking_violations, *enforcement_violations]
report = {
    "command": "governance-check",
    "lane": "G4",
    "ok": not all_blocking_violations,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/governance-check.json",
    "enforced_artifact": "target/appfw/governance-check-enforced.json",
    "gate": {
        "enforced": enforce,
        "ready_to_enforce": ready_to_enforce,
        "reason": "G4 enforcement rejects transitional governance evidence; live release authority, PDS baseline, provenance, and signing evidence remain external release inputs.",
    },
    "phi_pipeline": {
        "schema": expected_phi_pipeline_schema,
        "evidence_env": phi_pipeline_evidence_env,
        "evidence": phi_pipeline_evidence,
        "summary": phi_pipeline_summary,
        "required_controls": required_phi_pipeline_controls,
        "classification_validation_source": rel(repo_root / "app_gen/src/validation.rs"),
        "phi_log_lint_source": rel(repo_root / "scripts/ci/phi-log-lint.sh"),
        "pds_baseline": pds_baseline,
    },
    "provenance": {
        "local_evidence": provenance,
        "production_attestation": category_posture("release-provenance"),
        "release_ready": category_release_ready("release-provenance"),
        "category": category_dispositions.get("release-provenance", {}),
    },
    "artifact_signing": {
        "local_evidence": artifact_signing,
        "production_signing": category_posture("artifact-signing"),
        "release_ready": category_release_ready("artifact-signing"),
        "category": category_dispositions.get("artifact-signing", {}),
    },
    "security_assurance_decision": security_decision,
    "release_identity": release_identity,
    "release_authority_package": release_authority_package,
    "category_dispositions": category_dispositions,
    "required_sources": [{"path": rel(path), "present": path.exists()} for path in required_sources],
    "transitional_items": transitional_items,
    "blocking_violations": all_blocking_violations,
    "enforcement_violations": enforcement_violations,
    "next_steps": [
        "Keep DAST, SAST, ASVS, release-provenance, and artifact-signing decisions in scripts/ci/security-assurance-decision.sh.",
        "Retain PHI/data pipeline governance evidence with classification propagation, de-identification, environment movement, RAG curation, retention, redaction, deletion/tombstones, and audit lineage before claiming S9 release readiness.",
        "Use governance-check --enforce when a lane claims G4 release governance readiness.",
        "Provide SLSA/in-toto provenance and cosign or enterprise signing evidence, or retain formal risk acceptance.",
    ],
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if enforce:
    enforced_report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"governance-check ok: {report['artifact']}")
    if transitional_items:
        print(f"transitional items: {len(transitional_items)}")
else:
    print("governance-check failed")
    for violation in all_blocking_violations:
        print(f"- {violation}")

sys.exit(0 if report["ok"] else 1)
PY
}

aibom_check() {
  local json="$1"
  shift || true

  local plan=0
  local enforce=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --enforce)
        enforce=1
        ;;
      *)
        echo "aibom-check: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "aibom-check" --plan
    return
  fi

  python3 - "$repo_root" "$json" "$enforce" <<'PY'
import datetime
import hashlib
import json
import subprocess
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
json_mode = sys.argv[2] == "1"
enforce = sys.argv[3] == "1"
report_dir = repo_root / "target/appfw"
report_path = report_dir / "aibom-check.json"
enforced_report_path = report_dir / "aibom-check-enforced.json"
attestation_path = report_dir / "aibom-release-attestation.json"

def rel(path):
    path = Path(path)
    try:
        return str(path.relative_to(repo_root))
    except ValueError:
        return str(path)

def sha256(path):
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()

def read_json(path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def git_output(*args):
    try:
        return subprocess.check_output(
            ["git", *args],
            cwd=repo_root,
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return ""

def parse_trailers(message):
    trailers = {}
    for line in message.splitlines():
        if not line.strip() or ":" not in line:
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        if not key or any(char.isspace() for char in key):
            continue
        trailers.setdefault(key, []).append(value.strip())
    return trailers

head_sha = git_output("rev-parse", "HEAD")
head_subject = git_output("log", "-1", "--format=%s")
head_message = git_output("log", "-1", "--format=%B")
trailers = parse_trailers(head_message)
required_trailers = [
    "Agent-Assisted",
    "AIBOM-Artifact",
    "Human-Review",
    "Evidence",
]

required_sources = [
    repo_root / "scripts/appfw",
    repo_root / "scripts/check-doc-examples.sh",
    repo_root / "docs/architecture/concerns/agentic-code-provenance.md",
    repo_root / "docs/start/agent-handoff-backlog.md",
    repo_root / "docs/release/roadmap.md",
]
blocking_violations = [
    f"missing required SEC-AIBOM source {rel(path)}"
    for path in required_sources
    if not path.exists()
]

attestation = read_json(attestation_path)
attestation_item = {
    "path": rel(attestation_path),
    "present": attestation_path.is_file(),
    "json": isinstance(attestation, dict),
    "schema": attestation.get("schema") if isinstance(attestation, dict) else None,
    "ok": attestation.get("ok") if isinstance(attestation, dict) else None,
    "release_ready": attestation.get("release_ready") if isinstance(attestation, dict) else None,
}
if attestation_path.is_file():
    attestation_item["sha256"] = sha256(attestation_path)
    attestation_item["bytes"] = attestation_path.stat().st_size

attestation_checks = []
def check_attestation(check_id, ok, detail):
    attestation_checks.append({"id": check_id, "ok": bool(ok), "detail": detail})

if isinstance(attestation, dict):
    head_matches = attestation.get("head_sha") == head_sha or head_sha in (attestation.get("commit_shas") or [])
    agentic_changes = attestation.get("agentic_changes")
    human_review = attestation.get("human_review") if isinstance(attestation.get("human_review"), dict) else {}
    aibom_artifact = attestation.get("aibom_artifact") if isinstance(attestation.get("aibom_artifact"), dict) else {}
    check_attestation("schema-v1", attestation.get("schema") == "appfw.aibom.release-attestation.v1", attestation.get("schema"))
    check_attestation("ok-release-ready", attestation.get("ok") is True and attestation.get("release_ready") is True, {
        "ok": attestation.get("ok"),
        "release_ready": attestation.get("release_ready"),
    })
    check_attestation("head-sha-bound", head_matches, {"expected": head_sha, "attestation_head_sha": attestation.get("head_sha")})
    check_attestation("agentic-change-inventory", isinstance(agentic_changes, list) and len(agentic_changes) > 0, {
        "count": len(agentic_changes) if isinstance(agentic_changes, list) else 0,
    })
    check_attestation("human-review-approved", human_review.get("approved") is True and bool(human_review.get("reviewer")), human_review)
    check_attestation("trailers-verified", attestation.get("trailers_verified") is True, attestation.get("trailers_verified"))
    check_attestation("aibom-artifact-bound", bool(aibom_artifact.get("path")) and bool(aibom_artifact.get("sha256")), aibom_artifact)
else:
    check_attestation("schema-v1", False, "attestation missing or not JSON")
    check_attestation("ok-release-ready", False, "attestation missing or not JSON")
    check_attestation("head-sha-bound", False, {"expected": head_sha})
    check_attestation("agentic-change-inventory", False, {"count": 0})
    check_attestation("human-review-approved", False, {})
    check_attestation("trailers-verified", False, None)
    check_attestation("aibom-artifact-bound", False, {})

missing_trailers = [trailer for trailer in required_trailers if trailer not in trailers]
attestation_valid = all(item["ok"] for item in attestation_checks)

enforcement_violations = []
if enforce:
    if not attestation_valid:
        enforcement_violations.append("aibom-release-attestation-not-release-ready")
    if missing_trailers:
        enforcement_violations.append(f"missing required PR trailers: {', '.join(missing_trailers)}")

all_blocking_violations = [*blocking_violations, *enforcement_violations]
report = {
    "command": "aibom-check",
    "lane": "SEC-AIBOM",
    "ok": not all_blocking_violations,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/aibom-check.json",
    "enforced_artifact": "target/appfw/aibom-check-enforced.json",
    "gate": {
        "enforced": enforce,
        "ready_to_enforce": attestation_valid and not missing_trailers and not blocking_violations,
        "reason": "SEC-AIBOM enforcement requires release-grade AIBOM attestation and PR-trailer attribution tied to the exact HEAD commit.",
    },
    "git": {
        "head_sha": head_sha,
        "head_subject": head_subject,
    },
    "pr_trailer_contract": {
        "required": required_trailers,
        "present": {key: trailers.get(key, []) for key in required_trailers if key in trailers},
        "missing": missing_trailers,
        "enforced_only": True,
    },
    "attestation_contract": {
        "path": rel(attestation_path),
        "schema": "appfw.aibom.release-attestation.v1",
        "required_fields": [
            "ok:true",
            "release_ready:true",
            "head_sha or commit_shas[] containing HEAD",
            "agentic_changes[]",
            "human_review.approved:true",
            "human_review.reviewer",
            "trailers_verified:true",
            "aibom_artifact.path",
            "aibom_artifact.sha256",
        ],
    },
    "attestation": attestation_item,
    "attestation_checks": attestation_checks,
    "required_sources": [{"path": rel(path), "present": path.exists()} for path in required_sources],
    "blocking_violations": all_blocking_violations,
    "enforcement_violations": enforcement_violations,
    "next_steps": [
        "Select the enterprise AIBOM/provenance toolchain and produce target/appfw/aibom-release-attestation.json in managed CI.",
        "Require PR trailers for agent-assisted changes once the repository host can validate them consistently.",
        "Fold aibom-check --enforce into release authority only after the managed attestation path is producing evidence.",
    ],
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if enforce:
    enforced_report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"aibom-check ok: {report['artifact']}")
    if missing_trailers:
        print(f"missing PR trailers for enforcement: {len(missing_trailers)}")
else:
    print("aibom-check failed")
    for violation in all_blocking_violations:
        print(f"- {violation}")

sys.exit(0 if report["ok"] else 1)
PY
}

prompt_audit_check() {
  local json="$1"
  local enforce=0
  shift || true

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        wave0_reserved_plan "$json" "prompt-audit-check" --plan
        return
        ;;
      --enforce|--strict)
        enforce=1
        ;;
      *)
        echo "prompt-audit-check: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  python3 - "$framework_root" "$json" "$enforce" <<'PY'
import datetime
import hashlib
import json
import os
import re
import sys
from pathlib import Path

framework_root = Path(sys.argv[1]).resolve()
json_mode = sys.argv[2] == "1"
enforce = sys.argv[3] == "1"
report_dir = framework_root / "target/appfw"
report_path = report_dir / "prompt-audit-check.json"
enforced_report_path = report_dir / "prompt-audit-check-enforced.json"
evidence_path = Path(
    os.environ.get(
        "APPFW_PROMPT_AUDIT_EVIDENCE_FILE",
        str(report_dir / "prompt-audit-release-evidence.json"),
    )
).resolve()
expected_schema = "appfw.prompt-audit.release-evidence.v1"

def rel(path):
    path = Path(path)
    try:
        return str(path.resolve().relative_to(framework_root))
    except Exception:
        return str(path)

def sha256(path):
    path = Path(path)
    if not path.is_file():
        return None
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()

def read_json(path):
    path = Path(path)
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def source_contains(path, pattern):
    path = framework_root / path
    if not path.is_file():
        return False
    return re.search(pattern, path.read_text(encoding="utf-8"), re.MULTILINE) is not None

runtime_env_vars = [
    "APP_CHAT_ENABLED",
    "APP_CHAT_REQUIRED_ROLES",
    "APP_CHAT_REQUIRED_SCOPES",
    "APP_CHAT_PROMPT_AUDIT_ENABLED",
    "APP_CHAT_PROMPT_AUDIT_SIEM_ENABLED",
    "APP_CHAT_PROMPT_AUDIT_SINK",
    "APP_CHAT_PROMPT_AUDIT_RETENTION_DAYS",
    "APP_CHAT_KILL_SWITCH_ACTIVE",
]
required_sources = [
    framework_root / "appfw_runtime/src/security.rs",
    framework_root / "appfw_runtime/src/chat.rs",
    framework_root / "docs/runtime/ai-chat-search.md",
    framework_root / "docs/architecture/concerns/threat-model-litmus.md",
    framework_root / "docs/release/roadmap.md",
]
source_contract_checks = [
    {
        "id": "runtime-requires-prompt-audit-enabled",
        "ok": source_contains("appfw_runtime/src/security.rs", r"APP_CHAT_PROMPT_AUDIT_ENABLED=true is required"),
    },
    {
        "id": "runtime-requires-siem-enabled",
        "ok": source_contains("appfw_runtime/src/security.rs", r"APP_CHAT_PROMPT_AUDIT_SIEM_ENABLED=true is required"),
    },
    {
        "id": "runtime-requires-audit-sink",
        "ok": source_contains("appfw_runtime/src/security.rs", r"APP_CHAT_PROMPT_AUDIT_SINK must be configured"),
    },
    {
        "id": "runtime-enforces-retention-floor",
        "ok": source_contains("appfw_runtime/src/security.rs", r"APP_CHAT_PROMPT_AUDIT_RETENTION_DAYS must be at least 90"),
    },
    {
        "id": "runtime-honors-kill-switch",
        "ok": source_contains("appfw_runtime/src/security.rs", r"APP_CHAT_KILL_SWITCH_ACTIVE is set"),
    },
    {
        "id": "chat-route-appends-audit-event",
        "ok": source_contains("appfw_runtime/src/chat.rs", r"append_chat_prompt_audit_event"),
    },
]

evidence = read_json(evidence_path)
evidence_item = {
    "path": rel(evidence_path),
    "present": evidence_path.is_file(),
    "json": isinstance(evidence, dict),
    "schema": evidence.get("schema") if isinstance(evidence, dict) else None,
    "ok": evidence.get("ok") if isinstance(evidence, dict) else None,
    "release_ready": evidence.get("release_ready") if isinstance(evidence, dict) else None,
}
if evidence_path.is_file():
    evidence_item["sha256"] = sha256(evidence_path)
    evidence_item["bytes"] = evidence_path.stat().st_size

required_controls = [
    "prompt_audit_enabled",
    "siem_export_enabled",
    "audit_sink_configured",
    "retention_days_min_90",
    "kill_switch_tested",
    "prompt_redaction_verified",
    "correlation_ids_logged",
    "access_review_sampling",
    "incident_response_runbook",
]
evidence_checks = []
def evidence_check(check_id, ok, detail):
    evidence_checks.append({"id": check_id, "ok": bool(ok), "detail": detail})

if isinstance(evidence, dict):
    controls = evidence.get("controls") if isinstance(evidence.get("controls"), dict) else {}
    evidence_check("schema-v1", evidence.get("schema") == expected_schema, evidence.get("schema"))
    evidence_check("ok-release-ready", evidence.get("ok") is True and evidence.get("release_ready") is True, {
        "ok": evidence.get("ok"),
        "release_ready": evidence.get("release_ready"),
    })
    for control in required_controls:
        evidence_check(f"control-{control}", controls.get(control) is True, controls.get(control))
else:
    evidence_check("schema-v1", False, "evidence missing or not JSON")
    evidence_check("ok-release-ready", False, "evidence missing or not JSON")
    for control in required_controls:
        evidence_check(f"control-{control}", False, "evidence missing or not JSON")

missing_sources = [rel(path) for path in required_sources if not path.exists()]
source_contract_ok = all(item["ok"] for item in source_contract_checks)
evidence_ok = all(item["ok"] for item in evidence_checks)

enforcement_violations = []
if enforce:
    if not evidence_ok:
        enforcement_violations.append("prompt-audit-release-evidence-not-ready")
    if not source_contract_ok:
        enforcement_violations.append("prompt-audit-source-contract-not-ready")
    if missing_sources:
        enforcement_violations.append("prompt-audit-required-source-missing")

blocking_violations = [*missing_sources, *enforcement_violations]
report = {
    "command": "prompt-audit-check",
    "lane": "SEC-PROMPTAUDIT",
    "ok": not blocking_violations,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/prompt-audit-check.json",
    "enforced_artifact": "target/appfw/prompt-audit-check-enforced.json",
    "gate": {
        "enforced": enforce,
        "ready_to_enforce": not missing_sources and source_contract_ok and evidence_ok,
        "reason": "SEC-PROMPTAUDIT enforcement requires managed prompt audit, SIEM/export retention, redaction, access-review, runbook, and kill-switch evidence before real prompts are release-ready.",
    },
    "runtime_env_contract": {
        "source": "appfw_runtime/src/security.rs",
        "variables": runtime_env_vars,
        "chat_default_enabled": False,
        "minimum_retention_days": 90,
        "kill_switch_var": "APP_CHAT_KILL_SWITCH_ACTIVE",
    },
    "source_contract_checks": source_contract_checks,
    "evidence_contract": {
        "path": rel(evidence_path),
        "schema": expected_schema,
        "required_fields": [
            "ok:true",
            "release_ready:true",
            "controls.prompt_audit_enabled:true",
            "controls.siem_export_enabled:true",
            "controls.audit_sink_configured:true",
            "controls.retention_days_min_90:true",
            "controls.kill_switch_tested:true",
            "controls.prompt_redaction_verified:true",
            "controls.correlation_ids_logged:true",
            "controls.access_review_sampling:true",
            "controls.incident_response_runbook:true",
        ],
    },
    "evidence": evidence_item,
    "evidence_checks": evidence_checks,
    "required_sources": [{"path": rel(path), "present": path.exists()} for path in required_sources],
    "blocking_violations": blocking_violations,
    "enforcement_violations": enforcement_violations,
    "next_steps": [
        "Have managed CI or the approved security platform produce target/appfw/prompt-audit-release-evidence.json using schema appfw.prompt-audit.release-evidence.v1.",
        "Keep APP_CHAT_ENABLED=false or non-release until prompt-audit-check --enforce is green for the release environment.",
        "Fold prompt-audit-check evidence into chat release authority before enabling live AI prompts.",
    ],
}

report_dir.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if enforce:
    enforced_report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"prompt-audit-check ok: {report['artifact']}")
else:
    print("prompt-audit-check failed")
    for violation in blocking_violations:
        print(f"- {violation}")

sys.exit(0 if report["ok"] else 1)
PY
}

ai_gateway_decision_check() {
  local json="$1"
  shift || true

  local plan=0
  local enforce=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --enforce)
        enforce=1
        ;;
      *)
        echo "ai-gateway-decision: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "ai-gateway-decision" --plan
    return
  fi

  python3 - "$repo_root" "$json" "$enforce" <<'PY'
import datetime
import hashlib
import json
import os
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
json_mode = sys.argv[2] == "1"
enforce = sys.argv[3] == "1"
report_dir = repo_root / "target/appfw"
report_path = report_dir / "ai-gateway-decision.json"
enforced_report_path = report_dir / "ai-gateway-decision-enforced.json"
evidence_env = "APPFW_AI_GATEWAY_DECISION_EVIDENCE_FILE"
default_evidence_path = report_dir / "ai-gateway-decision-evidence.json"
evidence_path = Path(os.environ.get(evidence_env, str(default_evidence_path))).expanduser()
expected_schema = "appfw.ai-gateway-decision.v1"

def rel(path):
    path = Path(path)
    try:
        return str(path.resolve().relative_to(repo_root))
    except Exception:
        return str(path)

def sha256(path):
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()

def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8")
    except Exception:
        return ""

def read_json(path):
    path = Path(path)
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def source_contains(path, needle):
    return needle in read_text(repo_root / path)

def control_value(value, key):
    if isinstance(value, dict):
        return value.get(key)
    return None

required_sources = [
    repo_root / "docs/runtime/ai-chat-search.md",
    repo_root / "appfw_provider_ai_search/src/gateway.rs",
    repo_root / "appfw_provider_ai_search/docs/vendor-contract.md",
    repo_root / "docs/start/agent-handoff-backlog.md",
]
blocking_violations = [
    f"missing required CH7 source {rel(path)}"
    for path in required_sources
    if not path.exists()
]

source_contract_checks = [
    {
        "id": "gateway-prefers-litellm",
        "ok": source_contains("appfw_provider_ai_search/src/gateway.rs", "litellm"),
        "source": "appfw_provider_ai_search/src/gateway.rs",
    },
    {
        "id": "server-secret-ref-custody",
        "ok": source_contains("appfw_provider_ai_search/src/gateway.rs", "server_secret_ref_only"),
        "source": "appfw_provider_ai_search/src/gateway.rs",
    },
    {
        "id": "prompt-audit-dependency",
        "ok": source_contains("appfw_provider_ai_search/src/gateway.rs", "prompt_audit") or source_contains("appfw_provider_ai_search/src/gateway.rs", "prompt-audit"),
        "source": "appfw_provider_ai_search/src/gateway.rs",
    },
    {
        "id": "policy-re-resolution-boundary",
        "ok": source_contains("appfw_provider_ai_search/src/gateway.rs", "policy") and source_contains("docs/runtime/ai-chat-search.md", "gateway is **custody/transport, never policy authority**"),
        "source": "appfw_provider_ai_search/src/gateway.rs",
    },
    {
        "id": "provider-test-plan-names-ch7",
        "ok": source_contains("scripts/appfw", "approved AI gateway/model-backend decision"),
        "source": "scripts/appfw",
    },
]

evidence = read_json(evidence_path)
evidence_item = {
    "path": rel(evidence_path),
    "present": evidence_path.is_file(),
    "json": isinstance(evidence, dict),
    "schema": evidence.get("schema") if isinstance(evidence, dict) else None,
    "ok": evidence.get("ok") if isinstance(evidence, dict) else None,
    "release_ready": evidence.get("release_ready") if isinstance(evidence, dict) else None,
}
if evidence_path.is_file():
    evidence_item["sha256"] = sha256(evidence_path)
    evidence_item["bytes"] = evidence_path.stat().st_size

required_controls = [
    "gateway_selection",
    "model_backend_selection",
    "litellm_license_review",
    "credential_custody",
    "egress_allowlist",
    "prompt_audit_dependency",
    "policy_authority_boundary",
    "owner_approvals",
]

evidence_checks = []
def add_check(check_id, ok, detail):
    evidence_checks.append({"id": check_id, "ok": bool(ok), "detail": detail})

if isinstance(evidence, dict):
    controls = evidence.get("controls") if isinstance(evidence.get("controls"), dict) else {}
    approvals = evidence.get("approvals") if isinstance(evidence.get("approvals"), list) else []
    add_check("schema-v1", evidence.get("schema") == expected_schema, evidence.get("schema"))
    add_check("ok-release-ready", evidence.get("ok") is True and evidence.get("release_ready") is True, {
        "ok": evidence.get("ok"),
        "release_ready": evidence.get("release_ready"),
    })
    add_check("gateway-selection", control_value(controls, "gateway_selection") == "approved", control_value(controls, "gateway_selection"))
    add_check("model-backend-selection", control_value(controls, "model_backend_selection") == "approved", control_value(controls, "model_backend_selection"))
    add_check("litellm-license-review", control_value(controls, "litellm_license_review") in {"approved", "not_applicable"}, control_value(controls, "litellm_license_review"))
    add_check("credential-custody", control_value(controls, "credential_custody") == "server_secret_ref_only", control_value(controls, "credential_custody"))
    add_check("egress-allowlist", control_value(controls, "egress_allowlist") == "approved", control_value(controls, "egress_allowlist"))
    add_check("prompt-audit-dependency", control_value(controls, "prompt_audit_dependency") == "required_before_live_prompts", control_value(controls, "prompt_audit_dependency"))
    add_check("policy-authority-boundary", control_value(controls, "policy_authority_boundary") == "framework_policy_not_gateway", control_value(controls, "policy_authority_boundary"))
    add_check(
        "owner-approvals",
        len(approvals) >= 2
        and all(
            isinstance(item, dict) and item.get("approver") and item.get("role")
            for item in approvals
        ),
        approvals,
    )
else:
    add_check("schema-v1", False, "evidence missing or not JSON")
    add_check("ok-release-ready", False, "evidence missing or not JSON")
    for control in required_controls:
        add_check(control.replace("_", "-"), False, "evidence missing or not JSON")

source_contract_ready = all(item["ok"] for item in source_contract_checks)
evidence_ready = all(item["ok"] for item in evidence_checks)

enforcement_violations = []
if enforce:
    if not source_contract_ready:
        enforcement_violations.append("ai-gateway-source-contract-not-ready")
    if not evidence_ready:
        enforcement_violations.append("ai-gateway-decision-evidence-not-release-ready")
    if not evidence_path.is_file():
        enforcement_violations.append("ai-gateway-decision-evidence-missing")

all_blocking_violations = [*blocking_violations, *enforcement_violations]
report = {
    "command": "ai-gateway-decision",
    "lane": "CH7",
    "ok": not all_blocking_violations,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/ai-gateway-decision.json",
    "enforced_artifact": "target/appfw/ai-gateway-decision-enforced.json",
    "gate": {
        "enforced": enforce,
        "ready_to_enforce": source_contract_ready and evidence_ready and not blocking_violations,
        "reason": "CH7 enforcement requires stakeholder-approved gateway/model selection, LiteLLM or equivalent license posture, server-side credential custody, egress approval, prompt-audit dependency, policy boundary, and owner approvals before live AI prompts or credentials are release-ready.",
    },
    "decision_contract": {
        "schema": expected_schema,
        "evidence_env": evidence_env,
        "default_evidence_path": rel(default_evidence_path),
        "required_controls": required_controls,
        "allowed_values": {
            "controls.gateway_selection": ["approved"],
            "controls.model_backend_selection": ["approved"],
            "controls.litellm_license_review": ["approved", "not_applicable"],
            "controls.credential_custody": ["server_secret_ref_only"],
            "controls.egress_allowlist": ["approved"],
            "controls.prompt_audit_dependency": ["required_before_live_prompts"],
            "controls.policy_authority_boundary": ["framework_policy_not_gateway"],
        },
    },
    "evidence": evidence_item,
    "evidence_checks": evidence_checks,
    "source_contract_checks": source_contract_checks,
    "required_sources": [{"path": rel(path), "present": path.exists()} for path in required_sources],
    "blocking_violations": all_blocking_violations,
    "enforcement_violations": enforcement_violations,
    "next_steps": [
        "Have product, security, and platform owners retain target/appfw/ai-gateway-decision-evidence.json using schema appfw.ai-gateway-decision.v1.",
        "Verify the LiteLLM core-vs-enterprise license split from the exact adopted release, or mark the selected gateway not_applicable with an equivalent approved gateway.",
        "Keep live prompt execution disabled until ai-gateway-decision --enforce, prompt-audit-check --enforce, and ai-search provider-test/live evidence are all green.",
    ],
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if enforce:
    enforced_report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"ai-gateway-decision ok: {report['artifact']}")
else:
    print("ai-gateway-decision failed")
    for violation in all_blocking_violations:
        print(f"- {violation}")

sys.exit(0 if report["ok"] else 1)
PY
}

wave2_status() {
  local json="$1"
  local enforce=0
  shift || true

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --strict|--enforce)
        enforce=1
        ;;
      *)
        echo "wave2-status: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  python3 - "$framework_root" "$app_root" "$json" "$enforce" <<'PY'
import datetime
import hashlib
import json
import os
import sys
from pathlib import Path

framework_root = Path(sys.argv[1]).resolve()
app_root = Path(sys.argv[2]).resolve()
json_mode = sys.argv[3] == "1"
enforce = sys.argv[4] == "1"
canonical_framework_report_dir = framework_root / "target/appfw"
framework_report_output_dir = canonical_framework_report_dir
framework_report_source_dirs = [canonical_framework_report_dir]
if os.environ.get("APPFW_WAVE2_REPORT_DIR"):
    override_report_dir = Path(os.environ["APPFW_WAVE2_REPORT_DIR"]).resolve()
    framework_report_output_dir = override_report_dir
    framework_report_source_dirs = [override_report_dir, canonical_framework_report_dir]
product_report_dir = app_root / ".appfw/target/appfw"
report_path = framework_report_output_dir / "wave2-readiness.json"

def rel(path, base=framework_root):
    path = Path(path)
    try:
        return str(path.resolve().relative_to(base))
    except Exception:
        return str(path)

def read_json(path):
    path = Path(path)
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def reject_duplicate_json_keys(pairs):
    value = {}
    for key, child in pairs:
        if key in value:
            raise ValueError(f"duplicate object key {key!r}")
        value[key] = child
    return value

def reject_non_json_constant(value):
    raise ValueError(f"non-standard JSON constant {value!r}")

def sha256(path):
    path = Path(path)
    if not path.is_file():
        return None
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()

def artifact(path, *, base=framework_root, strict_unique_keys=False):
    path = Path(path)
    parse_error = None
    if strict_unique_keys and path.is_file():
        try:
            data = json.loads(
                path.read_text(encoding="utf-8"),
                object_pairs_hook=reject_duplicate_json_keys,
                parse_constant=reject_non_json_constant,
            )
        except Exception as exc:
            data = None
            detail = str(exc).splitlines()[0] if str(exc) else type(exc).__name__
            parse_error = f"$: JSON parse failed ({type(exc).__name__}): {detail}"
    else:
        data = read_json(path)
    item = {
        "path": rel(path, base),
        "present": path.is_file(),
        "json": data is not None,
    }
    if strict_unique_keys:
        item["strict_unique_keys"] = True
    if parse_error:
        item["parse_error"] = parse_error
    if path.is_file():
        item["sha256"] = sha256(path)
        item["bytes"] = path.stat().st_size
    if isinstance(data, dict):
        if isinstance(data.get("ok"), bool):
            item["ok"] = data.get("ok")
        if isinstance(data.get("release_ready"), bool):
            item["release_ready"] = data.get("release_ready")
        if data.get("command"):
            item["command"] = data.get("command")
        if data.get("lane"):
            item["lane"] = data.get("lane")
    return item, data

def framework_artifact(filename):
    candidates = [Path(directory) / filename for directory in framework_report_source_dirs]
    for candidate in candidates:
        if candidate.is_file():
            return artifact(candidate)
    return artifact(candidates[0])

def lane(code, name, local_status, release_ready, artifacts, remaining_gates, next_step, details=None):
    return {
        "code": code,
        "name": name,
        "local_status": local_status,
        "local_proven": local_status in {
            "proven",
            "proven-fail-closed",
            "proven-static",
            "proven-local-preflight",
        },
        "release_ready": bool(release_ready),
        "artifacts": artifacts,
        "remaining_external_gates": remaining_gates,
        "next_step": next_step,
        "details": details or {},
    }

def present_json_ok(item):
    return item.get("present") and item.get("json") and item.get("ok") is True

def governed_write_live_findings(value):
    if value is None:
        return ["missing governed-write live evidence"]
    if not isinstance(value, dict):
        return ["governed-write live evidence must be a JSON object"]
    findings = []
    sensitive_key_fragments = [
        "access_token",
        "refresh_token",
        "authorization",
        "bearer_token",
        "client_secret",
        "password",
        "raw_request",
        "raw_response",
        "request_payload",
        "response_payload",
        "tenant_data",
        "phi",
    ]
    allowed_redaction_keys = {"secrets_removed", "raw_payloads_removed", "tenant_data_removed"}
    def redaction_findings(candidate, path="$"):
        redaction_errors = []
        if isinstance(candidate, dict):
            for key, child in candidate.items():
                key_lower = str(key).lower()
                if key_lower not in allowed_redaction_keys and any(fragment in key_lower for fragment in sensitive_key_fragments):
                    redaction_errors.append(f"{path}.{key} must not retain secrets, raw payloads, tenant data, or PHI")
                redaction_errors.extend(redaction_findings(child, f"{path}.{key}"))
        elif isinstance(candidate, list):
            for index, child in enumerate(candidate):
                redaction_errors.extend(redaction_findings(child, f"{path}[{index}]"))
        elif isinstance(candidate, str):
            normalized = candidate.strip().lower()
            if normalized.startswith("bearer ") or normalized.startswith("basic "):
                redaction_errors.append(f"{path} must not retain authorization header values")
        return redaction_errors
    findings.extend(redaction_findings(value))
    external_api_providers = {
        "servicenow",
        "workday",
        "icims",
        "salesforce",
        "anaplan",
        "oracle_financials",
    }
    known_named_mutations_by_provider = {
        "servicenow": {
            "servicenow.create_incident": "servicenow.incident.write",
        }
    }
    provider = value.get("provider")
    for field in ["command", "lane", "ok", "release_ready", "provider", "operation"]:
        if field not in value:
            findings.append(f"missing {field}")
    if value.get("command") != "provider-test":
        findings.append("command must be provider-test")
    if value.get("lane") != "G1":
        findings.append("lane must be G1")
    if value.get("ok") is not True:
        findings.append("ok must be true")
    if value.get("release_ready") is not True:
        findings.append("release_ready must be true")
    if provider not in external_api_providers:
        findings.append("provider must be a supported external API provider")
    if value.get("operation") != "named_mutation":
        findings.append("operation must be named_mutation")

    redaction = value.get("redaction")
    if not isinstance(redaction, dict):
        findings.append("missing object redaction")
    else:
        if redaction.get("secrets_removed") is not True:
            findings.append("redaction.secrets_removed must be true")
        if redaction.get("raw_payloads_removed") is not True:
            findings.append("redaction.raw_payloads_removed must be true")
        if redaction.get("tenant_data_removed") is not True:
            findings.append("redaction.tenant_data_removed must be true")

    delegated = value.get("delegated_actor_context")
    if not isinstance(delegated, dict):
        findings.append("missing object delegated_actor_context")
    else:
        if delegated.get("principal_type") != "user":
            findings.append("delegated_actor_context.principal_type must be user")
        if not delegated.get("tenant"):
            findings.append("delegated_actor_context.tenant is required")
        if not delegated.get("on_behalf_of"):
            findings.append("delegated_actor_context.on_behalf_of is required")

    token_store = value.get("token_store_isolation")
    if not isinstance(token_store, dict):
        findings.append("missing object token_store_isolation")
    else:
        partition_key = token_store.get("partition_key")
        if not isinstance(partition_key, list) or not {"user", "tenant", "provider"}.issubset(set(partition_key)):
            findings.append("token_store_isolation.partition_key must include user, tenant, and provider")
        if token_store.get("revocation_checked") is not True:
            findings.append("token_store_isolation.revocation_checked must be true")

    registry = value.get("mutation_registry")
    if not isinstance(registry, dict):
        findings.append("missing object mutation_registry")
    else:
        registry_name = registry.get("name")
        registry_scope = registry.get("policy_scope")
        if not registry_name:
            findings.append("mutation_registry.name is required")
        if registry.get("mcp_enabled") is not False:
            findings.append("mutation_registry.mcp_enabled must be false until certified")
        if not registry_scope:
            findings.append("mutation_registry.policy_scope is required")
        known_mutations = known_named_mutations_by_provider.get(provider, {})
        if known_mutations and registry_name not in known_mutations:
            findings.append("mutation_registry.name is not in the provider allow-list")
        if registry_name in known_mutations and registry_scope != known_mutations[registry_name]:
            findings.append("mutation_registry.policy_scope does not match provider allow-list")

    request_binding = value.get("request_binding")
    if not isinstance(request_binding, dict):
        findings.append("missing object request_binding")
    else:
        if request_binding.get("provider_owned_request") is not True:
            findings.append("request_binding.provider_owned_request must be true")
        if request_binding.get("raw_url_or_query_from_caller") is not False:
            findings.append("request_binding.raw_url_or_query_from_caller must be false")

    idempotency = value.get("idempotency")
    if not isinstance(idempotency, dict):
        findings.append("missing object idempotency")
    else:
        if not idempotency.get("key_source"):
            findings.append("idempotency.key_source is required")
        if idempotency.get("replay_rejected") is not True:
            findings.append("idempotency.replay_rejected must be true")

    policy = value.get("policy")
    if not isinstance(policy, dict):
        findings.append("missing object policy")
    else:
        if policy.get("scope_enforced") is not True:
            findings.append("policy.scope_enforced must be true")
        if policy.get("decision") != "allow":
            findings.append("policy.decision must be allow")

    audit = value.get("audit")
    if not isinstance(audit, dict):
        findings.append("missing object audit")
    else:
        if audit.get("source") not in {"http", "mcp", "kafka"}:
            findings.append("audit.source must be http, mcp, or kafka")
        for field in ["correlation_id", "provider_request_id", "sink"]:
            if not audit.get(field):
                findings.append(f"audit.{field} is required")

    live_call = value.get("live_provider_call")
    if not isinstance(live_call, dict):
        findings.append("missing object live_provider_call")
    else:
        if live_call.get("executed") is not True:
            findings.append("live_provider_call.executed must be true")
        if live_call.get("non_production") is not True:
            findings.append("live_provider_call.non_production must be true")
        if isinstance(registry, dict) and registry.get("name") and live_call.get("mutation_name") != registry.get("name"):
            findings.append("live_provider_call.mutation_name must match mutation_registry.name")
        if live_call.get("result") != "success":
            findings.append("live_provider_call.result must be success")
        if live_call.get("replay_attempted") is not True:
            findings.append("live_provider_call.replay_attempted must be true")
    return findings

def mobile_release_findings(value):
    if value is None:
        return ["missing mobile-test evidence"]
    if not isinstance(value, dict):
        return ["mobile-test evidence must be a JSON object"]
    findings = []
    if value.get("command") != "mobile-test":
        findings.append("command must be mobile-test")
    if value.get("lane") != "U5":
        findings.append("lane must be U5")
    if value.get("ok") is not True:
        findings.append("ok must be true")
    if value.get("candidate_ready") is not False:
        findings.append("legacy mobile-test must keep candidate_ready false")
    if value.get("release_ready") is not False:
        findings.append("legacy mobile-test is non-authoritative and must keep release_ready false")
    if value.get("release_authority") != "none":
        findings.append("legacy mobile-test must declare release_authority none")
    if value.get("readiness_level") not in {"static-scaffold", "missing-static-scaffold"}:
        findings.append("legacy mobile-test readiness_level must remain scaffold diagnostic only")
    if not isinstance(value.get("legacy_evidence_satisfied"), bool):
        findings.append("legacy_evidence_satisfied must be boolean")

    authority = value.get("readiness_authority")
    if not isinstance(authority, dict):
        findings.append("missing object readiness_authority")
    else:
        if authority.get("authoritative") is not False:
            findings.append("readiness_authority.authoritative must be false")
        if authority.get("status") != "contained-non-authoritative":
            findings.append("readiness_authority.status must be contained-non-authoritative")
        if authority.get("containment_card") != "M0-05":
            findings.append("readiness_authority.containment_card must be M0-05")
        if authority.get("release_authority") != "none":
            findings.append("readiness_authority.release_authority must be none")

    def invalid_readiness_fields(candidate):
        matches = []
        pending = [("$", candidate)]
        while pending:
            current_path, current = pending.pop()
            if isinstance(current, dict):
                for key, child in current.items():
                    child_path = f"{current_path}.{key}"
                    if key in {"candidate_ready", "release_ready"} and child is not False:
                        matches.append(
                            f"{child_path}={json.dumps(child, sort_keys=True)[:160]} "
                            f"({type(child).__name__})"
                        )
                    pending.append((child_path, child))
            elif isinstance(current, list):
                for index, child in enumerate(current):
                    pending.append((f"{current_path}[{index}]", child))
        return sorted(matches)

    invalid_fields = invalid_readiness_fields(value)
    if invalid_fields:
        findings.append(
            "legacy mobile-test candidate_ready/release_ready fields must be exact JSON boolean false; found "
            + "; ".join(invalid_fields)
        )
    return findings

def chat_eval_local_findings(value):
    if value is None:
        return ["missing staged CH6 chat-eval evidence"]
    if not isinstance(value, dict):
        return ["chat-eval evidence must be a JSON object"]
    findings = []
    if value.get("command") != "chat-eval":
        findings.append("command must be chat-eval")
    if value.get("ok") is not True:
        findings.append("ok must be true")
    if value.get("mode") != "local-fixture":
        findings.append("mode must be local-fixture for deterministic local CH6 posture")
    if value.get("release_ready") is not False:
        findings.append("local-fixture chat-eval evidence must keep release_ready:false")
    red_team = value.get("red_team")
    if not isinstance(red_team, dict):
        findings.append("missing object red_team")
    else:
        if red_team.get("ok") is not True:
            findings.append("red_team.ok must be true")
        if red_team.get("leaks_found") != 0:
            findings.append("red_team.leaks_found must be 0")
    checks = value.get("checks")
    if not isinstance(checks, list) or not checks:
        findings.append("checks must be a non-empty list")
    else:
        failing_checks = [
            check.get("name", "<unnamed>")
            for check in checks
            if not isinstance(check, dict) or check.get("ok") is not True
        ]
        if failing_checks:
            findings.append(f"chat-eval checks must all pass: {', '.join(failing_checks)}")
    return findings

def chat_eval_judge_findings(value):
    if value is None:
        return ["missing chat-eval judge/live evidence"]
    if not isinstance(value, dict):
        return ["chat-eval judge/live evidence must be a JSON object"]
    findings = []
    if value.get("schema") != "appfw.chat-eval.judge-evidence.v1":
        findings.append("schema must be appfw.chat-eval.judge-evidence.v1")
    if value.get("ok") is not True:
        findings.append("ok must be true")
    if value.get("release_ready") is not True:
        findings.append("release_ready must be true")
    if value.get("mode") not in {"judge-live", "gateway-live", "managed-ci"}:
        findings.append("mode must be judge-live, gateway-live, or managed-ci")
    if not value.get("gateway"):
        findings.append("gateway is required")
    if not value.get("ai_search_provider"):
        findings.append("ai_search_provider is required")
    red_team = value.get("red_team")
    if not isinstance(red_team, dict):
        findings.append("missing object red_team")
    else:
        if red_team.get("ok") is not True:
            findings.append("red_team.ok must be true")
        if red_team.get("leaks_found") != 0:
            findings.append("red_team.leaks_found must be 0")
    judge = value.get("judge")
    if not isinstance(judge, dict):
        findings.append("missing object judge")
    else:
        if judge.get("enabled") is not True:
            findings.append("judge.enabled must be true")
        if judge.get("passed") is not True:
            findings.append("judge.passed must be true")
    return findings

governed_write_item, governed_write = framework_artifact("governed-write-posture.json")
governed_write_plan_item, governed_write_plan = framework_artifact("governed-write-provider-test.json")
