if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"mobile-test ok: {report['artifact']}")
else:
    print("mobile-test failed")
    for violation in blocking_violations:
        print(f"- {violation}")

