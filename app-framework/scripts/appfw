    "artifact": rel(artifact_path),
    "narrative_artifact": rel(narrative_path),
    "slash_command": (
        "/pds-sra-package --framework"
        if scope == "framework"
        else "/pds-sra-package --product"
    ),
    "project": {
        "name": project_name,
        "business_purpose": metadata["business_purpose"] or None,
        "owner": metadata["owner"] or None,
        "technical_owner": metadata["technical_owner"] or None,
        "sra_record_url": metadata["sra_record_url"] or None,
        "evidence_url": metadata["evidence_url"] or None,
    },
    "sra_ready": sra_ready,
    "readiness_reason": (
        "all required SRA package inputs are present"
        if sra_ready
        else "report generated, but human SRA inputs and/or diagrams remain incomplete"
    ),
    "required_package": required_package,
    "framework_responsibilities": framework_responsibilities,
    "product_app_responsibilities": product_responsibilities,
    "product_app_perspectives": products,
    "evidence_inventory": framework_evidence if scope == "framework" else product_evidence,
    "framework_evidence_inventory": framework_evidence,
    "product_evidence_inventory": product_evidence if scope == "product" else [],
    "missing_human_inputs": missing,
    "regulatory_source_note": (
        "Requirement summary is based on PDS Health SRA notes and local ignored regulatory/ source material. "
        "Do not commit raw regulatory source documents unless a human approves a sanitized strategy."
    ),
    "local_regulatory_source_inventory": regulatory_inventory,
    "next_actions": [
        "Complete the business purpose, business owner, technical owner, and LogicGate/SRA linkage fields.",
        "Prepare the Data Flow Diagram and Infrastructure / Logical Architecture Diagram from the required_package checklist.",
        "For each product app, classify PHI, PII, sensitive data, source systems, destination systems, SaaS vendors, service accounts, secrets, logging, monitoring, and mitigations.",
        "Run product and framework handoff commands after the package reflects the current branch state.",
        "Attach the retained sra-package.json and sra-package.md to the human SRA review package; do not treat either artifact as approval.",
    ],
}


def md_value(value):
    if value is None or value == "":
        return "_Not supplied_"
    return str(value).replace("|", "\\|")


def md_list(items, formatter=lambda item: str(item)):
    if not items:
        return "- _None recorded_"
    return "\n".join(f"- {formatter(item)}" for item in items)


def evidence_line(item):
    status = "present" if item.get("present") else "missing"
    required = " (required)" if item.get("required_for_sra_submission") else ""
    return f"{item.get('label', item.get('path'))}: `{item.get('path')}` - {status}{required}"


def requirement_line(item):
    requires = ", ".join(item.get("requires", []))
    return f"**{item.get('title')}** (`{item.get('id')}`): {requires}"


def product_line(item):
    schemas = ", ".join(schema.get("name", "") for schema in item.get("schemas", []) if schema.get("name")) or "none"
    data_sources = ", ".join(ds.get("name", "") for ds in item.get("data_sources", []) if ds.get("name")) or "none"
    ingress_names = ", ".join(ingress.get("name", "") for ingress in item.get("ingress", []) if ingress.get("name")) or "none"
    classification_count = len(item.get("classification_signals", []))
    return (
        f"**{item.get('display_name') or item.get('name')}** (`{item.get('root')}`): "
        f"schemas={schemas}; data_sources={data_sources}; ingress={ingress_names}; "
        f"classification_signals={classification_count}; manifest_present={item.get('manifest_present')}"
    )


def missing_line(item):
    return f"**{item.get('label')}** (`{item.get('id')}`) - source: {item.get('source')}"


narrative = f"""# PDS Health Security Risk Assessment Package

This report is preparation evidence only. It is not SRA approval, does not replace
LogicGate review, and must not be used to claim production authorization.

## Summary

| Field | Value |
| --- | --- |
| Scope | {md_value(report["scope"])} |
| Perspective | {md_value(report["perspective"])} |
| Generated At | {md_value(report["generated_at"])} |
| Slash Command | `{report["slash_command"]}` |
| JSON Artifact | `{report["artifact"]}` |
| SRA Ready | {str(report["sra_ready"]).lower()} |
| Readiness Reason | {md_value(report["readiness_reason"])} |

## Project

| Field | Value |
| --- | --- |
| Name | {md_value(report["project"]["name"])} |
| Business Purpose | {md_value(report["project"]["business_purpose"])} |
| Owner | {md_value(report["project"]["owner"])} |
| Technical Owner | {md_value(report["project"]["technical_owner"])} |
| SRA Record URL | {md_value(report["project"]["sra_record_url"])} |
| Evidence URL | {md_value(report["project"]["evidence_url"])} |

## Missing Human Inputs

{md_list(report["missing_human_inputs"], missing_line)}

## Required SRA Package Checklist

{md_list(report["required_package"], requirement_line)}

## Framework Responsibilities

{md_list(report["framework_responsibilities"])}

## Product App Responsibilities

{md_list(report["product_app_responsibilities"])}

## Product App Perspectives

{md_list(report["product_app_perspectives"], product_line)}

## Evidence Inventory

{md_list(report["evidence_inventory"], evidence_line)}

## Framework Evidence Inventory

{md_list(report["framework_evidence_inventory"], evidence_line)}

## Product Evidence Inventory

{md_list(report["product_evidence_inventory"], evidence_line)}

## Regulatory Source Note

{report["regulatory_source_note"]}

## Local Regulatory Source Inventory

{md_list(report["local_regulatory_source_inventory"], lambda item: f"{item.get('name')}: `{item.get('path')}`")}

## Next Actions

{md_list(report["next_actions"])}
"""

report_dir.mkdir(parents=True, exist_ok=True)
artifact_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
narrative_path.write_text(narrative.rstrip() + "\n", encoding="utf-8")
if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
else:
    print(f"SRA package report written: {rel(artifact_path)}")
    print(f"SRA package narrative written: {rel(narrative_path)}")
    print(f"Scope: {scope}")
    print(f"Perspective: {report['perspective']}")
    print(f"SRA ready: {str(sra_ready).lower()}")
    print(f"Missing inputs: {len(missing)}")
PY
}

change_impact() {
  local json_mode="$1"
  shift || true

  local base_ref="origin/main"
  local head_ref="HEAD"
  local skipped_checks=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json_mode="1"
        shift
        ;;
      --base)
        base_ref="${2:-}"
        shift 2
        ;;
      --head)
        head_ref="${2:-}"
        shift 2
        ;;
      --skipped-check)
        skipped_checks+=("${2:-}")
        shift 2
        ;;
      --help|-h)
        cat <<'EOF'
Usage: scripts/appfw framework change-impact [--json] [--base <ref>] [--head <ref>] [--skipped-check <reason>]

Writes target/appfw/change-impact.json with report-only branch impact,
human-review, integration-branch, and verification recommendations.
EOF
        return 0
        ;;
      *)
        echo "change-impact: unknown option: $1" >&2
        return 2
        ;;
    esac
  done

  local skipped_checks_env=""
  if [[ ${#skipped_checks[@]} -gt 0 ]]; then
    local item
    for item in "${skipped_checks[@]}"; do
      skipped_checks_env+="${item}"$'\n'
    done
  fi

  local impact_status=0
  APPFW_CHANGE_IMPACT_SKIPPED_CHECKS="$skipped_checks_env" python3 - "$framework_root" "$base_ref" "$head_ref" "$json_mode" <<'PY' || impact_status=$?
import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

repo = Path(sys.argv[1]).resolve()
base_ref = sys.argv[2]
head_ref = sys.argv[3]
json_mode = sys.argv[4] == "1"
report_path = repo / "target/appfw/change-impact.json"


def run_git(args):
    try:
        return subprocess.run(
            ["git", *args],
            cwd=repo,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as exc:
        return subprocess.CompletedProcess(["git", *args], 127, "", str(exc))


git_errors = []


def git_required(args, phase):
    result = run_git(args)
    if result.returncode != 0:
        git_errors.append({
            "phase": phase,
            "args": ["git", *args],
            "exit_code": result.returncode,
            "stdout": result.stdout.strip(),
            "stderr": result.stderr.strip(),
        })
        return ""
    return result.stdout.rstrip("\n")


def write_git_error_report():
    report = {
        "command": "change-impact",
        "ok": False,
        "scope": "framework",
        "mode": "report-only",
        "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
        "artifact": "target/appfw/change-impact.json",
        "base_ref": base_ref,
        "head_ref": head_ref,
        "error": "change-impact could not resolve the requested Git comparison",
        "git_error_count": len(git_errors),
        "git_errors": git_errors,
        "next_steps": [
            "Fetch or correct the requested base and head refs.",
            "Rerun scripts/appfw framework change-impact --json before PR review.",
            "Do not treat this artifact as successful review evidence while ok is false.",
        ],
    }
    report_path.parent.mkdir(parents=True, exist_ok=True)
    report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if not json_mode:
        print(f"change-impact failed: {report['error']}", file=sys.stderr)
        print(f"Artifact: {rel(report_path)}", file=sys.stderr)
    sys.exit(1)


def rel(path):
    try:
        return Path(path).resolve().relative_to(repo).as_posix()
    except Exception:
        return str(path)


def parse_numstat_line(line):
    parts = line.split("\t")
    if len(parts) < 3:
        return None
    added_raw, deleted_raw = parts[0], parts[1]
    path = parts[-1]
    if " => " in path:
        path = path.split(" => ", 1)[1].strip("{}")
    added = 0 if added_raw == "-" else int(added_raw or 0)
    deleted = 0 if deleted_raw == "-" else int(deleted_raw or 0)
    return {"path": path.strip('"'), "added": added, "deleted": deleted}


def parse_status_line(line):
    if not line:
        return None
    status = line[:2].strip() or line[:1].strip()
    path = line[3:].strip().strip('"')
    if " -> " in path:
        path = path.split(" -> ", 1)[1].strip().strip('"')
    return {"status": status, "path": path} if path else None


def classify_path(path):
    buckets = []
    domains = []
    sensitive = []
    p = path

    def add(bucket, domain=None):
        if bucket not in buckets:
            buckets.append(bucket)
        if domain and domain not in domains:
            domains.append(domain)

    if p.startswith("docs/") or p in {"README.md", "AGENTS.md"}:
        add("docs", "docs")
    if p.startswith("agent_skills/"):
        add("agent_skills", "agent_skills")
    if p == "scripts/appfw" or p.startswith("scripts/"):
        add("cli_or_scripts", "cli")
    if p.startswith("scripts/ci/") or p == "bitbucket-pipelines.yml":
        add("ci", "ci")
        sensitive.append("ci_release_gate")
    if p.startswith("app_gen/"):
        add("generator", "generator")
        if "_templates/" in p:
            add("generated_templates", "templates")
            sensitive.append("generated_templates")
    if p.startswith("appfw_runtime/"):
        add("runtime", "runtime")
    if p.startswith("appfw_provider_") or p.startswith("appfw_saas"):
        add("provider", "provider")
    if p.startswith("appfw_ui/") or "/frontend/" in p or p.startswith("frontend/"):
        add("frontend", "frontend")
    if "/mobile/" in p or p.startswith("mobile/"):
        add("mobile", "mobile")
        sensitive.append("mobile_secure_storage")
    if p.startswith("examples/products/"):
        add("product_example", "product")
    if p.startswith(".appfw/") or "/.appfw/" in p:
        add("product_model_or_manifest", "product_model")
    if p.startswith("backend/") or "/backend/" in p:
        add("backend", "backend")
    if p.startswith("database/") or "/database/" in p:
        add("database", "database")
    if p.startswith("api_tests/") or "/api_tests/" in p:
        add("api_tests", "tests")
    if p in {"Cargo.toml", "Cargo.lock"} or p.endswith("/Cargo.toml"):
        add("dependency", "dependency")
    if p.startswith("target/appfw/") or "/target/appfw/" in p:
        add("retained_evidence", "evidence")
    if not buckets:
        add("other", "other")

    sensitive_patterns = {
        "auth_or_policy": r"(auth|policy|rbac|rego|tenant|token|delegated|principal)",
        "release_or_governance": r"(release|governance|aibom|security|slsa|cosign|provenance|signing|baseline)",
        "provider_capability": r"(provider|saas|servicenow|salesforce|workday|anaplan|icims|oracle|snowflake|mssql|postgres|mongo|neo4j)",
        "ai_chat_egress": r"(chat|(^|[^a-z])ai([^a-z]|$)|prompt|llm|search|conversation|ambient)",
        "mcp_kafka_ingress": r"(mcp|kafka|ingress)",
    }
    lowered = p.lower()
    for name, pattern in sensitive_patterns.items():
        if re.search(pattern, lowered) and name not in sensitive:
            sensitive.append(name)
    return buckets, domains, sensitive


branch = git_required(["rev-parse", "--abbrev-ref", "HEAD"], "current-branch") or None
sha = git_required(["rev-parse", "HEAD"], "current-sha") or None
git_required(["rev-parse", "--verify", f"{base_ref}^{{commit}}"], "base-ref")
git_required(["rev-parse", "--verify", f"{head_ref}^{{commit}}"], "head-ref")
if git_errors:
    write_git_error_report()

merge_base = git_required(["merge-base", base_ref, head_ref], "merge-base")
if git_errors:
    write_git_error_report()

numstat_lines = git_required(["diff", "--numstat", merge_base, head_ref], "branch-diff").splitlines()
numstats = [item for item in (parse_numstat_line(line) for line in numstat_lines) if item]
worktree_numstat_lines = git_required(["diff", "--numstat"], "worktree-diff").splitlines()
worktree_numstats = [item for item in (parse_numstat_line(line) for line in worktree_numstat_lines) if item]
index_numstat_lines = git_required(["diff", "--cached", "--numstat"], "index-diff").splitlines()
index_numstats = [item for item in (parse_numstat_line(line) for line in index_numstat_lines) if item]
status_lines = git_required(["status", "--porcelain=v1", "--untracked-files=all"], "status").splitlines()
if git_errors:
    write_git_error_report()
status_items = [item for item in (parse_status_line(line) for line in status_lines) if item]
untracked_paths = [item["path"] for item in status_items if item["status"] == "??"]

changed_by_path = {}
for item in numstats:
    changed_by_path[item["path"]] = {
        "path": item["path"],
        "added": item["added"],
        "deleted": item["deleted"],
        "status": "tracked",
        "uncommitted": False,
    }
for item in worktree_numstats + index_numstats:
    changed_by_path.setdefault(item["path"], {
        "path": item["path"],
        "added": 0,
        "deleted": 0,
        "status": "tracked",
        "uncommitted": True,
    })
    changed_by_path[item["path"]]["added"] += item["added"]
    changed_by_path[item["path"]]["deleted"] += item["deleted"]
    changed_by_path[item["path"]]["uncommitted"] = True
for item in status_items:
    path = item["path"]
    changed_by_path.setdefault(path, {
        "path": path,
        "added": 0,
        "deleted": 0,
        "status": item["status"],
        "uncommitted": True,
    })
    changed_by_path[path]["status"] = item["status"]
    changed_by_path[path]["uncommitted"] = True

files = []
bucket_counts = {}
domain_set = set()
sensitive_flags = set()
generated_like_paths = []
for path, item in sorted(changed_by_path.items()):
    buckets, domains, sensitive = classify_path(path)
    for bucket in buckets:
        bucket_counts[bucket] = bucket_counts.get(bucket, 0) + 1
    domain_set.update(domains)
    sensitive_flags.update(sensitive)
    generated_like = any(token in path for token in [
        "/generated/",
        "backend/src/schemas/",
        "database/_pkg/",
        "api_tests/src/schemas/",
        "product_dist/",
        "admin_dist/",
    ])
    if generated_like:
        generated_like_paths.append(path)
    files.append({**item, "buckets": buckets, "domains": domains, "sensitive_flags": sensitive, "generated_like": generated_like})

non_generated_added = sum(f["added"] for f in files if not f["generated_like"])
non_generated_deleted = sum(f["deleted"] for f in files if not f["generated_like"])
line_delta = non_generated_added + non_generated_deleted
ownership_domain_count = len(domain_set)
changed_file_count = len(files)

class_value = "A"
class_reason = "focused docs/routing scale"
if any(bucket for bucket in bucket_counts if bucket not in {"docs", "agent_skills"}):
    class_value = "B"
    class_reason = "focused source or command behavior"
if changed_file_count > 25 or line_delta > 1200 or ownership_domain_count >= 3:
    class_value = "C"
    class_reason = "broad or cross-domain framework change"
if sensitive_flags:
    class_value = "D"
    class_reason = "sensitive surface touched"

requires_human_review = class_value in {"C", "D"}
requires_integration_branch = changed_file_count > 25 or ownership_domain_count >= 3 or any(
    flag in sensitive_flags
    for flag in ["auth_or_policy", "release_or_governance", "provider_capability", "ai_chat_egress", "mcp_kafka_ingress", "generated_templates"]
)

recommended = ["git diff --check", "rg -n '^(<<<<<<<|=======|>>>>>>>)' ."]
if bucket_counts.get("docs") or bucket_counts.get("cli_or_scripts") or bucket_counts.get("agent_skills"):
    recommended.append("scripts/appfw framework docs-check --changed-only --json")
if bucket_counts.get("generator") or bucket_counts.get("generated_templates"):
    recommended.append("scripts/appfw framework generate --check --json")
if bucket_counts.get("runtime") or bucket_counts.get("provider") or bucket_counts.get("backend"):
    recommended.append("scripts/appfw framework test --fast --json")
if bucket_counts.get("dependency"):
    recommended.append("scripts/appfw framework dependency-check --offline")
if bucket_counts.get("ci") or "release_or_governance" in sensitive_flags:
    recommended.append("scripts/appfw framework governance-check --json")
if "ai_chat_egress" in sensitive_flags:
    recommended.append("scripts/appfw product chat-eval --json")
if "provider_capability" in sensitive_flags:
    recommended.append("scripts/appfw framework provider-graduation --json")
recommended.append("scripts/appfw framework handoff --json")

skipped_checks = [line for line in os.environ.get("APPFW_CHANGE_IMPACT_SKIPPED_CHECKS", "").splitlines() if line.strip()]
report = {
    "command": "change-impact",
    "ok": True,
    "scope": "framework",
    "mode": "report-only",
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": "target/appfw/change-impact.json",
    "base_ref": base_ref,
    "head_ref": head_ref,
    "diff_base_ref": merge_base,
    "branch": branch,
    "sha": sha,
    "summary": {
        "changed_file_count": changed_file_count,
        "untracked_file_count": len(untracked_paths),
        "non_generated_added_lines": non_generated_added,
        "non_generated_deleted_lines": non_generated_deleted,
        "non_generated_line_delta": line_delta,
        "ownership_domain_count": ownership_domain_count,
        "sensitive_surface_count": len(sensitive_flags),
        "generated_like_file_count": len(generated_like_paths),
    },
    "change_class": {
        "class": class_value,
        "reason": class_reason,
        "requires_human_review": requires_human_review,
        "requires_integration_branch": requires_integration_branch,
    },
    "buckets": dict(sorted(bucket_counts.items())),
    "ownership_domains": sorted(domain_set),
    "sensitive_surfaces": sorted(sensitive_flags),
    "generated_like_paths": generated_like_paths,
    "changed_files": files,
    "recommended_verification": recommended,
    "skipped_check_reasons": skipped_checks,
    "human_review_guidance": [
        "Use docs/architecture/concerns/agentic-development-control-system.md for class semantics.",
        "Use docs/start/branch-integration-model.md when requires_integration_branch is true.",
        "Use docs/start/pr-review-agent-harness.md plus framework-pr-review for pre-push review.",
    ],
    "next_steps": [
        "Run the recommended verification commands appropriate to the touched surfaces.",
        "Retain this report in handoff evidence for Class C/D or integration-branch work.",
        "Do not treat this report-only artifact as release approval or live certification.",
    ],
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if not json_mode:
    print(f"change-impact report written: {rel(report_path)}")
    print(f"Class {class_value}: {class_reason}")
    print(f"Human review required: {str(requires_human_review).lower()}")
    print(f"Integration branch required: {str(requires_integration_branch).lower()}")
PY
  delivery_mode_annotate_artifact "$framework_root/target/appfw/change-impact.json" "$json" || return $?
  return $impact_status
}

docs_check() {
  local json="$1"
  shift || true

  require_framework_lockfile

  local args=()
  if [[ "$json" == "1" ]]; then
    args+=("--json")
  fi
  args+=("$@")
  bash "$script_dir/check-doc-examples.sh" "${args[@]}"
}

instruction_route() {
  local namespace="${command_namespace:-flat}"
  local args=("$namespace" instructions "$@")

  if [[ -n "${APPFW_CLI_BIN:-}" ]]; then
    "$APPFW_CLI_BIN" "${args[@]}"
    return
  fi
  if [[ -x "$framework_root/bin/appfw" ]]; then
    "$framework_root/bin/appfw" "${args[@]}"
    return
  fi

  require_framework_lockfile
  (
    cd "$framework_root"
    cargo run --locked --quiet --manifest-path "$appfw_cli_dir/Cargo.toml" -- "${args[@]}"
  )
}

cli_test_json_item() {
  local first="$1"
  local name="$2"
  local ok="$3"
  local exit_code="$4"
  local log_file="$5"
  local command_text="$6"

  if [[ "$first" != "1" ]]; then
    printf ','
  fi
  printf '{"name":'
  json_escape "$name"
  printf ',"ok":%s,"exit_code":%s,"log":' "$ok" "$exit_code"
  json_escape "$log_file"
  printf ',"command":'
  json_escape "$command_text"
  printf '}'
}

cli_test_plan_json() {
  printf '{"command":"cli-test","ok":true,"mode":"plan","scope":"fast CLI contract","artifact":"target/appfw/cli-test.json","checks":['
  printf '{"name":"shell-appfw","command":"bash -n scripts/appfw"},'
  printf '{"name":"shell-doc-examples","command":"bash -n scripts/check-doc-examples.sh"},'
  printf '{"name":"semantic-gates","command":"bash scripts/cli-semantic-gates-test.sh"},'
  printf '{"name":"delivery-mode-controller","command":"python3 scripts/appfw-delivery-mode-test.py"},'
  printf '{"name":"mobile-readiness-containment","command":"python3 scripts/mobile-readiness-containment.test.py"},'
  printf '{"name":"proget-publish","command":"bash scripts/ci/proget-publish.test.sh"},'
  printf '{"name":"appfw-cli-unit","command":"cargo test --locked -p appfw-cli"},'
  printf '{"name":"appfw-introspect-cli-contract","command":"cargo test --locked --bin appfw_introspect cli_contract"}'
  printf ']}\n'
}

