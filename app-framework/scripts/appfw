def json_type_name(value):
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, (int, float)):
        return "number"
    if isinstance(value, str):
        return "string"
    if isinstance(value, list):
        return "array"
    if isinstance(value, dict):
        return "object"
    return type(value).__name__

def invalid_contained_readiness_fields(value):
    matches = []
    pending = [("$", value)]
    while pending:
        current_path, current = pending.pop()
        if isinstance(current, dict):
            for key, child in current.items():
                child_path = f"{current_path}.{key}"
                if key in {"candidate_ready", "release_ready"} and child is not False:
                    rendered = json.dumps(child, sort_keys=True, allow_nan=False)
                    matches.append(
                        {
                            "path": child_path,
                            "observed_type": json_type_name(child),
                            "observed_value": rendered[:160] + ("..." if len(rendered) > 160 else ""),
                        }
                    )
                pending.append((child_path, child))
        elif isinstance(current, list):
            for index, child in enumerate(current):
                pending.append((f"{current_path}[{index}]", child))
    return sorted(matches, key=lambda item: item["path"])

raw_release_source_invalid_readiness = {
    source: (
        invalid_contained_readiness_fields(status["value"])
        if status["parse_valid"] is True
        else []
    )
    for source, status in raw_release_source_statuses.items()
}
raw_release_source_claims = {
    source: [item["path"] for item in invalid_fields]
    for source, invalid_fields in raw_release_source_invalid_readiness.items()
}
for source, status in raw_release_source_statuses.items():
    if status["present"]:
        add_check(
            f"legacy-source-{source.stem}-strict-json-valid",
            status["parse_valid"] is True,
            source,
            (
                "legacy diagnostic source is strict JSON with unique object keys"
                if status["parse_valid"] is True
                else status["parse_error"]
            ),
        )
    if status["parse_valid"] is True:
        claim_paths = raw_release_source_claims[source]
        invalid_fields = raw_release_source_invalid_readiness[source]
        add_check(
            f"legacy-source-{source.stem}-readiness-contained",
            not claim_paths,
            source,
            (
                "legacy diagnostic source readiness fields are absent or exact JSON boolean false"
                if not claim_paths
                else "legacy diagnostic source readiness fields must be exact JSON boolean false; found "
                + "; ".join(
                    f"{item['path']}={item['observed_value']} ({item['observed_type']})"
                    for item in invalid_fields
                )
            ),
        )

def evidence_passed(value):
    return isinstance(value, dict) and value.get("ok") is True

def command_evidence_findings(value, name, command):
    violations = []
    if not isinstance(value, dict):
        return [f"{name} evidence is missing"]
    if value.get("version") != 1:
        violations.append("version must be 1")
    if value.get("lane") != "U5":
        violations.append("lane must be U5")
    if value.get("name") != name:
        violations.append(f"name must be {name}")
    if value.get("command") != command:
        violations.append("command does not match expected command")
    if value.get("cwd") != rel(mobile_root):
        violations.append(f"cwd must be {rel(mobile_root)}")
    if not isinstance(value.get("generated_at"), str) or not value.get("generated_at").strip():
        violations.append("generated_at must be a non-empty string")
    if "exit_code" not in value:
        violations.append("exit_code is required")
    return violations

def command_evidence_passed(value, name, command):
    violations = command_evidence_findings(value, name, command)
    if isinstance(value, dict):
        if value.get("status") != "passed":
            violations.append("status must be passed")
        if value.get("ok") is not True:
            violations.append("ok must be true")
        if value.get("exit_code") != 0:
            violations.append("exit_code must be 0")
    return not violations, violations

def test_evidence_has_executed_tests(value):
    if not isinstance(value, dict):
        return False, ["test evidence is missing"]
    combined = "\n".join(
        part for part in (value.get("stdout_tail"), value.get("stderr_tail")) if isinstance(part, str)
    )
    violations = []
    if "No tests found" in combined:
        violations.append("test evidence reports zero executed tests")
    return not violations, violations

def expo_doctor_evidence_release_grade(value):
    if not isinstance(value, dict):
        return False, ["expo doctor evidence is missing"]
    combined = "\n".join(
        part for part in (value.get("stdout_tail"), value.get("stderr_tail")) if isinstance(part, str)
    )
    violations = []
    if "network error" in combined.lower() and "ignoring network error" in combined.lower():
        violations.append("expo doctor evidence ignored network errors")
    return not violations, violations

def npm_audit_evidence_valid(value):
    violations = command_evidence_findings(value, "npm-audit-runtime", ["npm", "audit", "--omit=dev", "--json"])
    if not isinstance(value, dict):
        return False, violations
    if value.get("status") not in {"passed", "failed"}:
        violations.append("status must be passed or failed")
    if not isinstance(value.get("ok"), bool):
        violations.append("ok must be boolean")
    if not isinstance(value.get("audit_summary"), dict):
        violations.append("audit_summary must be retained")
    if value.get("ok") is True:
        if value.get("exit_code") != 0:
            violations.append("passing audit evidence must have exit_code 0")
        total = value.get("audit_summary", {}).get("total")
        if total not in {0, None}:
            violations.append("passing audit evidence must not retain vulnerabilities")
    return not violations, violations

def audit_summary_from_evidence(value):
    if not isinstance(value, dict):
        return None
    if isinstance(value.get("audit_summary"), dict):
        return value["audit_summary"]
    metadata = value.get("metadata")
    if isinstance(metadata, dict) and isinstance(metadata.get("vulnerabilities"), dict):
        return metadata["vulnerabilities"]
    return None

def has_template_placeholder(value):
    if not isinstance(value, str):
        return False
    normalized = value.strip().lower()
    return (
        normalized in {"<release-authority>", "<yyyy-mm-dd>", "release-authority", "yyyy-mm-dd", "tbd", "todo"}
        or "<" in normalized
        or ">" in normalized
    )

def valid_runtime_audit_disposition(value):
    if not isinstance(value, dict):
        return False, ["mobile runtime audit disposition is missing"]
    violations = []
    if value.get("version") != 1:
        violations.append("version must be 1")
    if value.get("lane") != "U5":
        violations.append("lane must be U5")
    if value.get("name") != "npm-audit-runtime-disposition":
        violations.append("name must be npm-audit-runtime-disposition")
    if value.get("status") not in {"accepted_risk", "mitigated_by_controls", "upgrade_planned"}:
        violations.append("status must be accepted_risk, mitigated_by_controls, or upgrade_planned")
    if value.get("release_approved") is not True:
        violations.append("release_approved must be true")
    if value.get("template_only") is True:
        violations.append("template_only must be removed or false for approved disposition")
    for field in ("approved_by", "reason", "expires_on"):
        if not isinstance(value.get(field), str) or not value.get(field).strip():
            violations.append(f"{field} must be a non-empty string")
        elif has_template_placeholder(value.get(field)):
            violations.append(f"{field} must not use template placeholder text")
    if isinstance(value.get("reason"), str) and "template only" in value["reason"].lower():
        violations.append("reason must be a release-specific decision, not template instructions")
    if value.get("audit_evidence") != rel(paths["npm_audit_evidence"]):
        violations.append(f"audit_evidence must be {rel(paths['npm_audit_evidence'])}")
    current_audit_summary = audit_summary_from_evidence(npm_audit_evidence)
    if isinstance(current_audit_summary, dict):
        if not isinstance(value.get("current_evidence_summary"), dict):
            violations.append("current_evidence_summary must match retained audit evidence")
        elif value.get("current_evidence_summary") != current_audit_summary:
            violations.append("current_evidence_summary must match retained audit evidence")
    expires_on = value.get("expires_on")
    if isinstance(expires_on, str) and expires_on.strip():
        try:
            expiry_date = datetime.date.fromisoformat(expires_on)
            if expiry_date < datetime.datetime.now(datetime.timezone.utc).date():
                violations.append("expires_on must not be in the past")
        except ValueError:
            violations.append("expires_on must use YYYY-MM-DD")
    return not violations, violations

def valid_device_evidence(value):
    if not isinstance(value, dict):
        return False, ["mobile device evidence is missing"], "missing"
    status = value.get("status")
    if status in {None, "not-run"} and value.get("static_scaffold_only") is True:
        return False, [], "static-placeholder"

    violations = []
    if value.get("version") != 1:
        violations.append("version must be 1")
    if value.get("lane") != "U5":
        violations.append("lane must be U5")
    if value.get("name") != "mobile-device-smoke-evidence":
        violations.append("name must be mobile-device-smoke-evidence")
    if status not in {"passed", "certified"}:
        violations.append("status must be passed or certified")
    if value.get("platform") not in {"ios", "android"}:
        violations.append("platform must be ios or android")
    if value.get("app_profile") not in {"development", "preview", "production"}:
        violations.append("app_profile must be development, preview, or production")
    for field in ("device_target", "tested_at"):
        if not isinstance(value.get(field), str) or not value.get(field).strip():
            violations.append(f"{field} must be a non-empty string")
    command = value.get("command")
    if not isinstance(command, list) or not command or not all(isinstance(item, str) and item.strip() for item in command):
        violations.append("command must be a non-empty string array")
    evidence_artifacts = value.get("evidence_artifacts")
    if (
        not isinstance(evidence_artifacts, list)
        or not evidence_artifacts
        or not all(isinstance(item, str) and item.strip() for item in evidence_artifacts)
    ):
        violations.append("evidence_artifacts must be a non-empty string array")
    if status == "certified":
        if value.get("release_track") not in {"testflight", "play-internal", "play-closed", "production"}:
            violations.append("release_track must be testflight, play-internal, play-closed, or production when status is certified")
        if not isinstance(value.get("build_id"), str) or not value.get("build_id").strip():
            violations.append("build_id must be a non-empty string when status is certified")
    return not violations, violations, "legacy-evidence"

def valid_store_track_evidence(value):
    if not isinstance(value, dict):
        return False, ["mobile store-track evidence is missing"], "missing"
    status = value.get("status")
    if status in {None, "not-run"} and value.get("static_scaffold_only") is True:
        return False, [], "static-placeholder"

    violations = []
    if value.get("version") != 1:
        violations.append("version must be 1")
    if value.get("lane") != "U5":
        violations.append("lane must be U5")
    if value.get("name") != "mobile-store-track-evidence":
        violations.append("name must be mobile-store-track-evidence")
    if status != "certified":
        violations.append("status must be certified")
    if value.get("release_track") not in {"testflight", "play-internal", "play-closed", "production", "enterprise-mdm"}:
        violations.append("release_track must be testflight, play-internal, play-closed, production, or enterprise-mdm")
    if value.get("app_profile") not in {"preview", "production"}:
        violations.append("app_profile must be preview or production")
    for field in ("build_id", "runtime_version", "binary_digest", "signing_identity", "tested_at", "approved_by"):
        if not isinstance(value.get(field), str) or not value.get(field).strip():
            violations.append(f"{field} must be a non-empty string")
    evidence_artifacts = value.get("evidence_artifacts")
    if (
        not isinstance(evidence_artifacts, list)
        or not evidence_artifacts
        or not all(isinstance(item, str) and item.strip() for item in evidence_artifacts)
    ):
        violations.append("evidence_artifacts must be a non-empty string array")
    store_metadata = value.get("store_metadata")
    if not isinstance(store_metadata, dict):
        violations.append("store_metadata must be an object")
    else:
        metadata_status = store_metadata.get("status")
        if metadata_status not in {"approved", "ready-for-review", "submitted"}:
            violations.append("store_metadata.status must be approved, ready-for-review, or submitted")
    return not violations, violations, "legacy-evidence"

