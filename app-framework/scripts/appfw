skills_command() {
  local json="$1"
  shift || true
  local audience=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --audience)
        audience="${2:-}"
        shift || true
        ;;
      --audience=*)
        audience="${1#--audience=}"
        ;;
      *)
        echo "Unknown skills option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done
  if [[ "$json" != "1" ]]; then
    appfw_banner
    echo
  fi
  python3 - "$repo_root" "$json" "$audience" <<'PY'
import json
import re
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
json_mode = sys.argv[2] == "1"
audience_filter = sys.argv[3]
skill_root = repo_root / "agent_skills"


def parse_frontmatter(text):
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}
    values = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        values[key.strip()] = value.strip()
    return values


def rel(path):
    return Path(path).resolve().relative_to(repo_root).as_posix()


skills = []
if skill_root.is_dir():
    for path in sorted(skill_root.glob("*/SKILL.md")):
        text = path.read_text(encoding="utf-8")
        frontmatter = parse_frontmatter(text)
        docs = sorted(set(re.findall(r"`(docs/[^`]+\.md)`", text)))
        proof_commands = sorted(
            set(re.findall(r"(?m)^(scripts/appfw [^\n]+|npm run [^\n]+|cargo [^\n]+)$", text))
        )
        audience = frontmatter.get("audience", "product")
        audiences = [item.strip() for item in audience.split(",") if item.strip()]
        if audience_filter and audience_filter not in audiences and "all" not in audiences:
            continue
        skills.append(
            {
                "name": frontmatter.get("name", path.parent.name),
                "audience": audience,
                "audiences": audiences,
                "phase": frontmatter.get("phase", ""),
                "cli_namespace": frontmatter.get("cli_namespace", audience),
                "description": frontmatter.get("description", ""),
                "path": rel(path),
                "docs": docs,
                "proof_commands": proof_commands,
                "artifacts": [
                    item.strip()
                    for item in frontmatter.get("artifacts", "").split(",")
                    if item.strip()
                ],
            }
        )

payload = {
    "command": "skills",
    "ok": bool(skills),
    "skill_root": rel(skill_root),
    "audience": audience_filter or "all",
    "count": len(skills),
    "skills": skills,
}

if json_mode:
    print(json.dumps(payload, indent=2, sort_keys=True))
elif not skills:
    print("No agent skills found under agent_skills/.")
    sys.exit(1)
else:
    print("Agent skills")
    if audience_filter:
        print(f"Audience: {audience_filter}")
    print()
    for skill in skills:
        phase = f" [{skill['audience']}:{skill['phase']}]" if skill.get("phase") else f" [{skill['audience']}]"
        print(f"  {skill['name']}{phase}")
        print(f"    {skill['description']}")
        print(f"    {skill['path']}")
    print()
    print("Use one skill for the current workflow, then open linked docs only when needed.")

if not skills:
    sys.exit(1)
PY
}

mobile_plan() {
  local json="$1"
  shift || true

  python3 - "$json" "$invocation_cwd" "$app_root" "$framework_root" "$report_root" "$@" <<'PY'
import hashlib
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

json_mode = sys.argv[1] == "1"
invocation_cwd = Path(sys.argv[2]).resolve()
app_root = Path(sys.argv[3]).resolve()
framework_root = Path(sys.argv[4]).resolve()
report_root = Path(sys.argv[5]).resolve()
args = sys.argv[6:]


def utc_now():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def emit_error(message, code=2):
    payload = {
        "command": "mobile-plan",
        "ok": False,
        "error": message,
        "usage": "scripts/appfw product mobile-plan --ui-artifact <mockup.html> --json",
    }
    if json_mode:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"mobile-plan: {message}", file=sys.stderr)
        print(payload["usage"], file=sys.stderr)
    raise SystemExit(code)


ui_artifact = None
target = "react-native-expo"
app_name = None
idx = 0
while idx < len(args):
    arg = args[idx]
    if arg in {"--ui-artifact", "--mockup", "--source"}:
        idx += 1
        if idx >= len(args):
            emit_error(f"{arg} requires a path")
        ui_artifact = args[idx]
    elif arg.startswith("--ui-artifact="):
        ui_artifact = arg.split("=", 1)[1]
    elif arg.startswith("--mockup="):
        ui_artifact = arg.split("=", 1)[1]
    elif arg.startswith("--source="):
        ui_artifact = arg.split("=", 1)[1]
    elif arg == "--target":
        idx += 1
        if idx >= len(args):
            emit_error("--target requires a value")
        target = args[idx]
    elif arg.startswith("--target="):
        target = arg.split("=", 1)[1]
    elif arg == "--app-name":
        idx += 1
        if idx >= len(args):
            emit_error("--app-name requires a value")
        app_name = args[idx]
    elif arg.startswith("--app-name="):
        app_name = arg.split("=", 1)[1]
    elif arg in {"--help", "-h"}:
        if json_mode:
            print(json.dumps({
                "command": "mobile-plan",
                "ok": True,
                "usage": "scripts/appfw product mobile-plan --ui-artifact <mockup.html> [--target react-native-expo] --json",
            }, indent=2, sort_keys=True))
        else:
            print("Usage: scripts/appfw product mobile-plan --ui-artifact <mockup.html> [--target react-native-expo] [--json]")
        raise SystemExit(0)
    else:
        emit_error(f"unknown option: {arg}")
    idx += 1

if not ui_artifact:
    emit_error("--ui-artifact is required")

target_aliases = {
    "react-native": "react-native-expo",
    "react-native-expo": "react-native-expo",
    "rn": "react-native-expo",
    "rn-expo": "react-native-expo",
}
if target not in target_aliases:
    emit_error("--target must be react-native-expo")
target = target_aliases[target]

source_path = Path(ui_artifact)
if not source_path.is_absolute():
    source_path = (invocation_cwd / source_path).resolve()
if not source_path.is_file():
    emit_error(f"HTML mockup not found: {source_path}")

contents = source_path.read_bytes()
sha256 = hashlib.sha256(contents).hexdigest()
suffix = source_path.suffix.lower()
kind = "html_mockup" if suffix in {".html", ".htm"} else "ui_artifact"
report_root.mkdir(parents=True, exist_ok=True)
report_path = report_root / "mobile-rn-conversion-plan.json"

plan = {
    "command": "mobile-plan",
    "ok": True,
    "generated_at": utc_now(),
    "target": target,
    "status": "planning-evidence-only",
    "implementation_state": (
        "React Native + Expo is the mobile direction. Until the mobile generator "
        "target ships, agents create or update product-owned mobile/ source by "
        "following docs/frontend/mobile-react-native.md and retain this plan."
    ),
    "app_root": str(app_root),
    "framework_root": str(framework_root),
    "source": {
        "path": str(source_path),
        "kind": kind,
        "bytes": len(contents),
        "sha256": sha256,
    },
    "app_name": app_name,
    "skill": "product-mobile-react-native",
    "docs": [
        "docs/frontend/mobile-react-native.md",
        "docs/frontend/product-frontend.md",
        "docs/frontend/pds-health-design-system.md",
        "docs/start/generated-ownership.md",
    ],
    "architecture_decisions": [
        "Generate mobile from the shared product experience contract, not from the web layout tree.",
        "Web and mobile share model, API contract, auth, tenant, policy, validation, request IDs, and PDS tokens.",
        "Mobile owns native navigation, screen composition, touch behavior, offline policy, secure storage, push, and app lifecycle.",
        "HTML mockups are visual/workflow evidence; they are not copied verbatim into React Native source.",
        "Generated mobile files must be overwrite-safe and recorded in mobile/.appfw-mobile/ownership.json.",
    ],
    "recommended_output_shape": {
        "root": "mobile/",
        "generated": [
            "mobile/src/generated/appfw-mobile-contract.ts",
            "mobile/src/generated/graphql/",
            "mobile/src/generated/routes.ts",
            "mobile/src/design/pdsNativeTokens.ts",
            "mobile/.appfw-mobile/ownership.json",
            "mobile/.appfw-mobile/scaffold-manifest.json",
        ],
        "human_owned": [
            "mobile/app/",
            "mobile/src/features/",
            "mobile/src/components/",
            "mobile/src/lib/",
            "mobile/src/test/",
        ],
    },
    "conversion_checklist": [
        "Extract screens, tabs/stacks, modal/sheet behavior, key actions, empty/error/loading states, and device assumptions from the HTML mockup.",
        "Map every screen and action to .appfw/model entities, generated operations, product services, or documented integration boundaries.",
        "Choose native navigation by workflow archetype; do not mirror desktop sidebars, dense grids, or split panels by default.",
        "Translate visual styling to PDS native tokens and RN primitives; do not copy CSS, DOM structure, or mock data.",
        "Implement auth, tenant, policy-denied, validation, request/correlation ID, and audit behavior before claiming product readiness.",
        "Gate offline caches, SecureStore use, push notifications, biometrics, and local files with data-classification and retention decisions.",
        "Retain typecheck, Expo config validation, simulator/device smoke, accessibility notes, and build/profile evidence before handoff.",
    ],
    "verification": [
        "scripts/appfw product validate --json",
        "scripts/appfw product generate --check --json",
        "cd mobile && npm run typecheck",
        "cd mobile && npm run test",
        "cd mobile && npx expo-doctor",
        "scripts/appfw product handoff --json",
    ],
    "future_cli_contract": [
        "scripts/appfw product generate --target mobile-rn --json",
        "scripts/appfw product generate --target mobile-rn --check --json",
        "scripts/appfw product mobile-test --json",
    ],
    "report_path": str(report_path),
}

report_path.write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(plan, indent=2, sort_keys=True))
else:
    print("React Native mobile conversion plan")
    print(f"  source   {source_path}")
    print(f"  target   {target}")
    print(f"  report   {report_path}")
    print("  skill    product-mobile-react-native")
    print("  docs     docs/frontend/mobile-react-native.md")
PY
}

mobile_test() {
  local json="$1"
  shift || true

  local plan=0
  local run_local=0
  local device_preflight=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --run-local)
        run_local=1
        ;;
      --device-preflight)
        device_preflight=1
        ;;
      *)
        echo "mobile-test: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "mobile-test" --plan
    return
  fi

  python3 - "$app_root" "$framework_root" "$report_root" "$json" "$run_local" "$device_preflight" <<'PY'
import datetime
import json
import shutil
import subprocess
import sys
import time
from pathlib import Path

app_root = Path(sys.argv[1]).resolve()
framework_root = Path(sys.argv[2]).resolve()
report_root = Path(sys.argv[3]).resolve()
json_mode = sys.argv[4] == "1"
run_local = sys.argv[5] == "1"
device_preflight = sys.argv[6] == "1"

report_path = report_root / "mobile-test.json"
mobile_root = app_root / "mobile"

def rel(path, root=app_root):
    path = Path(path)
    for candidate in (root, framework_root):
        try:
            return str(path.relative_to(candidate))
        except ValueError:
            pass
    return str(path)

def read_json(path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

class DuplicateJsonKeyError(ValueError):
    pass

def reject_duplicate_json_keys(pairs):
    value = {}
    for key, child in pairs:
        if key in value:
            raise DuplicateJsonKeyError(f"duplicate object key {key!r}")
        value[key] = child
    return value

def reject_non_json_constant(value):
    raise ValueError(f"non-standard JSON constant {value!r}")

def read_strict_json_source(path):
    status = {
        "present": path.is_file(),
        "parse_valid": None,
        "parse_error": None,
        "value": None,
    }
    if not status["present"]:
        return status
    try:
        status["value"] = json.loads(
            path.read_text(encoding="utf-8"),
            object_pairs_hook=reject_duplicate_json_keys,
            parse_constant=reject_non_json_constant,
        )
    except Exception as exc:
        detail = str(exc).splitlines()[0] if str(exc) else type(exc).__name__
        status["parse_valid"] = False
        status["parse_error"] = f"$: JSON parse failed ({type(exc).__name__}): {detail}"
        return status
    status["parse_valid"] = True
    return status

mobile_plan = report_root / "mobile-rn-conversion-plan.json"
paths = {
    "mobile_root": mobile_root,
    "package_json": mobile_root / "package.json",
    "app_json": mobile_root / "app.json",
    "eas_json": mobile_root / "eas.json",
    "tsconfig": mobile_root / "tsconfig.json",
    "contract": mobile_root / "src/generated/appfw-mobile-contract.ts",
    "generated_data_client": mobile_root / "src/generated/AppfwMobileDataClient.ts",
    "pds_native_tokens": mobile_root / "src/design/pdsNativeTokens.ts",
    "ownership": mobile_root / ".appfw-mobile/ownership.json",
    "scaffold_manifest": mobile_root / ".appfw-mobile/scaffold-manifest.json",
    "auth_tenant_policy": mobile_root / ".appfw-mobile/auth-tenant-policy.json",
    "offline_posture": mobile_root / ".appfw-mobile/offline-posture.json",
    "device_evidence": mobile_root / ".appfw-mobile/device-evidence.json",
    "store_track_evidence": mobile_root / ".appfw-mobile/store-track-evidence.json",
    "typecheck_evidence": mobile_root / ".appfw-mobile/typecheck-evidence.json",
    "test_evidence": mobile_root / ".appfw-mobile/test-evidence.json",
    "expo_doctor_evidence": mobile_root / ".appfw-mobile/expo-doctor-evidence.json",
    "npm_audit_evidence": mobile_root / ".appfw-mobile/npm-audit-evidence.json",
    "npm_audit_disposition": mobile_root / ".appfw-mobile/npm-audit-disposition.json",
    "npm_audit_disposition_template": mobile_root / ".appfw-mobile/npm-audit-disposition.template.json",
    "device_tooling_evidence": mobile_root / ".appfw-mobile/device-tooling-evidence.json",
}

blocking_violations = []
checks = []

def add_check(name, ok, path, detail, required=True):
    item = {
        "name": name,
        "ok": bool(ok),
        "path": rel(path),
        "required": required,
        "detail": detail,
    }
    checks.append(item)
    if required and not ok:
        blocking_violations.append(f"{name}: {detail} ({rel(path)})")

add_check(
    "mobile-root-present",
    mobile_root.is_dir(),
    mobile_root,
    "product-owned React Native workspace must exist at mobile/",
)
add_check(
    "package-json-present",
    paths["package_json"].is_file(),
    paths["package_json"],
    "mobile package.json must declare Expo/RN scripts and dependencies",
)
add_check(
    "expo-app-config-present",
    paths["app_json"].is_file(),
    paths["app_json"],
    "mobile app.json must define Expo app configuration",
)
add_check(
    "eas-config-present",
    paths["eas_json"].is_file(),
    paths["eas_json"],
    "mobile eas.json must define build/update profiles",
)
add_check(
    "typescript-config-present",
    paths["tsconfig"].is_file(),
    paths["tsconfig"],
    "mobile tsconfig.json must exist for typecheck evidence",
)
add_check(
    "generated-contract-present",
    paths["contract"].is_file(),
    paths["contract"],
    "mobile must consume generated appfw mobile contract from source",
)
add_check(
    "generated-data-client-present",
    paths["generated_data_client"].is_file(),
    paths["generated_data_client"],
    "mobile must retain generated policy-aware GraphQL request binding",
)
add_check(
    "pds-native-token-bridge-present",
    paths["pds_native_tokens"].is_file(),
    paths["pds_native_tokens"],
    "mobile must bridge PDS tokens from the framework source system",
)
add_check(
    "ownership-present",
    paths["ownership"].is_file(),
    paths["ownership"],
    "mobile generated/human ownership metadata must be retained",
)
add_check(
    "scaffold-manifest-present",
    paths["scaffold_manifest"].is_file(),
    paths["scaffold_manifest"],
    "mobile scaffold manifest must record generator/product ownership",
)
add_check(
    "auth-tenant-policy-posture-present",
    paths["auth_tenant_policy"].is_file(),
    paths["auth_tenant_policy"],
    "mobile auth, tenant, policy-denied, request-id, and validation states must be documented",
)
add_check(
    "offline-secure-storage-posture-present",
    paths["offline_posture"].is_file(),
    paths["offline_posture"],
    "mobile offline cache and secure-storage posture must be data-classification aware",
)
add_check(
    "device-evidence-present",
    paths["device_evidence"].is_file(),
    paths["device_evidence"],
    "mobile simulator/device smoke input must be retained for legacy diagnostic completeness",
)
add_check(
    "store-track-evidence-present",
    paths["store_track_evidence"].is_file(),
    paths["store_track_evidence"],
    "mobile TestFlight/Play or enterprise track input must be retained for legacy diagnostic completeness",
)

package_json = read_json(paths["package_json"]) or {}
scripts = package_json.get("scripts", {}) if isinstance(package_json, dict) else {}
dependencies = {}
if isinstance(package_json, dict):
    for section in ("dependencies", "devDependencies"):
        value = package_json.get(section)
        if isinstance(value, dict):
            dependencies.update(value)

if paths["package_json"].is_file():
    for script_name in ("typecheck", "test"):
        add_check(
            f"npm-script-{script_name}",
            script_name in scripts,
            paths["package_json"],
            f"mobile package.json must expose npm run {script_name}",
        )
    add_check(
        "expo-dependency-present",
        "expo" in dependencies,
        paths["package_json"],
        "mobile package.json must declare Expo dependency",
    )
    add_check(
        "react-native-dependency-present",
        "react-native" in dependencies,
        paths["package_json"],
        "mobile package.json must declare React Native dependency",
    )

def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")

def tail(value, limit=8000):
    value = value or ""
    if len(value) <= limit:
        return value
    return value[-limit:]

def scrub_local_paths(value):
    text = value or ""
    replacements = [
        (str(mobile_root), rel(mobile_root)),
        (str(app_root), "."),
        (str(framework_root), "<framework-root>"),
    ]
    for source, replacement in sorted(replacements, key=lambda item: len(item[0]), reverse=True):
        text = text.replace(source, replacement)
    return text

def write_command_evidence(name, command, evidence_path, status, ok, exit_code=None, stdout="", stderr="", error=None, duration_ms=None):
    evidence = {
        "version": 1,
        "lane": "U5",
        "name": name,
        "command": command,
        "cwd": rel(mobile_root),
        "status": status,
        "ok": bool(ok),
        "exit_code": exit_code,
        "duration_ms": duration_ms,
        "generated_at": utc_now(),
        "stdout_tail": tail(scrub_local_paths(stdout)),
        "stderr_tail": tail(scrub_local_paths(stderr)),
    }
    if error:
        evidence["error"] = scrub_local_paths(error)
    if name == "npm-audit-runtime":
        try:
            audit_payload = json.loads(stdout or "{}")
        except json.JSONDecodeError:
            audit_payload = {}
        parsed_current_audit = False
        if isinstance(audit_payload, dict):
            audit_metadata = audit_payload.get("metadata")
            audit_vulnerabilities = audit_payload.get("vulnerabilities")
            if isinstance(audit_metadata, dict) and isinstance(audit_metadata.get("vulnerabilities"), dict):
                evidence["audit_summary"] = audit_metadata["vulnerabilities"]
                parsed_current_audit = True
            if isinstance(audit_vulnerabilities, dict):
                parsed_current_audit = True
                direct_vulnerabilities = sorted(
                    name
                    for name, finding in audit_vulnerabilities.items()
                    if isinstance(finding, dict) and finding.get("isDirect") is True
                )
                fix_available = []
                semver_major_fixes = []
                unknown_fix_fixes = []
                for package_name, finding in audit_vulnerabilities.items():
                    if not isinstance(finding, dict):
                        continue
                    fix = finding.get("fixAvailable")
                    if not fix:
                        continue
                    fix_available.append(package_name)
                    if isinstance(fix, dict) and fix.get("isSemVerMajor") is True:
                        semver_major_fixes.append(package_name)
                    elif fix is True:
                        unknown_fix_fixes.append(package_name)
                evidence["audit_vulnerability_count"] = len(audit_vulnerabilities)
                evidence["audit_direct_vulnerabilities"] = direct_vulnerabilities
                evidence["audit_fix_available_count"] = len(fix_available)
                evidence["audit_remediation"] = {
                    "fix_available_count": len(fix_available),
                    "semver_major_fix_count": len(semver_major_fixes),
                    "unknown_fix_count": len(unknown_fix_fixes),
                    "direct_vulnerabilities": direct_vulnerabilities,
                    "semver_major_fix_packages": sorted(semver_major_fixes),
                    "recommendation": (
                        "plan dependency upgrade and rerun mobile local evidence"
                        if semver_major_fixes
                        else (
                            "run npm audit fix and rerun mobile local evidence"
                            if fix_available
                            else "retain release-approved disposition or investigate advisory chain"
                        )
                    ),
                }
            if not parsed_current_audit:
                previous = read_json(evidence_path)
                if isinstance(previous, dict):
                    preserved_fields = [
                        "audit_summary",
                        "audit_vulnerability_count",
                        "audit_direct_vulnerabilities",
                        "audit_fix_available_count",
                        "audit_remediation",
                    ]
                    preserved = []
                    for field in preserved_fields:
                        if field in previous:
                            evidence[field] = previous[field]
                            preserved.append(field)
                    if preserved:
                        evidence["audit_unavailable"] = {
                            "used_previous_audit_details": True,
                            "preserved_fields": preserved,
                            "reason": audit_payload.get("message")
                            if isinstance(audit_payload.get("message"), str)
                            else "npm audit did not return vulnerability metadata",
                        }
                if "audit_unavailable" not in evidence:
                    evidence["audit_unavailable"] = {
                        "used_previous_audit_details": False,
                        "reason": audit_payload.get("message")
                        if isinstance(audit_payload.get("message"), str)
                        else "npm audit did not return vulnerability metadata",
                    }
    evidence_path.parent.mkdir(parents=True, exist_ok=True)
    evidence_path.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return evidence

def run_local_command(name, command, evidence_path):
    started = time.monotonic()
    try:
        completed = subprocess.run(
            command,
            cwd=mobile_root,
            text=True,
            capture_output=True,
            timeout=180,
        )
        duration_ms = int((time.monotonic() - started) * 1000)
        return write_command_evidence(
            name,
            command,
            evidence_path,
            "passed" if completed.returncode == 0 else "failed",
            completed.returncode == 0,
            exit_code=completed.returncode,
            stdout=completed.stdout,
            stderr=completed.stderr,
            duration_ms=duration_ms,
        )
    except FileNotFoundError as exc:
        duration_ms = int((time.monotonic() - started) * 1000)
        return write_command_evidence(
            name,
            command,
            evidence_path,
            "failed",
            False,
            error=str(exc),
            duration_ms=duration_ms,
        )
    except subprocess.TimeoutExpired as exc:
        duration_ms = int((time.monotonic() - started) * 1000)
        return write_command_evidence(
            name,
            command,
            evidence_path,
            "timeout",
            False,
            stdout=exc.stdout or "",
            stderr=exc.stderr or "",
            error="command exceeded 180 second mobile-test timeout",
            duration_ms=duration_ms,
        )

def tool_evidence(name, binary, detail):
    resolved = shutil.which(binary)
    return {
        "name": name,
        "binary": binary,
        "available": bool(resolved),
        "resolved_path": resolved or None,
        "detail": detail,
    }

def write_device_tooling_evidence():
    tools = [
        tool_evidence("ios-simulator-control", "xcrun", "Needed for xcrun simctl iOS simulator smoke evidence."),
        tool_evidence("ios-build", "xcodebuild", "Needed for native iOS build diagnostics and simulator build smoke."),
        tool_evidence("android-debug-bridge", "adb", "Needed for Android emulator/device connectivity evidence."),
        tool_evidence("android-emulator", "emulator", "Needed to launch Android emulator smoke evidence locally."),
        tool_evidence("eas-cli", "eas", "Needed for EAS build/submit/update release-track evidence."),
        tool_evidence("maestro", "maestro", "Needed for optional mobile E2E flow evidence."),
    ]
    readiness = {
        "ios_simulator_preflight_ready": all(
            tool["available"] for tool in tools if tool["name"] in {"ios-simulator-control", "ios-build"}
        ),
        "android_emulator_preflight_ready": all(
            tool["available"] for tool in tools if tool["name"] in {"android-debug-bridge", "android-emulator"}
        ),
        "store_track_preflight_ready": any(
            tool["available"] for tool in tools if tool["name"] == "eas-cli"
        ),
        "e2e_preflight_ready": any(
            tool["available"] for tool in tools if tool["name"] == "maestro"
        ),
    }
    evidence = {
        "version": 1,
        "lane": "U5",
        "name": "device-tooling-preflight",
        "command": ["scripts/appfw", "product", "mobile-test", "--device-preflight", "--json"],
        "cwd": rel(app_root),
        "status": "collected",
        "ok": True,
        "release_ready": False,
        "generated_at": utc_now(),
        "tools": tools,
        "readiness": readiness,
        "missing": [tool["name"] for tool in tools if not tool["available"]],
        "next_steps": [
            "Run simulator/emulator navigation smoke tests and retain device-evidence.json as Prototype diagnostics for the future candidate checker.",
            "Use EAS/TestFlight/Play inputs only as diagnostics until the source-bound candidate checker exists.",
            "Use Maestro or equivalent mobile E2E evidence for governed-write confirmation flows when enabled.",
        ],
    }
    existing = read_json(paths["device_tooling_evidence"]) or {}
    comparable_existing = {key: value for key, value in existing.items() if key != "generated_at"} if isinstance(existing, dict) else {}
    comparable_evidence = {key: value for key, value in evidence.items() if key != "generated_at"}
    if comparable_existing == comparable_evidence and isinstance(existing.get("generated_at"), str):
        evidence["generated_at"] = existing["generated_at"]
    paths["device_tooling_evidence"].parent.mkdir(parents=True, exist_ok=True)
    rendered = json.dumps(evidence, indent=2, sort_keys=True) + "\n"
    if not paths["device_tooling_evidence"].is_file() or paths["device_tooling_evidence"].read_text(encoding="utf-8") != rendered:
        paths["device_tooling_evidence"].write_text(rendered, encoding="utf-8")
    return evidence

