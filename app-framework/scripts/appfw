json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

json_result() {
  local command="$1"
  local ok="$2"
  local detail="${3:-}"

  printf '{"command":'
  json_escape "$command"
  printf ',"ok":%s' "$ok"
  if [[ -n "$detail" ]]; then
    printf ',"detail":'
    json_escape "$detail"
  fi
  printf '}\n'
}

detected_context_mode() {
  if [[ "$invocation_cwd" == "$repo_root"* ]]; then
    printf 'framework'
  elif [[ -f "$invocation_cwd/.appfw/manifest.yaml" ]]; then
    printf 'product'
  else
    printf 'product'
  fi
}

context_command() {
  local json="$1"
  local mode recommended_namespace product_manifest product_name
  mode="$(detected_context_mode)"
  recommended_namespace="$mode"
  product_manifest="$app_root/.appfw/manifest.yaml"
  product_name=""
  if [[ -f "$product_manifest" ]]; then
    product_name="$(grep -E '^[[:space:]]*name:' "$product_manifest" | head -1 | sed 's/^[[:space:]]*name:[[:space:]]*//' || true)"
  fi

  if [[ "$json" == "1" ]]; then
    printf '{"command":"context","ok":true'
    printf ',"mode":'
    json_escape "$mode"
    printf ',"recommended_namespace":'
    json_escape "$recommended_namespace"
    printf ',"invocation_cwd":'
    json_escape "$invocation_cwd"
    printf ',"framework_root":'
    json_escape "$framework_root"
    printf ',"app_root":'
    json_escape "$app_root"
    printf ',"default_product":'
    json_escape "$product_name"
    printf ',"product_manifest":'
    json_escape "$product_manifest"
    printf ',"product_manifest_present":'
    if [[ -f "$product_manifest" ]]; then
      printf 'true'
    else
      printf 'false'
    fi
    printf '}\n'
    return 0
  fi

  appfw_banner
  echo
  printf "  mode                  %s\n" "$mode"
  printf "  recommended namespace %s\n" "$recommended_namespace"
  printf "  invocation cwd        %s\n" "$invocation_cwd"
  printf "  framework root        %s\n" "$framework_root"
  printf "  app root              %s\n" "$app_root"
  printf "  product manifest      %s\n" "$product_manifest"
  if [[ -n "$product_name" ]]; then
    printf "  product               %s\n" "$product_name"
  fi
}

