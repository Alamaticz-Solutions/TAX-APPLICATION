    case "$1" in
      --plan)
        plan=1
        ;;
      *)
        echo "$command: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$json" != "1" && "$plan" != "1" ]]; then
    cat <<EOF
$command is reserved by the North-Star Wave 0 CLI contract.

Use:
  scripts/appfw ${command_namespace:-product} $command --plan --json

This command is plan-only until its Roadmap lane implements executable evidence.
EOF
