        "local_proven_count": local_proven_count,
        "local_preflight_lane_count": local_preflight_lane_count,
        "local_preflight_proven_count": local_preflight_proven_count,
        "release_ready_count": release_ready_count,
        "remaining_external_gate_count": len(remaining_external_gates),
        "external_required_artifact_count": external_required_artifact_summary["required_count"],
        "external_required_artifact_present_count": external_required_artifact_summary["present_count"],
