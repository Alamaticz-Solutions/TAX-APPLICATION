    print(f"wave2-status live-gated: {report['artifact']}")
    print(f"total lanes: {len(lanes)}")
    print(f"local evidence: {local_proven_count}/{local_lane_count} local executable lanes proven")
    print(f"local preflight: {local_preflight_proven_count}/{local_preflight_lane_count} branch-level local preflight lanes proven")
    print(f"release-ready lanes: {release_ready_count}/{len(lanes)}")
    print(f"remaining external gates: {len(remaining_external_gates)}")

if enforce and not release_ready:
    sys.exit(1)
PY
}

compat_verify() {
  local json="$1"
  shift || true

  local plan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      *)
        echo "compat-verify: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$plan" == "1" ]]; then
    wave0_reserved_plan "$json" "compat-verify" --plan
    return
  fi

  python3 - "$repo_root" "$app_root" "$framework_root" "$report_root" "$json" <<'PY'
import datetime
import hashlib
import json
import re
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
app_root = Path(sys.argv[2])
framework_root = Path(sys.argv[3])
report_root = Path(sys.argv[4])
json_mode = sys.argv[5] == "1"
report_path = report_root / "compat-verify.json"

APPFW_CRATES = {
    "appfw_runtime",
    "appfw_provider_mongo",
    "appfw_provider_mssql",
    "appfw_provider_neo4j",
    "appfw_provider_postgres",
    "appfw_provider_snowflake",
    "appfw_test",
    "appfw_codegen",
    "appfw_cli",
}

def rel(path, root=app_root):
    path = Path(path)
    for candidate in (root, framework_root, repo_root):
        try:
            return str(path.relative_to(candidate))
        except ValueError:
            pass
    return str(path)

def read_text(path):
    if not path.exists():
        return None
    return path.read_text(encoding="utf-8")

def sha256(path):
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()

def package_version(path):
    text = read_text(path) or ""
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("version") and "=" in line:
            return line.split("=", 1)[1].strip().strip('"')
    return None

def parse_lock(path):
    values = {}
    text = read_text(path)
    if text is None:
        return values
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"')
    return values

def parse_manifest_app(path):
    if not path.exists():
        return {}
    try:
        import yaml
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        return data.get("app", {}) if isinstance(data, dict) else {}
    except Exception:
        return {}

def parse_toml_dependencies(path):
    text = read_text(path) or ""
    deps = []
    try:
        import tomllib
        parsed = tomllib.loads(text)
        for section in ("dependencies", "dev-dependencies", "build-dependencies"):
            for name, spec in (parsed.get(section) or {}).items():
                if name not in APPFW_CRATES and not str(name).startswith("appfw_"):
                    continue
                item = {"crate": name, "section": section, "path": rel(path)}
                if isinstance(spec, dict):
                    item.update(
                        {
                            "version": spec.get("version"),
                            "registry": spec.get("registry"),
                            "source_path": spec.get("path"),
                            "uses_local_path": bool(spec.get("path")),
                        }
                    )
                else:
                    item.update(
                        {
                            "version": str(spec),
                            "registry": None,
                            "source_path": None,
                            "uses_local_path": False,
                        }
                    )
                deps.append(item)
        return deps
    except Exception:
        pass

    current = None
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line.strip("[]")
            current = section if section in {"dependencies", "dev-dependencies", "build-dependencies"} else None
            continue
        if not current or "=" not in line:
            continue
        name, spec = line.split("=", 1)
        name = name.strip()
        if name not in APPFW_CRATES and not name.startswith("appfw_"):
            continue
        deps.append(
            {
                "crate": name,
                "section": current,
                "path": rel(path),
                "version": next(iter(re.findall(r'version\s*=\s*"([^"]+)"', spec)), None),
                "registry": next(iter(re.findall(r'registry\s*=\s*"([^"]+)"', spec)), None),
                "source_path": next(iter(re.findall(r'path\s*=\s*"([^"]+)"', spec)), None),
                "uses_local_path": "path" in spec,
            }
        )
    return deps

manifest_path = app_root / ".appfw/manifest.yaml"
lock_path = app_root / "appfw.lock"
package_manifest = framework_root / "target/appfw/package-manifest.json"
current_versions = {
    "appfw_cli": package_version(framework_root / "appfw_cli/Cargo.toml"),
    "appfw_codegen": package_version(framework_root / "app_gen/Cargo.toml"),
    "appfw_runtime": package_version(framework_root / "appfw_runtime/Cargo.toml"),
}
lock_values = parse_lock(lock_path)
product = parse_manifest_app(manifest_path)

cargo_files = [
    path
    for path in [
        app_root / "backend/Cargo.toml",
        app_root / "api_tests/Cargo.toml",
        app_root / "rego_test/Cargo.toml",
        app_root / "Cargo.toml",
    ]
    if path.exists()
]
dependencies = []
for cargo_file in cargo_files:
    dependencies.extend(parse_toml_dependencies(cargo_file))

frontend_package = app_root / "frontend/package.json"
frontend = {
    "package_json": rel(frontend_package),
    "present": frontend_package.exists(),
    "appfw_pds_dependency": None,
}
if frontend_package.exists():
    try:
        parsed = json.loads(frontend_package.read_text(encoding="utf-8"))
        merged = {}
        for section in ("dependencies", "devDependencies"):
            merged.update(parsed.get(section, {}) or {})
        frontend["appfw_pds_dependency"] = merged.get("@appfw/pds-health-components")
    except Exception:
        frontend["appfw_pds_dependency"] = "unreadable"

package_manifest_present = package_manifest.exists()
package_manifest_json = None
if package_manifest_present:
    try:
        package_manifest_json = json.loads(package_manifest.read_text(encoding="utf-8"))
    except Exception:
        package_manifest_json = None

blocking_violations = []
if not manifest_path.exists():
    blocking_violations.append(f"missing product manifest {rel(manifest_path)}")

transitional_items = []
def transitional(ident, current, target, path):
    transitional_items.append(
        {
            "id": ident,
            "current": current,
            "target": target,
            "path": rel(path),
        }
    )

if not lock_path.exists():
    transitional(
        "appfw-lock-missing",
        "product app has no appfw.lock",
        "write appfw.lock from the approved packaged framework release before product upgrade/release",
        lock_path,
    )
else:
    locked_version = lock_values.get("framework_version")
    if locked_version and current_versions["appfw_codegen"] and locked_version != current_versions["appfw_codegen"]:
        transitional(
            "appfw-lock-version-mismatch",
            f"appfw.lock framework_version={locked_version}, current codegen={current_versions['appfw_codegen']}",
            "refresh appfw.lock only after accepted upgrade evidence",
            lock_path,
        )

path_deps = [dep for dep in dependencies if dep.get("uses_local_path")]
for dep in path_deps:
    dep_id_path = dep["path"].replace("/", "-").replace(".", "_")
    transitional(
        f"{dep['crate']}-{dep_id_path}-local-path-dependency",
        f"{dep['crate']} uses local path {dep.get('source_path')}",
        "product CI should consume approved ProGet package versions except during explicit local framework development",
        app_root / dep["path"],
    )

missing_registry = [
    dep for dep in dependencies if not dep.get("uses_local_path") and not dep.get("registry")
]
for dep in missing_registry:
    transitional(
        f"{dep['crate']}-registry-not-declared",
        f"{dep['crate']} does not declare the pds-app-framework-crates registry",
        "pin App Framework crates to the approved ProGet Cargo registry",
        app_root / dep["path"],
    )

if not package_manifest_present:
    transitional(
        "framework-package-manifest-missing",
        "framework package manifest is not present in target/appfw",
        "retain package-manifest.json from scripts/appfw framework package --json or CI package distribution",
        package_manifest,
    )

if frontend["present"] and not frontend["appfw_pds_dependency"]:
    transitional(
        "frontend-pds-package-not-declared",
        "frontend package does not declare @appfw/pds-health-components",
        "product frontend should consume the approved PDS package or document why the UI is not scaffolded",
        frontend_package,
    )

gating_ok = not blocking_violations
semantic_ok = gating_ok and not transitional_items

report = {
    "command": "compat-verify",
    "lane": "P6",
    "ok": semantic_ok,
    "gating_ok": gating_ok,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": rel(report_path),
    "app_root": rel(app_root, repo_root),
    "product": product,
    "inputs": {
        "manifest": rel(manifest_path),
        "appfw_lock": rel(lock_path),
        "cargo_files": [rel(path) for path in cargo_files],
        "frontend_package": rel(frontend_package),
        "framework_package_manifest": rel(package_manifest, repo_root),
    },
    "gate": {
        "enforced": False,
        "gating_ok": gating_ok,
        "ready_to_enforce": semantic_ok,
        "reason": "report-only first P6 slice; enable rejection after packaged ProGet consumption is the product default",
    },
    "current_framework": current_versions,
    "appfw_lock": {
        "path": rel(lock_path),
        "present": lock_path.exists(),
        "sha256": sha256(lock_path) if lock_path.exists() else None,
        "values": lock_values,
    },
    "framework_package_manifest": {
        "path": rel(package_manifest, repo_root),
        "present": package_manifest_present,
        "sha256": sha256(package_manifest) if package_manifest_present else None,
        "json": package_manifest_json is not None,
        "package_version": package_manifest_json.get("version") if isinstance(package_manifest_json, dict) else None,
    },
    "rust_dependencies": dependencies,
    "frontend": frontend,
    "checks": [
        {
            "name": "product-manifest-present",
            "ok": manifest_path.exists(),
            "path": rel(manifest_path),
        },
        {
            "name": "appfw-lock-present",
            "ok": lock_path.exists(),
            "path": rel(lock_path),
            "report_only": True,
        },
        {
            "name": "no-local-appfw-path-dependencies",
            "ok": not path_deps,
            "count": len(path_deps),
            "report_only": True,
        },
        {
            "name": "framework-package-manifest-present",
            "ok": package_manifest_present,
            "path": rel(package_manifest, repo_root),
            "report_only": True,
        },
        {
            "name": "frontend-pds-package-declared",
            "ok": (not frontend["present"]) or bool(frontend["appfw_pds_dependency"]),
            "path": rel(frontend_package),
            "report_only": True,
        },
    ],
    "transitional_items": transitional_items,
    "blocking_violations": blocking_violations,
    "not_applicable": [],
    "risk_acceptance": [],
    "next_steps": [
        "Publish framework crates/binaries/docs to ProGet through the release pipeline.",
        "Refresh product Cargo.toml files to use versioned pds-app-framework-crates dependencies in CI/product branches.",
        "Write appfw.lock from the approved framework release and retain compat-verify evidence before product release.",
    ],
}

report_path.parent.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"compat-verify ok: {report['artifact']}")
elif gating_ok:
    print(f"compat-verify report-only findings: {report['artifact']}")
    print(f"non-gating transitional items: {len(transitional_items)}")
else:
    print("compat-verify failed")
    for violation in blocking_violations:
        print(f"- {violation}")

sys.exit(0 if gating_ok else 1)
PY
}

saas_lineage() {
  local json="$1"
  shift || true

  local enforce=0
  local plan=0
  local evidence_file="${APPFW_SAAS_LINEAGE_EVIDENCE_FILE:-}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --enforce)
        enforce=1
        ;;
      --plan)
        plan=1
        ;;
      --evidence-file)
        shift || true
        if [[ $# -eq 0 ]]; then
          echo "saas-lineage: --evidence-file requires a path" >&2
          return 2
        fi
        evidence_file="$1"
        ;;
      *)
        echo "saas-lineage: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  python3 - "$framework_root" "$app_root" "$report_root" "$backend_dir" "$json" "$enforce" "$plan" "$evidence_file" <<'PY'
import datetime
import hashlib
import json
import re
import sys
from pathlib import Path

framework_root = Path(sys.argv[1]).resolve()
app_root = Path(sys.argv[2]).resolve()
product_report_root = Path(sys.argv[3]).resolve()
backend_dir = Path(sys.argv[4]).resolve()
json_mode = sys.argv[5] == "1"
enforce = sys.argv[6] == "1"
plan = sys.argv[7] == "1"
evidence_file = sys.argv[8]

framework_report_root = framework_root / "target/appfw"
artifact = framework_report_root / ("saas-freshness-lineage-enforced.json" if enforce else "saas-freshness-lineage.json")
report_artifact = framework_report_root / "saas-freshness-lineage.json"
enforced_artifact = framework_report_root / "saas-freshness-lineage-enforced.json"

def rel(path, base=framework_root):
    path = Path(path)
    try:
        return str(path.resolve().relative_to(base.resolve()))
    except Exception:
        return str(path)

def sha256(path):
    if not path.exists() or not path.is_file():
        return None
    h = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()

def read_json(path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return {"_json_error": str(exc)}

def parse_worker_yaml(path):
    result = {
        "path": rel(path),
        "present": path.exists(),
        "sha256": sha256(path),
        "enabled": None,
        "worker_count": None,
        "activation_gates": [],
    }
    if not path.exists():
        return result
    text = path.read_text(encoding="utf-8")
    enabled = re.search(r"(?m)^enabled:\s*(true|false)\s*$", text)
    worker_count = re.search(r"(?m)^worker_count:\s*(\d+)\s*$", text)
    result["enabled"] = enabled.group(1) == "true" if enabled else None
    result["worker_count"] = int(worker_count.group(1)) if worker_count else None
    capture = False
    for raw in text.splitlines():
        line = raw.rstrip()
        if line.startswith("activation_gates:"):
            capture = True
            continue
        if capture:
            if line.startswith("- "):
                result["activation_gates"].append(line[2:].strip())
                continue
            if line and not line.startswith(" "):
                capture = False
    return result

def evidence_findings(value, expected_head):
    findings = []
    if not isinstance(value, dict):
        return ["evidence is missing or not JSON"]
    if value.get("schema") != "appfw.saas.freshness-lineage.v1":
        findings.append("schema must be appfw.saas.freshness-lineage.v1")
    if value.get("ok") is not True:
        findings.append("ok must be true")
    if value.get("release_ready") is not True:
        findings.append("release_ready must be true")
    if expected_head and value.get("head_sha") not in {expected_head, None}:
        findings.append("head_sha must match current HEAD when present")
    if not isinstance(value.get("freshness"), list) or not value.get("freshness"):
        findings.append("freshness evidence must be a non-empty list")
    if not isinstance(value.get("lineage"), list) or not value.get("lineage"):
        findings.append("lineage evidence must be a non-empty list")
    if not isinstance(value.get("provenance"), dict):
        findings.append("provenance evidence must be an object")
    if not isinstance(value.get("echo_loop"), dict):
        findings.append("echo_loop evidence must be an object")
    redaction = value.get("redaction")
    if not isinstance(redaction, dict) or redaction.get("raw_payloads_removed") is not True or redaction.get("secrets_removed") is not True:
        findings.append("redaction must prove raw_payloads_removed and secrets_removed")
    return findings

def git_value(*args):
    import subprocess
    try:
        return subprocess.check_output(["git", *args], cwd=framework_root, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return None

if plan:
    result = {
        "command": "saas-lineage",
        "lane": "DP4",
        "mode": "plan",
        "ok": True,
        "namespace": "framework",
        "artifact": "target/appfw/saas-freshness-lineage.json",
        "enforced_artifact": "target/appfw/saas-freshness-lineage-enforced.json",
        "purpose": "Report unified SaaS projection freshness, lineage, provenance, echo-loop, and redaction posture.",
        "docs": [
            "docs/runtime/saas-connectors.md",
            "docs/reference/cli.md",
            "docs/start/agent-handoff-backlog.md",
            "docs/release/roadmap.md",
        ],
        "next_step": "Retain runtime freshness/lineage evidence from sync workers and rerun with --enforce.",
    }
    print(json.dumps(result, indent=2, sort_keys=True) if json_mode else "saas-lineage plan")
    sys.exit(0)

sync_descriptors_path = product_report_root / "sync_descriptors.json"
sync_worker_plan_path = product_report_root / "sync_worker_plan.json"
sync_workers_config_path = backend_dir / "config/generated/sync_workers.yaml"
evidence_path = Path(evidence_file).expanduser().resolve() if evidence_file else framework_report_root / "saas-freshness-lineage-live.json"

sync_descriptors = read_json(sync_descriptors_path)
sync_worker_plan = read_json(sync_worker_plan_path)
external_evidence = read_json(evidence_path)
worker_config = parse_worker_yaml(sync_workers_config_path)
head_sha = git_value("rev-parse", "HEAD")
head_subject = git_value("log", "-1", "--pretty=%s")

descriptor_items = sync_descriptors.get("descriptors", []) if isinstance(sync_descriptors, dict) else []
descriptor_count = sync_descriptors.get("descriptor_count") if isinstance(sync_descriptors, dict) else None
descriptor_findings = []
lineage_edges = []
for descriptor in descriptor_items if isinstance(descriptor_items, list) else []:
    name = descriptor.get("name")
    if descriptor.get("mode") != "incremental_watermark":
        descriptor_findings.append(f"{name}: mode must be incremental_watermark")
    for field in ["source_schema", "target_schema", "freshness_slo", "governance"]:
        if not descriptor.get(field):
            descriptor_findings.append(f"{name}: missing {field}")
    objects = descriptor.get("objects") if isinstance(descriptor.get("objects"), list) else []
    if not objects:
        descriptor_findings.append(f"{name}: missing object mappings")
    for obj in objects:
        missing = [field for field in ["source", "target", "key", "watermark"] if not obj.get(field)]
        if missing:
            descriptor_findings.append(f"{name}/{obj.get('target', '<unknown>')}: missing {', '.join(missing)}")
        lineage_edges.append(
            {
                "descriptor": name,
                "source_schema": descriptor.get("source_schema"),
                "source": obj.get("source"),
                "target_schema": descriptor.get("target_schema"),
                "target": obj.get("target"),
                "watermark": obj.get("watermark"),
                "freshness_slo": descriptor.get("freshness_slo"),
                "provenance_status": "descriptor-only",
            }
        )

evidence_contract = {
    "schema": "appfw.saas.freshness-lineage.v1",
    "path": "target/appfw/saas-freshness-lineage-live.json",
    "required_fields": [
        "ok:true",
        "release_ready:true",
        "head_sha matching current HEAD when present",
        "freshness[]",
        "lineage[]",
        "provenance{}",
        "echo_loop{}",
        "redaction.raw_payloads_removed:true",
        "redaction.secrets_removed:true",
    ],
}
external_findings = evidence_findings(external_evidence, head_sha)
external_ready = not external_findings
descriptor_report_ok = isinstance(sync_descriptors, dict) and not sync_descriptors.get("_json_error")
worker_config_ok = worker_config["present"] and worker_config["enabled"] is False

checks = [
    {
        "name": "sync-descriptor-report-present",
        "ok": sync_descriptors_path.exists() and descriptor_report_ok,
        "path": rel(sync_descriptors_path),
    },
    {
        "name": "descriptor-freshness-lineage-shape",
        "ok": descriptor_report_ok and not descriptor_findings,
        "descriptor_count": descriptor_count,
        "findings": descriptor_findings,
        "report_only_when_empty": True,
    },
    {
        "name": "sync-worker-config-fail-closed",
        "ok": worker_config_ok,
        "path": rel(sync_workers_config_path),
        "enabled": worker_config["enabled"],
        "worker_count": worker_config["worker_count"],
    },
    {
        "name": "sync-worker-plan-present",
        "ok": isinstance(sync_worker_plan, dict) and not sync_worker_plan.get("_json_error"),
        "path": rel(sync_worker_plan_path),
        "report_only": True,
    },
    {
        "name": "live-freshness-lineage-evidence-present",
        "ok": external_ready,
        "path": rel(evidence_path),
        "findings": external_findings,
        "report_only": True,
    },
]

release_ready = bool(descriptor_items) and external_ready and worker_config.get("enabled") is True
blocking_violations = []
if not descriptor_report_ok:
    blocking_violations.append("sync-descriptor-report-missing-or-invalid")
if not worker_config_ok:
    blocking_violations.append("sync-worker-config-not-fail-closed")
if enforce and not release_ready:
    blocking_violations.append("saas-freshness-lineage-not-release-ready")
    if not external_ready:
        blocking_violations.append("live-freshness-lineage-evidence-missing-or-invalid")
    if not descriptor_items:
        blocking_violations.append("no-sync-descriptors-to-certify")

report = {
    "command": "saas-lineage",
    "lane": "DP4",
    "ok": not blocking_violations,
    "release_ready": release_ready,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": rel(artifact),
    "report_artifact": rel(report_artifact),
    "enforced_artifact": rel(enforced_artifact),
    "app_root": rel(app_root),
    "git": {
        "head_sha": head_sha,
        "head_subject": head_subject,
    },
    "gate": {
        "enforced": enforce,
        "ready_to_enforce": release_ready,
        "reason": "DP4 release readiness requires sync descriptors plus runtime/live freshness, lineage, provenance, echo-loop, and redaction evidence.",
    },
    "inputs": {
        "sync_descriptors": {
            "path": rel(sync_descriptors_path),
            "present": sync_descriptors_path.exists(),
            "json": descriptor_report_ok,
            "sha256": sha256(sync_descriptors_path),
            "descriptor_count": descriptor_count,
        },
        "sync_worker_plan": {
            "path": rel(sync_worker_plan_path),
            "present": sync_worker_plan_path.exists(),
            "json": isinstance(sync_worker_plan, dict) and not sync_worker_plan.get("_json_error"),
            "sha256": sha256(sync_worker_plan_path),
        },
        "sync_workers_config": worker_config,
        "live_evidence": {
            "path": rel(evidence_path),
            "present": evidence_path.exists(),
            "json": isinstance(external_evidence, dict) and not external_evidence.get("_json_error"),
            "sha256": sha256(evidence_path),
        },
    },
    "evidence_contract": evidence_contract,
    "descriptor_summary": {
        "descriptor_count": descriptor_count,
        "lineage_edge_count": len(lineage_edges),
        "findings": descriptor_findings,
    },
    "lineage_edges": lineage_edges,
    "checks": checks,
    "external_evidence_findings": external_findings,
    "blocking_violations": blocking_violations,
    "next_steps": [
        "Add model-owned sync descriptors for each Archetype-1 SaaS projection.",
        "Retain runtime sync-worker freshness and checkpoint evidence outside generated descriptors.",
        "Retain source-to-projection lineage, echo-loop suppression, and redaction evidence before enabling --enforce in release gates.",
    ],
}

artifact.parent.mkdir(parents=True, exist_ok=True)
artifact.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
if not enforce and artifact != report_artifact:
    report_artifact.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
elif report["ok"]:
    print(f"saas-lineage ok: {report['artifact']}")
else:
    print("saas-lineage failed")
    for violation in blocking_violations:
        print(f"- {violation}")

sys.exit(0 if report["ok"] else 1)
PY
}

wave0_reserved_plan() {
