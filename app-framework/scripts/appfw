local_preflight_lane_count = len(local_preflight_lanes)
local_preflight_proven_count = len([item for item in local_preflight_lanes if item["local_proven"]])
release_ready_count = len([item for item in lanes if item["release_ready"]])
release_ready = all(item["release_ready"] for item in lanes)

