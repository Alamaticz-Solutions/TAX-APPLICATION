      "commands": ["scripts/appfw framework dependency-check --json --offline", "scripts/appfw framework dependency-plan --json --offline"],
      "artifacts": ["target/appfw/dependency-check.json"]
    },
    {
      "phase": "package-distribution",
      "skill": "framework-release-certification",
      "docs": ["docs/release/proget-distribution.md", "docs/architecture/framework-packaging.md", "docs/reference/cli.md"],
      "commands": ["scripts/appfw framework package --plan --json", "scripts/appfw framework package --json"],
      "artifacts": ["target/appfw/proget/app-framework-proget-manifest.json", "target/appfw/proget/app-framework-crates-publish-plan-<version>.json", "target/appfw/proget/app-framework-<version>-<platform>.tar.gz", "target/appfw/proget/app-framework-binaries-<version>-<platform>.tar.gz", "target/appfw/proget/app-framework-product-docs-<version>.tar.gz"]
    },
    {
      "phase": "pr-review",
      "skill": "framework-pr-review",
      "docs": ["docs/start/pr-review-agent-harness.md", "docs/start/agent-task-map.md"],
      "commands": ["scripts/appfw framework change-impact --json", "scripts/appfw framework review-brief --auto-depth --json", "scripts/appfw framework review-performance --auto-depth --json", "scripts/appfw framework handoff --json"],
      "artifacts": ["target/appfw/change-impact.json", "target/appfw/review-brief.json", "target/appfw/review-performance.json", "target/appfw/agent-handoff.json"]
    },
    {
      "phase": "handoff",
      "skill": "framework-handoff",
      "docs": ["docs/start/agent-task-map.md"],
      "commands": ["scripts/appfw framework handoff --json"],
      "artifacts": ["target/appfw/agent-handoff.json"]
    }
  ]
}
JSON
    return 0
  fi

  appfw_banner
  echo
  cat <<'EOF'
Product lifecycle:
  intake -> bootstrap -> proposal -> model -> generate-extend -> run-local
  -> frontend -> mobile -> release -> pr-review -> upgrade -> handoff

Framework stewardship:
  docs-ia -> generator -> runtime-ingress -> provider-certification
  -> release-certification -> dependency-maintenance -> package-distribution
  -> pr-review -> handoff

Use --json for command, docs, skill, and artifact metadata.
EOF
}

lockfile_error() {
  local lockfile="$1"
  local label="$2"

  cat >&2 <<EOF
appfw: missing required Cargo lockfile for $label:
  $lockfile

App Framework workflow commands run Cargo with --locked so framework and product
evidence is deterministic. Generate and commit the workspace lockfile before
running this command:
  cd "$(dirname "$lockfile")" && cargo generate-lockfile
EOF
}

require_lockfile() {
  local lockfile="$1"
  local label="$2"

  if [[ -f "$lockfile" ]]; then
    return 0
  fi

  lockfile_error "$lockfile" "$label"
  return 2
}

require_framework_lockfile() {
  require_lockfile "$framework_root/Cargo.lock" "framework workspace"
}

require_product_lockfile() {
  if [[ -f "$app_root/Cargo.toml" ]]; then
    require_lockfile "$app_root/Cargo.lock" "product workspace"
  fi
}

json_file_or_result() {
  local file="$1"
  local command="$2"
  local ok="$3"
  local detail="$4"

  if [[ -f "$file" ]]; then
    cat "$file"
  else
    json_result "$command" "$ok" "$detail"
  fi
}

run_app_gen_validate() {
  if [[ -n "${APPFW_APP_GEN_BIN:-}" && -x "${APPFW_APP_GEN_BIN}" ]]; then
    "${APPFW_APP_GEN_BIN}" "${app_gen_root_args[@]}" --validate-only
    return
  fi
  require_framework_lockfile
  (cd "$app_gen_dir" && cargo run --locked --bin app_gen -- "${app_gen_root_args[@]}" --validate-only)
}

run_app_gen_generate() {
  if [[ -n "${APPFW_APP_GEN_BIN:-}" && -x "${APPFW_APP_GEN_BIN}" ]]; then
    "${APPFW_APP_GEN_BIN}" "${app_gen_root_args[@]}"
    return
  fi
  require_framework_lockfile
  (cd "$app_gen_dir" && cargo run --locked --bin app_gen -- "${app_gen_root_args[@]}")
}

run_appfw_introspect() {
  local root_args=(
    --app-root "$app_root"
    --framework-root "$framework_root"
    --generator-root "$app_gen_dir"
    --config-root "$config_root"
    --templates-root "$templates_root"
    --report-root "$report_root"
  )
  # Fast path: when a prebuilt binary is provided (e.g. by docs-check), invoke
  # it directly instead of `cargo run`. This avoids a build-graph check and a
  # `target/` build-lock acquisition on every call, which otherwise serialize
  # behind any concurrent compile (rust-analyzer, a parallel agent, CI).
  if [[ -n "${APPFW_INTROSPECT_BIN:-}" && -x "${APPFW_INTROSPECT_BIN}" ]]; then
    (
      cd "$invocation_cwd"
      "${APPFW_INTROSPECT_BIN}" "${root_args[@]}" "$@"
    )
    return
  fi
  require_framework_lockfile
  (
    cd "$invocation_cwd"
    cargo run --locked --quiet --manifest-path "$app_gen_dir/Cargo.toml" --bin appfw_introspect -- \
      "${root_args[@]}" \
      "$@"
  )
}

provider_certification_export_supports_args() {
  local binary="$1"
  shift || true

  local requires_graduation=0
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--graduation" ]]; then
      requires_graduation=1
      break
    fi
  done

  if [[ "$requires_graduation" == "0" ]]; then
    return 0
  fi

  local help_output
  if ! help_output="$("$binary" --help 2>&1)"; then
    return 1
  fi
  [[ "$help_output" == *"--graduation"* ]]
}

run_provider_certification_export() {
  if [[ -n "${APPFW_PROVIDER_CERTIFICATION_EXPORT_BIN:-}" && -x "${APPFW_PROVIDER_CERTIFICATION_EXPORT_BIN}" ]]; then
    if provider_certification_export_supports_args "${APPFW_PROVIDER_CERTIFICATION_EXPORT_BIN}" "$@"; then
      "${APPFW_PROVIDER_CERTIFICATION_EXPORT_BIN}" "$@"
      return
    fi
    echo "provider_certification_export helper does not support requested arguments; rebuilding via Cargo" >&2
  fi
  local local_debug_bin="$framework_root/target/debug/provider_certification_export"
  if [[ -x "$local_debug_bin" \
    && "$local_debug_bin" -nt "$framework_root/appfw_cli/src/bin/provider_certification_export.rs" \
    && "$local_debug_bin" -nt "$framework_root/appfw_runtime/src/provider_certification.rs" \
    && "$local_debug_bin" -nt "$framework_root/appfw_runtime/src/provider_capabilities.rs" \
    && "$local_debug_bin" -nt "$framework_root/appfw_runtime/src/provider_contract_types.rs" \
    && "$local_debug_bin" -nt "$framework_root/appfw_runtime/src/provider_keys.rs" ]]; then
    if provider_certification_export_supports_args "$local_debug_bin" "$@"; then
      "$local_debug_bin" "$@"
      return
    fi
  fi
  require_framework_lockfile
  (
    cd "$framework_root"
    cargo run --locked --quiet --manifest-path "$framework_root/appfw_cli/Cargo.toml" \
      --bin provider_certification_export -- "$@"
  )
}

cargo_test_for_product_crate() {
  local args=("test")
  if [[ -f Cargo.lock || -f ../Cargo.lock ]]; then
    args+=("--locked")
  fi
  args+=("$@")
  cargo "${args[@]}"
}

run_database_cargo() {
  local command="$1"
  shift || true
  if [[ "$command" == "run" && -n "${APPFW_DATABASE_BIN:-}" && -x "${APPFW_DATABASE_BIN}" ]]; then
    local binary_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --quiet)
          shift
          ;;
        --)
          shift
          break
          ;;
        *)
          break
          ;;
      esac
    done
    binary_args=("$@")
    (cd "$database_dir" && "${APPFW_DATABASE_BIN}" "${binary_args[@]}")
    return
  fi
  require_framework_lockfile
  require_product_lockfile
  (cd "$database_dir" && cargo "$command" --locked --manifest-path "$database_crate_dir/Cargo.toml" "$@")
}

run_with_json_capture() {
  local command_name="$1"
  shift

  local log_file
  log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-${command_name}.XXXXXX")"

  set +e
  "$@" >"$log_file" 2>&1
  local status=$?
  set -e

  if [[ $status -eq 0 ]]; then
    json_result "$command_name" true
    rm -f "$log_file"
  else
    local retained_log_file="$framework_root/target/appfw/${command_name}.log"
    mkdir -p "$(dirname "$retained_log_file")"
    cp "$log_file" "$retained_log_file" || true
    json_result "$command_name" false "command failed; diagnostic output was captured at $retained_log_file"
  fi

  return "$status"
}

generate_check_json_result() {
  local timing_file="${APPFW_APPGEN_EQUIV_TIMING_FILE:-$framework_root/target/appfw/generate-check-timing.json}"
  local timing_artifact="$timing_file"
  case "$timing_file" in
    "$framework_root"/*)
      timing_artifact="${timing_file#"$framework_root"/}"
      ;;
  esac

  local log_file
  log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-generate-check.XXXXXX")"

  set +e
  APPFW_APPGEN_EQUIV_TIMING_FILE="$timing_file" "$repo_root/scripts/check_app_gen_backend_equivalence.sh" >"$log_file" 2>&1
  local status=$?
  set -e

  printf '{"command":"generate-check","ok":'
  if [[ $status -eq 0 ]]; then
    printf 'true'
  else
    printf 'false'
  fi
  printf ',"timing_artifact":'
  json_escape "$timing_artifact"
  if [[ $status -ne 0 ]]; then
    local retained_log_file="$framework_root/target/appfw/generate-check.log"
    mkdir -p "$(dirname "$retained_log_file")"
    cp "$log_file" "$retained_log_file" || true
    printf ',"detail":'
    json_escape "command failed; diagnostic output was captured at $retained_log_file"
  fi
  printf '}\n'

  if [[ $status -eq 0 ]]; then
    rm -f "$log_file"
  fi

  return "$status"
}

release_check_json_item() {
  local first="$1"
  local name="$2"
  local ok="$3"
  local log_file="$4"
  local artifact_file="${5:-}"

  if [[ "$first" != "1" ]]; then
    printf ','
  fi
  printf '{"name":'
  json_escape "$name"
  printf ',"ok":%s,"log":' "$ok"
  json_escape "$log_file"
  if [[ -n "$artifact_file" ]]; then
    printf ',"artifact":'
    json_escape "$artifact_file"
  fi
  printf '}'
}

release_check_missing_provider_urls_json() {
  local snapshot_file="${APPFW_RELEASE_PROVIDER_URL_PREFLIGHT_JSON:-}"
  if [[ -n "$snapshot_file" && -f "$snapshot_file" ]]; then
    release_check_provider_url_preflight_snapshot_field "$snapshot_file" missing_provider_base_urls
    return
  fi
  release_check_provider_url_preflight_data missing-json
}

release_check_invalid_provider_urls_json() {
  local snapshot_file="${APPFW_RELEASE_PROVIDER_URL_PREFLIGHT_JSON:-}"
  if [[ -n "$snapshot_file" && -f "$snapshot_file" ]]; then
    release_check_provider_url_preflight_snapshot_field "$snapshot_file" invalid_provider_base_urls
    return
  fi
  release_check_provider_url_preflight_data invalid-json
}

release_check_provider_url_preflight_snapshot_field() {
  local snapshot_file="$1"
  local field="$2"

  python3 - "$snapshot_file" "$field" <<'PY'
import json
import sys

path, field = sys.argv[1:3]
with open(path, "r", encoding="utf-8") as handle:
    data = json.load(handle)
value = data.get(field, [])
if not isinstance(value, list):
    value = []
print(json.dumps(value, separators=(",", ":")))
PY
}

release_check_provider_url_preflight_data() {
  local mode="$1"
  python3 - "$mode" <<'PY'
import json
import os
import ssl
import sys
from collections import defaultdict
from datetime import datetime, timezone
from urllib.parse import urlsplit, urlunsplit
from urllib.request import Request, urlopen

mode = sys.argv[1]
providers = ["postgres", "mongo", "mssql", "snowflake"]
missing = []
invalid = []
valid = {}
try:
    health_timeout = float(os.environ.get("APPFW_RELEASE_PROVIDER_URL_PREFLIGHT_TIMEOUT", "").strip() or os.environ.get("APPFW_PROVIDER_TEST_PREFLIGHT_TIMEOUT", "").strip() or "5")
    if health_timeout <= 0:
        health_timeout = 5.0
except ValueError:
    health_timeout = 5.0


def utc_now():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def env_name(provider):
    return f"API_TEST_BASE_URL_{provider.upper()}"


def redacted_url(parts):
    host = parts.hostname or ""
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    netloc = host
    if parts.port is not None:
        netloc = f"{netloc}:{parts.port}"
    return urlunsplit(
        (
            parts.scheme.lower(),
            netloc,
            parts.path.rstrip("/"),
            "",
            "",
        )
    )


def provider_health_url(parts):
    return f"{redacted_url(parts).rstrip('/')}/health/ready"


def health_endpoint_probe(parts):
    url = provider_health_url(parts)
    result = {
        "url": url,
        "status": None,
        "ok": False,
        "checked_at_utc": utc_now(),
        "timeout_seconds": health_timeout,
    }
    context = ssl._create_unverified_context() if parts.scheme.lower() == "https" else None
    try:
        request = Request(url, method="GET")
        with urlopen(request, timeout=health_timeout, context=context) as response:
            status = response.getcode()
        result["status"] = status
        result["ok"] = 200 <= status < 400
    except Exception as exc:
        result["error"] = exc.__class__.__name__
    return result


def add_invalid(provider, env, value, reason):
    entry = {
        "provider": provider,
        "env": env,
        "reason": reason,
        "redacted_url": "<redacted-invalid-url>",
    }
    try:
        parts = urlsplit(value.strip())
        if parts.scheme and parts.hostname:
            entry["redacted_url"] = redacted_url(parts)
    except ValueError:
        pass
    invalid.append(entry)


for provider in providers:
    env = env_name(provider)
    value = os.environ.get(env, "")
    if not value.strip():
        missing.append({"provider": provider, "env": env})
        continue
    text = value.strip()
    try:
        parts = urlsplit(text)
        hostname = parts.hostname
        port = parts.port
    except ValueError:
        add_invalid(provider, env, text, "must be a valid absolute URL")
        continue
    if parts.scheme.lower() not in {"http", "https"}:
        add_invalid(provider, env, text, "must use http or https")
        continue
    if not parts.netloc or not hostname:
        add_invalid(provider, env, text, "must include a host")
        continue
    if parts.username or parts.password:
        add_invalid(provider, env, text, "must not include credentials")
        continue
    if parts.query or parts.fragment:
        add_invalid(provider, env, text, "must not include query strings or fragments")
        continue
    health_probe = health_endpoint_probe(parts)
    if not health_probe["ok"]:
        add_invalid(provider, env, text, "health endpoint /health/ready must be reachable")
        continue
    key = (
        parts.scheme.lower(),
        hostname.lower(),
        port if port is not None else (443 if parts.scheme.lower() == "https" else 80),
    )
    valid[provider] = {
        "provider": provider,
        "env": env,
        "key": key,
        "redacted_url": redacted_url(parts),
        "health_url": health_probe["url"],
        "health_status": health_probe["status"],
        "health_checked_at_utc": health_probe["checked_at_utc"],
        "health_timeout_seconds": health_probe["timeout_seconds"],
    }

duplicates = defaultdict(list)
for provider, item in valid.items():
    duplicates[item["key"]].append(provider)
for providers_with_same_url in duplicates.values():
    if len(providers_with_same_url) < 2:
        continue
    providers_text = ", ".join(sorted(providers_with_same_url))
    for provider in providers_with_same_url:
        item = valid[provider]
        invalid.append(
            {
                "provider": provider,
                "env": item["env"],
                "reason": (
                    "must be provider-specific and distinct for release provider-test --all "
                    f"(shared with {providers_text})"
                ),
                "redacted_url": item["redacted_url"],
            }
        )

valid_provider_base_urls = [
    {
        "provider": provider,
        "env": item["env"],
        "redacted_url": item["redacted_url"],
        "health_url": item["health_url"],
        "health_status": item["health_status"],
        "health_checked_at_utc": item["health_checked_at_utc"],
        "health_timeout_seconds": item["health_timeout_seconds"],
    }
    for provider, item in valid.items()
    if not any(invalid_item.get("provider") == provider for invalid_item in invalid)
]
result = {
    "ok": not missing and not invalid,
    "generated_at_utc": utc_now(),
    "missing_provider_base_urls": missing,
    "invalid_provider_base_urls": invalid,
    "valid_provider_base_urls": valid_provider_base_urls,
}

if mode == "missing-json":
    print(json.dumps(result["missing_provider_base_urls"], separators=(",", ":")))
elif mode == "invalid-json":
    print(json.dumps(result["invalid_provider_base_urls"], separators=(",", ":")))
elif mode == "json":
    print(json.dumps(result, separators=(",", ":")))
elif mode == "log":
    print("release-check provider URL preflight")
    print("provider-test --all requires one provider-specific backend URL per CRUD provider.")
    print()
    invalid_by_provider = {item["provider"]: item for item in invalid}
    for provider in providers:
        env = env_name(provider)
        if any(item["provider"] == provider for item in missing):
            print(f"missing {env} for {provider}")
        elif provider in invalid_by_provider:
            item = invalid_by_provider[provider]
            detail = item["reason"]
            if "redacted_url" in item:
                detail = f"{detail}: {item['redacted_url']}"
            print(f"invalid {env} for {provider}: {detail}")
        else:
            print(f"found valid {env} for {provider}: {valid[provider]['redacted_url']}")
    if missing or invalid:
        print()
        print("release-check cannot produce provider-backed release evidence without valid provider-specific URLs.")
        print("Use scripts/ci/bitbucket-release-gate.sh or an approved live lane to start provider backends and export the URLs.")
        sys.exit(1)
    print()
    print("provider URL preflight passed.")
else:
    raise SystemExit(f"unknown provider URL preflight mode: {mode}")
PY
}

release_check_provider_url_preflight_log_from_snapshot() {
  local snapshot_file="$1"

  python3 - "$snapshot_file" <<'PY'
import json
import sys

path = sys.argv[1]
providers = ["postgres", "mongo", "mssql", "snowflake"]


def env_name(provider):
    return f"API_TEST_BASE_URL_{provider.upper()}"


with open(path, "r", encoding="utf-8") as handle:
    data = json.load(handle)
missing = data.get("missing_provider_base_urls", [])
invalid = data.get("invalid_provider_base_urls", [])
valid = data.get("valid_provider_base_urls", [])
if not isinstance(missing, list):
    missing = []
if not isinstance(invalid, list):
    invalid = []
if not isinstance(valid, list):
    valid = []

print("release-check provider URL preflight")
print("provider-test --all requires one provider-specific backend URL per CRUD provider.")
print()
invalid_by_provider = {
    item.get("provider"): item
    for item in invalid
    if isinstance(item, dict) and isinstance(item.get("provider"), str)
}
valid_by_provider = {
    item.get("provider"): item
    for item in valid
    if isinstance(item, dict) and isinstance(item.get("provider"), str)
}
missing_providers = {
    item.get("provider")
    for item in missing
    if isinstance(item, dict) and isinstance(item.get("provider"), str)
}
for provider in providers:
    env = env_name(provider)
    if provider in missing_providers:
        print(f"missing {env} for {provider}")
    elif provider in invalid_by_provider:
        item = invalid_by_provider[provider]
        detail = item.get("reason") or "invalid provider URL"
        if item.get("redacted_url"):
            detail = f"{detail}: {item['redacted_url']}"
        print(f"invalid {env} for {provider}: {detail}")
    elif provider in valid_by_provider:
        print(f"found valid {env} for {provider}: {valid_by_provider[provider].get('redacted_url')}")
    else:
        print(f"missing {env} for {provider}")

if missing or invalid:
    print()
    print("release-check cannot produce provider-backed release evidence without valid provider-specific URLs.")
    print("Use scripts/ci/bitbucket-release-gate.sh or an approved live lane to start provider backends and export the URLs.")
    sys.exit(1)
print()
print("provider URL preflight passed.")
PY
}

release_check_provider_url_preflight() {
  local log_file="$1"
  local snapshot_file="${2:-}"

  if [[ -n "$snapshot_file" ]]; then
    local snapshot_tmp
    snapshot_tmp="$(mktemp "${TMPDIR:-/tmp}/appfw-provider-url-preflight.XXXXXX")"
    release_check_provider_url_preflight_data json >"$snapshot_tmp"
    mv "$snapshot_tmp" "$snapshot_file"
    release_check_provider_url_preflight_log_from_snapshot "$snapshot_file" >"$log_file"
    return
  fi

  release_check_provider_url_preflight_data log >"$log_file"
}

release_check_bool_from_env() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | y | on | required | require)
      printf 'true'
      ;;
    *)
      printf 'false'
      ;;
  esac
}

json_top_level_bool_is_true() {
  local file="$1"
  local field="$2"

  python3 - "$file" "$field" <<'PY' >/dev/null 2>&1
import json
import sys

path, field = sys.argv[1], sys.argv[2]
with open(path, "r", encoding="utf-8") as handle:
    data = json.load(handle)
sys.exit(0 if data.get(field) is True else 1)
PY
}

json_top_level_bool_is_false() {
  local file="$1"
  local field="$2"

  python3 - "$file" "$field" <<'PY' >/dev/null 2>&1
import json
import sys

path, field = sys.argv[1], sys.argv[2]
with open(path, "r", encoding="utf-8") as handle:
    data = json.load(handle)
sys.exit(0 if data.get(field) is False else 1)
PY
}

json_set_top_level_bool() {
  local source_file="$1"
  local output_file="$2"
  local field="$3"
  local value="$4"

  python3 - "$source_file" "$output_file" "$field" "$value" <<'PY'
import json
import sys

source_file, output_file, field, value = sys.argv[1:5]
with open(source_file, "r", encoding="utf-8") as handle:
    data = json.load(handle)
if not isinstance(data, dict):
    raise SystemExit(f"{source_file} must contain a JSON object")
if value == "true":
    data[field] = True
elif value == "false":
    data[field] = False
else:
    raise SystemExit(f"unsupported boolean value: {value}")
with open(output_file, "w", encoding="utf-8") as handle:
    json.dump(data, handle, separators=(",", ":"))
    handle.write("\n")
PY
}

release_check_diagnostics_json() {
  local failed="$1"
  local incomplete="$2"
  local report_dir="$3"
  local current_check="${4:-}"
  local release_ready=true
  if [[ "$failed" == "1" || "$incomplete" == "true" ]]; then
    release_ready=false
  fi

  local live_ops_required
  live_ops_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_LIVE_OPS_EVIDENCE:-}")"
  local ops_certification_required
  ops_certification_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_OPS_CERTIFICATION:-}")"
  if [[ "$live_ops_required" == "true" ]]; then
    ops_certification_required=true
  fi
  local performance_required
  performance_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_PERFORMANCE_EVIDENCE:-}")"
  local pds_baseline_required
  pds_baseline_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_PDS_BASELINE_EVIDENCE:-${APPFW_RELEASE_REQUIRE_PDS_BASELINE:-}}")"
  local release_identity_required
  release_identity_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_RELEASE_IDENTITY:-}")"
  local security_assurance_required
  security_assurance_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_SECURITY_ASSURANCE_DECISION:-${APPFW_REQUIRE_SECURITY_ASSURANCE_DECISION:-}}")"
  local production_attestations_required
  production_attestations_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_PRODUCTION_ATTESTATIONS:-${APPFW_REQUIRE_PRODUCTION_ATTESTATIONS:-}}")"
  if [[ "$production_attestations_required" == "true" ]]; then
    security_assurance_required=true
  fi
  local provider_item_needed=false
  local security_item_needed=false
  local security_assurance_item_needed=false
  local ops_item_needed=false
  local pds_baseline_item_needed=false
  local release_identity_item_needed=false

  printf ',"evidence_mode":{'
  printf '"provider_certification":"live-required"'
  printf ',"security_certification":"live-provider-evidence-required"'
  printf ',"operations":'
  if [[ "$live_ops_required" == "true" ]]; then
    json_escape "live-required"
  else
    json_escape "static-local-allowed"
  fi
  printf ',"pds_security_baseline":'
  if [[ "$pds_baseline_required" == "true" ]]; then
    json_escape "live-required"
  else
    json_escape "traceability-local-allowed"
  fi
  printf ',"performance":'
  if [[ "$performance_required" == "true" ]]; then
    json_escape "live-required"
  else
    json_escape "not-required"
  fi
  printf ',"release_identity":'
  if [[ "$release_identity_required" == "true" ]]; then
    json_escape "release-authority-required"
  else
    json_escape "not-required"
  fi
  printf ',"production_attestations_required":%s' "$production_attestations_required"
  printf ',"security_assurance":'
  if [[ "$production_attestations_required" == "true" ]]; then
    json_escape "production-attestations-required"
  elif [[ "$security_assurance_required" == "true" ]]; then
    json_escape "decision-required"
  else
    json_escape "not-required"
  fi
  printf '}'

  printf ',"provider_scope":{'
  printf '"release_certified_crud":["postgres","mongo","mssql","snowflake"]'
  printf ',"graph_providers":[{'
  printf '"provider":"neo4j"'
  printf ',"workspace_crate":"appfw-provider-neo4j"'
  printf ',"release_certified":false'
  printf ',"posture":"graph-read and governed-write foundation; outside CRUD semantic parity"'
  printf ',"certification_path":"docs/runtime/graph-read-providers.md#certification-posture"'
  printf '}]'
  printf ',"external_api_providers":['
  local first_external_api_provider=1
  local external_api_provider
  for external_api_provider in \
    servicenow:appfw-provider-servicenow \
    workday:appfw-provider-workday \
    icims:appfw-provider-icims \
    salesforce:appfw-provider-salesforce \
    anaplan:appfw-provider-anaplan \
    oracle_financials:appfw-provider-oracle-financials; do
    local provider_key="${external_api_provider%%:*}"
    local workspace_crate="${external_api_provider#*:}"
    if [[ "$first_external_api_provider" == "1" ]]; then
      first_external_api_provider=0
    else
      printf ','
    fi
    printf '{'
    printf '"provider":'
    json_escape "$provider_key"
    printf ',"workspace_crate":'
    json_escape "$workspace_crate"
    printf ',"release_certified":false'
    printf ',"governed_write_certified":false'
    printf ',"posture":"external API named-read foundation; governed writes disabled until G1 delegated-auth evidence exists"'
    printf ',"certification_path":"docs/runtime/saas-certification.md#governed-write-posture"'
    printf '}'
  done
  printf ']'
  printf ',"ai_search_providers":[{'
  printf '"provider":"ai_search"'
  printf ',"workspace_crate":"appfw-provider-ai-search"'
  printf ',"release_certified":false'
  printf ',"posture":"AI search named-query contract foundation; execution disabled until enterprise contract evidence and shared SaaS HTTP executor exist"'
  printf ',"certification_path":"docs/runtime/ai-chat-search.md#held-spec-contract-ai-search-provider-graduation"'
  printf '}]}'

  printf ',"missing_provider_base_urls":'
  release_check_missing_provider_urls_json
  printf ',"invalid_provider_base_urls":'
  release_check_invalid_provider_urls_json

  printf ',"failure_summary":{"root_causes":['
  local first=1
  local missing_provider_urls
  missing_provider_urls="$(release_check_missing_provider_urls_json)"
  local invalid_provider_urls
  invalid_provider_urls="$(release_check_invalid_provider_urls_json)"
  if [[ "$missing_provider_urls" != "[]" ]]; then
    json_escape "missing provider-specific backend URLs for provider-test --all; set API_TEST_BASE_URL_POSTGRES, API_TEST_BASE_URL_MONGO, API_TEST_BASE_URL_MSSQL, and API_TEST_BASE_URL_SNOWFLAKE"
    first=0
    provider_item_needed=true
    security_item_needed=true
  fi
  if [[ "$invalid_provider_urls" != "[]" ]]; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    json_escape "invalid provider-specific backend URLs for provider-test --all; set distinct http(s) API_TEST_BASE_URL_POSTGRES, API_TEST_BASE_URL_MONGO, API_TEST_BASE_URL_MSSQL, and API_TEST_BASE_URL_SNOWFLAKE values"
    first=0
    provider_item_needed=true
    security_item_needed=true
  fi
  if [[ "$current_check" != "provider-url-preflight" \
    && -f "$report_dir/provider-parity.json" ]] \
    && ! json_top_level_bool_is_true "$report_dir/provider-parity.json" ok; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    json_escape "provider certification artifact is not ok"
    first=0
    provider_item_needed=true
  fi
  if [[ "$current_check" != "provider-url-preflight" \
    && -f "$report_dir/security-certification.json" ]] \
    && ! json_top_level_bool_is_true "$report_dir/security-certification.json" ok; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    json_escape "security certification is not ok; live provider security contracts are missing or failing"
    first=0
    security_item_needed=true
  fi
  if [[ "$security_assurance_required" == "true" ]]; then
    if [[ ! -f "$report_dir/security-assurance-decision.json" ]]; then
      if [[ "$first" != "1" ]]; then
        printf ','
      fi
      json_escape "security assurance decision is required but target/appfw/security-assurance-decision.json is missing"
      first=0
      security_assurance_item_needed=true
    elif ! json_top_level_bool_is_true "$report_dir/security-assurance-decision.json" release_ready; then
      if [[ "$first" != "1" ]]; then
        printf ','
      fi
      json_escape "security assurance decision is not release-ready"
      first=0
      security_assurance_item_needed=true
    elif [[ "$production_attestations_required" == "true" ]] \
      && ! json_top_level_bool_is_true "$report_dir/security-assurance-decision.json" production_attestations_required; then
      if [[ "$first" != "1" ]]; then
        printf ','
      fi
      json_escape "security assurance decision was not generated with production attestations required"
      first=0
      security_assurance_item_needed=true
    fi
  fi
  if [[ "$ops_certification_required" == "true" \
    && "$current_check" != "provider-url-preflight" \
    && -f "$report_dir/ops-certification.json" ]] \
    && ! json_top_level_bool_is_true "$report_dir/ops-certification.json" release_ready; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    json_escape "operations certification is static/local and not production release-ready"
    first=0
    ops_item_needed=true
  fi
  if [[ "$pds_baseline_required" == "true" \
    && -f "$report_dir/pds-security-baseline.json" ]] \
    && ! json_top_level_bool_is_true "$report_dir/pds-security-baseline.json" release_ready; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    json_escape "PDS Security Baseline r4.5 evidence is traceability-only or missing live release-authority proof"
    first=0
    pds_baseline_item_needed=true
  fi
  if [[ "$release_identity_required" == "true" \
    && -f "$report_dir/release-identity.json" ]] \
    && ! json_top_level_bool_is_true "$report_dir/release-identity.json" release_ready; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    json_escape "release identity, licensing, release notes, or distribution evidence is missing release-authority proof"
    first=0
    release_identity_item_needed=true
  fi
  printf ']}'

  if [[ "$security_assurance_item_needed" == "true" || "$ops_item_needed" == "true" || "$pds_baseline_item_needed" == "true" || "$release_identity_item_needed" == "true" ]]; then
    release_ready=false
  fi
  printf ',"release_ready":%s' "$release_ready"

  printf ',"remediation_work_items":['
  first=1
  if [[ "$provider_item_needed" == "true" ]]; then
    printf '{"id":"LIVE-001","priority":"P0","owner":"CI/CD + platform","summary":'
    json_escape "Run provider-backed release certification with one backend URL per provider."
    printf ',"doc":"docs/release/live-environment-work-items.md#p0-release-blockers"}'
    first=0
  fi
  if [[ "$security_item_needed" == "true" ]]; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    printf '{"id":"LIVE-002","priority":"P0","owner":"Security + CI/CD","summary":'
    json_escape "Produce live security certification evidence from the provider-backed release run."
    printf ',"doc":"docs/release/live-environment-work-items.md#p0-release-blockers"}'
    first=0
  fi
  if [[ "$ops_item_needed" == "true" ]]; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    printf '{"id":"LIVE-005","priority":"P1","owner":"SRE/platform","summary":'
    json_escape "Collect live operations evidence when production ops proof is in scope."
    printf ',"doc":"docs/release/live-environment-work-items.md#p1-enterprise-evidence"}'
    first=0
  fi
  if [[ "$security_assurance_item_needed" == "true" ]]; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    printf '{"id":"LIVE-007","priority":"P1","owner":"Security + release authority","summary":'
    json_escape "Provide regulated security-assurance evidence or formal risk acceptance."
    printf ',"doc":"docs/release/live-environment-work-items.md#p1-enterprise-evidence"}'
    first=0
  fi
  if [[ "$pds_baseline_item_needed" == "true" ]]; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    printf '{"id":"LIVE-015","priority":"P0","owner":"Release authority + security","summary":'
    json_escape "Retain PDS Security Baseline r4.5 traceability and evidence for production-readiness claims."
    printf ',"doc":"docs/release/live-environment-work-items.md#p0-release-blockers"}'
    printf ',{"id":"LIVE-016","priority":"P0","owner":"IAM + security + platform","summary":'
    json_escape "Prove PDS IAM, Okta, MFA, and user-lifecycle posture."
    printf ',"doc":"docs/release/live-environment-work-items.md#p0-release-blockers"}'
    printf ',{"id":"LIVE-017","priority":"P0","owner":"Security + platform","summary":'
    json_escape "Prove PDS secrets-management posture."
    printf ',"doc":"docs/release/live-environment-work-items.md#p0-release-blockers"}'
    printf ',{"id":"LIVE-018","priority":"P0","owner":"Network + platform + security","summary":'
    json_escape "Prove PDS internet-facing API and gateway posture."
    printf ',"doc":"docs/release/live-environment-work-items.md#p0-release-blockers"}'
    printf ',{"id":"LIVE-019","priority":"P1","owner":"SRE/platform + data owners + security","summary":'
    json_escape "Prove lower-environment data, backup, restore, and DR posture."
    printf ',"doc":"docs/release/live-environment-work-items.md#p1-enterprise-evidence"}'
    printf ',{"id":"LIVE-020","priority":"P1","owner":"Platform + network + database operations","summary":'
    json_escape "Prove host, cloud, network, and database hardening posture."
    printf ',"doc":"docs/release/live-environment-work-items.md#p1-enterprise-evidence"}'
    printf ',{"id":"LIVE-021","priority":"P1","owner":"Security operations + SRE + IAM","summary":'
    json_escape "Prove PDS SIEM, monitoring, and access-review posture."
    printf ',"doc":"docs/release/live-environment-work-items.md#p1-enterprise-evidence"}'
    first=0
  fi
  if [[ "$release_identity_item_needed" == "true" ]]; then
    if [[ "$first" != "1" ]]; then
      printf ','
    fi
    printf '{"id":"LIVE-004","priority":"P0","owner":"Release management + CI/CD","summary":'
    json_escape "Cut the first release candidate through the v* tag lane."
    printf ',"doc":"docs/release/live-environment-work-items.md#p0-release-blockers"}'
    printf ',{"id":"LIVE-014","priority":"P2","owner":"Legal + product leadership","summary":'
    json_escape "Select and approve the framework license for downstream consumers."
    printf ',"doc":"docs/release/live-environment-work-items.md#p2-follow-up"}'
  fi
  printf ']'
}

mcp_release_posture_check() {
  local artifact_file="${1:-}"
  local enabled="${APP_MCP_ENABLED:-false}"
  local normalized
  normalized="$(printf '%s' "$enabled" | tr '[:upper:]' '[:lower:]')"
  local ok=true
  local detail="MCP is excluded from the current release posture and must remain disabled."

  case "$normalized" in
    1|true|yes|on)
      ok=false
      ;;
  esac

  if [[ -n "$artifact_file" ]]; then
    local generated_at
    generated_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    {
      printf '{"command":"mcp-release-posture","ok":%s' "$ok"
      printf ',"generated_at_utc":'
      json_escape "$generated_at"
      printf ',"release_posture":"excluded"'
      printf ',"mcp_enabled":'
      json_escape "$enabled"
      printf ',"required_setting":"APP_MCP_ENABLED=false"'
      printf ',"detail":'
      json_escape "$detail"
      printf '}\n'
    } >"$artifact_file"
  fi

  if [[ "$ok" != "true" ]]; then
    printf '%s Current value: APP_MCP_ENABLED=%s\n' "$detail" "$enabled" >&2
    return 1
  fi
}

mcp_posture() {
  local json="$1"
  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local artifact_file="$report_dir/release-mcp-posture.json"
  mkdir -p "$report_dir"

  set +e
  mcp_release_posture_check "$artifact_file"
  local status=$?
  set -e

  if [[ "$json" == "1" ]]; then
    cat "$artifact_file"
  elif [[ $status -eq 0 ]]; then
    printf 'MCP release posture: OK (APP_MCP_ENABLED=%s)\n' "${APP_MCP_ENABLED:-false}"
    printf 'Evidence: %s\n' "$artifact_file"
  fi

  return "$status"
}

ops_certification_check() {
  local artifact_file="$1"
  mkdir -p "$(dirname "$artifact_file")"

  python3 - "$repo_root" "$artifact_file" <<'PY'
import datetime as dt
import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
artifact_file = Path(sys.argv[2]).resolve()
report_dir = artifact_file.parent

checks = []
artifacts = []
failures = []


def utc_now():
    return (
        dt.datetime.now(dt.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def env_flag_enabled(value):
    return str(value or "").strip().lower() in {
        "1",
        "true",
        "yes",
        "y",
        "on",
        "required",
        "require",
    }


def rel(path):
    path = Path(path).resolve()
    try:
        return path.relative_to(repo_root).as_posix()
    except ValueError:
        return path.as_posix()


def sha256(path):
    return "sha256:" + hashlib.sha256(Path(path).read_bytes()).hexdigest()


def artifact(name, path, required=True, status=None, detail=None):
    path = Path(path)
    present = path.is_file()
    item = {
        "name": name,
        "path": rel(path),
        "required": bool(required),
        "present": present,
        "status": status
        or ("present" if present else ("missing" if required else "not-applicable")),
    }
    if present:
        item["sha256"] = sha256(path)
        item["bytes"] = path.stat().st_size
    if detail:
        item["detail"] = detail
    artifacts.append(item)
    return present


def record(name, ok, path=None, detail=None, blocking=True):
    check = {"name": name, "ok": bool(ok), "blocking": bool(blocking)}
    if path is not None:
        check["artifact"] = rel(path)
    if detail:
        check["detail"] = detail
    checks.append(check)
    if not ok and blocking:
        failures.append(name if detail is None else f"{name}: {detail}")


def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8")
    except Exception:
        return ""


def check_text_file(name, path, tokens):
    present = artifact(name, path, required=True)
    record(f"{name} artifact is present", present, path)
    text = read_text(path)
    for token in tokens:
        record(f"{name} references {token}", token in text, path)
    return text


alerts = repo_root / "observability/prometheus/alerts.yml"
alerts_text = check_text_file(
    "prometheus-alert-rules",
    alerts,
    [
        "BackendTargetDown",
        "BackendHigh5xxErrorRate",
        "BackendHighRequestLatencyP95",
        "ProviderSlowOperationsP95",
        "ProviderPoolSaturation",
        "app_provider_operation_duration_seconds_bucket",
        "app_provider_pool_pressure",
    ],
)
record(
    "provider latency alert uses histogram quantile",
    "histogram_quantile" in alerts_text
    and "provider, data_source, entity, operation" in alerts_text,
    alerts,
)

check_text_file(
    "prometheus-config",
    repo_root / "observability/prometheus/prometheus.yml",
    ["/etc/prometheus/alerts.yml", "alertmanager:9093", "app-framework-backend", "/metrics"],
)
check_text_file(
    "alertmanager-config",
    repo_root / "observability/alertmanager/alertmanager.yml",
    ["placeholder-alert-webhook", "group_by", "receiver"],
)
check_text_file(
    "alloy-log-pipeline",
    repo_root / "observability/alloy/config.alloy",
    [
        "stage.structured_metadata",
        "request_id",
        "correlation_id",
        "stage.replace",
        "stage.luhn",
    ],
)

dashboard = repo_root / "observability/grafana/dashboards/app-framework-backend.json"
dashboard_present = artifact("grafana-backend-dashboard", dashboard, required=True)
record("grafana backend dashboard artifact is present", dashboard_present, dashboard)
if dashboard_present:
    try:
        dashboard_json = json.loads(dashboard.read_text(encoding="utf-8"))
        dashboard_text = json.dumps(dashboard_json)
        record("grafana backend dashboard parses as JSON", True, dashboard)
        for token in [
            "app_provider_operation_duration_seconds",
            "app_provider_operation_duration_seconds_max",
            "app_provider_query_count_total",
            "app_provider_result_count_total",
            "app_provider_pool_pressure",
        ]:
            record(f"grafana dashboard references {token}", token in dashboard_text, dashboard)
    except Exception as exc:
        record("grafana backend dashboard parses as JSON", False, dashboard, str(exc))

check_text_file(
    "observability-runbook",
    repo_root / "observability/README.md",
    [
        "ProviderSlowOperationsP95",
        "OpenTelemetry Export Contract",
        "otel_export_contract_is_reflected_in_alloy_and_runbook",
        "observability_bundle_links_provider_latency_alert_dashboard_and_runbook",
    ],
)
check_text_file(
    "deployment-observability-reference",
    repo_root / "docs/release/deployment-reference.md",
    ["OpenTelemetry traces and metrics", "/health/ready", "/metrics", "retention"],
)

promtool_required = env_flag_enabled(os.environ.get("APPFW_REQUIRE_PROMTOOL")) or env_flag_enabled(
    os.environ.get("APPFW_RELEASE_REQUIRE_PROMTOOL")
)
promtool = shutil.which("promtool")
if promtool_required:
    record("promtool is installed", bool(promtool), detail="APPFW_REQUIRE_PROMTOOL is enabled")
    if promtool:
        result = subprocess.run(
            [promtool, "check", "rules", (repo_root / "observability/prometheus/alerts.yml").as_posix()],
            text=True,
            capture_output=True,
        )
        log_path = report_dir / "ops-promtool-rules.log"
        log_path.write_text(result.stdout + result.stderr, encoding="utf-8")
        artifact("promtool-rules-log", log_path, required=True)
        record("promtool validates Prometheus alert rules", result.returncode == 0, log_path)
else:
    record(
        "promtool validation is optional for this evidence bundle",
        True,
        detail="set APPFW_RELEASE_REQUIRE_PROMTOOL=true in release CI to make it blocking",
        blocking=False,
    )

static_bundle_verified = not failures
live_required = env_flag_enabled(os.environ.get("APPFW_REQUIRE_LIVE_OPS_EVIDENCE")) or env_flag_enabled(
    os.environ.get("APPFW_RELEASE_REQUIRE_LIVE_OPS_EVIDENCE")
)
default_live_artifacts = [
    "live-otel-evidence.json",
    "health-ready.json",
    "metrics.prom",
    "metrics.json",
    "prometheus-targets.json",
    "prometheus-rules.json",
    "alertmanager-status.json",
    "grafana-dashboard-provisioning.json",
    "runbook-drill.json",
]
configured = [
    item.strip()
    for item in os.environ.get("APPFW_OPS_EVIDENCE_FILES", "").replace("\n", ",").split(",")
    if item.strip()
]
live_artifacts = configured or default_live_artifacts
for item in live_artifacts:
    path = Path(item)
    if not path.is_absolute():
        path = report_dir / path
    present = artifact(
        "live-ops-evidence",
        path,
        required=live_required,
        status="present" if path.is_file() else ("missing" if live_required else "not-applicable"),
        detail="live ops evidence retained by release CI" if live_required else None,
    )
    if live_required:
        record(
            "required live ops evidence artifact is present",
            present,
            path,
            None if present else f"missing {rel(path)}",
        )
        if present and path.suffix == ".json":
            try:
                value = json.loads(path.read_text(encoding="utf-8"))
                is_json_object = isinstance(value, dict)
                record("live ops JSON evidence parses", isinstance(value, (dict, list)), path)
                record(
                    "live ops JSON evidence ok flag is true",
                    is_json_object and value.get("ok") is True,
                    path,
                    "required live ops evidence must report ok=true",
                )
                if path.name == "live-otel-evidence.json":
                    otel = value.get("otel") if is_json_object else {}
                    otel = otel if isinstance(otel, dict) else {}
                    endpoint_configured = bool(otel.get("shared_endpoint_configured")) or (
                        bool(otel.get("traces_endpoint_configured"))
                        and bool(otel.get("metrics_endpoint_configured"))
                    )
                    record(
                        "live OTLP evidence shows exporter enabled",
                        otel.get("app_otel_enabled") is True,
                        path,
                        "APP_OTEL_ENABLED must be true for live OTLP release evidence",
                    )
                    record(
                        "live OTLP evidence has service identity",
                        otel.get("service_name_configured") is True,
                        path,
                        "OTEL_SERVICE_NAME or APP_SERVICE_NAME must be configured",
                    )
                    record(
                        "live OTLP evidence has exporter endpoint",
                        endpoint_configured,
                        path,
                        "configure OTEL_EXPORTER_OTLP_ENDPOINT or both trace and metric endpoints",
                    )
                    record(
                        "live OTLP evidence has protocol",
                        otel.get("protocol_configured") is True,
                        path,
                        "OTEL_EXPORTER_OTLP_PROTOCOL must be configured",
                    )
                elif path.name == "runbook-drill.json":
                    steps = value.get("steps") if is_json_object else []
                    steps = steps if isinstance(steps, list) else []
                    all_steps_passed = bool(steps) and all(
                        isinstance(step, dict) and step.get("passed") is True for step in steps
                    )
                    record(
                        "runbook drill evidence has passing steps",
                        all_steps_passed,
                        path,
                        "runbook-drill.json must record at least one passed drill step and no failed steps",
                    )
                elif path.name == "alertmanager-status.json":
                    live_endpoint = value.get("live_endpoint") is True if is_json_object else False
                    status = value.get("status") if is_json_object else None
                    record(
                        "Alertmanager evidence is live",
                        live_endpoint and status != "static-config-retained",
                        path,
                        "live ops release evidence must prove a live Alertmanager endpoint, not only retained static config",
                    )
            except Exception as exc:
                record("live ops JSON evidence parses", False, path, str(exc))

if not live_required:
    record(
        "live ops evidence is not required for this local bundle",
        True,
        detail="set APPFW_RELEASE_REQUIRE_LIVE_OPS_EVIDENCE=true in production release gates",
        blocking=False,
    )

release_blockers = []
if not live_required:
    release_blockers.append(
        "live operations evidence was not required; set APPFW_RELEASE_REQUIRE_LIVE_OPS_EVIDENCE=true in production release gates"
    )
if failures:
    release_blockers.extend(failures)

release_ready = not failures and live_required
remediation_work_items = []
if not release_ready:
    remediation_work_items.append(
        {
            "id": "LIVE-005",
            "priority": "P1",
            "owner": "SRE/platform",
            "summary": "Collect live operations evidence when production ops proof is in scope.",
            "doc": "docs/release/live-environment-work-items.md#p1-enterprise-evidence",
        }
    )

evidence = {
    "command": "ops-certification",
    "ok": not failures,
    "release_ready": release_ready,
    "generated_at_utc": utc_now(),
    "static_bundle_verified": static_bundle_verified,
    "live_evidence_required": live_required,
    "promtool_required": promtool_required,
    "checks": checks,
    "artifacts": artifacts,
    "failure_count": len(failures),
    "failures": failures,
    "release_blockers": release_blockers,
    "failure_summary": {
        "root_causes": release_blockers,
    },
    "remediation_work_items": remediation_work_items,
}
artifact_file.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if failures:
    print(f"ops-certification: FAILED; evidence written to {artifact_file}", file=sys.stderr)
    for failure in failures:
        print(f"  - {failure}", file=sys.stderr)
    sys.exit(1)

if release_ready:
    print(f"ops-certification: OK; release_ready=true; evidence written to {artifact_file}")
else:
    print(f"ops-certification: OK; release_ready=false; evidence written to {artifact_file}")
    print("  - live operations evidence is not required for this local bundle", file=sys.stderr)
PY
}

ops_certification() {
  local json="$1"
  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local artifact_file="$report_dir/ops-certification.json"
  local log_file="$report_dir/ops-certification.log"
  mkdir -p "$report_dir"

  set +e
  if [[ "$json" == "1" ]]; then
    ops_certification_check "$artifact_file" >"$log_file" 2>&1
  else
    ops_certification_check "$artifact_file"
  fi
  local status=$?
  set -e

  if [[ "$json" == "1" ]]; then
    cat "$artifact_file"
  elif [[ $status -eq 0 ]]; then
    printf 'Operations certification: OK\n'
    printf 'Evidence: %s\n' "$artifact_file"
  fi

  return "$status"
}

pds_baseline_check() {
  local artifact_file="$1"
  python3 - "$repo_root" "$artifact_file" <<'PY'
import json
import hashlib
import os
import sys
from datetime import date, datetime, timedelta, timezone
from pathlib import Path


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def env_bool(name: str) -> bool:
    return os.environ.get(name, "").strip().lower() in {"1", "true", "yes", "y", "on", "required", "require"}


def positive_int_env(name: str, default: int, upper_bound: int | None = None) -> tuple[int, str]:
    value = os.environ.get(name, "").strip()
    if not value:
        return default, ""
    try:
        parsed = int(value)
    except ValueError:
        return default, f"{name} must be a positive integer"
    if parsed <= 0:
        return default, f"{name} must be greater than zero"
    if upper_bound is not None and parsed > upper_bound:
        return default, f"{name} must be no greater than {upper_bound}"
    return parsed, ""


def split_paths(value: str) -> list[str]:
    if not value:
        return []
    normalized = value.replace("\n", os.pathsep).replace(",", os.pathsep)
    return [part.strip() for part in normalized.split(os.pathsep) if part.strip()]


repo_root = Path(sys.argv[1])
artifact_file = Path(sys.argv[2])
report_dir = artifact_file.parent
traceability_doc = repo_root / "docs/release/pds-security-baseline-traceability.md"
work_items_doc = repo_root / "docs/release/live-environment-work-items.md"
baseline_version = "r4.5"
risk_acceptance_max_days_policy_limit = 365
risk_acceptance_max_days, risk_acceptance_max_days_issue = positive_int_env(
    "APPFW_PDS_BASELINE_RISK_ACCEPTANCE_MAX_DAYS",
    risk_acceptance_max_days_policy_limit,
    upper_bound=risk_acceptance_max_days_policy_limit,
)

required_work_items = [
    {
        "id": "LIVE-015",
        "priority": "P0",
        "owner": "Release authority + security",
        "summary": "Retain PDS Security Baseline r4.5 traceability for production-readiness claims.",
        "doc": "docs/release/live-environment-work-items.md#p0-release-blockers",
    },
    {
        "id": "LIVE-016",
        "priority": "P0",
        "owner": "IAM + security + platform",
        "summary": "Prove PDS IAM, Okta, MFA, and user-lifecycle posture.",
        "doc": "docs/release/live-environment-work-items.md#p0-release-blockers",
    },
    {
        "id": "LIVE-017",
        "priority": "P0",
        "owner": "Security + platform",
        "summary": "Prove PDS secrets-management posture.",
        "doc": "docs/release/live-environment-work-items.md#p0-release-blockers",
    },
    {
        "id": "LIVE-018",
        "priority": "P0",
        "owner": "Network + platform + security",
        "summary": "Prove PDS internet-facing API and gateway posture.",
        "doc": "docs/release/live-environment-work-items.md#p0-release-blockers",
    },
    {
        "id": "LIVE-019",
        "priority": "P1",
        "owner": "SRE/platform + data owners + security",
        "summary": "Prove lower-environment data, backup, restore, and DR posture.",
        "doc": "docs/release/live-environment-work-items.md#p1-enterprise-evidence",
    },
    {
        "id": "LIVE-020",
        "priority": "P1",
        "owner": "Platform + network + database operations",
        "summary": "Prove host, cloud, network, and database hardening posture.",
        "doc": "docs/release/live-environment-work-items.md#p1-enterprise-evidence",
    },
    {
        "id": "LIVE-021",
        "priority": "P1",
        "owner": "Security operations + SRE + IAM",
        "summary": "Prove PDS SIEM, monitoring, and access-review posture.",
        "doc": "docs/release/live-environment-work-items.md#p1-enterprise-evidence",
    },
]

baseline_areas = [
    "Encryption in transit and at rest",
    "Lower-environment data",
    "Human IAM and SSO",
    "User lifecycle management",
    "Authorization / least privilege",
    "Non-human identities and service accounts",
    "Secrets management",
    "Host, endpoint, and patch posture",
    "Database security",
    "Backup and restore",
    "Security monitoring and SIEM",
    "Internet-facing service gateway",
    "Application security scanning",
    "API security",
    "Cloud controls",
    "Mobile application controls",
    "Exceptions and risk acceptance",
]

checks = []
failures = []
decision_summary = {
    "covered_work_items": [],
    "evidence_backed_work_items": [],
    "risk_accepted_work_items": [],
}
evidence_artifacts_by_path = {}


def add_check(name: str, ok: bool, detail: str, blocking: bool = True) -> None:
    checks.append({"name": name, "ok": ok, "blocking": blocking, "detail": detail})
    if blocking and not ok:
        failures.append(detail)


add_check(
    "PDS risk acceptance max-days policy is valid",
    not risk_acceptance_max_days_issue,
    risk_acceptance_max_days_issue or f"max_days {risk_acceptance_max_days}",
)


def sha256_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def retained_file_artifact(name: str, path: Path, present: bool | None = None, work_item_id: str | None = None) -> dict:
    if present is None:
        present = path.is_file()
    artifact = {
        "name": name,
        "path": path.as_posix(),
        "present": present,
        "ok": present,
    }
    if work_item_id:
        artifact["work_item_id"] = work_item_id
    if present:
        artifact["sha256"] = f"sha256:{sha256_digest(path)}"
        artifact["bytes"] = path.stat().st_size
    return artifact


def path_is_within_directory(path: Path, directory: Path) -> bool:
    try:
        path.resolve(strict=False).relative_to(directory.resolve(strict=False))
    except ValueError:
        return False
    return True


def add_evidence_artifact(path: Path, work_item_id: str) -> None:
    key = path.resolve().as_posix()
    artifact = retained_file_artifact(f"PDS {work_item_id} evidence", path, present=True, work_item_id=work_item_id)
    existing = evidence_artifacts_by_path.get(key)
    if existing is not None:
        work_items = set(existing.get("work_item_ids", []))
        work_items.add(work_item_id)
        existing["work_item_ids"] = sorted(work_items)
        existing["work_item_id"] = existing["work_item_ids"][0]
        existing["name"] = "PDS evidence"
        return
    artifact["work_item_ids"] = [work_item_id]
    evidence_artifacts_by_path[key] = artifact


def non_empty(value: object) -> bool:
    return isinstance(value, str) and bool(value.strip())


def as_list(value: object) -> list[object]:
    if value is None:
        return []
    if isinstance(value, list):
        return value
    return [value]


def first_non_empty(mapping: object, keys: tuple[str, ...]) -> str:
    if not isinstance(mapping, dict):
        return ""
    for key in keys:
        value = mapping.get(key)
        if non_empty(value):
            return value.strip()
    return ""


def nested_mapping(mapping: object, keys: tuple[str, ...]) -> dict:
    if not isinstance(mapping, dict):
        return {}
    for key in keys:
        value = mapping.get(key)
        if isinstance(value, dict):
            return value
    return {}


def baseline_version_from(decision_obj: object) -> str:
    if not isinstance(decision_obj, dict):
        return ""
    baseline = decision_obj.get("baseline")
    if isinstance(baseline, dict):
        version = baseline.get("version")
        if non_empty(version):
            return version.strip()
    version = decision_obj.get("baseline_version")
    if non_empty(version):
        return version.strip()
    return ""


def parse_expiry_date(value: str):
    text = value.strip()
    try:
        if "T" in text:
            normalized = text.replace("Z", "+00:00")
            parsed = datetime.fromisoformat(normalized)
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone.utc)
            return parsed.astimezone(timezone.utc).date()
        return date.fromisoformat(text[:10])
    except ValueError:
        return None


def parse_approval_timestamp(value: str):
    text = value.strip()
    if not text:
        return None
    try:
        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return None
    return parsed.astimezone(timezone.utc)


def collect_decision_entries(decision_obj: object) -> list[dict]:
    if not isinstance(decision_obj, dict):
        return []
    entries: list[dict] = []
    for collection_name in ("work_items", "categories"):
        collection = decision_obj.get(collection_name)
        if isinstance(collection, list):
            entries.extend(entry for entry in collection if isinstance(entry, dict))
        elif isinstance(collection, dict):
            for key, value in collection.items():
                if isinstance(value, dict):
                    entry = dict(value)
                    entry.setdefault("id", key)
                    entries.append(entry)
    return entries


def collect_work_item_ids(entry: dict) -> set[str]:
    values: list[object] = []
    for key in ("id", "work_item_id", "workItemId"):
        values.extend(as_list(entry.get(key)))
    for key in ("ids", "work_item_ids", "workItemIds"):
        values.extend(as_list(entry.get(key)))
    return {str(value).strip().upper() for value in values if non_empty(value)}


def collect_evidence_paths(entry: dict) -> list[str]:
    paths: list[str] = []
    for key in ("evidence_files", "artifact_files", "artifacts", "evidence"):
        for value in as_list(entry.get(key)):
            if non_empty(value):
                paths.append(value.strip())
            elif isinstance(value, dict):
                path = first_non_empty(value, ("path", "file", "artifact", "uri"))
                if path:
                    paths.append(path)
    return paths


def resolve_evidence_path(path_text: str, decision_path: Path) -> Path | None:
    candidate = Path(path_text).expanduser()
    if candidate.is_absolute():
        return candidate if candidate.is_file() else None
    for base in (report_dir, decision_path.parent, repo_root):
        resolved = base / candidate
        if resolved.is_file():
            return resolved
    return None


def validate_risk_acceptance(entry: dict, work_item_id: str) -> bool:
    risk = nested_mapping(entry, ("risk_acceptance", "riskAcceptance", "exception", "risk"))
    ok = True
    field_specs = (
        ("owner", ("owner", "risk_owner")),
        ("approver", ("approver", "approved_by")),
        ("scope", ("scope", "affected_scope", "impact_scope")),
        ("expiry", ("expires_on", "expires_at", "expiration_date", "expiry")),
        ("rationale", ("rationale", "justification")),
        ("compensating controls", ("compensating_controls", "compensatingControls")),
        ("follow-up", ("follow_up", "follow_up_work_item", "followUp")),
    )
    for label, keys in field_specs:
        value = first_non_empty(risk, keys)
        add_check(
            f"PDS {work_item_id} risk acceptance has {label}",
            bool(value),
            value or f"PDS baseline decision risk acceptance for {work_item_id} must include {label}",
        )
        ok = ok and bool(value)

    expiry = first_non_empty(risk, ("expires_on", "expires_at", "expiration_date", "expiry"))
    parsed_expiry = parse_expiry_date(expiry) if expiry else None
    add_check(
        f"PDS {work_item_id} risk acceptance expiry is valid",
        parsed_expiry is not None,
        expiry or f"PDS baseline decision risk acceptance for {work_item_id} must include an ISO expires_on date",
    )
    if parsed_expiry is not None:
        not_expired = parsed_expiry >= datetime.now(timezone.utc).date()
        add_check(
            f"PDS {work_item_id} risk acceptance is unexpired",
            not_expired,
            f"expires_on {parsed_expiry.isoformat()}"
            if not_expired
            else f"PDS baseline decision risk acceptance for {work_item_id} expired on {parsed_expiry.isoformat()}",
        )
        within_window = parsed_expiry <= datetime.now(timezone.utc).date() + timedelta(days=risk_acceptance_max_days)
        add_check(
            f"PDS {work_item_id} risk acceptance expiry is within max window",
            within_window,
            f"expires_on {parsed_expiry.isoformat()}, max_days {risk_acceptance_max_days}"
            if within_window
            else (
                f"PDS baseline decision risk acceptance for {work_item_id} expires on "
                f"{parsed_expiry.isoformat()}, beyond max_days {risk_acceptance_max_days}"
            ),
        )
        ok = ok and not_expired and within_window
    else:
        ok = False
    return ok


def validate_decision_schema(decision_obj: object, decision_path: Path) -> None:
    is_object = isinstance(decision_obj, dict)
    add_check(
        "PDS baseline decision artifact is a JSON object",
        is_object,
        "decision artifact is a JSON object" if is_object else "pds-baseline-decision.json must be a JSON object",
    )
    if not is_object:
        return

    release_ready_declared = decision_obj.get("ok") is True and decision_obj.get("release_ready") is True
    add_check(
        "PDS baseline decision artifact is release-ready",
        release_ready_declared,
        "ok:true and release_ready:true"
        if release_ready_declared
        else "pds-baseline-decision.json must declare ok:true and release_ready:true",
    )
    decision_baseline_version = baseline_version_from(decision_obj)
    add_check(
        "PDS baseline decision artifact references baseline r4.5",
        decision_baseline_version == baseline_version,
        f"baseline version {decision_baseline_version}"
        if decision_baseline_version == baseline_version
        else "pds-baseline-decision.json must declare baseline.version or baseline_version as r4.5",
    )

    authority = nested_mapping(decision_obj, ("release_authority", "authority", "approval"))
    authority_owner = first_non_empty(authority, ("owner", "release_owner")) or first_non_empty(
        decision_obj, ("owner", "release_owner")
    )
    authority_approver = first_non_empty(authority, ("approver", "approved_by")) or first_non_empty(
        decision_obj, ("approver", "approved_by")
    )
    authority_approved_at = first_non_empty(authority, ("approved_at_utc", "approved_at", "approved_on")) or first_non_empty(
        decision_obj, ("approved_at_utc", "approved_at", "approved_on")
    )
    for label, value in (
        ("owner", authority_owner),
        ("approver", authority_approver),
        ("approved_at_utc", authority_approved_at),
    ):
        add_check(
            f"PDS baseline release authority has {label}",
            bool(value),
            value or f"pds-baseline-decision.json must include release authority {label}",
        )

    approved_at = parse_approval_timestamp(authority_approved_at) if authority_approved_at else None
    add_check(
        "PDS baseline release authority approved_at_utc is an ISO-8601 timestamp with timezone",
        approved_at is not None,
        approved_at.isoformat().replace("+00:00", "Z")
        if approved_at is not None
        else "pds-baseline-decision.json release authority approved_at_utc must be an ISO-8601 timestamp with timezone",
    )
    if approved_at is not None:
        not_future = approved_at <= datetime.now(timezone.utc) + timedelta(minutes=5)
        add_check(
            "PDS baseline release authority approved_at_utc is not in the future",
            not_future,
            approved_at.isoformat().replace("+00:00", "Z")
            if not_future
            else "pds-baseline-decision.json release authority approved_at_utc must not be in the future",
        )

    entries = collect_decision_entries(decision_obj)
    entries_present = bool(entries)
    add_check(
        "PDS baseline decision artifact maps work items",
        entries_present,
        f"{len(entries)} work item/category entries"
        if entries_present
        else "pds-baseline-decision.json must include work_items or categories mapping LIVE-015 through LIVE-021",
    )

    entries_by_work_item: dict[str, list[dict]] = {}
    for entry in entries:
        for work_item_id in collect_work_item_ids(entry):
            entries_by_work_item.setdefault(work_item_id, []).append(entry)

    covered: list[str] = []
    evidence_backed: list[str] = []
    risk_accepted: list[str] = []
    evidence_statuses = {"evidence", "proven", "satisfied", "complete"}
    risk_statuses = {"risk-accepted", "risk_accepted", "exception"}

    for item in required_work_items:
        work_item_id = item["id"]
        item_entries = entries_by_work_item.get(work_item_id, [])
        item_covered = bool(item_entries)
        add_check(
            f"PDS baseline decision covers {work_item_id}",
            item_covered,
            f"{work_item_id} has {len(item_entries)} decision entr{'y' if len(item_entries) == 1 else 'ies'}"
            if item_covered
            else f"pds-baseline-decision.json must map {work_item_id} to evidence or risk acceptance",
        )
        if not item_entries:
            continue
        covered.append(work_item_id)
        item_valid = False
        for entry in item_entries:
            status = str(entry.get("status", "")).strip().lower()
            status_allowed = status in evidence_statuses or status in risk_statuses
            add_check(
                f"PDS {work_item_id} decision status is allowed",
                status_allowed,
                f"status {status}" if status_allowed else f"PDS baseline decision for {work_item_id} must use status evidence or risk-accepted",
            )
            evidence_paths = collect_evidence_paths(entry)
            if status in evidence_statuses:
                evidence_paths_present = bool(evidence_paths)
                add_check(
                    f"PDS {work_item_id} decision lists evidence files",
                    evidence_paths_present,
                    f"{len(evidence_paths)} evidence file{'s' if len(evidence_paths) != 1 else ''}"
                    if evidence_paths_present
                    else f"PDS baseline decision for {work_item_id} must list evidence_files",
                )
                evidence_ok = evidence_paths_present
                for evidence_path in evidence_paths:
                    resolved = resolve_evidence_path(evidence_path, decision_path)
                    add_check(
                        f"PDS {work_item_id} evidence file exists: {Path(evidence_path).name}",
                        resolved is not None,
                        resolved.as_posix()
                        if resolved is not None
                        else f"missing PDS baseline decision evidence file for {work_item_id}: {evidence_path}",
                    )
                    evidence_retained = resolved is not None and path_is_within_directory(resolved, report_dir)
                    add_check(
                        f"PDS {work_item_id} evidence file is retained in report directory",
                        evidence_retained,
                        (
                            f"{resolved.as_posix()} is retained under {report_dir.as_posix()}"
                            if evidence_retained
                            else f"PDS baseline decision evidence file for {work_item_id} must be retained under {report_dir.as_posix()}: {evidence_path}"
                        ),
                    )
                    evidence_non_empty = resolved is not None and resolved.stat().st_size > 0
                    add_check(
                        f"PDS {work_item_id} evidence file is non-empty",
                        evidence_non_empty,
                        (
                            f"{resolved.as_posix()} has {resolved.stat().st_size} bytes"
                            if evidence_non_empty
                            else f"PDS baseline decision evidence file for {work_item_id} must be non-empty: {evidence_path}"
                        ),
                    )
                    if resolved is not None:
                        if evidence_retained and evidence_non_empty:
                            add_evidence_artifact(resolved, work_item_id)
                    evidence_ok = evidence_ok and evidence_retained and evidence_non_empty
                if evidence_ok:
                    item_valid = True
                    evidence_backed.append(work_item_id)
            elif status in risk_statuses and validate_risk_acceptance(entry, work_item_id):
                item_valid = True
                risk_accepted.append(work_item_id)
        add_check(
            f"PDS baseline decision satisfies {work_item_id}",
            item_valid,
            f"{work_item_id} satisfied"
            if item_valid
            else f"pds-baseline-decision.json must satisfy {work_item_id} with existing evidence files or an unexpired risk acceptance",
        )

    decision_summary["covered_work_items"] = sorted(set(covered))
    decision_summary["evidence_backed_work_items"] = sorted(set(evidence_backed))
    decision_summary["risk_accepted_work_items"] = sorted(set(risk_accepted))


traceability_text = ""
if traceability_doc.is_file():
    traceability_text = traceability_doc.read_text(encoding="utf-8")
add_check(
    "traceability document is present",
    traceability_doc.is_file(),
    traceability_doc.relative_to(repo_root).as_posix(),
)

work_items_text = ""
if work_items_doc.is_file():
    work_items_text = work_items_doc.read_text(encoding="utf-8")
add_check(
    "live work item document is present",
    work_items_doc.is_file(),
    work_items_doc.relative_to(repo_root).as_posix(),
)

for area in baseline_areas:
    add_check(
        f"traceability covers {area}",
        area in traceability_text,
        f"required baseline area in {traceability_doc.relative_to(repo_root).as_posix()}: {area}",
    )

for item in required_work_items:
    add_check(
        f"work item {item['id']} is tracked",
        item["id"] in work_items_text and item["id"] in traceability_text,
        f"required work item in PDS baseline traceability and live work items: {item['id']}",
    )

live_required = env_bool("APPFW_RELEASE_REQUIRE_PDS_BASELINE_EVIDENCE") or env_bool("APPFW_RELEASE_REQUIRE_PDS_BASELINE")
decision_file = Path(os.environ.get("APPFW_PDS_BASELINE_DECISION_FILE", report_dir / "pds-baseline-decision.json"))
evidence_files = [Path(item) for item in split_paths(os.environ.get("APPFW_PDS_BASELINE_EVIDENCE_FILES", ""))]

decision = None
decision_artifact = retained_file_artifact("PDS baseline decision", decision_file)
if live_required:
    decision_file_exists = decision_file.is_file()
    decision_artifact = retained_file_artifact("PDS baseline decision", decision_file, present=decision_file_exists)
    add_check(
        "PDS baseline decision artifact is present",
        decision_file_exists,
        decision_file.as_posix() if decision_file_exists else f"missing {decision_file.as_posix()}",
    )
    decision_file_retained = path_is_within_directory(decision_file, report_dir)
    add_check(
        "PDS baseline decision artifact is retained in report directory",
        decision_file_retained,
        (
            f"{decision_file.as_posix()} is retained under {report_dir.as_posix()}"
            if decision_file_retained
            else f"PDS baseline decision artifact must be retained under {report_dir.as_posix()}: {decision_file.as_posix()}"
        ),
    )
    if decision_file_exists:
        try:
            decision = json.loads(decision_file.read_text(encoding="utf-8"))
            add_check(
                "PDS baseline decision artifact parses as JSON",
                True,
                decision_file.as_posix(),
            )
            validate_decision_schema(decision, decision_file)
        except Exception as exc:  # noqa: BLE001 - artifact validation report should preserve parse errors
            add_check(
                "PDS baseline decision artifact parses as JSON",
                False,
                f"failed to parse {decision_file.as_posix()}: {exc}",
            )
    for evidence_file in evidence_files:
        evidence_file_exists = evidence_file.is_file()
        add_check(
            f"PDS baseline evidence file exists: {evidence_file.name}",
            evidence_file_exists,
            evidence_file.as_posix() if evidence_file_exists else f"missing PDS baseline evidence file {evidence_file.as_posix()}",
        )
        if evidence_file_exists:
            evidence_file_retained = path_is_within_directory(evidence_file, report_dir)
            add_check(
                f"PDS baseline evidence file is retained in report directory: {evidence_file.name}",
                evidence_file_retained,
                (
                    f"{evidence_file.as_posix()} is retained under {report_dir.as_posix()}"
                    if evidence_file_retained
                    else f"PDS baseline evidence file must be retained under {report_dir.as_posix()}: {evidence_file.as_posix()}"
                ),
            )
            if evidence_file_retained:
                evidence_file_non_empty = evidence_file.stat().st_size > 0
                add_check(
                    f"PDS baseline evidence file is non-empty: {evidence_file.name}",
                    evidence_file_non_empty,
                    (
                        f"{evidence_file.as_posix()} has {evidence_file.stat().st_size} bytes"
                        if evidence_file_non_empty
                        else f"PDS baseline evidence file must be non-empty: {evidence_file.as_posix()}"
                    ),
                )
            else:
                evidence_file_non_empty = False
            if evidence_file_retained and evidence_file_non_empty:
                key = evidence_file.resolve().as_posix()
                evidence_artifacts_by_path.setdefault(
                    key,
                    retained_file_artifact("PDS supplemental evidence", evidence_file, present=True),
                )
else:
    add_check(
        "live PDS baseline evidence is not required for this local bundle",
        True,
        "set APPFW_RELEASE_REQUIRE_PDS_BASELINE_EVIDENCE=true in production release gates",
        blocking=False,
    )

release_blockers = []
if not live_required:
    release_blockers.append(
        "PDS Security Baseline r4.5 live evidence was not required; set APPFW_RELEASE_REQUIRE_PDS_BASELINE_EVIDENCE=true in production release gates"
    )
if failures:
    release_blockers.extend(failures)

release_ready = not failures and live_required
remediation_work_items = [] if release_ready else required_work_items

artifact_file.parent.mkdir(parents=True, exist_ok=True)
evidence = {
    "command": "pds-baseline",
    "ok": not failures,
    "release_ready": release_ready,
    "generated_at_utc": utc_now(),
    "baseline": {
        "name": "PDS Health IT Security Baseline Standard",
        "version": baseline_version,
        "source_distribution": "internal PDS PDF; not committed to this repository",
        "traceability_doc": traceability_doc.relative_to(repo_root).as_posix(),
    },
    "live_evidence_required": live_required,
    "decision_file": decision_file.as_posix(),
    "decision_artifact": decision_artifact,
    "decision_summary": decision_summary,
    "risk_acceptance": {
        "max_days": risk_acceptance_max_days,
    },
    "evidence_files": [path.as_posix() for path in evidence_files],
    "evidence_artifacts": sorted(
        evidence_artifacts_by_path.values(),
        key=lambda item: item.get("path", ""),
    ),
    "checks": checks,
    "failure_count": len(failures),
    "failures": failures,
    "release_blockers": release_blockers,
    "failure_summary": {"root_causes": release_blockers},
    "remediation_work_items": remediation_work_items,
}
artifact_file.write_text(json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if failures:
    print(f"pds-baseline: FAILED; evidence written to {artifact_file}", file=sys.stderr)
    for failure in failures:
        print(f"  - {failure}", file=sys.stderr)
    sys.exit(1)

if release_ready:
    print(f"pds-baseline: OK; release_ready=true; evidence written to {artifact_file}")
else:
    print(f"pds-baseline: OK; release_ready=false; evidence written to {artifact_file}")
    print("  - live PDS baseline evidence is not required for this local bundle", file=sys.stderr)
PY
}

pds_baseline() {
  local json="$1"
  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local artifact_file="$report_dir/pds-security-baseline.json"
  local log_file="$report_dir/pds-security-baseline.log"
  mkdir -p "$report_dir"

  set +e
  if [[ "$json" == "1" ]]; then
    pds_baseline_check "$artifact_file" >"$log_file" 2>&1
  else
    pds_baseline_check "$artifact_file"
  fi
  local status=$?
  set -e

  if [[ "$json" == "1" ]]; then
    cat "$artifact_file"
  elif [[ $status -eq 0 ]]; then
    printf 'PDS baseline traceability: OK\n'
    printf 'Evidence: %s\n' "$artifact_file"
  fi

  return "$status"
}

release_identity_check() {
  local artifact_file="$1"
  local report_dir
  report_dir="$(dirname "$artifact_file")"
  APPFW_RELEASE_ARTIFACT_DIR="$report_dir" bash "$script_dir/ci/release-identity-check.sh"
}

release_identity() {
  local json="$1"
  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local artifact_file="$report_dir/release-identity.json"
  local log_file="$report_dir/release-identity.log"
  mkdir -p "$report_dir"

  set +e
  if [[ "$json" == "1" ]]; then
    release_identity_check "$artifact_file" >"$log_file" 2>&1
  else
    release_identity_check "$artifact_file"
  fi
  local status=$?
  set -e

  if [[ "$json" == "1" ]]; then
    cat "$artifact_file"
  elif [[ $status -eq 0 ]]; then
    printf 'Release identity evidence: OK\n'
    printf 'Evidence: %s\n' "$artifact_file"
  fi

  return "$status"
}

package_version_from_manifest() {
  local manifest="$1"
  sed -n 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -1
}

appfw_platform_id() {
  local os arch
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"
  printf '%s-%s' "$os" "$arch"
}

sha256_file() {
  local file="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    sha256sum "$file" | awk '{print $1}'
  fi
}

framework_source_commit_short() {
  if [[ -n "${APPFW_SOURCE_COMMIT:-}" ]]; then
    printf '%s\n' "$APPFW_SOURCE_COMMIT"
  elif git -C "$framework_root" rev-parse --short HEAD >/dev/null 2>&1; then
    git -C "$framework_root" rev-parse --short HEAD
  else
    printf 'unknown\n'
  fi
}

framework_source_commit_full() {
  if [[ -n "${APPFW_SOURCE_COMMIT_FULL:-}" ]]; then
    printf '%s\n' "$APPFW_SOURCE_COMMIT_FULL"
  elif git -C "$framework_root" rev-parse HEAD >/dev/null 2>&1; then
    git -C "$framework_root" rev-parse HEAD
  else
    framework_source_commit_short
  fi
}

create_framework_source_archive() {
  local source_tar="$1"
  local source_name="$2"
  local tmp_root

  mkdir -p "$(dirname "$source_tar")"
  if git -C "$framework_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    (cd "$framework_root" && git archive --format=tar --prefix="${source_name}/" HEAD | gzip -c >"$source_tar")
    return 0
  fi

  tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/appfw-source.XXXXXX")"
  mkdir -p "$tmp_root/$source_name"
  (
    cd "$framework_root"
    tar -cf - \
      --exclude './.git' \
      --exclude './.env' \
      --exclude './target' \
      --exclude './debug' \
      --exclude './node_modules' \
      --exclude './admin_ui/node_modules' \
      --exclude './examples/products/crm/frontend/node_modules' \
      .
  ) | (cd "$tmp_root/$source_name" && tar -xf -)
  (cd "$tmp_root" && tar -czf "$source_tar" "$source_name")
  rm -rf "$tmp_root"
}

appfw_crate_publish_order() {
  cat <<'EOF'
appfw-saas-core
appfw-runtime
appfw-mssql-auth
appfw-provider-postgres
appfw-provider-mongo
appfw-provider-mssql
appfw-provider-snowflake
appfw-provider-neo4j
appfw-provider-salesforce
appfw-provider-workday
appfw-provider-anaplan
appfw-provider-oracle-financials
appfw-provider-servicenow
appfw-provider-icims
appfw-cli
appfw-codegen
appfw-test
EOF
}

write_crates_publish_plan() {
  local crates_plan="$1"
  local version="$2"
  local cargo_registry="$3"
  local cargo_registry_index="$4"
  local first crate

  mkdir -p "$(dirname "$crates_plan")"
  {
    printf '{"version":'
    json_escape "$version"
    printf ',"registry":'
    json_escape "$cargo_registry"
    printf ',"registry_index":'
    json_escape "$cargo_registry_index"
    printf ',"publish_order":['
    first=1
    while IFS= read -r crate; do
      [[ -z "$crate" ]] && continue
      if [[ "$first" == "1" ]]; then
        first=0
      else
        printf ','
      fi
      json_escape "$crate"
    done < <(appfw_crate_publish_order)
    printf '],"commands":['
    first=1
    while IFS= read -r crate; do
      [[ -z "$crate" ]] && continue
      if [[ "$first" == "1" ]]; then
        first=0
      else
        printf ','
      fi
      json_escape "cargo publish --locked --registry ${cargo_registry} -p ${crate}"
    done < <(appfw_crate_publish_order)
    printf ']}\n'
  } >"$crates_plan"
}

write_crates_publish_script() {
  local script_file="$1"
  local source_archive_name="$2"
  local source_name="$3"
  local cargo_registry="$4"
  local publish_order
  publish_order="$(appfw_crate_publish_order)"

  cat >"$script_file" <<EOF
#!/usr/bin/env bash
set -euo pipefail

if [[ -z "\${PROGET_API_KEY:-}" ]]; then
  echo "PROGET_API_KEY is required in the environment." >&2
  exit 2
fi

script_dir="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
source_archive="\$script_dir/${source_archive_name}"
work_dir="\${APPFW_PUBLISH_WORK_DIR:-\$script_dir/publish-work}"

if [[ ! -f "\$source_archive" ]]; then
  echo "Missing source archive: \$source_archive" >&2
  exit 2
fi

mkdir -p "\$work_dir"
tar -xzf "\$source_archive" -C "\$work_dir"
cd "\$work_dir/${source_name}"

export CARGO_REGISTRIES_PDS_APP_FRAMEWORK_CRATES_TOKEN="\$PROGET_API_KEY"

while IFS= read -r crate; do
  [[ -z "\$crate" ]] && continue
  cargo publish --locked --registry ${cargo_registry} -p "\$crate"
done <<'CRATES'
${publish_order}
CRATES

echo "App Framework Cargo crates published to ${cargo_registry}."
EOF
  chmod +x "$script_file"
}

copy_tree_if_exists() {
  local source="$1"
  local target_parent="$2"
  if [[ -e "$source" ]]; then
    mkdir -p "$target_parent"
    cp -R "$source" "$target_parent/"
  fi
}

write_product_docs_pack_readme() {
  local docs_root="$1"
  cat >"$docs_root/README.md" <<'EOF'
# App Framework Product Docs Pack

This pack is the product-developer subset of App Framework documentation and
agent skills. It is intended to be copied into downstream product repos or
published beside the packaged `appfw` CLI/toolchain artifact.

Start here:

- `docs/product/README.md`
- `docs/lifecycle/product-golden-path.md`
- `docs/start/agent-task-map.md`
- `docs/start/product-pr-review-agent-harness.md`
- `docs/reference/cli.md`
- `agent_skills/README.md`
- `AGENTS.md`

The framework architecture, historical extraction notes, and framework-owner
release internals are intentionally excluded from this product pack.
EOF
}

write_product_docs_pack_agents() {
  local docs_root="$1"
  cat >"$docs_root/AGENTS.md" <<'EOF'
# Product Agent Operating Guide

This product repository uses the App Framework product workflow. Before
changing code, docs, CLI usage, skills, config, generated contracts, tests, or
release evidence, start from:

```bash
scripts/appfw product validate --json
scripts/appfw product handoff --json
scripts/appfw product skills --json
```

Use `docs/start/agent-task-map.md` for routing,
`docs/start/product-pr-review-agent-harness.md` for product PR review, and
`agent_skills/README.md` for the smallest matching product skill.

## Product Pre-Push Review Gate

Before pushing any agent-authored product branch:

1. Finish the risk-appropriate proof loop and run
   `scripts/appfw product handoff --json`.
2. Run `scripts/appfw product review-brief --auto-depth --json`.
3. Invoke `/product-pr-review` or `/product-pr-review --comprehensive` as
   indicated by the retained brief, or the `product-pr-review` skill.
4. Present the structured review output to the human:
   Recommendation Summary, Attention Items when final status is not `GO`,
   Findings, Strategic Significance, Role Adherence Assessment, Alignment Drift
   Assessment, Independent Code Quality And Architecture Assessment, Shared
   Reviewer Judgment, Human Approval Brief, Evidence Checked, and Open
   Questions. The Recommendation
   Summary must state final status (`GO`,
   `GO WITH CONDITIONS`, `NO-GO`, or `DEFER`) plus severity counts for blockers,
   critical, important, should_address, and nice_to_address, plus
   `Conditions captured: yes` for `GO WITH CONDITIONS` or
   `Conditions captured: not_applicable` otherwise. Non-`GO` statuses must
   include Attention Items with concise bullets naming the conditions, blockers,
   evidence gaps, or review limits the human must inspect.
5. Push-capable implementation or integration agents may use standing approval
   to push only when review status is `GO` or `GO WITH CONDITIONS`, blocker and
   critical counts are zero, any conditions are captured, and branch state has
   not changed since review.

The review covers the whole change surface, not only source code: product model,
manifest/topology, handlers, services, frontend/mobile, docs, CLI usage, skills,
config, generated contracts, tests, release/CI evidence, product brief alignment,
tenant/security posture, and product/framework boundary drift.

Use `scripts/appfw product review-brief --auto-depth --json` to retain the
normal pre-push review contract input and `scripts/appfw product
review-performance --auto-depth --json` when the human asks to audit the quality
of a prior review. Bare `review-brief --json` and `review-performance --json`
default to focused mode; `--auto-depth` selects focused or comprehensive based
on branch shape and touched surfaces, and `--comprehensive` remains available
when the human explicitly wants whole-branch or PR review.

## Branch Naming

Branch prefixes describe the work stream, not the tool or author. Use purpose or
lane prefixes such as `feature/<topic>`, `fix/<issue>`, `docs/<topic>`,
`integrate/<wave-or-family>`, or `wave3/<lane>`. Do not use assistant/tool
prefixes such as `codex/`, `claude/`, or `agent/`.
EOF
}

create_product_docs_pack() {
  local docs_root="$1"
  rm -rf "$docs_root"
  mkdir -p "$docs_root/docs" "$docs_root/agent_skills"
  write_product_docs_pack_readme "$docs_root"
  write_product_docs_pack_agents "$docs_root"

  copy_tree_if_exists "$framework_root/docs/product" "$docs_root/docs"
  copy_tree_if_exists "$framework_root/docs/lifecycle" "$docs_root/docs"
  copy_tree_if_exists "$framework_root/docs/model" "$docs_root/docs"
  mkdir -p "$docs_root/docs/frontend" "$docs_root/docs/release" "$docs_root/docs/reference" "$docs_root/docs/start"
  for file in README.md product-frontend.md pds-health-design-system.md mobile-react-native.md; do
    [[ -f "$framework_root/docs/frontend/$file" ]] && cp "$framework_root/docs/frontend/$file" "$docs_root/docs/frontend/"
  done
  for file in README.md deployment-reference.md release-gate-ci-cd.md versioning-and-compatibility.md; do
    [[ -f "$framework_root/docs/release/$file" ]] && cp "$framework_root/docs/release/$file" "$docs_root/docs/release/"
  done
  for file in README.md cli.md app-manifest.md product-extension-api.md product-workspace-boundaries.md product-workspace-contract.md; do
    [[ -f "$framework_root/docs/reference/$file" ]] && cp "$framework_root/docs/reference/$file" "$docs_root/docs/reference/"
  done
  for file in README.md agent-task-map.md cli-quickstart.md generated-ownership.md getting-started.md product-pr-review-agent-harness.md; do
    [[ -f "$framework_root/docs/start/$file" ]] && cp "$framework_root/docs/start/$file" "$docs_root/docs/start/"
  done
  cp "$framework_root/agent_skills/README.md" "$docs_root/agent_skills/README.md"
  for skill_dir in "$framework_root"/agent_skills/product-*; do
    [[ -d "$skill_dir" ]] && cp -R "$skill_dir" "$docs_root/agent_skills/"
  done
}

framework_package_manifest_json() {
  local manifest_file="$1"
  local ok="$2"
  local plan="$3"
  local version="$4"
  local platform="$5"
  local package_tar="$6"
  local package_sha="$7"
  local binary_tar="$8"
  local binary_sha="$9"
  local crates_plan="${10}"
  local crates_sha="${11}"
  local docs_tar="${12}"
  local docs_sha="${13}"
  local detail="${14:-}"
  local source_tar="${15:-}"
  local source_sha="${16:-}"
  local publish_script="${17:-}"
  local publish_script_sha="${18:-}"

  mkdir -p "$(dirname "$manifest_file")"
  {
    printf '{"command":"package","ok":%s,"plan":%s' "$ok" "$plan"
    printf ',"version":'
    json_escape "$version"
    printf ',"platform":'
    json_escape "$platform"
    printf ',"build_profile":'
    json_escape "${build_profile:-debug}"
    printf ',"proget_posture":"uploadable-artifacts-produced-locally-ci-publishes"'
    printf ',"artifacts":['
    printf '{"name":"app-framework-toolchain","path":'
    json_escape "$package_tar"
    printf ',"sha256":'
    json_escape "$package_sha"
    printf ',"contents":["bin/appfw","bin/app_gen","bin/appfw_introspect","bin/database","scripts/","app_gen/_templates","app_gen/_golden","app_gen/_config","docs/start/delivery-profiles.json","product-docs"]}'
    printf ',{"name":"app-framework-binaries","path":'
    json_escape "$binary_tar"
    printf ',"sha256":'
    json_escape "$binary_sha"
    printf ',"contents":["bin/appfw","bin/app_gen","bin/appfw_introspect","bin/database"]}'
    printf ',{"name":"app-framework-crates-publish-plan","path":'
    json_escape "$crates_plan"
    printf ',"sha256":'
    json_escape "$crates_sha"
    printf ',"contents":["ordered cargo publish commands","product-facing framework crate list","ProGet Cargo registry metadata"]}'
    printf ',{"name":"app-framework-product-docs","path":'
    json_escape "$docs_tar"
    printf ',"sha256":'
    json_escape "$docs_sha"
    printf ',"contents":["AGENTS.md","docs/product","docs/lifecycle","docs/model","docs/frontend","docs/release","docs/reference","docs/start","docs/start/product-pr-review-agent-harness.md","agent_skills/product-*","product review governance"]}'
    if [[ -n "$source_tar" ]]; then
      printf ',{"name":"app-framework-source","path":'
      json_escape "$source_tar"
      printf ',"sha256":'
      json_escape "$source_sha"
      printf ',"contents":["Cargo workspace source","Cargo.lock",".cargo/config.toml","publishable framework crates"]}'
    fi
    if [[ -n "$publish_script" ]]; then
      printf ',{"name":"app-framework-crates-publish-script","path":'
      json_escape "$publish_script"
      printf ',"sha256":'
      json_escape "$publish_script_sha"
      printf ',"contents":["extract source archive","set Cargo ProGet token","publish crates in dependency order"]}'
    fi
    printf ']'
    if [[ -n "$detail" ]]; then
      printf ',"detail":'
      json_escape "$detail"
    fi
    printf '}\n'
  } >"$manifest_file"
}

framework_package() {
  local json="$1"
  shift || true
  if [[ "$command_namespace" == "product" ]]; then
    echo "package is a framework command; use scripts/appfw framework package --json" >&2
    return 2
  fi

  local plan=0
  local out_dir="${APPFW_PACKAGE_DIR:-$repo_root/target/appfw/proget}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)
        plan=1
        ;;
      --out-dir)
        shift
        out_dir="${1:-}"
        if [[ -z "$out_dir" ]]; then
          echo "--out-dir requires a value" >&2
          return 2
        fi
        ;;
      *)
        echo "Unknown package option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  local version platform source_commit source_commit_full source_name package_name binary_name crates_plan_name docs_name source_name_archive publish_script_name dist_dir binary_dir docs_dir package_tar binary_tar crates_plan docs_tar source_tar publish_script manifest_file cargo_registry cargo_registry_index build_profile cargo_target_root
  build_profile="${APPFW_PACKAGE_PROFILE:-debug}"
  case "$build_profile" in
    debug | release)
      ;;
    *)
      echo "APPFW_PACKAGE_PROFILE must be debug or release, got: $build_profile" >&2
      return 2
      ;;
  esac
  # Honor CARGO_TARGET_DIR (CI sets target/cargo); relative values are
  # cargo-cwd-relative, and the package builds run from the framework root.
  cargo_target_root="${CARGO_TARGET_DIR:-$framework_root/target}"
  case "$cargo_target_root" in
    /*)
      ;;
    *)
      cargo_target_root="$framework_root/$cargo_target_root"
      ;;
  esac
  version="$(package_version_from_manifest "$appfw_cli_dir/Cargo.toml")"
  platform="$(appfw_platform_id)"
  source_commit="$(framework_source_commit_short)"
  source_commit_full="$(framework_source_commit_full)"
  source_name="app-framework-source-${source_commit}"
  package_name="app-framework-${version}-${platform}"
  binary_name="app-framework-binaries-${version}-${platform}"
  crates_plan_name="app-framework-crates-publish-plan-${version}.json"
  docs_name="app-framework-product-docs-${version}"
  source_name_archive="${source_name}.tar.gz"
  publish_script_name="publish-crates-from-source.sh"
  dist_dir="$out_dir/$package_name"
  binary_dir="$out_dir/$binary_name"
  docs_dir="$out_dir/$docs_name"
  package_tar="$out_dir/$package_name.tar.gz"
  binary_tar="$out_dir/$binary_name.tar.gz"
  crates_plan="$out_dir/$crates_plan_name"
  docs_tar="$out_dir/$docs_name.tar.gz"
  source_tar="$out_dir/$source_name_archive"
  publish_script="$out_dir/$publish_script_name"
  manifest_file="$out_dir/app-framework-proget-manifest.json"
  cargo_registry="${APPFW_CARGO_REGISTRY:-pds-app-framework-crates}"
  cargo_registry_index="${APPFW_CARGO_REGISTRY_INDEX:-sparse+https://proget.pdsconnect.com/cargo/pds-app-framework-crates/}"

  if [[ "$plan" == "1" ]]; then
    write_crates_publish_plan "$crates_plan" "$version" "$cargo_registry" "$cargo_registry_index"
    local crates_plan_sha
    crates_plan_sha="$(sha256_file "$crates_plan")"
    framework_package_manifest_json "$manifest_file" true true "$version" "$platform" "$package_tar" "planned" "$binary_tar" "planned" "$crates_plan" "$crates_plan_sha" "$docs_tar" "planned" "plan only; no binaries built; crates publish plan emitted for CI inspection" "$source_tar" "planned" "$publish_script" "planned"
    if [[ "$json" == "1" ]]; then
      cat "$manifest_file"
    else
      printf 'Package plan written: %s\n' "$manifest_file"
    fi
    return 0
  fi

  require_framework_lockfile
  rm -rf "$dist_dir" "$binary_dir" "$docs_dir" "$package_tar" "$binary_tar" "$crates_plan" "$docs_tar" "$source_tar" "$publish_script"
  mkdir -p "$dist_dir/bin" "$binary_dir/bin" "$dist_dir/product-docs" "$out_dir"

  local profile_args=()
  if [[ "$build_profile" == "release" ]]; then
    profile_args+=(--release)
  fi
  (cd "$framework_root" && cargo build --locked ${profile_args[@]+"${profile_args[@]}"} -p appfw-cli --bin appfw)
  (cd "$framework_root" && cargo build --locked ${profile_args[@]+"${profile_args[@]}"} -p appfw-codegen --bin app_gen --bin appfw_introspect)
  (cd "$framework_root" && cargo build --locked ${profile_args[@]+"${profile_args[@]}"} -p database)
  cp "$cargo_target_root/$build_profile/appfw" "$dist_dir/bin/appfw"
  cp "$cargo_target_root/$build_profile/app_gen" "$dist_dir/bin/app_gen"
  cp "$cargo_target_root/$build_profile/appfw_introspect" "$dist_dir/bin/appfw_introspect"
  cp "$cargo_target_root/$build_profile/database" "$dist_dir/bin/database"
  cp "$dist_dir/bin/appfw" "$binary_dir/bin/appfw"
  cp "$dist_dir/bin/app_gen" "$binary_dir/bin/app_gen"
  cp "$dist_dir/bin/appfw_introspect" "$binary_dir/bin/appfw_introspect"
  cp "$dist_dir/bin/database" "$binary_dir/bin/database"
  copy_tree_if_exists "$framework_root/scripts" "$dist_dir"
  mkdir -p "$dist_dir/docs/start"
  cp "$framework_root/docs/start/delivery-profiles.json" "$dist_dir/docs/start/delivery-profiles.json"
  chmod +x "$dist_dir/bin/"*
  chmod +x "$binary_dir/bin/"*
  find "$dist_dir/scripts" -type f -name '*.sh' -exec chmod +x {} \;
  chmod +x "$dist_dir/scripts/appfw"

  copy_tree_if_exists "$app_gen_dir/_templates" "$dist_dir/app_gen"
  copy_tree_if_exists "$app_gen_dir/_golden" "$dist_dir/app_gen"
  copy_tree_if_exists "$app_gen_dir/_config" "$dist_dir/app_gen"
  copy_tree_if_exists "$app_gen_dir/src" "$dist_dir/app_gen"
  cp "$app_gen_dir/Cargo.toml" "$dist_dir/app_gen/Cargo.toml"
  copy_tree_if_exists "$appfw_runtime_dir/src" "$dist_dir/appfw_runtime"
  cp "$appfw_runtime_dir/Cargo.toml" "$dist_dir/appfw_runtime/Cargo.toml"
  copy_tree_if_exists "$appfw_cli_dir/src" "$dist_dir/appfw_cli"
  cp "$appfw_cli_dir/Cargo.toml" "$dist_dir/appfw_cli/Cargo.toml"
  cp "$database_crate_dir/Cargo.toml" "$dist_dir/database.Cargo.toml"

  cat >"$dist_dir/app-framework-package.json" <<EOF
{"version":"${version}","platform":"${platform}","build_profile":"${build_profile}","dependency_source":"registry","cargo_registry":"${cargo_registry}","cargo_registry_index":"${cargo_registry_index}"}
EOF

  write_crates_publish_plan "$crates_plan" "$version" "$cargo_registry" "$cargo_registry_index"

  create_product_docs_pack "$docs_dir"
  cp -R "$docs_dir" "$dist_dir/product-docs/$docs_name"

  cat >"$dist_dir/README.md" <<EOF
# App Framework Toolchain ${version}

This is the ProGet-ready App Framework product toolchain artifact.

Use:

\`\`\`bash
bin/appfw product validate --json
bin/appfw product generate --check --json
bin/appfw product handoff --json
\`\`\`

The packaged CLI auto-discovers sibling binaries in \`bin/\` and uses the
packaged helper scripts under \`scripts/\`, avoiding framework crate builds for
validation, generation, migration, and introspection paths.
EOF

  (cd "$out_dir" && tar -czf "$package_tar" "$package_name")
  (cd "$out_dir" && tar -czf "$binary_tar" "$binary_name")
  (cd "$out_dir" && tar -czf "$docs_tar" "$docs_name")
  create_framework_source_archive "$source_tar" "$source_name"
  write_crates_publish_script "$publish_script" "$source_name_archive" "$source_name" "$cargo_registry"
  printf '%s\n' "$source_commit" >"$out_dir/COMMIT_SHORT.txt"
  printf '%s\n' "$source_commit_full" >"$out_dir/COMMIT_FULL.txt"

  local package_sha binary_sha crates_sha docs_sha source_sha publish_script_sha
  package_sha="$(sha256_file "$package_tar")"
  binary_sha="$(sha256_file "$binary_tar")"
  crates_sha="$(sha256_file "$crates_plan")"
  docs_sha="$(sha256_file "$docs_tar")"
  source_sha="$(sha256_file "$source_tar")"
  publish_script_sha="$(sha256_file "$publish_script")"
  framework_package_manifest_json "$manifest_file" true false "$version" "$platform" "$package_tar" "$package_sha" "$binary_tar" "$binary_sha" "$crates_plan" "$crates_sha" "$docs_tar" "$docs_sha" "" "$source_tar" "$source_sha" "$publish_script" "$publish_script_sha"
  cp "$manifest_file" "$dist_dir/package-manifest.json"

  if [[ "$json" == "1" ]]; then
    cat "$manifest_file"
  else
    printf 'Framework package: %s\n' "$package_tar"
    printf 'Framework binaries: %s\n' "$binary_tar"
    printf 'Framework crates publish plan: %s\n' "$crates_plan"
    printf 'Product docs pack: %s\n' "$docs_tar"
    printf 'Framework source archive: %s\n' "$source_tar"
    printf 'Crates publish script: %s\n' "$publish_script"
    printf 'Manifest: %s\n' "$manifest_file"
  fi
}

copy_app_gen_release_artifacts() {
  local report_dir="$1"
  local target_dir="$report_dir/app-gen"
  local file_name
  local failed=0

  if [[ ! -d "$report_root" ]]; then
    return 0
  fi

  mkdir -p "$target_dir" || return $?
  for file_name in validation.json app_topology.json config_contract.json config_contract.md; do
    if [[ -f "$report_root/$file_name" ]]; then
      cp "$report_root/$file_name" "$target_dir/$file_name" || failed=1
    fi
  done
  return "$failed"
}

prepare_app_gen_release_artifacts() {
  local report_dir="$1"
  local file_name
  local failed=0

  rm -rf "$report_dir/app-gen" || failed=1
  mkdir -p "$report_root" || failed=1
  for file_name in validation.json app_topology.json config_contract.json config_contract.md; do
    rm -f "$report_root/$file_name" || failed=1
  done
  return "$failed"
}

finalize_release_check_json_report() {
  local report_tmp="$1"
  local report_file="$2"
  local failed="$3"
  local incomplete="${4:-false}"
  local current_check="${5:-}"
  local report_dir
  local generated_at_utc
  report_dir="$(dirname "$report_file")"
  generated_at_utc="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

  printf '],"generated_at_utc":' >>"$report_tmp"
  json_escape "$generated_at_utc" >>"$report_tmp"
  printf ',"incomplete":%s' "$incomplete" >>"$report_tmp"
  if [[ -n "$current_check" ]]; then
    printf ',"current_check":' >>"$report_tmp"
    json_escape "$current_check" >>"$report_tmp"
  fi
  release_check_diagnostics_json "$failed" "$incomplete" "$report_dir" "$current_check" >>"$report_tmp"
  printf '}\n' >>"$report_tmp"
  if [[ "$failed" == "1" ]]; then
    local failed_report
    failed_report="$(mktemp "${TMPDIR:-/tmp}/appfw-release-check.XXXXXX")"
    json_set_top_level_bool "$report_tmp" "$failed_report" ok false
    mv "$failed_report" "$report_tmp"
  fi
  mv "$report_tmp" "$report_file"
}

abort_release_check_json_report() {
  local status=$?

  if [[ "${APPFW_RELEASE_CHECK_JSON_OPEN:-0}" == "1" \
    && -n "${APPFW_RELEASE_CHECK_JSON_TMP:-}" \
    && -n "${APPFW_RELEASE_CHECK_JSON_FILE:-}" \
    && -f "${APPFW_RELEASE_CHECK_JSON_TMP:-}" ]]; then
    finalize_release_check_json_report \
      "$APPFW_RELEASE_CHECK_JSON_TMP" \
      "$APPFW_RELEASE_CHECK_JSON_FILE" \
      1 \
      true \
      "${APPFW_RELEASE_CHECK_CURRENT:-unknown}" || true
  fi

  exit "$status"
}

run_release_check_logged() {
  local log_file="$1"
  shift

  (
    set +e
    "$@"
  ) >"$log_file" 2>&1
}

doctor_check_json_item() {
  local first="$1"
  local name="$2"
  local status="$3"
  local required="$4"
  local detail="$5"

  if [[ "$first" != "1" ]]; then
    printf ','
  fi
  printf '{"name":'
  json_escape "$name"
  printf ',"status":'
  json_escape "$status"
  printf ',"required":%s,"detail":' "$required"
  json_escape "$detail"
  printf '}'
}

doctor_mssql_odbc_driver_check() {
  local mode="$1"
  local first="$2"
  local name="$3"
  local driver_pattern="$4"
  local required=false
  local status detail

  if ! command -v odbcinst >/dev/null 2>&1; then
    status="missing"
    detail="odbcinst not on PATH; install unixodbc and MSSQL ODBC drivers (see docs/runtime/provider-sdk.md)"
  else
    local drivers
    drivers="$(odbcinst -q -d 2>/dev/null || true)"
    if [[ -z "$drivers" ]]; then
      status="missing"
      detail="no ODBC drivers registered; install unixodbc + msodbcsql18/FreeTDS (see docs/runtime/provider-sdk.md)"
    elif printf '%s\n' "$drivers" | grep -qi "$driver_pattern"; then
      status="ok"
      detail="registered in odbcinst"
    else
      status="missing"
      detail="not registered in odbcinst; see docs/runtime/provider-sdk.md MSSQL ODBC drivers"
    fi
  fi

  if [[ "$mode" == "json" ]]; then
    doctor_check_json_item "$first" "$name" "$status" "$required" "$detail"
  else
    if [[ "$status" == "ok" ]]; then
      printf "  %s       %-22s %s\n" "$(appfw_color '1;32' ok)" "$name" "$detail"
    else
      printf "  %s %-22s %s\n" "$(appfw_color '1;33' optional)" "$name" "$detail"
    fi
  fi
}

doctor() {
  local json="$1"
  shift || true
  local database=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --database)
        database=1
        ;;
      *)
        if [[ "$json" == "1" ]]; then
          json_result "doctor" false "unknown doctor option: $1"
        else
          echo "Unknown doctor option: $1" >&2
        fi
        return 2
        ;;
    esac
    shift || true
  done

  if [[ "$database" == "1" && "$json" == "1" ]]; then
    run_database_cargo run --quiet -- doctor --json
    return
  fi

  local failed=0

  local checks=(
    "cargo:required"
    "rustc:required"
    "rustfmt:required"
    "git:required"
    "rsync:required"
    "diff:required"
    "shasum:required"
    "podman:optional"
    "docker:optional"
    "odbcinst:optional"
  )

  if [[ "$json" == "1" ]]; then
    local first=1
    local item name requirement required status detail
    printf '{"command":"doctor","ok":'
    for item in "${checks[@]}"; do
      name="${item%%:*}"
      requirement="${item##*:}"
      if [[ "$requirement" == "required" ]]; then
        required=true
      else
        required=false
      fi
      if command -v "$name" >/dev/null 2>&1; then
        status="ok"
        detail="$(command -v "$name")"
      else
        status="missing"
        detail="$name is not available on PATH"
        if [[ "$requirement" == "required" ]]; then
          failed=1
        fi
      fi
      if [[ "$first" == "1" ]]; then
        first=0
      fi
    done
    if [[ "$failed" == "0" ]]; then
      printf 'true,"checks":['
    else
      printf 'false,"checks":['
    fi

    first=1
    for item in "${checks[@]}"; do
      name="${item%%:*}"
      requirement="${item##*:}"
      if [[ "$requirement" == "required" ]]; then
        required=true
      else
        required=false
      fi
      if command -v "$name" >/dev/null 2>&1; then
        status="ok"
        detail="$(command -v "$name")"
      else
        status="missing"
        detail="$name is not available on PATH"
      fi
      doctor_check_json_item "$first" "$name" "$status" "$required" "$detail"
      first=0
    done
    doctor_mssql_odbc_driver_check json 0 "mssql-freetds-driver" "FreeTDS"
    doctor_mssql_odbc_driver_check json 0 "mssql-odbc-driver18" "ODBC Driver 18 for SQL Server"
    printf ']}\n'
    return "$failed"
  fi

  appfw_banner
  echo
  for item in "${checks[@]}"; do
    local name="${item%%:*}"
    local requirement="${item##*:}"
    if command -v "$name" >/dev/null 2>&1; then
      printf "  %s       %-10s %s\n" "$(appfw_color '1;32' ok)" "$name" "$(command -v "$name")"
    elif [[ "$requirement" == "required" ]]; then
      printf "  %s  %-10s required\n" "$(appfw_color '1;31' missing)" "$name"
      failed=1
    else
      printf "  %s %-10s not found\n" "$(appfw_color '1;33' optional)" "$name"
    fi
  done
  doctor_mssql_odbc_driver_check text 0 "mssql-freetds-driver" "FreeTDS"
  doctor_mssql_odbc_driver_check text 0 "mssql-odbc-driver18" "ODBC Driver 18 for SQL Server"
  echo
  printf "  app root       %s\n" "$app_root"
  printf "  framework root %s\n" "$framework_root"
  printf "  generator      %s\n" "$app_gen_dir"
  printf "  config         %s\n" "$config_root"
  printf "  templates      %s\n" "$templates_root"
  printf "  reports        %s\n" "$report_root"
  printf "  scripts        %s\n" "$script_dir"

  if [[ "$database" == "1" ]]; then
    echo
    set +e
    run_database_cargo run -- doctor
    local database_status=$?
    set -e
    if [[ $database_status -ne 0 ]]; then
      failed=1
    fi
  fi

  return "$failed"
}

validate() {
  local json="$1"
  local report="$report_root/validation.json"

  if [[ "$json" == "1" ]]; then
    local log_file
    log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-validate.XXXXXX")"
    set +e
    run_app_gen_validate >"$log_file" 2>&1
    local status=$?
    set -e
    if [[ -f "$report" ]]; then
      python3 - "$report" "$status" "${command_namespace:-compatibility}" <<'PY'
import json
import sys

report_path, status, namespace = sys.argv[1:4]
with open(report_path, "r", encoding="utf-8") as handle:
    report = json.load(handle)

report["command"] = "validate"
report["ok"] = int(status) == 0 and report.get("valid") is True
report["requested_namespace"] = namespace
report["scope"] = (
    "framework-default-product-config"
    if namespace == "framework"
    else "product-config"
)
print(json.dumps(report, indent=2))
PY
      rm -f "$log_file"
    elif [[ $status -eq 0 ]]; then
      json_result "validate" true "validation report was not written"
      rm -f "$log_file"
    else
      json_result "validate" false "validation failed; diagnostic output was captured at $log_file"
    fi
    return "$status"
  fi

  run_app_gen_validate
}

generate_mobile_rn_target() {
  local json="$1"
  local check="$2"
  local log_file
  local emission_file
  log_file="$report_root/mobile-rn-generate-mobile-test.log"
  emission_file="$report_root/mobile-rn-generate-emission.json"
  mkdir -p "$(dirname "$log_file")"

  set +e
  python3 - "$app_root" "$framework_root" "$report_root" "$check" "$emission_file" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

app_root = Path(sys.argv[1]).resolve()
framework_root = Path(sys.argv[2]).resolve()
report_root = Path(sys.argv[3]).resolve()
check_mode = sys.argv[4] == "1"
emission_file = Path(sys.argv[5]).resolve()

ui_contract_path = app_root / "frontend/src/generated/appfw-ui-contract.ts"
mobile_contract_path = app_root / "mobile/src/generated/appfw-mobile-contract.ts"
token_bridge_path = app_root / "mobile/src/design/pdsNativeTokens.ts"
ownership_path = app_root / "mobile/.appfw-mobile/ownership.json"
scaffold_manifest_path = app_root / "mobile/.appfw-mobile/scaffold-manifest.json"
manifest_path = app_root / ".appfw/manifest.yaml"

def rel(path, root=app_root):
    path = Path(path)
    for candidate in (root, framework_root):
        try:
            return str(path.relative_to(candidate))
        except ValueError:
            pass
    return str(path)

def sha256(value):
    return hashlib.sha256(value.encode("utf-8")).hexdigest()

def read_text(path):
    return path.read_text(encoding="utf-8") if path.exists() else ""

def read_json(path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None

def parse_manifest_display_name():
    text = read_text(manifest_path)
    match = re.search(r"(?m)^\s*display_name:\s*(.+?)\s*$", text)
    if not match:
        return None
    return match.group(1).strip().strip('"').strip("'")

def parse_existing_product_display_name():
    text = read_text(mobile_contract_path)
    match = re.search(r'productDisplayName:\s*"([^"]+)"', text)
    return match.group(1) if match else None

def parse_existing_governed_actions():
    text = read_text(mobile_contract_path)
    match = re.search(r"governedActions:\s*(\[[\s\S]*?\])\s*,\s*requiredStates:", text)
    if not match:
        return []
    block = match.group(1)
    try:
        normalized = re.sub(r"(\w+):", r'"\1":', block)
        normalized = normalized.replace("'", '"')
        return json.loads(normalized)
    except Exception:
        return []

def extract_ui_contract():
    if not ui_contract_path.exists():
        raise ValueError(f"missing UI contract: {rel(ui_contract_path)}")
    text = ui_contract_path.read_text(encoding="utf-8")
    match = re.search(
        r"export const [A-Za-z0-9_]+UiContract =\s*(\{[\s\S]*?\})\s*as const satisfies AppfwUiContract;",
        text,
    )
    if not match:
        raise ValueError("could not find AppfwUiContract JSON object in frontend UI contract")
    try:
        return json.loads(match.group(1))
    except json.JSONDecodeError as exc:
        raise ValueError(f"could not parse AppfwUiContract JSON object: {exc}") from exc

def operation_alias(name):
    for prefix in ("query_", "find_", "get_", "list_"):
        if name.startswith(prefix):
            return name[len(prefix):]
    return name

def operation_summary(operation):
    return {
        "name": operation.get("name"),
        "graphqlName": operation.get("graphqlName") or operation.get("name"),
        "returnsShape": operation.get("returnsShape"),
        "variables": operation.get("variables") or [],
        "selectionPreset": operation.get("selectionPreset") or ["id"],
        "requiresAuth": bool(operation.get("requiresAuth")),
        "requiresTenant": bool(operation.get("requiresTenant")),
    }

def entity_operations(entity):
    reads = []
    detail = None
    list_operation = None
    detail_operation = None
    entity_name = entity.get("typeName") or "Record"
    entity_lower = entity_name[:1].lower() + entity_name[1:]
    for operation in entity.get("operations", []):
        if operation.get("kind") != "query":
            continue
        name = operation.get("name")
        if not name:
            continue
        returns = operation.get("returnsShape")
        alias = operation_alias(name)
        if returns in ("connection", "list") and alias not in reads:
            reads.append(alias)
            if list_operation is None:
                list_operation = operation_summary(operation)
        elif returns == "record" and detail is None:
            detail = alias
            detail_operation = operation_summary(operation)
    if list_operation is None:
        list_operation = {
            "name": f"query_{entity_lower}s",
            "graphqlName": f"query{entity_name}s",
            "returnsShape": "connection",
            "variables": [],
            "selectionPreset": ["id"],
            "requiresAuth": True,
            "requiresTenant": True,
        }
    if detail_operation is None:
        detail_operation = {
            "name": f"find_{entity_lower}",
            "graphqlName": f"find{entity_name}",
            "returnsShape": "record",
            "variables": [{"name": "id", "dataType": "ID", "required": True}],
            "selectionPreset": ["id"],
            "requiresAuth": True,
            "requiresTenant": True,
        }
    return reads or [f"{entity_lower}s"], detail or entity_lower, list_operation, detail_operation

def mobile_primary_entities(contract):
    entities = []
    for entity in contract.get("entities", []):
        if entity.get("readOnly"):
            continue
        name = entity.get("typeName")
        route = entity.get("routeSegment")
        caption = (entity.get("caption") or {}).get("plural")
        if not name or not route or not caption:
            continue
        reads, detail, list_operation, detail_operation = entity_operations(entity)
        entities.append(
            {
                "name": name,
                "caption": caption,
                "mobileRoute": f"entities/{route}",
                "readOperations": reads,
                "detailOperation": detail,
                "listOperation": list_operation,
                "recordOperation": detail_operation,
            }
        )
    return entities

def mobile_contract_source(contract):
    schema_name = contract.get("schemaName") or "product"
    product_display_name = (
        parse_existing_product_display_name()
        or parse_manifest_display_name()
        or schema_name.upper()
    )
    entities = mobile_primary_entities(contract)

    governed_actions = parse_existing_governed_actions()
    if not governed_actions and any(entity.get("name") == "Account" for entity in entities):
        governed_actions = [
            {
                "name": "AccountHealthReview",
                "caption": "Review account health",
                "requiresIntentPreview": True,
                "requiresAuditTrail": True,
                "undo": "not-applicable-for-read-review",
            }
        ]

    payload = {
        "product": schema_name,
        "productDisplayName": product_display_name,
        "generatedContractSource": "frontend/src/generated/appfw-ui-contract.ts",
        "nativeRuntime": "react-native-expo-new-architecture",
        "primaryEntities": entities,
        "governedActions": governed_actions,
        "requiredStates": [
            "loading",
            "empty",
            "policy-denied",
            "validation-error",
            "offline",
            "unexpected-error",
        ],
    }

    body = json.dumps(payload, indent=2)
    body = re.sub(r'\n(\s*)"([^"]+)":', r"\n\1\2:", body)
    body = body.replace(": true", ": true").replace(": false", ": false")
    return (
        "// Generated by App Framework. Do not hand-edit.\n"
        "export const mobileContract = "
        + body
        + " as const;\n\n"
        "export type AppfwMobileContract = typeof mobileContract;\n"
    )

def token_bridge_source():
    return """// Generated by App Framework. Do not hand-edit.
