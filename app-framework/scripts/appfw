def generated_data_client_source():
    return """// Generated by App Framework. Do not hand-edit.
import { mobileContract } from "./appfw-mobile-contract";

type MobileEntity = (typeof mobileContract.primaryEntities)[number];
type MobileOperation = {
  graphqlName: string;
  returnsShape: "connection" | "list" | "record";
  variables: ReadonlyArray<{
    name: string;
    dataType: string;
    required: boolean;
  }>;
  selectionPreset: ReadonlyArray<string>;
  requiresAuth: boolean;
  requiresTenant: boolean;
};

export type AppfwMobileRequestKind = "list" | "record";
export type AppfwMobileState =
  | "idle"
  | "loading"
  | "loaded"
  | "empty"
  | "policy-denied"
  | "validation-error"
  | "offline"
  | "unexpected-error";

export type AppfwMobileGraphqlRequest = {
  entityName: string;
  kind: AppfwMobileRequestKind;
  operationName: string;
  query: string;
  variables: Record<string, unknown>;
  requiresAuth: boolean;
  requiresTenant: boolean;
};

export type AppfwMobileGraphqlResult<T = unknown> = {
  state: AppfwMobileState;
  data?: T;
  errors?: ReadonlyArray<{ message?: string; extensions?: Record<string, unknown> }>;
  requestId?: string;
  correlationId?: string;
};

export type AppfwMobileGraphqlClientOptions = {
  endpoint: string;
  getAccessToken?: () => Promise<string | undefined> | string | undefined;
  getTenantId?: () => Promise<string | undefined> | string | undefined;
  fetchImpl?: typeof fetch;
};

const graphqlScalarByDataType: Record<string, string> = {
  Boolean: "Boolean",
  Date: "String",
  DateTime: "String",
  Decimal: "Float",
  Float: "Float",
  ID: "ID",
  Int: "Int",
  JsonValue: "JsonValue",
  String: "String",
  Uuid: "ID"
};

function resolveGraphqlType(dataType: string) {
  return graphqlScalarByDataType[dataType] ?? "String";
}

function operationVariables(operation: MobileOperation) {
  return operation.variables.filter((variable) => variable.name);
}

function variableDefinitions(operation: MobileOperation) {
  const definitions = operationVariables(operation).map((variable) => {
    const required = variable.required ? "!" : "";
    return `$${variable.name}: ${resolveGraphqlType(variable.dataType)}${required}`;
  });
  return definitions.length > 0 ? `(${definitions.join(", ")})` : "";
}

function operationArguments(operation: MobileOperation) {
  const args = operationVariables(operation).map((variable) => `${variable.name}: $${variable.name}`);
  return args.length > 0 ? `(${args.join(", ")})` : "";
}

function selectionFields(operation: MobileOperation) {
  const fields = Array.from(new Set(operation.selectionPreset)).filter((field) => /^[A-Za-z_][A-Za-z0-9_]*$/.test(field));
  return fields.length > 0 ? fields : ["id"];
}

function selectionBlock(operation: MobileOperation) {
  const fields = selectionFields(operation).join("\\n      ");
  if (operation.returnsShape === "connection") {
    return `{\\n    nodes {\\n      ${fields}\\n    }\\n    totalCount\\n    pageInfo {\\n      hasNextPage\\n      endCursor\\n    }\\n  }`;
  }
  if (operation.returnsShape === "list") {
    return `{\\n    ${fields}\\n  }`;
  }
  return `{\\n    ${fields}\\n  }`;
}

function requestFor(entity: MobileEntity, kind: AppfwMobileRequestKind, variables: Record<string, unknown>) {
  const operation = kind === "list" ? entity.listOperation : entity.recordOperation;
  const operationName = `AppfwMobile${entity.name}${kind === "list" ? "List" : "Record"}`;
  const query = `query ${operationName}${variableDefinitions(operation)} {\\n  ${operation.graphqlName}${operationArguments(operation)} ${selectionBlock(operation)}\\n}`;

  return {
    entityName: entity.name,
    kind,
    operationName,
    query,
    variables,
    requiresAuth: operation.requiresAuth,
    requiresTenant: operation.requiresTenant
  } satisfies AppfwMobileGraphqlRequest;
}

function classifyErrors(errors: AppfwMobileGraphqlResult["errors"]): AppfwMobileState {
  if (!errors || errors.length === 0) {
    return "unexpected-error";
  }
  const errorText = errors.map((error) => `${error.message ?? ""} ${String(error.extensions?.error_category ?? "")}`).join(" ").toLowerCase();
  if (errorText.includes("policy") || errorText.includes("permission") || errorText.includes("forbidden")) {
    return "policy-denied";
  }
  if (errorText.includes("validation")) {
    return "validation-error";
  }
  return "unexpected-error";
}

async function resolveMaybeAsync(value: (() => Promise<string | undefined> | string | undefined) | undefined) {
  if (!value) {
    return undefined;
  }
  return await value();
}

export function getAppfwMobileEntityClient(entityName: string) {
  const entity = mobileContract.primaryEntities.find((candidate) => candidate.name === entityName);
  if (!entity) {
    throw new Error(`Unknown mobile entity: ${entityName}`);
  }

  return {
    entityName: entity.name,
    caption: entity.caption,
    mobileRoute: entity.mobileRoute,
    listOperation: entity.listOperation,
    recordOperation: entity.recordOperation,
    selectionPreset: selectionFields(entity.listOperation),
    buildListRequest: (variables: Record<string, unknown> = { limit: 25 }) => requestFor(entity, "list", variables),
    buildRecordRequest: (id: string) => requestFor(entity, "record", { id })
  } as const;
}

export function createAppfwMobileGraphqlClient(options: AppfwMobileGraphqlClientOptions) {
  const fetcher = options.fetchImpl ?? fetch;

  async function execute<T = unknown>(request: AppfwMobileGraphqlRequest): Promise<AppfwMobileGraphqlResult<T>> {
    const headers: Record<string, string> = {
      "content-type": "application/json"
    };
    const token = await resolveMaybeAsync(options.getAccessToken);
    const tenantId = await resolveMaybeAsync(options.getTenantId);

    if (request.requiresAuth && token) {
      headers.authorization = `Bearer ${token}`;
    }
    if (request.requiresTenant && tenantId) {
      headers["x-tenant-id"] = tenantId;
    }

    try {
      const response = await fetcher(options.endpoint, {
        method: "POST",
        headers,
        body: JSON.stringify({
          operationName: request.operationName,
          query: request.query,
          variables: request.variables
        })
      });
      const payload = await response.json();
      const requestId = payload?.extensions?.request_id;
      const correlationId = payload?.extensions?.correlation_id;
      if (payload?.errors?.length) {
        return {
          state: classifyErrors(payload.errors),
          errors: payload.errors,
          requestId,
          correlationId
        };
      }
      const data = payload?.data as T | undefined;
      return {
        state: data == null ? "empty" : "loaded",
        data,
        requestId,
        correlationId
      };
    } catch (error) {
      return {
        state: "offline",
        errors: [{ message: error instanceof Error ? error.message : "network request failed" }]
      };
    }
  }

  return { execute } as const;
}
"""

