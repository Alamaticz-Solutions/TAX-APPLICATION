}

provider_test_saas_read_area() {
  local json="$1"
  local provider="$2"
  local plan="$3"

  case "$provider" in
    servicenow|workday|icims|salesforce|anaplan|oracle_financials)
      ;;
    "")
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "missing external API provider; pass --provider servicenow|workday|icims|salesforce|anaplan|oracle_financials with --area saas-read --plan"
      else
        echo "Missing external API provider for --area saas-read." >&2
      fi
      return 2
      ;;
    *)
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "saas-read provider-test area is only for external API providers"
      else
        echo "saas-read provider-test area is only for external API providers." >&2
      fi
      return 2
      ;;
  esac

  if [[ "$plan" != "1" ]]; then
    if [[ "$json" == "1" ]]; then
      json_result "provider-test" false "saas-read provider-test currently supports --plan only; live SaaS read certification awaits the W3-A runtime executor and provider-backed live smoke evidence"
    else
      echo "saas-read provider-test currently supports --plan only." >&2
    fi
    return 2
  fi

  local areas_json
  if ! areas_json="$(run_provider_certification_export --provider "$provider" --areas)"; then
    if [[ "$json" == "1" ]]; then
      json_result "provider-test" false "failed to read external API provider capability matrix"
    else
      echo "Failed to read external API provider capability matrix." >&2
    fi
    return 2
  fi

  APPFW_SAAS_READ_AREAS_JSON="$areas_json" python3 - "$repo_root" "$json" "$provider" <<'PY'
import datetime
import json
import os
import sys
from pathlib import Path

repo_root = Path(sys.argv[1]).resolve()
json_mode = sys.argv[2] == "1"
provider = sys.argv[3]
report_dir = Path(os.environ.get("APPFW_PROVIDER_TEST_REPORT_DIR", repo_root / "target/appfw")).resolve()
report_path = report_dir / "saas-read-provider-test.json"

read_areas = [
    "connection_auth",
    "named_operation_registry",
    "request_binding",
    "pagination_cursoring",
    "rate_limit_backoff",
    "incremental_watermark",
    "field_redaction",
    "tenant_scoping",
    "schema_version_pinning",
    "result_and_timeout_caps",
    "query_metrics_and_audit",
    "freshness_reporting",
]
write_areas = {
    "governed_write_enforcement",
    "delegated_actor_context",
    "token_store_isolation",
    "named_mutation_registry",
    "mutation_request_binding",
    "idempotency_and_replay_protection",
    "write_policy_and_scope_enforcement",
    "write_audit_and_evidence",
}

def rel(path):
    try:
        return str(Path(path).resolve().relative_to(repo_root))
    except ValueError:
        return str(Path(path).resolve())

try:
    exported_areas = json.loads(os.environ["APPFW_SAAS_READ_AREAS_JSON"])
except Exception as exc:
    exported_areas = []
    export_error = str(exc)
else:
    export_error = None

areas_by_key = {
    item.get("area"): item
    for item in exported_areas
    if isinstance(item, dict) and isinstance(item.get("area"), str)
}
read_area_rows = [
    areas_by_key[area]
    for area in read_areas
    if area in areas_by_key
]
omitted_write_areas = [
    item.get("area")
    for item in exported_areas
    if isinstance(item, dict) and item.get("area") in write_areas
]
missing_read_areas = [
    area
    for area in read_areas
    if area not in areas_by_key
]

env_prefix = f"APPFW_{provider.upper()}_SAAS_READ"
required_env = [
    f"{env_prefix}_BASE_URL",
    f"{env_prefix}_AUTH_MODE",
    f"{env_prefix}_TOKEN_REF",
    f"{env_prefix}_TEST_TENANT",
    f"{env_prefix}_READ_OPERATION_NAME",
    f"{env_prefix}_EVIDENCE_FILE",
]
status_counts = {}
for row in read_area_rows:
    status = row.get("status", "unknown")
    status_counts[status] = status_counts.get(status, 0) + 1

report = {
    "command": "provider-test",
    "lane": "DP6",
    "schema_version": "appfw.saas_read_provider_test.plan.v1",
    "area": "saas_read",
    "provider": provider,
    "provider_family": "external_api",
    "mode": "plan",
    "plan_only": True,
    "ok": export_error is None and not missing_read_areas,
    "release_ready": False,
    "generated_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "artifact": rel(report_path),
    "evidence_artifact": "target/appfw/saas-read-evidence.json",
    "required_checks": read_areas,
    "required_env": required_env,
    "required_live_inputs": {
        "connection": required_env[:4],
        "operation_contract": required_env[4:5],
        "evidence_retention": required_env[5:],
    },
    "areas": read_area_rows,
    "omitted_write_areas": omitted_write_areas,
    "status_counts": status_counts,
    "evidence_template": {
        "command": "provider-test",
        "lane": "DP6",
        "ok": True,
        "release_ready": True,
        "provider": provider,
        "operation": "saas_read",
        "redaction": {
            "secrets_removed": True,
            "raw_payloads_removed": True,
            "tenant_data_removed": True,
        },
        "connection_auth": {
            "tenant": f"${env_prefix}_TEST_TENANT",
            "token_ref": f"${env_prefix}_TOKEN_REF",
        },
        "request_binding": {
            "provider_owned_request": True,
            "raw_url_or_query_from_caller": False,
            "operation_name": f"${env_prefix}_READ_OPERATION_NAME",
        },
        "caps": {
            "result_limit_enforced": True,
            "timeout_enforced": True,
        },
        "audit": {
            "correlation_id": "generated-by-provider-test",
            "provider_request_id": "redacted-or-hash",
            "query_metrics_recorded": True,
        },
        "freshness": {
            "watermark_recorded": True,
            "lineage_recorded": True,
        },
        "live_provider_call": {
            "executed": True,
            "non_production": True,
            "result": "success",
        },
    },
    "evidence_policy": (
        "Plan mode does not create saas-read-evidence.json. Live mode must be added by W3-A/DP6 after "
        "the runtime SaaS executor and provider-backed live smoke fixtures exist."
    ),
    "next_step": (
        f"Add a provider-backed {provider} live-smoke fixture, set {env_prefix}_EVIDENCE_FILE, and "
        "extend this area from plan mode to live evidence validation without retaining secrets or tenant data."
    ),
}
if export_error:
    report["export_error"] = export_error
if missing_read_areas:
    report["missing_read_areas"] = missing_read_areas

report_dir.mkdir(parents=True, exist_ok=True)
report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

if json_mode:
    print(json.dumps(report, indent=2, sort_keys=True))
else:
    print(f"provider-test SaaS read plan for {provider}: {rel(report_path)}")
raise SystemExit(0 if report["ok"] else 1)
PY
}

provider_test() {
  local json="$1"
  shift

  local all=0
  local provider=""
  local area=""
  local plan=0
  local provider_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        all=1
        ;;
      --provider)
        shift || true
        provider="${1:-}"
        ;;
      --area)
        shift || true
        area="${1:-}"
        ;;
      --plan)
        plan=1
        ;;
      postgres|mongo|mssql|snowflake|ai_search|ai-search)
        provider="$1"
        ;;
      *)
        provider_args+=("$1")
        ;;
    esac
    shift || true
  done

  if [[ "$all" == "1" && -n "$provider" ]]; then
    if [[ "$json" == "1" ]]; then
      json_result "provider-test" false "use either --all or --provider, not both"
    else
      echo "Use either --all or --provider, not both." >&2
    fi
    return 2
  fi

  if [[ "$provider" == "ai-search" ]]; then
    provider="ai_search"
  fi

  if [[ "$provider" == "ai_search" ]]; then
    if [[ "$all" == "1" || -n "$area" ]]; then
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "AI search provider-test supports only --provider ai_search --plan"
      else
        echo "AI search provider-test supports only --provider ai_search --plan." >&2
      fi
      return 2
    fi
    if [[ "$plan" != "1" ]]; then
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "AI search provider-test is plan-only until enterprise contract evidence and executor support exist; pass --plan"
      else
        echo "AI search provider-test is plan-only until enterprise contract evidence and executor support exist; pass --plan." >&2
      fi
      return 2
    fi
    provider_test_ai_search_plan "$json"
    return $?
  fi

  case "$area" in
    "" )
      ;;
    governed-write|governed_write|g1|G1)
      if [[ "$all" == "1" ]]; then
        if [[ "$json" == "1" ]]; then
          json_result "provider-test" false "governed-write provider-test area requires one external API provider, not --all"
        else
          echo "governed-write provider-test area requires one external API provider, not --all." >&2
        fi
        return 2
      fi
      provider_test_governed_write_area "$json" "$provider" "$plan"
      return $?
      ;;
    saas-read|saas_read|dp6|DP6)
      if [[ "$all" == "1" ]]; then
        if [[ "$json" == "1" ]]; then
          json_result "provider-test" false "saas-read provider-test area requires one external API provider, not --all"
        else
          echo "saas-read provider-test area requires one external API provider, not --all." >&2
        fi
        return 2
      fi
      provider_test_saas_read_area "$json" "$provider" "$plan"
      return $?
      ;;
    *)
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "unknown provider-test area: $area"
      else
        echo "Unknown provider-test area: $area" >&2
      fi
      return 2
      ;;
  esac

  local providers=()
  if [[ "$all" == "1" ]]; then
    providers=(postgres mongo mssql snowflake)
  else
    if [[ -z "$provider" ]]; then
      provider="$(provider_from_env)"
    fi
    if [[ -z "$provider" ]]; then
      if [[ "$json" == "1" ]]; then
        json_result "provider-test" false "missing provider; pass --provider postgres|mongo|mssql|snowflake or --all"
      else
        echo "Missing provider. Pass --provider postgres|mongo|mssql|snowflake or --all." >&2
      fi
      return 2
    fi
    providers=("$provider")
  fi

  if [[ ! -d "$provider_api_tests_dir" ]]; then
    if [[ "$json" == "1" ]]; then
      json_result "provider-test" false "provider certification crate not found under framework root"
    else
      echo "Provider certification crate not found: $provider_api_tests_dir" >&2
    fi
    return 2
  fi

  local report_dir="${APPFW_PROVIDER_TEST_REPORT_DIR:-$repo_root/target/appfw}"
  local report_file="$report_dir/provider-parity.json"
  local legacy_report_dir="$provider_api_tests_dir/target"
  local release_report_dir="$repo_root/target/appfw"
  mkdir -p "$report_dir"

  local failed=0
  local first=1

  if [[ "$json" == "1" ]]; then
    local report_tmp
    report_tmp="$(mktemp "$report_dir/provider-parity.XXXXXX")"
    APPFW_PROVIDER_TEST_JSON_TMP="$report_tmp"
    APPFW_PROVIDER_TEST_JSON_FILE="$report_file"
    APPFW_PROVIDER_TEST_JSON_OPEN=1
    trap abort_provider_test_json_report EXIT

    local generated_at_utc
    generated_at_utc="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '{"command":"provider-test","generated_at_utc":' >"$report_tmp"
    json_escape "$generated_at_utc" >>"$report_tmp"
    printf ',"ok":true,"providers":[' >>"$report_tmp"

    local test_filter
    if [[ ${#provider_args[@]} -gt 0 ]]; then
      test_filter="$(provider_test_filter_from_args "${provider_args[@]}")"
    else
      test_filter=""
    fi
    local report_mode="full"
    if [[ -n "$test_filter" ]]; then
      report_mode="targeted"
    fi

    for provider in "${providers[@]}"; do
      local data_source
      data_source="$(provider_data_source_name "$provider")"
      local base_url
      base_url="$(provider_base_url "$provider")"
      local log_file="$report_dir/provider-test-${provider}.log"

      set +e
      : >"$log_file"
      provider_test_preflight "$provider" "$base_url" "$log_file" "$all"
      local status=$?
      if [[ $status -eq 0 && ${#provider_args[@]} -gt 0 ]]; then
        run_provider_api_tests "$provider" "$log_file" "${provider_args[@]}"
        status=$?
      elif [[ $status -eq 0 ]]; then
        run_provider_api_tests "$provider" "$log_file"
        status=$?
      else
        status=$status
      fi
      set -e

      local ok=true
      if [[ $status -ne 0 ]]; then
        ok=false
        failed=1
      fi
      local areas_json
      if [[ "$report_mode" == "targeted" ]]; then
        areas_json="[]"
      else
        set +e
        areas_json="$(provider_area_report "$provider" "$log_file" 2>>"$log_file")"
        local area_status=$?
        set -e
        if [[ $area_status -ne 0 ]]; then
          areas_json="[]"
          ok=false
          failed=1
        fi
      fi

      provider_test_report_item "$first" "$provider" "$ok" "$data_source" "$base_url" "$log_file" "$areas_json" "$report_mode" "$test_filter" >>"$report_tmp"
      first=0
    done

    finalize_provider_test_json_report "$report_tmp" "$report_file" "$failed"
    mirror_provider_test_artifacts "$report_dir" "$release_report_dir" "${providers[@]}"
    mirror_provider_test_artifacts "$report_dir" "$legacy_report_dir" "${providers[@]}"
    APPFW_PROVIDER_TEST_JSON_OPEN=0
    unset APPFW_PROVIDER_TEST_JSON_TMP APPFW_PROVIDER_TEST_JSON_FILE APPFW_PROVIDER_TEST_JSON_OPEN
    trap - EXIT
    cat "$report_file"
    return "$failed"
  fi

  local test_filter
  if [[ ${#provider_args[@]} -gt 0 ]]; then
    test_filter="$(provider_test_filter_from_args "${provider_args[@]}")"
  else
    test_filter=""
  fi
  for provider in "${providers[@]}"; do
    local data_source
    data_source="$(provider_data_source_name "$provider")"
    local base_url
    base_url="$(provider_base_url "$provider")"
    echo "Provider certification: $provider ($data_source at $base_url)"
    local log_file
    log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-provider-${provider}.XXXXXX")"
    set +e
    provider_test_preflight "$provider" "$base_url" "$log_file" "$all"
    local status=$?
    if [[ $status -eq 0 && ${#provider_args[@]} -gt 0 ]]; then
      run_provider_api_tests "$provider" "$log_file" "${provider_args[@]}"
      status=$?
    elif [[ $status -eq 0 ]]; then
      run_provider_api_tests "$provider" "$log_file"
      status=$?
    else
      status=$status
    fi
    set -e
    cat "$log_file"
    if [[ -z "$test_filter" ]]; then
      if ! provider_area_report "$provider" "$log_file" >/dev/null; then
        failed=1
        echo "Provider certification area gate failed for $provider." >&2
      fi
    fi
    rm -f "$log_file"
    if [[ $status -ne 0 ]]; then
      failed=1
    fi
  done
  return "$failed"
}

release_check() {
  local json="$1"

  if [[ "$json" == "1" ]]; then
    local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
    local report_file="$report_dir/release-check.json"
    mkdir -p "$report_dir"
    local report_tmp
    report_tmp="$(mktemp "$report_dir/release-check.XXXXXX")"
    APPFW_RELEASE_CHECK_JSON_TMP="$report_tmp"
    APPFW_RELEASE_CHECK_JSON_FILE="$report_file"
    APPFW_RELEASE_CHECK_JSON_OPEN=1
    trap abort_release_check_json_report EXIT

    local failed=0
    local first=1
    local first_failed_check=""
    printf '{"command":"release-check","ok":true,"checks":[' >"$report_tmp"
    local security_assurance_required
    security_assurance_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_SECURITY_ASSURANCE_DECISION:-${APPFW_REQUIRE_SECURITY_ASSURANCE_DECISION:-}}")"
    local production_attestations_required
    production_attestations_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_PRODUCTION_ATTESTATIONS:-${APPFW_REQUIRE_PRODUCTION_ATTESTATIONS:-}}")"
    if [[ "$production_attestations_required" == "true" ]]; then
      security_assurance_required=true
    fi
    local live_ops_required
    live_ops_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_LIVE_OPS_EVIDENCE:-}")"
    local ops_certification_required
    ops_certification_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_OPS_CERTIFICATION:-}")"
    if [[ "$live_ops_required" == "true" ]]; then
      ops_certification_required=true
    fi
    local pds_baseline_required
    pds_baseline_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_PDS_BASELINE_EVIDENCE:-${APPFW_RELEASE_REQUIRE_PDS_BASELINE:-}}")"
    local release_identity_required
    release_identity_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_RELEASE_IDENTITY:-}")"

    APPFW_RELEASE_CHECK_CURRENT="pds-baseline"
    local pds_log_file="$report_dir/release-check-pds-baseline.log"
    local pds_artifact_file="$report_dir/pds-security-baseline.json"
    set +e
    pds_baseline_check "$pds_artifact_file" >"$pds_log_file" 2>&1
    local pds_status=$?
    set -e
    if [[ "$pds_baseline_required" == "true" \
      && $pds_status -eq 0 \
      && -f "$pds_artifact_file" ]] \
      && json_top_level_bool_is_false "$pds_artifact_file" release_ready; then
      printf '\nrelease-check: pds-baseline artifact is not release-ready.\n' >>"$pds_log_file"
      pds_status=1
    fi
    if [[ $pds_status -ne 0 ]]; then
      release_check_json_item "$first" "pds-baseline" false "$pds_log_file" "$pds_artifact_file" >>"$report_tmp"
      failed=1
      first_failed_check="pds-baseline"
    else
      release_check_json_item "$first" "pds-baseline" true "$pds_log_file" "$pds_artifact_file" >>"$report_tmp"
    fi
    first=0

    if [[ "$release_identity_required" == "true" ]]; then
      APPFW_RELEASE_CHECK_CURRENT="release-identity"
      local release_identity_log_file="$report_dir/release-check-release-identity.log"
      local release_identity_artifact_file="$report_dir/release-identity.json"
      set +e
      release_identity_check "$release_identity_artifact_file" >"$release_identity_log_file" 2>&1
      local release_identity_status=$?
      set -e
      if [[ $release_identity_status -eq 0 \
        && -f "$release_identity_artifact_file" ]] \
        && json_top_level_bool_is_false "$release_identity_artifact_file" release_ready; then
        printf '\nrelease-check: release-identity artifact is not release-ready.\n' >>"$release_identity_log_file"
        release_identity_status=1
      fi
      if [[ $release_identity_status -ne 0 ]]; then
        release_check_json_item "$first" "release-identity" false "$release_identity_log_file" "$release_identity_artifact_file" >>"$report_tmp"
        failed=1
        if [[ -z "$first_failed_check" ]]; then
          first_failed_check="release-identity"
        fi
      else
        release_check_json_item "$first" "release-identity" true "$release_identity_log_file" "$release_identity_artifact_file" >>"$report_tmp"
      fi
      first=0
    fi

    if [[ "$security_assurance_required" == "true" ]]; then
      APPFW_RELEASE_CHECK_CURRENT="security-assurance-decision"
      local security_assurance_log_file="$report_dir/release-check-security-assurance-decision.log"
      local security_assurance_artifact_file="$report_dir/security-assurance-decision.json"
      set +e
      APPFW_RELEASE_ARTIFACT_DIR="$report_dir" \
        APPFW_RELEASE_REQUIRE_SECURITY_ASSURANCE_DECISION=true \
        APPFW_RELEASE_REQUIRE_PRODUCTION_ATTESTATIONS="$production_attestations_required" \
        run_release_check_logged "$security_assurance_log_file" bash "$script_dir/ci/security-assurance-decision.sh"
      local security_assurance_status=$?
      set -e
      if [[ $security_assurance_status -ne 0 ]]; then
        release_check_json_item "$first" "security-assurance-decision" false "$security_assurance_log_file" "$security_assurance_artifact_file" >>"$report_tmp"
        failed=1
        if [[ -z "$first_failed_check" ]]; then
          first_failed_check="security-assurance-decision"
        fi
      else
        release_check_json_item "$first" "security-assurance-decision" true "$security_assurance_log_file" "$security_assurance_artifact_file" >>"$report_tmp"
      fi
      first=0
    fi

    APPFW_RELEASE_CHECK_CURRENT="provider-url-preflight"
    local preflight_log_file="$report_dir/release-check-provider-url-preflight.log"
    local preflight_snapshot_file="$report_dir/release-check-provider-url-preflight.json"
    APPFW_RELEASE_PROVIDER_URL_PREFLIGHT_JSON="$preflight_snapshot_file"
    set +e
    release_check_provider_url_preflight "$preflight_log_file" "$preflight_snapshot_file"
    local preflight_status=$?
    set -e
    if [[ $preflight_status -ne 0 ]]; then
      release_check_json_item "$first" "provider-url-preflight" false "$preflight_log_file" "$preflight_snapshot_file" >>"$report_tmp"
      finalize_release_check_json_report "$report_tmp" "$report_file" 1 false "provider-url-preflight"
      APPFW_RELEASE_CHECK_JSON_OPEN=0
      unset APPFW_RELEASE_CHECK_JSON_TMP APPFW_RELEASE_CHECK_JSON_FILE APPFW_RELEASE_CHECK_JSON_OPEN APPFW_RELEASE_CHECK_CURRENT APPFW_RELEASE_PROVIDER_URL_PREFLIGHT_JSON
      trap - EXIT
      cat "$report_file"
      return 1
    fi
    release_check_json_item "$first" "provider-url-preflight" true "$preflight_log_file" "$preflight_snapshot_file" >>"$report_tmp"
    first=0

    local release_checks=(
      validate
      mcp-posture
      boundary-check
      feature-check
      composition-check
      provider-graduation
      governed-write-check
      wave2-status
      docs-check
      generate-check
      test
      policy-test
      ops-certification
      provider-test
      security-certification
    )
    if [[ "${APPFW_RELEASE_REQUIRE_PERFORMANCE_EVIDENCE:-false}" == "true" ]]; then
      release_checks+=(load-test-suite provider-performance)
    fi
    release_checks+=(handoff)

    local name ok log_file status artifact_file artifact_status
    for name in "${release_checks[@]}"; do
      APPFW_RELEASE_CHECK_CURRENT="$name"
      log_file="$report_dir/release-check-${name}.log"
      artifact_file=""
      status=0
      set +e
      case "$name" in
        validate)
          prepare_app_gen_release_artifacts "$report_dir"
          status=$?
          if [[ $status -eq 0 ]]; then
            run_release_check_logged "$log_file" validate 1
            status=$?
          else
            printf 'failed to prepare app_gen release artifacts\n' >"$log_file"
          fi
          copy_app_gen_release_artifacts "$report_dir"
          artifact_status=$?
          if [[ $status -eq 0 ]]; then
            status=$artifact_status
          fi
          if [[ -f "$report_dir/app-gen/validation.json" ]]; then
            artifact_file="$report_dir/app-gen/validation.json"
          fi
          ;;
        boundary-check)
          rm -f "$report_dir/boundary-check.json"
          status=$?
          if [[ $status -eq 0 ]]; then
            run_release_check_logged "$log_file" boundary_check 1
            status=$?
          else
            printf 'failed to clear stale boundary-check artifact\n' >"$log_file"
          fi
          if [[ -f "$report_root/boundary_check.json" ]]; then
            artifact_file="$report_dir/boundary-check.json"
            cp "$report_root/boundary_check.json" "$artifact_file"
            artifact_status=$?
            if [[ $status -eq 0 ]]; then
              status=$artifact_status
            fi
          fi
          ;;
        mcp-posture)
          artifact_file="$report_dir/release-mcp-posture.json"
          mcp_release_posture_check "$artifact_file" >"$log_file" 2>&1
          status=$?
          ;;
        feature-check)
          run_release_check_logged "$log_file" feature_check 1
          status=$?
          ;;
        composition-check)
          artifact_file="$report_dir/composition-check.json"
          rm -f "$artifact_file"
          status=$?
          if [[ $status -eq 0 ]]; then
            run_release_check_logged "$log_file" composition_check 1 --enforce
            status=$?
          else
            printf 'failed to clear stale composition-check artifact\n' >"$log_file"
          fi
          local composition_source="$repo_root/target/appfw/composition-check.json"
          if [[ -f "$composition_source" ]]; then
            if [[ "$composition_source" != "$artifact_file" ]]; then
              cp "$composition_source" "$artifact_file"
              artifact_status=$?
              if [[ $status -eq 0 ]]; then
                status=$artifact_status
              fi
            fi
          fi
          ;;
        provider-graduation)
          artifact_file="$report_dir/provider-graduation.json"
          rm -f "$artifact_file"
          status=$?
          if [[ $status -eq 0 ]]; then
            run_release_check_logged "$log_file" provider_graduation
            status=$?
          else
            printf 'failed to clear stale provider-graduation artifact\n' >"$log_file"
          fi
          local provider_graduation_source="$repo_root/target/appfw/provider-graduation.json"
          if [[ -f "$provider_graduation_source" ]]; then
            if [[ "$provider_graduation_source" != "$artifact_file" ]]; then
              cp "$provider_graduation_source" "$artifact_file"
              artifact_status=$?
              if [[ $status -eq 0 ]]; then
                status=$artifact_status
              fi
            fi
          fi
          ;;
        governed-write-check)
          artifact_file="$report_dir/governed-write-posture.json"
          rm -f "$artifact_file"
          status=$?
          if [[ $status -eq 0 ]]; then
            APPFW_GOVERNED_WRITE_REPORT_DIR="$report_dir" run_release_check_logged "$log_file" governed_write_check 1 --enforce
            status=$?
          else
            printf 'failed to clear stale governed-write posture artifact\n' >"$log_file"
          fi
          ;;
        wave2-status)
          artifact_file="$report_dir/wave2-readiness.json"
          rm -f "$artifact_file"
          status=$?
          if [[ $status -eq 0 ]]; then
            APPFW_WAVE2_REPORT_DIR="$report_dir" run_release_check_logged "$log_file" wave2_status 1
            status=$?
          else
            printf 'failed to clear stale Wave 2 readiness artifact\n' >"$log_file"
          fi
          ;;
        docs-check)
          run_release_check_logged "$log_file" docs_check 1
          status=$?
          ;;
        generate-check)
          run_release_check_logged "$log_file" generate 1 1
          status=$?
          ;;
        test)
          run_release_check_logged "$log_file" test_all 1
          status=$?
          ;;
        policy-test)
          artifact_file="$report_dir/policy-test.json"
          write_policy_test_release_artifact "$artifact_file" "$log_file"
          status=$?
          ;;
        ops-certification)
          artifact_file="$report_dir/ops-certification.json"
          ops_certification_check "$artifact_file" >"$log_file" 2>&1
          status=$?
          ;;
        provider-test)
          rm -f "$provider_api_tests_dir/target/provider-parity.json" "$report_dir/provider-parity.json" "$report_dir"/provider-test-*.log
          status=$?
          if [[ $status -eq 0 ]]; then
            APPFW_PROVIDER_TEST_REPORT_DIR="$report_dir" run_release_check_logged "$log_file" provider_test 1 --all
            status=$?
          fi
          if [[ -f "$report_dir/provider-parity.json" ]]; then
            artifact_file="$report_dir/provider-parity.json"
          elif [[ -f "$provider_api_tests_dir/target/provider-parity.json" ]]; then
            artifact_file="$report_dir/provider-parity.json"
            cp "$provider_api_tests_dir/target/provider-parity.json" "$artifact_file"
            artifact_status=$?
            if [[ $status -eq 0 ]]; then
              status=$artifact_status
            fi
          fi
          ;;
        security-certification)
          artifact_file="$report_dir/security-certification.json"
          run_release_check_logged "$log_file" security_certification 1
          status=$?
          ;;
        load-test-suite)
          artifact_file="$report_dir/load-test.json"
          APPFW_LOAD_TEST_SUITE_OUTPUT_DIR="$report_dir/load-tests" \
            APPFW_LOAD_TEST_SUITE_SUMMARY="$artifact_file" \
            run_release_check_logged "$log_file" load_test_suite 1
          status=$?
          ;;
        provider-performance)
          artifact_file="$report_dir/provider-performance.json"
          APPFW_PROVIDER_PERFORMANCE_OUTPUT="$artifact_file" \
            APPFW_PROVIDER_PARITY_REPORT="$report_dir/provider-parity.json" \
            APPFW_PROVIDER_PERF_REQUIRE_LIVE=true \
            run_release_check_logged "$log_file" provider_performance 1 --all
          status=$?
          ;;
        handoff)
          rm -f "$report_dir/agent-handoff.json"
          status=$?
          if [[ $status -eq 0 ]]; then
            run_release_check_logged "$log_file" handoff 1
            status=$?
          else
            printf 'failed to clear stale handoff artifact\n' >"$log_file"
          fi
          if [[ -f "$report_dir/agent-handoff.json" ]]; then
            artifact_file="$report_dir/agent-handoff.json"
          fi
          ;;
      esac
      set -e
      if [[ $status -eq 0 ]]; then
        ok=true
        local release_ready_required=true
        case "$name" in
          ops-certification)
            if [[ "$ops_certification_required" != "true" ]]; then
              release_ready_required=false
            fi
            ;;
          wave2-status)
            release_ready_required=false
            ;;
        esac
        if [[ "$release_ready_required" == "true" \
          && -n "$artifact_file" \
          && -f "$artifact_file" ]] \
          && json_top_level_bool_is_false "$artifact_file" release_ready; then
          ok=false
          failed=1
          if [[ -z "$first_failed_check" ]]; then
            first_failed_check="$name"
          fi
          printf '\nrelease-check: %s artifact is not release-ready.\n' "$name" >>"$log_file"
        fi
      else
        ok=false
        failed=1
        if [[ -z "$first_failed_check" ]]; then
          first_failed_check="$name"
        fi
      fi
      release_check_json_item "$first" "$name" "$ok" "$log_file" "$artifact_file" >>"$report_tmp"
      first=0
    done
    unset APPFW_RELEASE_CHECK_CURRENT

    finalize_release_check_json_report "$report_tmp" "$report_file" "$failed" false "$first_failed_check"
    APPFW_RELEASE_CHECK_JSON_OPEN=0
    unset APPFW_RELEASE_CHECK_JSON_TMP APPFW_RELEASE_CHECK_JSON_FILE APPFW_RELEASE_CHECK_JSON_OPEN APPFW_RELEASE_PROVIDER_URL_PREFLIGHT_JSON
    trap - EXIT
    local release_status="$failed"
    if [[ "$release_status" == "0" ]] && ! json_top_level_bool_is_true "$report_file" release_ready; then
      release_status=1
    fi
    cat "$report_file"
    return "$release_status"
  fi

  local prerequisite_failed=0
  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local pds_baseline_required
  pds_baseline_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_PDS_BASELINE_EVIDENCE:-${APPFW_RELEASE_REQUIRE_PDS_BASELINE:-}}")"
  local release_identity_required
  release_identity_required="$(release_check_bool_from_env "${APPFW_RELEASE_REQUIRE_RELEASE_IDENTITY:-}")"

  if ! pds_baseline 0; then
    prerequisite_failed=1
  fi
  if [[ "$pds_baseline_required" == "true" \
    && -f "$report_dir/pds-security-baseline.json" ]] \
    && ! json_top_level_bool_is_true "$report_dir/pds-security-baseline.json" release_ready; then
    echo "release-check: pds-baseline artifact is not release-ready." >&2
    prerequisite_failed=1
  fi

  if [[ "$release_identity_required" == "true" ]]; then
    if ! release_identity 0; then
      prerequisite_failed=1
    fi
    if [[ -f "$report_dir/release-identity.json" ]] \
      && ! json_top_level_bool_is_true "$report_dir/release-identity.json" release_ready; then
      echo "release-check: release-identity artifact is not release-ready." >&2
      prerequisite_failed=1
    fi
  fi

  local preflight_log_file="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}/release-check-provider-url-preflight.log"
  mkdir -p "$(dirname "$preflight_log_file")"
  if ! release_check_provider_url_preflight "$preflight_log_file"; then
    cat "$preflight_log_file" >&2
    prerequisite_failed=1
  fi
  if [[ "$prerequisite_failed" != "0" ]]; then
    return 1
  fi

  validate 0
  mcp_release_posture_check
  boundary_check 0
  docs_check 0
  generate 0 1
  test_all 0
  policy_test 0
  ops_certification 0
  provider_test 0 --all
  security_certification 0
  if [[ "${APPFW_RELEASE_REQUIRE_PERFORMANCE_EVIDENCE:-false}" == "true" ]]; then
    load_test_suite 0
    APPFW_PROVIDER_PERF_REQUIRE_LIVE=true provider_performance 0 --all
  fi
  handoff 0
}

migrate() {
  local json="$1"
  shift || true
  local args=("$@")

  if [[ ${#args[@]} -eq 0 && "$json" == "1" ]]; then
    run_with_json_capture "migrate" run_database_cargo run
    return
  fi

  if [[ ${#args[@]} -eq 0 ]]; then
    run_database_cargo run
    return
  fi

  if [[ "$json" == "1" ]]; then
    args+=("--json")
    run_database_cargo run --quiet -- migrate "${args[@]}"
    return
  fi

  run_database_cargo run -- migrate "${args[@]}"
}

serve() {
  local json="$1"

  if [[ "$json" == "1" ]]; then
    json_result "serve" false "serve is an interactive long-running command; run without --json"
    return 2
  fi

  require_product_lockfile
  (
    cd "$backend_dir"
    VERSION="${VERSION:-local-dev}" \
      RUST_MIN_STACK="${RUST_MIN_STACK:-16777216}" \
      cargo run --locked --bin backend
  )
}

load_test() {
  local json="$1"
  shift || true

  local args=()
  if [[ "$json" == "1" ]]; then
    args+=("--json")
    if [[ -z "${APPFW_LOAD_TEST_OUTPUT:-}" ]]; then
      local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
      mkdir -p "$report_dir"
      export APPFW_LOAD_TEST_OUTPUT="$report_dir/load-test.json"
    fi
  fi
  args+=("$@")
  bash "$script_dir/load-test-generated-api.sh" "${args[@]}"
}

load_test_suite() {
  local json="$1"
  shift || true

  local args=()
  if [[ "$json" == "1" ]]; then
    args+=("--json")
    local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
    mkdir -p "$report_dir/load-tests"
    if [[ -z "${APPFW_LOAD_TEST_SUITE_OUTPUT_DIR:-}" ]]; then
      export APPFW_LOAD_TEST_SUITE_OUTPUT_DIR="$report_dir/load-tests"
    fi
    if [[ -z "${APPFW_LOAD_TEST_SUITE_SUMMARY:-}" ]]; then
      export APPFW_LOAD_TEST_SUITE_SUMMARY="$report_dir/load-test.json"
    fi
  fi
  args+=("$@")
  bash "$script_dir/load-test-suite-generated-api.sh" "${args[@]}"
}

provider_performance() {
  local json="$1"
  shift || true

  local args=()
  if [[ "$json" == "1" ]]; then
    args+=("--json")
    local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
    mkdir -p "$report_dir"
    if [[ -z "${APPFW_PROVIDER_PERFORMANCE_OUTPUT:-}" ]]; then
      export APPFW_PROVIDER_PERFORMANCE_OUTPUT="$report_dir/provider-performance.json"
    fi
    if [[ -z "${APPFW_PERFORMANCE_RECOMMENDATIONS_REPORT:-}" ]]; then
      local recommendations_retained="$report_dir/performance_recommendations.json"
      local recommendations_source=""
      local candidate
      local recommendation_sources=(
        "$report_root/performance_recommendations.json"
        "$app_root/.appfw/target/appfw/performance_recommendations.json"
        "$framework_root/examples/products/crm/.appfw/target/appfw/performance_recommendations.json"
      )
      for candidate in "${recommendation_sources[@]}"; do
        if [[ -f "$candidate" ]]; then
          recommendations_source="$candidate"
          break
        fi
      done
      if [[ -f "$recommendations_source" && "$recommendations_source" != "$recommendations_retained" ]]; then
        cp "$recommendations_source" "$recommendations_retained"
      fi
      export APPFW_PERFORMANCE_RECOMMENDATIONS_REPORT="$recommendations_retained"
    fi
  fi
  args+=("$@")
  bash "$script_dir/provider-performance-certification.sh" "${args[@]}"
}

dependency_check() {
  local json="$1"
  shift || true

  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local args=(
    --repo-root "$repo_root"
    --report-dir "$report_dir"
  )
  if [[ "$json" == "1" ]]; then
    args+=(--json)
  fi
  args+=("$@")
  python3 "$script_dir/dependency-check.py" "${args[@]}"
}

dependency_plan() {
  local json="$1"
  shift || true

  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local args=(
    --mode plan
    --repo-root "$repo_root"
    --report-dir "$report_dir"
  )
  if [[ "$json" == "1" ]]; then
    args+=(--json)
  fi
  args+=("$@")
  python3 "$script_dir/dependency-check.py" "${args[@]}"
}

dependency_upgrade() {
  local json="$1"
  local check_mode="$2"
  shift 2 || true

  local report_dir="${APPFW_RELEASE_ARTIFACT_DIR:-$repo_root/target/appfw}"
  local args=(
    --mode upgrade
    --repo-root "$repo_root"
    --report-dir "$report_dir"
  )
  if [[ "$json" == "1" ]]; then
    args+=(--json)
  fi
  if [[ "$check_mode" == "1" ]]; then
    args+=(--check)
  fi
  args+=("$@")
  python3 "$script_dir/dependency-check.py" "${args[@]}"
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

command_name="$1"
shift || true
command_namespace=""

# The typed resolver owns instruction-route parsing, including positional errors.
if [[ "$command_name" == "product" || "$command_name" == "framework" ]]; then
  if [[ "${1:-}" == "instructions" ]]; then
    command_namespace="$command_name"
    shift
    instruction_route "$@"
    exit $?
  fi
elif [[ "$command_name" == "instructions" ]]; then
  instruction_route "$@"
  exit $?
fi

json=0
check=0
declare -a passthrough=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)
      json=1
      ;;
    --check)
      check=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      passthrough+=("$@")
      break
      ;;
    *)
      passthrough+=("$1")
      ;;
  esac
  shift || true
done

if [[ "$command_name" == "product" || "$command_name" == "framework" ]]; then
  command_namespace="$command_name"
  if [[ ${#passthrough[@]} -eq 0 ]]; then
    usage
    exit 2
  fi
  command_name="${passthrough[0]}"
  passthrough=("${passthrough[@]:1}")
fi

case "$command_name" in
  context)
    context_command "$json"
    ;;
  lifecycle)
    lifecycle_command "$json"
    ;;
  doctor)
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      doctor "$json" "${passthrough[@]}"
    else
      doctor "$json"
    fi
    ;;
  validate)
    validate "$json"
    ;;
  topology)
    topology "$json"
    ;;
  generate)
    if [[ "$command_namespace" == "framework" && "$check" == "1" ]]; then
      generate_gate_evidence=0
      if [[ "$json" == "1" && -z "${passthrough[0]-}" ]]; then
        generate_gate_evidence=1
      fi
      run_framework_gate \
        "framework-generate-check" \
        "scripts/appfw framework generate --check --json" \
        "$generate_gate_evidence" \
        generate "$json" "$check" ${passthrough[@]+"${passthrough[@]}"}
    elif [[ ${#passthrough[@]} -gt 0 ]]; then
      generate "$json" "$check" "${passthrough[@]}"
    else
      generate "$json" "$check"
    fi
    ;;
  config-contract)
    config_contract "$json"
    ;;
  manifest)
    manifest "$json"
    ;;
  explain)
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      explain "$json" "${passthrough[@]}"
    else
      explain "$json"
    fi
    ;;
  lock)
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      lock_command "$json" "${passthrough[@]}"
    else
      lock_command "$json"
    fi
    ;;
  upgrade)
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      upgrade "$json" "$check" "${passthrough[@]}"
    else
      upgrade "$json" "$check"
    fi
    ;;
  new)
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      new_app "$json" "${passthrough[@]}"
    else
      new_app "$json"
    fi
    ;;
  analyze)
    if [[ "$command_namespace" == "framework" ]]; then
      echo "analyze is a product command; use scripts/appfw product analyze --json" >&2
      exit 2
    fi
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      analyze "$json" "${passthrough[@]}"
    else
      analyze "$json"
    fi
    ;;
  propose-model)
    if [[ "$command_namespace" == "framework" ]]; then
      echo "propose-model is a product command; use scripts/appfw product propose-model --json" >&2
      exit 2
    fi
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      propose_model "$json" "${passthrough[@]}"
    else
      propose_model "$json"
    fi
    ;;
  model-status)
    if [[ "$command_namespace" == "framework" ]]; then
      echo "model-status is a product command; use scripts/appfw product model-status --json" >&2
      exit 2
    fi
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      model_status "$json" "${passthrough[@]}"
    else
      model_status "$json"
    fi
    ;;
  scaffold-model)
    if [[ "$command_namespace" == "framework" ]]; then
      echo "scaffold-model is a product command; use scripts/appfw product scaffold-model --dry-run --json" >&2
      exit 2
    fi
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      scaffold_model "$json" "${passthrough[@]}"
    else
      scaffold_model "$json"
    fi
    ;;
  intake-proof)
    if [[ "$command_namespace" == "product" ]]; then
      echo "intake-proof is a framework command; use scripts/appfw framework intake-proof --json" >&2
      exit 2
    fi
    if [[ ${#passthrough[@]} -gt 0 ]]; then
      intake_proof "$json" "${passthrough[@]}"
    else
      intake_proof "$json"
    fi
    ;;
