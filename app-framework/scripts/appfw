generate() {
  local json="$1"
  local check="$2"
  shift 2 || true
  local manifest="$report_root/artifacts.json"
  local target=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift || true
        if [[ $# -eq 0 ]]; then
          echo "generate: --target requires a value" >&2
          return 2
        fi
        target="$1"
        ;;
      --target=*)
        target="${1#--target=}"
        ;;
      *)
        echo "generate: unknown option: $1" >&2
        return 2
        ;;
    esac
    shift || true
  done

  if [[ -n "$target" ]]; then
    case "$target" in
      mobile-rn)
        if [[ "$command_namespace" == "framework" ]]; then
          echo "generate --target mobile-rn is a product command; use scripts/appfw product generate --target mobile-rn --json" >&2
          return 2
        fi
        generate_mobile_rn_target "$json" "$check"
        return
        ;;
      *)
        echo "generate: unknown target: $target" >&2
        return 2
        ;;
    esac
  fi

  if [[ "$check" == "1" ]]; then
    if [[ "$json" == "1" ]]; then
      generate_check_json_result
    else
      "$repo_root/scripts/check_app_gen_backend_equivalence.sh"
    fi
    return
  fi

  if [[ "$json" == "1" ]]; then
    local log_file
    log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-generate.XXXXXX")"
    set +e
    run_app_gen_generate >"$log_file" 2>&1
    local status=$?
    set -e
    if [[ $status -eq 0 ]]; then
      json_file_or_result "$manifest" "generate" true "artifact manifest was not written"
      rm -f "$log_file"
    else
      json_result "generate" false "generation failed; diagnostic output was captured at $log_file"
    fi
    return "$status"
  fi

  run_app_gen_generate
}

config_contract() {
  local json="$1"
  local contract_json="$report_root/config_contract.json"
  local contract_md="$report_root/config_contract.md"
  local source_contract="$config_root/_specs/CONFIG_CONTRACT.md"

  if [[ "$json" == "1" ]]; then
    local log_file
    log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-config-contract.XXXXXX")"
    set +e
    run_app_gen_validate >"$log_file" 2>&1
    local status=$?
    set -e
    if [[ $status -eq 0 ]]; then
      json_file_or_result "$contract_json" "config-contract" true "config contract was not written"
      rm -f "$log_file"
    else
      json_result "config-contract" false "config contract generation failed; diagnostic output was captured at $log_file"
    fi
    return "$status"
  fi

  run_app_gen_validate
  echo
  echo "Config contract written:"
  echo "  $contract_json"
  echo "  $contract_md"
  echo "  $source_contract"
}

manifest() {
  local json="$1"
  local manifest_file="$report_root/artifacts.json"

  if [[ ! -f "$manifest_file" ]]; then
    if [[ "$json" == "1" ]]; then
      json_result "manifest" false "artifact manifest is missing; run scripts/appfw generate first"
    else
      echo "Artifact manifest is missing. Run scripts/appfw generate first." >&2
    fi
    return 1
  fi

  cat "$manifest_file"
}

topology() {
  local json="$1"
  local topology_file="$report_root/app_topology.json"

  if [[ "$json" == "1" ]]; then
    local log_file
    log_file="$(mktemp "${TMPDIR:-/tmp}/appfw-topology.XXXXXX")"
    set +e
    run_app_gen_validate >"$log_file" 2>&1
    local status=$?
    set -e
    if [[ $status -eq 0 ]]; then
      json_file_or_result "$topology_file" "topology" true "app topology report was not written"
      rm -f "$log_file"
    else
      json_result "topology" false "topology validation failed; diagnostic output was captured at $log_file"
    fi
    return "$status"
  fi

  run_app_gen_validate
  echo
  echo "App topology written:"
  echo "  $topology_file"
  echo
  cat "$topology_file"
}

